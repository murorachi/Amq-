function getQuizPool(){const chosenPool=document.getElementById('quizPool').value;const type=quizSettings.watchlistOnly?'all':chosenPool;let pool=songs.filter(s=>String(s[4]||'').trim()&&window.__aniCandidatePoolPolicyV8265.blacklistAllowed(!!window.__aniHistoryAPIv51?.isBlacklisted(s[1])));if(activeFocusModeV72){if(!activeFocusSongIdsV72.length){document.getElementById('quizStatus').textContent='這組學習歌曲已全部完成一輪。可回到「練習工作台」查看下一步，或離開學習模式後再開始一般猜歌。';return []}const focusSet=new Set(activeFocusSongIdsV72.map(String));pool=pool.filter(s=>focusSet.has(String(s[1])));if(quizSettings.noRepeat)pool=pool.filter(s=>window.__aniCandidatePoolPolicyV8265.repeatAllowed(s[1],true,quizRoundSeen,lastQuestionId));return pool}pool=pool.filter(s=>window.__aniCandidatePoolPolicyV8265.quickPoolAllowed(st(s[1]),songTags[String(s[1])]||'',s[6],type,'amq'));const selectedStatuses=quizSettings.statuses;pool=pool.filter(s=>window.__aniCandidatePoolPolicyV8265.statusAllowed(st(s[1]),selectedStatuses));pool=pool.filter(s=>{const a=byAnime.get(s[0]);if(!a)return false;if(!window.__aniCandidatePoolPolicyV8265.watchStatusAllowed(watchStatus(a[0]),!!quizSettings.watchStatusFilterEnabled,quizSettings.watchStatuses))return false;if(!window.__aniCandidatePoolPolicyV8265.metadataAllowed({source:'amq',year:a[5],season:a[3],animeType:a[4],songType:s[2],difficulty:s[6]},quizSettings))return false;if(!window.__aniCandidatePoolPolicyV8265.tagAllowed(songTags[String(s[1])]||'',!!quizSettings.tagsOnly,quizSettings.tagText))return false;if(quizSettings.watchlistOnly){const keys=[String(a[0]),String(a[6]||'')].filter(Boolean);const inList=keys.some(k=>{const w=animeWatch?.[k];if(!w)return false;const v=typeof w==='string'?w:(w.status||'none');return v!=='none'&&v!==''});if(!window.__aniCandidatePoolPolicyV8265.watchlistAllowed(inList,true))return false}if(!window.__aniCandidatePoolPolicyV8265.repeatAllowed(s[1],!!quizSettings.noRepeat,quizRoundSeen,lastQuestionId))return false;return true});if(!pool.length){const inListCount=anime.filter(a=>watchStatus(a[0])!=='none'||(animeWatch?.[String(a[6]||'')]&&((animeWatch[String(a[6]||'')].status)||animeWatch[String(a[6]||'')])!=='none')).length;document.getElementById('quizStatus').textContent=quizSettings.watchlistOnly&&!inListCount?'你的「我的清單」目前沒有可辨識的看番狀態。請到「我的清單」確認作品是否已加入，或重新匯入 AniList／MAL 清單。':'目前條件沒有符合的歌曲。系統不會自動放寬範圍；請檢查年代、作品類型、歌曲類型、熟悉度、標籤、清單與黑名單。';return []}if(quizSettings.noRepeat&&lastQuestionId!==null&&pool.length>1)pool=pool.filter(s=>String(s[1])!==String(lastQuestionId));return pool}
const __aniEmqGetQuizPoolBaseV8248=getQuizPool;getQuizPool=function(){const base=__aniEmqGetQuizPoolBaseV8248();const mixed=window.__aniEmqAPI?.combinePool?.(base,quizSettings,activeFocusModeV72,quizRoundSeen,lastQuestionId,activeFocusSongIdsV72);const rows=(Array.isArray(mixed)?mixed:base);const health=window.__aniAudioHealthV857;const healthy=health?rows.filter(song=>health.eligible(song)):rows;if(rows.length&&!healthy.length){const status=document.getElementById('quizStatus');if(status)status.textContent='目前篩選範圍沒有可播放的音源；無音源歌曲已暫時排除，來源資料更新後會自動重新納入。'}const scopeFilter=window.__aniApplyQuizCustomListScopeV8265;let scoped=healthy;if(typeof scopeFilter==='function'){try{const result=scopeFilter(healthy,!!activeFocusModeV72);scoped=Array.isArray(result)?result:[]}catch(error){console.error('Custom-list candidate scope failed closed',error);scoped=[]}}else if(!activeFocusModeV72){const ids=Array.isArray(quizSettings?.customListIds)?quizSettings.customListIds:[];let invalid=false;try{invalid=localStorage.getItem('aniQuizCustomListScopeInvalidV8265')==='1'}catch{}if(ids.length||quizSettings?.customListId||invalid){scoped=[];const status=document.getElementById('quizStatus');if(status)status.textContent='自訂清單範圍驗證尚未載入，已停止抽題以避免擴大候選範圍。請重新載入頁面。'}}return scoped};