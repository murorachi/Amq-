<script id="v82-30-storage-repository-v1">
(()=>{
 'use strict';
 const VERSION=1, PREFIX='aniUserDataV1:', MAX_ENTRY_BYTES=10*1024*1024, MAX_IMPORT_BYTES=30*1024*1024,
  LEGACY_KEYS=Object.freeze([
   'aniAmqProfileV1','aniAmqPPRecordsV1','aniAmqProfileRecoveryV1','aniAmqPPRecordsRecoveryV1',
   'aniAnimeAliases_v1','aniAnimeWatch_v1','aniBlacklistedSongs_v1','aniBlacklistedAnime_v1','aniManualWeakAnimeV1',
   'aniCustomPracticeListsV1','aniCustomPracticeListsRecoveryV825','aniManualWeakAnimeRecoveryV825','aniBlacklistedAnimeRecoveryV825',
   'aniCatalogModeV6','aniVNWatchlistV1','aniCollectionThemeV18','aniCollection_v2','aniDockMutedV57','aniDockVolumeV57',
   'aniFavorites_v1','aniLearningPlanProgressV1','aniPlayHistory_v1','aniPlayQueue_v1',
   'aniQuizHistorySummaryRecoveryOriginalV1','aniQuizHistorySummaryRecoveryV1','aniQuizHistorySummaryV1','aniQuizHistory_v1',
   'aniQuizPlanBackupSettingsV72','aniQuizSettingsV14','aniQuizCustomListScopeInvalidV8265','aniMultiplayerAmqListScopeInvalidV8265','aniMultiplayerEmqListScopeInvalidV8265','aniQuizTargetSummaryRecoveryOriginalV1','aniQuizTargetSummaryRecoveryV1',
   'aniQuizTargetSummaryV1','aniQuizVndbCharacterV36','aniQuizVolume','aniQuizRevealVideoV835','aniMultiplayerGameMediaV835','aniMultiplayerPersonalSettingsV82','aniSongTags_v1','aniSrsScheduleV1','anisongFieldGuide_v1'
  ]),
  LEGACY_KEY_PATTERNS=Object.freeze([
   /^aniQuizHistorySummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,
   /^aniQuizTargetSummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,
   /^aniSrsScheduleRecoveryV1_\d+$/,
   /^aniCustomPracticeListsRecoveryV825_\d+$/,
   /^aniManualWeakAnimeRecoveryV825_\d+$/,
   /^aniBlacklistedAnimeRecoveryV825_\d+$/
  ]),
  RAW_ENUM_VALUES=Object.freeze({aniCatalogModeV6:['grid','list'],aniCollectionThemeV18:['dark','light']});
 const adapterRegistry=new Map();
 const localAdapter={
  name:'localStorage',
  async getItem(k){return localStorage.getItem(String(k))},
  async setItem(k,v){localStorage.setItem(String(k),String(v))},
  async removeItem(k){localStorage.removeItem(String(k))},
  async keys(){const out=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k!==null)out.push(k)}return out}
 };
 adapterRegistry.set('localStorage',localAdapter);
 let defaultAdapterName='localStorage';
 const userKey=(userId,key)=>{
  const uid=String(userId||'').trim(),k=String(key||'').trim();
  if(!uid||uid.length>128||/[\u0000-\u001f]/.test(uid))throw new TypeError('A valid userId is required');
  if(!k||k.length>180||/[\u0000-\u001f]/.test(k))throw new TypeError('A valid storage key is required');
  return PREFIX+encodeURIComponent(uid)+':'+k;
 };
 const parseJson=(raw)=>{if(raw===null)return {exists:false,valid:true,value:null};try{return {exists:true,valid:true,value:JSON.parse(raw)}}catch{return {exists:true,valid:false,value:null}}};
 const isLegacyKey=key=>LEGACY_KEYS.includes(String(key))||LEGACY_KEY_PATTERNS.some(pattern=>pattern.test(String(key)));
 function validateLegacyRaw(key,raw){
  if(typeof raw!=='string')return {valid:false,format:'invalid',bytes:0};
  const bytes=new TextEncoder().encode(raw).length;
  if(bytes>MAX_ENTRY_BYTES)return {valid:false,format:'too-large',bytes};
  if(Object.prototype.hasOwnProperty.call(RAW_ENUM_VALUES,key))return {valid:RAW_ENUM_VALUES[key].includes(raw),format:'raw-enum',bytes};
  const parsed=parseJson(raw);return {valid:parsed.valid,format:'json',bytes};
 }
 function forUser(userId,adapterName=defaultAdapterName){
  const adapter=adapterRegistry.get(adapterName);if(!adapter)throw new Error('Unknown storage adapter: '+adapterName);
  const keyFor=k=>userKey(userId,k);
  return Object.freeze({
   userId:String(userId),adapterName,
   async get(key){const raw=await adapter.getItem(keyFor(key));if(raw===null||raw===undefined)return null;try{return JSON.parse(raw)}catch{throw new Error('Stored JSON is invalid for key: '+key)}},
   async set(key,value){const raw=JSON.stringify(value);if(raw===undefined)throw new TypeError('Value is not JSON serializable');await adapter.setItem(keyFor(key),raw);return true},
   async remove(key){await adapter.removeItem(keyFor(key));return true},
   async keys(){const prefix=PREFIX+encodeURIComponent(String(userId))+':';return (await adapter.keys()).filter(k=>k.startsWith(prefix)).map(k=>k.slice(prefix.length))},
   async snapshot(keys){const selected=Array.isArray(keys)?[...new Set(keys.map(String))]:await this.keys();const out={};for(const key of selected){const raw=await adapter.getItem(keyFor(key));if(raw!==null&&raw!==undefined)out[key]=raw}return {version:VERSION,userId:String(userId),values:out}},
   async transaction(changes){
    if(!changes||typeof changes!=='object'||Array.isArray(changes))throw new TypeError('changes must be an object');
    const entries=Object.entries(changes);if(!entries.length)return {ok:true,changed:0};
    const before=new Map();for(const [key] of entries)before.set(key,await adapter.getItem(keyFor(key)));
    const changed=[];
    try{for(const [key,value] of entries){changed.push(key);if(value===undefined){await adapter.removeItem(keyFor(key))}else{const raw=typeof value==='string'?value:JSON.stringify(value);if(raw===undefined)throw new TypeError('Value is not JSON serializable: '+key);await adapter.setItem(keyFor(key),raw)}}return {ok:true,changed:changed.length}}
    catch(error){const rollbackErrors=[];for(const key of changed.reverse()){try{const old=before.get(key);if(old===null||old===undefined)await adapter.removeItem(keyFor(key));else await adapter.setItem(keyFor(key),old)}catch(rollbackError){rollbackErrors.push(String(rollbackError))}}return {ok:false,changed:0,error:String(error?.message||error),rollbackComplete:rollbackErrors.length===0,rollbackErrors}}
   }
  });
 }
 async function previewLegacyImport(){
  const rows=[];let totalBytes=0;const allKeys=await localAdapter.keys();
  for(const key of allKeys){if(!isLegacyKey(key)||key==='aniCoverCacheV12')continue;const raw=localStorage.getItem(key);if(raw===null)continue;const valid=validateLegacyRaw(key,raw);totalBytes+=valid.bytes;rows.push({key,bytes:valid.bytes,validStoredValue:valid.valid,format:valid.format,sourceExists:true})}
  return {version:VERSION,source:'existing-localStorage',totalBytes,keys:rows,canImport:rows.every(x=>x.validStoredValue)&&totalBytes<=MAX_IMPORT_BYTES,note:'只遷移明確列入備份契約的使用者資料鍵；先預覽、先驗證，再複製到使用者命名空間。原始 key 不會刪除。'};
 }
 async function importLegacyData(userId,keys){
  const scope=forUser(userId),allKeys=await localAdapter.keys(),selected=[...new Set((keys===undefined?allKeys.filter(isLegacyKey):keys.map(String)))];
  if(selected.some(k=>!isLegacyKey(k)||k==='aniCoverCacheV12'))throw new Error('Legacy import key is not allowlisted');
  const existing=await scope.keys();if(existing.length)throw new Error('Target user scope is not empty; import was refused');
  const values={},invalid=[];let totalBytes=0;
  for(const key of selected){const raw=localStorage.getItem(key);if(raw===null)continue;const checked=validateLegacyRaw(key,raw);totalBytes+=checked.bytes;if(!checked.valid)invalid.push(key);else values[key]=checked.format==='raw-enum'?JSON.stringify(raw):raw}
  if(invalid.length)throw new Error('Invalid legacy storage value; import refused before writing: '+invalid.join(', '));
  if(totalBytes>MAX_IMPORT_BYTES)throw new Error('Legacy import exceeds '+MAX_IMPORT_BYTES+' bytes; split the migration into reviewed subsets');
  const result=await scope.transaction(values);if(!result.ok)throw new Error('Legacy import failed and rollback was '+(result.rollbackComplete?'complete':'incomplete')+': '+result.error);
  return {ok:true,userId:String(userId),imported:Object.keys(values),preservedLegacyKeys:Object.keys(values),count:Object.keys(values).length,bytes:totalBytes};
 }
 window.__aniStorageRepositoryV1=Object.freeze({version:VERSION,namespacePrefix:PREFIX,legacyImportAllowlist:LEGACY_KEYS,legacyImportPatterns:LEGACY_KEY_PATTERNS.map(x=>x.source),adapterNames:()=>[...adapterRegistry.keys()],registerAdapter(name,adapter){const n=String(name||'').trim();if(!/^[a-z][a-z0-9_-]{1,40}$/i.test(n)||n==='localStorage')throw new TypeError('Invalid or reserved adapter name');for(const method of ['getItem','setItem','removeItem','keys'])if(typeof adapter?.[method]!=='function')throw new TypeError('Adapter missing method: '+method);adapterRegistry.set(n,adapter);return true},setDefaultAdapter(name){if(!adapterRegistry.has(name))throw new Error('Unknown storage adapter: '+name);defaultAdapterName=name;return true},getDefaultAdapter:()=>defaultAdapterName,forUser,previewLegacyImport,importLegacyData});
})();
</script>
