function calculateQuizPoolCandidatesV8280(ctx){
 const {songs,anime,byAnime,quizSettings,chosenPool,activeFocusMode,activeFocusSongIds,songTags,animeWatch,roundSeen,lastQuestionId,st,watchStatus,policy,isBlacklisted}=ctx;
 const type=quizSettings.watchlistOnly?'all':chosenPool;
 let pool=songs.filter(s=>String(s[4]||'').trim()&&policy.blacklistAllowed(!!isBlacklisted(s[1])));
 if(activeFocusMode){
  if(!activeFocusSongIds.length)return {pool:[],diagnostic:'這組學習歌曲已全部完成一輪。可回到「練習工作台」查看下一步，或離開學習模式後再開始一般猜歌。'};
  const focusSet=new Set(activeFocusSongIds.map(String));
  pool=pool.filter(s=>focusSet.has(String(s[1])));
  if(quizSettings.noRepeat)pool=pool.filter(s=>policy.repeatAllowed(s[1],true,roundSeen,lastQuestionId));
  return {pool,diagnostic:''};
 }
 pool=pool.filter(s=>policy.quickPoolAllowed(st(s[1]),songTags[String(s[1])]||'',s[6],type,'amq'));
 pool=pool.filter(s=>policy.statusAllowed(st(s[1]),quizSettings.statuses));
 pool=pool.filter(s=>{
  const a=byAnime.get(s[0]);if(!a)return false;
  if(!policy.watchStatusAllowed(watchStatus(a[0]),!!quizSettings.watchStatusFilterEnabled,quizSettings.watchStatuses))return false;
  if(!policy.metadataAllowed({source:'amq',year:a[5],season:a[3],animeType:a[4],songType:s[2],difficulty:s[6]},quizSettings))return false;
  if(!policy.tagAllowed(songTags[String(s[1])]||'',!!quizSettings.tagsOnly,quizSettings.tagText))return false;
  if(quizSettings.watchlistOnly){
   const keys=[String(a[0]),String(a[6]||'')].filter(Boolean);
   const inList=keys.some(k=>{const w=animeWatch?.[k];if(!w)return false;const v=typeof w==='string'?w:(w.status||'none');return v!=='none'&&v!==''});
   if(!policy.watchlistAllowed(inList,true))return false;
  }
  if(!policy.repeatAllowed(s[1],!!quizSettings.noRepeat,roundSeen,lastQuestionId))return false;
  return true;
 });
 let diagnostic='';
 if(!pool.length){
  const inListCount=anime.filter(a=>watchStatus(a[0])!=='none'||(animeWatch?.[String(a[6]||'')]&&((animeWatch[String(a[6]||'')].status)||animeWatch[String(a[6]||'')])!=='none')).length;
  diagnostic=quizSettings.watchlistOnly&&!inListCount?'你的「我的清單」目前沒有可辨識的看番狀態。請到「我的清單」確認作品是否已加入，或重新匯入 AniList／MAL 清單。':'目前條件沒有符合的歌曲。系統不會自動放寬範圍；請檢查年代、作品類型、歌曲類型、熟悉度、標籤、清單與黑名單。';
 }
 if(quizSettings.noRepeat&&lastQuestionId!==null&&pool.length>1)pool=pool.filter(s=>String(s[1])!==String(lastQuestionId));
 return {pool,diagnostic};
}
function getQuizPool(){
 const chosenPool=document.getElementById('quizPool').value;
 const result=calculateQuizPoolCandidatesV8280({
  songs,anime,byAnime,quizSettings,chosenPool,activeFocusMode:activeFocusModeV72,
  activeFocusSongIds:activeFocusSongIdsV72,songTags,animeWatch,roundSeen:quizRoundSeen,
  lastQuestionId,st,watchStatus,policy:window.__aniCandidatePoolPolicyV8265,
  isBlacklisted:id=>window.__aniHistoryAPIv51?.isBlacklisted(id)
 });
 if(result.diagnostic)document.getElementById('quizStatus').textContent=result.diagnostic;
 return result.pool;
}