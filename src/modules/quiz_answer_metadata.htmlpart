function uniqueQuizNamesV8239(values){const seen=new Set(),out=[];for(const value of values){const v=String(value??'').trim();const key=v.normalize('NFKC').toLocaleLowerCase();if(v&&key&&!seen.has(key)){seen.add(key);out.push(v)}}return out}
function getQuizAnimeNameBundleV8239(animeId){const row=byAnime.get(Number(animeId))||byAnime.get(String(animeId));const zh=String(window.__aniChineseTitleAPIv8237?.getTitle(animeId)||'').trim();const aliases=window.__aniChineseTitleAPIv8237?.getAliases(animeId)||[];return {row,english:String(row?.[1]||'').trim(),romaji:String(row?.[2]||'').trim(),chinese:zh,aliases:uniqueQuizNamesV8239([row?.[1],row?.[2],zh,...aliases])}}
function quizSongRoleLabelV8239(song){const typeNames={1:'OP',2:'ED',3:'插入歌',4:'OST',5:'其他'};const role=typeNames[Number(song?.[2])]||'未標示';const number=Number(song?.[3]);return (role==='OP'||role==='ED')&&Number.isFinite(number)&&number>0?`${role} ${number}`:role}