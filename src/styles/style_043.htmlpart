<style id="v82-46-home-menu-and-watchlist-dark-style">
/* V82.46: osu!-inspired icon-first home navigation, with only four primary destinations. */
body.ui-home-menu #homeMenu{gap:clamp(16px,2.5vh,28px)!important}
body.ui-home-menu #homeMenu .amqHomeStage{position:relative;z-index:2;display:flex!important;align-items:center;justify-content:center;gap:clamp(24px,4.5vw,58px);width:min(100%,1000px);min-height:clamp(320px,47vh,500px);margin:auto;padding:clamp(16px,3vh,34px) 0;flex:1 0 auto;transition:gap .18s ease}
body.ui-home-menu #homeMenu .amqMainIcon{position:relative;z-index:2;display:grid!important;place-items:center;flex:0 0 auto;width:clamp(240px,29vw,340px)!important;max-width:100%;aspect-ratio:1;padding:0!important;margin:0;border:0!important;border-radius:50%!important;background:transparent!important;box-shadow:none!important;cursor:pointer;filter:drop-shadow(0 16px 30px color-mix(in srgb,var(--primary) 22%,transparent));transition:transform .2s ease,filter .2s ease;touch-action:manipulation}
body.ui-home-menu #homeMenu .amqMainIcon svg{display:block;width:100%;height:100%;overflow:visible}
body.ui-home-menu #homeMenu .amqMainIcon:hover{transform:translateY(-3px) scale(1.02);filter:drop-shadow(0 20px 35px color-mix(in srgb,var(--primary) 28%,transparent))}
body.ui-home-menu #homeMenu .amqMainIcon:focus-visible{outline:3px solid var(--focus-ring);outline-offset:6px}
body.ui-home-menu #homeMenu .amqHomeStage:not(.is-open) .amqMainIcon{transform:translateX(-34px)}
body.ui-home-menu #homeMenu .amqHomeOverlay[hidden],body.ui-home-menu #homeMenu #amqLearningCenterSubmenu[hidden],body.ui-home-menu #homeMenu #amqHomePrimaryNav[hidden]{display:none!important}
body.ui-home-menu #homeMenu .amqHomeOverlay:not([hidden]){position:relative!important;inset:auto!important;z-index:3;display:block!important;flex:0 1 390px!important;width:min(100%,390px)!important;min-width:0;max-width:100%;padding:0!important;margin:0!important;background:transparent!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;border:0!important;border-radius:0!important;box-shadow:none!important;animation:amqMenuInV846 .2s ease-out}
body.ui-home-menu #homeMenu .amqHomeDialog{width:100%!important;max-height:none!important;overflow:visible!important;padding:0!important;margin:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;color:var(--text-primary)!important}
body.ui-home-menu #homeMenu .home-menu-list.amqHomePrimaryGrid{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:10px!important;width:100%!important;max-width:390px!important;margin:0!important;padding:0!important}
body.ui-home-menu #homeMenu .home-menu-card{display:flex!important;position:relative!important;align-items:center!important;justify-content:flex-start!important;box-sizing:border-box!important;min-width:0!important;width:100%!important;min-height:58px!important;height:auto!important;padding:15px 22px!important;border:1px solid color-mix(in srgb,var(--primary) 20%,var(--border))!important;border-radius:6px 18px 18px 6px!important;background:linear-gradient(105deg,color-mix(in srgb,var(--primary) 13%,var(--surface)),var(--surface) 70%)!important;color:var(--text-primary)!important;box-shadow:var(--shadow-card)!important;text-align:left!important;white-space:normal!important;transition:transform .15s ease,border-color .15s ease,background-color .15s ease!important}
body.ui-home-menu #homeMenu .home-menu-card:before,body.ui-home-menu #homeMenu .home-menu-card:after,body.ui-home-menu #homeMenu .home-menu-card>i{display:none!important;content:none!important}
body.ui-home-menu #homeMenu .home-menu-card .home-card-copy{display:flex!important;align-items:flex-start!important;justify-content:center!important;gap:0!important;width:100%!important;min-width:0!important;padding:0!important}
body.ui-home-menu #homeMenu .home-menu-card .home-card-copy b{display:block!important;font-size:clamp(15px,1.35vw,18px)!important;font-weight:750!important;line-height:1.35!important;letter-spacing:.015em;color:inherit!important}
body.ui-home-menu #homeMenu .home-menu-card .home-card-copy small{display:none!important}
body.ui-home-menu #homeMenu .home-menu-card:hover{transform:translateX(3px)!important;border-color:color-mix(in srgb,var(--primary) 58%,var(--border))!important;background:linear-gradient(105deg,color-mix(in srgb,var(--primary) 21%,var(--surface)),var(--surface) 78%)!important;box-shadow:var(--shadow-card)!important}
body.ui-home-menu #homeMenu .home-menu-card:focus-visible{outline:3px solid var(--focus-ring)!important;outline-offset:3px!important}
body.ui-home-menu #homeMenu .amqHomeSubmenuHead{display:flex;align-items:center;gap:14px;margin:0 0 12px;padding:0 0 10px;border-bottom:1px solid var(--border);color:var(--text-primary)}
body.ui-home-menu #homeMenu .amqHomeSubmenuHead strong{font-size:18px;font-weight:800}
body.ui-home-menu #homeMenu .amqSubmenuBack{flex:0 0 auto;padding:7px 10px;border:1px solid var(--border);border-radius:8px;background:var(--surface-muted);color:var(--text-secondary);font-size:12px;font-weight:700}
body.ui-home-menu #homeMenu .amqSubmenuBack:hover{background:var(--primary-soft);color:var(--text-primary)}
@keyframes amqMenuInV846{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:translateX(0)}}
@media(max-width:760px){body.ui-home-menu #homeMenu .amqHomeStage{min-height:clamp(300px,45vh,440px);gap:0;padding:12px 0 24px;flex-direction:column}body.ui-home-menu #homeMenu .amqHomeStage:not(.is-open) .amqMainIcon{transform:translateX(-12px)}body.ui-home-menu #homeMenu .amqHomeStage.is-open{gap:16px}body.ui-home-menu #homeMenu .amqMainIcon{width:clamp(176px,47vw,228px)!important}body.ui-home-menu #homeMenu .amqHomeOverlay:not([hidden]){flex:0 1 auto!important;width:min(100%,420px)!important}body.ui-home-menu #homeMenu .home-menu-list.amqHomePrimaryGrid{gap:8px!important;width:100%!important;max-width:none!important}body.ui-home-menu #homeMenu .home-menu-card{min-height:50px!important;padding:12px 17px!important;border-radius:5px 13px 13px 5px!important}body.ui-home-menu #homeMenu .home-menu-card .home-card-copy b{font-size:15px!important}body.ui-home-menu #homeMenu .amqHomeSubmenuHead{margin-bottom:8px}}
@media(prefers-reduced-motion:reduce){body.ui-home-menu #homeMenu .amqHomeStage,body.ui-home-menu #homeMenu .amqMainIcon,body.ui-home-menu #homeMenu .home-menu-card,body.ui-home-menu #homeMenu .amqHomeOverlay{transition:none!important;animation:none!important}}
/* Keep watch-state controls within the dark palette; the previous select background stayed nearly white. */
body.dark-theme #watchGrid .watchCard select,body.dark-theme #watchlistView .watchToolbar select,body.dark-theme #watchlistView .watchToolbar input{background:#242a31!important;color:#e2e7ed!important;border-color:#38414a!important;color-scheme:dark}
body.dark-theme #watchGrid .watchCard select option{background:#242a31!important;color:#e2e7ed!important}
body.dark-theme #watchGrid .watchCard select:focus-visible{outline:2px solid #66506d!important;outline-offset:2px}
body.dark-theme #watchlistView .watchTabs .watchTab.active{background:#302533!important;color:#e7c1d4!important;border-color:#60465a!important;box-shadow:none!important}
body.dark-theme .watchpill.completed{background:#24392e!important;color:#a8d6ba!important;border-color:#3a5948!important}
body.dark-theme .watchpill.current{background:#243447!important;color:#afcfee!important;border-color:#38526b!important}
body.dark-theme .watchpill.dropped{background:#432a30!important;color:#e6b1bc!important;border-color:#64404a!important}
@media(hover:none){body.ui-home-menu #homeMenu .home-menu-card:hover{transform:none!important;background:linear-gradient(105deg,color-mix(in srgb,var(--primary) 13%,var(--surface)),var(--surface) 70%)!important;border-color:color-mix(in srgb,var(--primary) 20%,var(--border))!important}}
</style>