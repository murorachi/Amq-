<style id="quizSuggestionsV31Style">#quizView .quizSuggestions{max-height:min(280px,40vh);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;z-index:100!important}#quizView .quizSuggestion{cursor:pointer;min-height:42px;line-height:1.4}#quizView .quizSuggestion.focus, #quizView .quizSuggestion:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;background:color-mix(in srgb,var(--accent) 15%,var(--panel))!important}#quizView .quizSuggestions:not(.open){display:none!important}</style>