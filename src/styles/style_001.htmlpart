<style>
:root{--paper:#fff9fc;--ink:#34283c;--muted:#8b7b91;--line:#ead9e8;--pink:#ff7eb6;--pink2:#ffd2e5;--purple:#a28ae8;--lilac:#eee6ff;--blue:#cce9ff;--mint:#c8f2df;--yellow:#ffe7a8;--red:#ef6c9b;--shadow:0 14px 35px #744d7412}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--paper);font-family:"Trebuchet MS","Noto Sans TC","Noto Sans JP",system-ui,sans-serif;background-image:radial-gradient(#e7b6d9 0.75px,transparent .75px);background-size:17px 17px}button, input, select{font:inherit}button{cursor:pointer}.wrap{max-width:1420px;margin:auto;padding:18px clamp(12px,3vw,38px) 100px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}.brand{display:flex;align-items:center;gap:11px}.logo{width:49px;height:49px;display:grid;place-items:center;background:linear-gradient(145deg,#ffacd0,#d6c6ff);border:2px solid #fff;border-radius:16px;box-shadow:0 4px 0 #d8b7d8;transform:rotate(-5deg);font-size:27px}.brand small{font-size:10px;letter-spacing:.18em;color:#b16b9c;font-weight:900}.brand h1{font-size:clamp(15px,2vw,22px);margin:2px 0 0;letter-spacing:.01em}.actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.btn{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:12px;padding:9px 12px;font-size:12px;font-weight:800;box-shadow:0 3px 0 #ebd9e9}.btn:hover{transform:translateY(-1px);box-shadow:0 4px 0 #e4cce2}.btn.primary{background:var(--pink);border-color:#f36ea8;color:#fff}.hero{display:grid;grid-template-columns:1.4fr .8fr;gap:16px;margin-bottom:16px}


.tag{display:inline-block;background:white;border:1px solid #f3c5df;color:#b35e94;padding:6px 10px;border-radius:99px;font-size:10px;font-weight:900;letter-spacing:.09em}


.heroSide{background:#fff;border:2px solid white;border-radius:25px;padding:20px;box-shadow:0 7px 0 #e7d7ef,var(--shadow);display:flex;flex-direction:column;justify-content:space-between;gap:15px}.sectionLabel{font-size:10px;letter-spacing:.12em;font-weight:900;color:#aa79a6}.bigNum{font-size:36px;line-height:1.1;font-weight:1000;color:#4d3658;margin:7px 0}.bigNum small{font-size:12px;color:var(--muted);font-weight:700}.bar{height:10px;background:#f5e8f3;border-radius:99px;overflow:hidden;border:1px solid #f0dceb}.bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,#ff91bf,#b4a2ff,#9ee6d1);border-radius:99px;transition:width .3s}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{border-radius:15px;padding:11px 8px;background:#fff5fb;border:1px solid #f4e0ed}.stat:nth-child(2){background:#f7f3ff}.stat:nth-child(3){background:#f0fbf8}.stat b{display:block;font-size:22px}.stat span{font-size:10px;color:var(--muted)}




.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;padding:12px;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);margin-bottom:12px}.search{flex:1;min-width:190px}.search input{width:100%;border:1px solid #ead7e8;border-radius:12px;padding:12px;background:#fffaff;color:var(--ink);outline:none}.search input:focus{border-color:#e88bb9;box-shadow:0 0 0 3px #ffddec}.toolbar select{max-width:100%;border:1px solid #ead7e8;border-radius:12px;padding:11px;background:#fffaff;color:var(--ink)}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 18px}.tab{border:1px solid #ead9e8;background:#fff;color:#927d97;border-radius:12px;padding:9px 13px;font-size:12px;font-weight:800}.tab.active{background:#ffdaeb;border-color:#f4a5cb;color:#8e416e;box-shadow:0 3px 0 #edc3dd}.head{display:flex;align-items:end;justify-content:space-between;gap:10px;margin:20px 2px 13px}.head h3{font-size:21px;margin:0 0 3px}.head p{font-size:11px;color:var(--muted);margin:0}.result{font-size:11px;color:#a18ca7}.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px}.card{position:relative;text-align:left;min-width:0;border:2px solid #fff;background:#fff;border-radius:18px;padding:0;overflow:hidden;color:var(--ink);box-shadow:0 4px 0 #e8d8e9,0 10px 20px #865b7810;transition:transform .15s,box-shadow .15s}.card:hover{transform:translateY(-3px) rotate(-.4deg);box-shadow:0 7px 0 #e1c9e2,0 16px 25px #865b7819}.cover{height:125px;position:relative;overflow:hidden;display:flex;align-items:end;padding:11px;background:linear-gradient(145deg,var(--c1),var(--c2))}.cover:before{content:'';position:absolute;width:155px;height:155px;right:-36px;top:-55px;border-radius:45% 55% 52% 48%;border:2px solid #ffffff90;transform:rotate(25deg)}.cover:after{content:'';position:absolute;width:88px;height:88px;right:20px;top:17px;border:1.5px dashed #ffffffad;border-radius:50%}.cover .symbol{position:absolute;right:27px;top:24px;color:#fff;font-size:42px;text-shadow:0 2px 0 #9b77b433}.cover .year{z-index:1;position:relative;background:#fffdf0e8;border:1px solid #fff;border-radius:8px;padding:4px 7px;font-size:10px;font-weight:900}.sticker{position:absolute;right:8px;bottom:8px;z-index:2;background:#fff;border-radius:99px;width:28px;height:28px;display:grid;place-items:center;font-size:14px;box-shadow:0 2px 0 #d7c3d9}.cardbody{padding:11px 12px 12px}.cardtitle{font-size:13px;font-weight:900;line-height:1.45;min-height:37px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.sub{font-size:10px;color:var(--muted);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cardfoot{display:flex;justify-content:space-between;align-items:center;gap:5px;margin-top:11px}.pill{display:inline-block;font-size:10px;border-radius:8px;padding:5px 7px;background:#fff3f9;border:1px solid #f6dce9;color:#956180;font-weight:800}.tinybar{height:5px;background:#f4e9f3;border-radius:9px;overflow:hidden;margin-top:9px}.tinybar span{height:100%;display:block;background:linear-gradient(90deg,#ff8cb9,#bba3ff,#91dfc7)}.empty{padding:40px 18px;text-align:center;border:2px dashed #e5cce2;border-radius:20px;background:#fff;color:var(--muted)}.overlay{position:fixed;inset:0;background:#33233bd9;backdrop-filter:blur(8px);z-index:10;display:none;align-items:flex-end;justify-content:center;padding:16px}.overlay.open{display:flex}.drawer{width:min(950px,100%);max-height:94vh;overflow:auto;background:#fff9fd;border:2px solid #fff;border-radius:25px;box-shadow:0 25px 100px #291a3790}.drawerhead{position:relative;padding:23px 24px 20px;background:linear-gradient(120deg,#ffe0ef,#eee5ff 65%,#dff5ff);border-bottom:1px solid #eed8e9}.close{position:absolute;right:14px;top:14px;background:#fff;border:1px solid #ebd8e9;border-radius:10px;padding:8px 11px;color:var(--ink);font-weight:900}.detailEyebrow{font-size:10px;font-weight:900;letter-spacing:.14em;color:#b1669a}.drawerhead h2{font-size:clamp(22px,4vw,32px);margin:8px 45px 5px 0}.drawerhead p{font-size:12px;color:#866e8c;margin:0}.drawerstats{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.playerbar{display:flex;align-items:center;gap:12px;padding:13px 18px;background:#fff;border-bottom:1px solid #f1e2ef}.playerDisc{width:40px;height:40px;border-radius:50%;flex-shrink:0;background:conic-gradient(#ff8fba,#c3a8ff,#a0e8d4,#ff8fba);display:grid;place-items:center;border:3px solid #fff;box-shadow:0 0 0 1px #e9d4e9;font-size:18px}.playerInfo{min-width:0;flex:1}.playerInfo b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.playerInfo span{display:block;font-size:10px;color:var(--muted);margin-top:3px}.playerButtons{display:flex;gap:6px;flex-wrap:wrap}.songlist{padding:6px 18px 24px}.songrow{display:grid;grid-template-columns:35px minmax(0,1fr) auto;gap:10px;align-items:center;padding:13px 2px;border-bottom:1px solid #f1e5f0}.songnum{color:#ba91b6;font-size:11px;font-weight:900}.songname{font-size:13px;font-weight:900;line-height:1.45}.songmeta{font-size:10px;color:var(--muted);margin-top:4px}.songactions{display:flex;gap:5px;flex-wrap:wrap;justify-content:end}.statusbtn{font-size:10px;padding:7px 8px;border-radius:9px;border:1px solid #e9d9e8;background:#fff;color:#9b8199;font-weight:800}.statusbtn.on[data-s="1"]{background:#ffe0ed;border-color:#f2a5c9;color:#a7477d}.statusbtn.on[data-s="2"]{background:#fff0c9;border-color:#efcf76;color:#87651a}.statusbtn.on[data-s="3"]{background:#dff8ed;border-color:#9adcc2;color:#267c61}.listenBtn{background:#f0e9ff;border-color:#d5c4f4;color:#7657b1}.listenBtn:hover{background:#e4d8ff}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);padding:11px 16px;border-radius:12px;background:#4e3657;color:#fff;font-size:12px;font-weight:800;display:none;z-index:20;box-shadow:0 6px 20px #24142c55;max-width:90vw;text-align:center}.toast.show{display:block}.footnote{text-align:center;font-size:10px;color:#a28ca4;line-height:1.7;margin-top:32px}.hidden{display:none!important}.discover{background:linear-gradient(110deg,#fff,#fff4fa);border:2px solid white;border-radius:22px;padding:17px;box-shadow:0 5px 0 #ead8eb;margin-bottom:18px}.discoverTop{display:flex;align-items:center;justify-content:space-between;gap:10px}.discoverTop h3{font-size:17px;margin:0}.discoverTop p{font-size:11px;color:var(--muted);margin:4px 0 0}.discoverCard{display:grid;grid-template-columns:100px 1fr auto;gap:14px;align-items:center;margin-top:14px;padding:13px;border:1px dashed #e9c9e2;border-radius:16px;background:#fff}.discArt{height:100px;border-radius:13px;background:linear-gradient(140deg,#ffd8e9,#dcd3ff,#c9f4e5);display:grid;place-items:center;font-size:42px}.discName{font-size:15px;font-weight:1000}.discMeta{font-size:11px;color:var(--muted);margin-top:5px;line-height:1.6}.discBtns{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}

@media(max-width:1000px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}.hero{grid-template-columns:1fr}.heroSide{gap:14px}.heroMain{min-height:210px}}@media(max-width:700px){.wrap{padding:12px 10px 90px}.top{align-items:flex-start}.brand small{font-size:8px}.logo{width:42px;height:42px}.actions .btn{padding:8px;font-size:10px}.heroMain{padding:22px;min-height:230px}.heroMain h2{font-size:33px}.heroSide{padding:16px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cover{height:90px}.cardbody{padding:9px}.cardtitle{font-size:12px;min-height:35px}.toolbar{padding:9px}.search{min-width:100%}.overlay{padding:0}.drawer{max-height:96vh;border-radius:23px 23px 0 0}.drawerhead{padding:22px 16px}.songrow{grid-template-columns:22px minmax(0,1fr)}.songactions{grid-column:2;justify-content:start}.songlist{padding:5px 13px 25px}.playerbar{align-items:flex-start;flex-wrap:wrap}.playerButtons{width:100%;padding-left:52px}.discoverCard{grid-template-columns:70px 1fr}.discArt{height:75px}.discoverCard>.btn{grid-column:2;justify-self:start}.daily{align-items:flex-start}.stats .stat b{font-size:18px}}

/* Collection room v6 additions */
.songlist{padding-bottom:155px}.drawer{padding-bottom:100px}
body{padding-bottom:105px}
.quicktools{margin:18px 0;padding:16px 18px;border:1px solid #ead8eb;border-radius:18px;background:linear-gradient(120deg,#fff,#fff5fb);box-shadow:0 8px 20px #865b780a}
.quicktoolsHead{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px}.quicktoolsHead b{font-size:14px}.quicktoolsHead span, .toolhint{font-size:11px;color:var(--muted)}
.toolrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.toolrow select, .toolrow input{max-width:100%;border:1px solid #e8d7e8;background:#fff;border-radius:10px;padding:9px 10px;color:var(--ink);font:inherit;font-size:12px}.toolrow .btn{white-space:nowrap}
.cardSelect{position:absolute;left:9px;top:9px;z-index:5;background:#fffdf6eF;border:1px solid #e4cfe5;border-radius:9px;padding:4px 6px;font-size:11px;display:none;box-shadow:0 2px 6px #35223b22}.selectionMode .cardSelect{display:block}.cardSelect input{accent-color:#d75f9f;vertical-align:middle}.card .cover .realcover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;opacity:.9}.card .cover:after{z-index:1;background:linear-gradient(0deg,#2b1e36a8,transparent 80%);border:0;border-radius:0;inset:0;width:auto;height:auto;top:auto;right:auto}.card .cover .symbol, .card .cover .year, .card .cover .sticker{z-index:2;color:#fff;text-shadow:0 1px 4px #33213eaa}.card .cover .year{background:#3a2b4680;border-radius:7px;padding:4px 6px}.card.selected{outline:3px solid #e879b0;outline-offset:1px}
.watchpill{display:inline-block;border-radius:999px;background:#f6e9ff;color:#9161aa;padding:3px 7px;font-size:9px;font-weight:900;margin-top:5px}.watchpill.completed{background:#ddf7e9;color:#32865d}.watchpill.current{background:#dff0ff;color:#387aa8}.watchpill.dropped{background:#ffe6e9;color:#ae5a70}
.songactions .queueBtn{background:#f2eaff;color:#8063b0;border-color:#e3d6ff}.songtags{font-size:10px;color:#a66b9b;margin-top:4px}.songactions .statusbtn{cursor:pointer}
.audioDock{position:fixed;z-index:90;left:12px;right:12px;bottom:12px;max-width:1050px;margin:auto;background:#fffdfdf2;border:1px solid #e7d5e7;box-shadow:0 12px 38px #49314e30;backdrop-filter:blur(12px);border-radius:18px;padding:10px 13px;display:grid;grid-template-columns:minmax(150px,1fr) minmax(180px,1.1fr) auto;align-items:center;gap:12px}.audioDock .dockMeta{min-width:0}.audioDock .dockMeta b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.audioDock .dockMeta span{display:block;font-size:10px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}.audioDock audio{width:100%;height:34px}.audioDock video{grid-column:1/-1}.dockBtns{display:flex;gap:5px;align-items:center}.dockBtns .btn{padding:8px 10px;min-width:34px}.dockStatus{font-size:9px;color:#9b789a;margin-top:3px}
.modalShade{position:fixed;inset:0;background:#30203980;z-index:120;display:none;align-items:center;justify-content:center;padding:16px}.modalShade.open{display:flex}.modalCard{width:min(680px,100%);max-height:90vh;overflow:auto;background:#fffafd;border-radius:22px;border:1px solid #ecd7eb;padding:22px;box-shadow:0 25px 70px #24132e50}.modalCard h3{margin:0 0 8px;font-size:20px}.modalCard p{font-size:12px;line-height:1.7;color:var(--muted)}.modalCard label{display:block;font-size:12px;font-weight:800;margin:12px 0 5px}.modalCard input[type=text], .modalCard input[type=password]{width:100%;padding:11px;border:1px solid #e5d4e5;border-radius:10px;font:inherit}.modalActions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:16px}
.modalStatus{font-size:12px;color:#8d5d89;margin-top:10px;white-space:pre-wrap}

.loadMoreWrap{text-align:center;padding:22px}.gridCounter{font-size:11px;color:var(--muted)}
@media(max-width:760px){.audioDock{grid-template-columns:1fr auto;gap:7px;padding:8px 10px;bottom:7px;left:7px;right:7px}.audioDock audio{grid-column:1/-1;grid-row:2}.dockBtns{grid-column:2;grid-row:1}.audioDock .dockMeta{grid-column:1;grid-row:1}.dockBtns .btn{padding:7px}.quicktools{padding:12px}.toolrow select{flex:1;min-width:125px}}
@media(max-width:420px){.audioDock .dockMeta b{font-size:11px}.dockBtns .btn{font-size:10px;padding:7px 8px}.audioDock{border-radius:14px}}


/* v4 layout */
body{background:#fbf7fc;background-image:radial-gradient(#e7b6d9 .55px,transparent .55px);background-size:19px 19px}



.wrap{margin:0 auto;max-width:1420px;padding:20px clamp(15px,2.5vw,36px) 120px}.top{position:sticky;top:0;z-index:8;background:#fbf7fceF;backdrop-filter:blur(12px);padding:10px 0;margin-bottom:15px}.discoverTop p, .quicktoolsHead span, .footnote{display:none!important}.hero{margin-top:8px}.watchlistView{min-height:65vh}.watchlistHead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:18px 0}.watchlistHead h2{font-size:24px;margin:0}.watchSummary{font-size:12px;color:var(--muted)}.watchToolbar{display:flex;gap:10px;margin-bottom:14px}.watchToolbar input{flex:1;min-width:0;border:1px solid #ead7e8;border-radius:12px;padding:12px;background:#fffaff;color:var(--ink)}.watchToolbar select{border:1px solid #ead7e8;border-radius:12px;padding:10px;background:#fffaff;color:var(--ink)}.watchTabs{display:flex;gap:7px;overflow-x:auto;padding:3px 1px 12px;margin-bottom:8px}.watchTab{flex-shrink:0;border:1px solid #ead9e8;background:#fff;color:#927d97;border-radius:12px;padding:9px 12px;font-size:12px;font-weight:800}.watchTab.active{background:#ffdaeb;border-color:#f4a5cb;color:#8e416e}.watchGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.watchCard{background:#fff;border:1px solid #efdfed;border-radius:16px;padding:12px;min-width:0;box-shadow:0 4px 0 #e8d8e9}.watchCardTop{display:flex;gap:10px;align-items:flex-start}.watchCover{width:56px;height:76px;flex:0 0 56px;border-radius:9px;background:linear-gradient(145deg,#ffdcec,#e5dcff);display:grid;place-items:center;overflow:hidden;position:relative;font-size:20px}.watchCover .realcover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}.watchCover>span{position:relative;z-index:0}.watchCardName{font-size:12px;font-weight:900;line-height:1.45;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.watchCardMeta{font-size:10px;color:var(--muted);margin-top:5px}.watchCard select{width:100%;margin-top:11px;padding:8px;border-radius:10px;border:1px solid #ead9e8;background:#fffaff;color:var(--ink);font-size:11px}.watchCardActions{display:flex;gap:6px;margin-top:7px}.watchCardActions button{flex:1;padding:7px 5px;font-size:10px}.hidden{display:none!important}
@media(max-width:1050px){.watchGrid{grid-template-columns:repeat(3,minmax(0,1fr))}.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:760px){.wrap{margin:0;padding:10px 12px 100px}.top{position:relative;flex-wrap:wrap;align-items:flex-start}.brand small{display:none}.actions .btn{padding:7px 8px;font-size:10px}.hero{grid-template-columns:1fr}.heroMain{min-height:150px;padding:23px}.heroMain h2{font-size:30px;margin-top:5px}.heroSide{padding:15px}.daily{margin-top:12px}.discoverCard{grid-template-columns:45px 1fr}.discoverCard .btn{grid-column:1/-1;width:100%}.toolbar{padding:9px}.toolbar .search{min-width:100%}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.cover{height:100px}.cardbody{padding:9px}.quicktools .toolrow{gap:6px}.quicktools .btn,.quicktools select{font-size:10px;padding:8px}.watchGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.watchCard{padding:9px}.watchCover{width:46px;height:65px;flex-basis:46px}.watchlistHead h2{font-size:21px}.watchToolbar select{max-width:120px}.watchTabs{margin-right:-12px}.audioDock{left:8px;right:8px;bottom:76px;grid-template-columns:1fr auto;gap:6px;padding:9px}.audioDock audio,.audioDock video{grid-column:1/-1;max-width:100%;width:100%}.dockMeta{min-width:0}.dockMeta b{font-size:11px}.dockMeta span,.dockStatus{font-size:9px}.dockBtns{gap:3px}.dockBtns .btn{padding:7px}.overlay{padding:8px}.drawer{max-height:94vh}.songactions{flex-wrap:wrap}}
@media(min-width:761px) and (max-width:1250px){.watchGrid{grid-template-columns:repeat(3,minmax(0,1fr))}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}


/* V13 in-page quiz and relationship explorer */
.quizView{background:#fff;border:2px solid #fff;border-radius:24px;padding:clamp(16px,3vw,30px);box-shadow:var(--shadow);margin:14px 0 100px}
.quizTop{display:flex;justify-content:space-between;align-items:start;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.quizTop h2{margin:5px 0;font-size:clamp(23px,4vw,34px)}
.quizGrid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr);gap:16px}
.quizStage{border:1px solid #efddea;border-radius:20px;background:linear-gradient(140deg,#fff5fb,#f5f1ff);padding:20px;min-width:0}
.quizMystery{min-height:150px;display:grid;place-items:center;text-align:center;border-radius:17px;background:linear-gradient(145deg,#f9ddeb,#e5ddff,#d9f1f4);border:2px solid #fff;margin-bottom:16px}
.quizMystery .note{font-size:58px;line-height:1}.quizMystery b{display:block;margin-top:10px;font-size:16px}.quizMystery small{display:block;margin-top:5px;color:#826e8b}
.quizControls{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.quizControls select, .quizAnswerInput{border:1px solid #e8d4e7;border-radius:11px;padding:11px;background:#fff;color:var(--ink);min-width:0}
.quizAnswerInput{width:100%;font-size:15px}.quizSuggest{position:relative}.quizSuggestions{position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:6;background:#fff;border:1px solid #e8d4e7;border-radius:12px;box-shadow:0 12px 25px #34213c20;max-height:250px;overflow:auto;display:none}.quizSuggestions.open{display:block}.quizSuggestion{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid #f5e8f3;background:#fff;padding:10px 12px;color:var(--ink);font-size:12px}.quizSuggestion:hover, .quizSuggestion:focus{background:#fff0f7}.quizStatus{font-size:12px;color:var(--muted);line-height:1.7;min-height:40px;margin:10px 0}.quizResult{border-radius:13px;background:#fff;padding:13px;border:1px solid #efdfed;line-height:1.7;font-size:13px}.quizStats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.quizStat{background:#fff;border:1px solid #efdfed;border-radius:12px;padding:11px}.quizStat b{display:block;font-size:22px}.quizStat span{font-size:10px;color:var(--muted)}.quizSide{background:#fff;border:1px solid #efdfed;border-radius:20px;padding:17px}.quizSide h3{margin:0 0 10px;font-size:15px}.quizRule{font-size:12px;color:#796a81;line-height:1.8}.quizRule li{margin:5px 0}.quizSource{font-size:11px;color:var(--muted);margin-top:12px}












body.quiz-mode .wrap> *:not(.top):not(#quizView){display:none!important}
body.quiz-mode #quizView{display:block!important}
body.quiz-mode #audioDock .dockMeta{display:none!important}body.quiz-mode #videoPlayer{display:none!important}body.quiz-mode #audioDock{grid-template-columns:minmax(0,1fr) auto;}
@media(max-width:760px){.quizGrid{grid-template-columns:1fr}.quizStats{grid-template-columns:repeat(3,minmax(0,1fr))}.relationCanvas,.relationCanvas svg{height:360px;min-height:360px}.quizMystery{min-height:120px}}

/* V14: AMQ-inspired quiz layout, customizable settings, and dark theme */
.quizView{background:var(--panel,#fff);border-color:var(--line);}
.quizTop{align-items:center}.quizTop h2{font-size:clamp(22px,3vw,30px);letter-spacing:-.03em}
.quizGrid{grid-template-columns:minmax(0,1fr) 310px;align-items:start}
.quizStage{min-width:0}.quizMystery{min-height:190px;background:linear-gradient(145deg,#1c1726,#2b2140 55%,#433050);color:#fff;border:1px solid #5a4869;border-radius:18px;display:flex;align-items:center;justify-content:center;text-align:center;padding:22px;box-shadow:inset 0 0 0 1px #ffffff0b}
.quizMystery .note{font-size:34px;color:#ff8fbd;margin-bottom:12px}.quizMystery b{display:block;font-size:clamp(18px,3vw,27px);letter-spacing:.01em}.quizMystery small{display:block;margin-top:8px;color:#c5b8d2;font-size:12px}
.quizControls{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:12px 0}.quizControls select, .quizControls input, .quizAnswerInput, .quizSetting input[type=number], .quizSetting input[type=text], .quizSetting select{background:var(--field,#fff);color:var(--ink);border:1px solid var(--line);border-radius:9px;padding:9px 10px;min-width:0}.quizControls label{color:var(--muted)}
.quizAnswerInput{min-height:47px;font-size:15px}.quizSide{position:sticky;top:12px;background:var(--panel,#fff);border-color:var(--line)}.quizRule{padding-left:18px}.quizSettingsToggle{display:flex;justify-content:space-between;align-items:center;width:100%;padding:12px;border:1px solid var(--line);border-radius:11px;background:var(--panel2,#f8f5fa);color:var(--ink);font-weight:900;margin-bottom:10px}
.quizSetting{border:1px solid var(--line);border-radius:12px;padding:12px;margin:9px 0;background:var(--panel2,#fbf8fc)}.quizSetting h4{font-size:12px;margin:0 0 9px}.quizSetting .settingRow{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:7px 0}.quizSetting label{font-size:11px;color:var(--muted);display:inline-flex;gap:5px;align-items:center}.quizSetting input[type=checkbox]{accent-color:var(--pink)}.quizSetting input[type=number]{width:82px}.quizSetting input[type=text]{width:100%}.quizSetting .checkGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.quizRoundBar{height:6px;background:var(--line);border-radius:99px;overflow:hidden;margin:9px 0}.quizRoundBar span{display:block;width:0;height:100%;background:var(--pink);transition:width .2s}.quizQuickSettings{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.quizQuickSettings label{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:5px}.quizStats{margin-bottom:8px}.quizStatus{padding:10px 12px;border-radius:10px;background:var(--panel2,#fbf8fc)}
body.dark-theme{--paper:#111018;--ink:#eee8f5;--muted:#aaa0b6;--line:#3a3245;--pink:#c65c94;--pink2:#60304d;--purple:#8f7bd0;--lilac:#30283e;--blue:#27394a;--mint:#243d35;--yellow:#584821;--red:#ce5e87;--shadow:0 14px 35px #0005;--panel:#1b1722;--panel2:#25202e;--field:#15121b;background-color:var(--paper);background-image:radial-gradient(#49334c 0.65px,transparent .65px);color:var(--ink)}

body.dark-theme .drawerhead p{color:#c1b2cc}body.dark-theme .heroSide, body.dark-theme .toolbar, body.dark-theme .card, body.dark-theme .empty, body.dark-theme .drawer, body.dark-theme .playerbar, body.dark-theme .quizView, body.dark-theme .quizSide, body.dark-theme .quizResult, body.dark-theme .quizStat, body.dark-theme .quizSuggestions, body.dark-theme .quizSuggestion{background:var(--panel);color:var(--ink);border-color:var(--line)}body.dark-theme .toolbar select, body.dark-theme .search input, body.dark-theme .quizControls select, body.dark-theme .quizControls input, body.dark-theme .quizAnswerInput, body.dark-theme .quizSetting input, body.dark-theme .quizSetting select{background:var(--field);color:var(--ink);border-color:var(--line)}body.dark-theme .btn, body.dark-theme .tab, body.dark-theme .statusbtn, body.dark-theme .close{background:#292331;color:var(--ink);border-color:var(--line);box-shadow:0 3px 0 #17131c}body.dark-theme .btn.primary{background:#b84e85;color:#fff;border-color:#c65c94}body.dark-theme .tab.active{background:#593047;color:#ffd7e8}body.dark-theme .stat, body.dark-theme .quizSetting, body.dark-theme .quizSettingsToggle, body.dark-theme .quizStatus{background:var(--panel2);border-color:var(--line);color:var(--ink)}body.dark-theme .cover{filter:saturate(.8)}body.dark-theme .songrow{border-color:var(--line)}body.dark-theme .drawerhead{background:linear-gradient(120deg,#3c283a,#30283f 65%,#20333c);border-color:var(--line)}body.dark-theme .quizSuggestion{border-color:var(--line)}body.dark-theme .quizSuggestion:hover, body.dark-theme .quizSuggestion:focus{background:#3a2a3e}body.dark-theme .bar, body.dark-theme .tinybar{background:#332b3c;border-color:var(--line)}

@media(max-width:850px){.quizGrid{grid-template-columns:1fr}.quizSide{position:static}.quizMystery{min-height:150px}}

.syncProviderHeading{font-size:14px;font-weight:800;letter-spacing:.03em;margin:4px 0 10px;color:var(--accent)}
