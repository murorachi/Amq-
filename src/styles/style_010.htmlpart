<style id="v36-amq-avatar-style">
#quizView .v36-amq-player{position:relative;display:flex;flex-direction:column;align-items:center;width:142px;min-height:158px;margin:18px auto 12px;padding:7px 7px 8px;text-align:center}
#quizView .v36-answer{min-height:22px;max-width:100%;font-size:12px;font-weight:700;overflow-wrap:anywhere;color:var(--text);margin:0 0 5px}
#quizView .v36-avatar{width:86px;height:105px;object-fit:cover;object-position:center top;border-radius:8px;display:block}
#quizView .v36-count{position:absolute;left:0;bottom:0;font-size:12px;font-weight:800;color:var(--text)}
#quizView .quizVisualizerV30{justify-content:center!important}
#quizView .quizCountdownV30{text-align:center!important}
#quizView .quizSide{text-align:center!important;align-items:center!important}
#quizView .quizSide>*{margin-left:auto;margin-right:auto}
#quizView .quizSetting{text-align:left}
</style>