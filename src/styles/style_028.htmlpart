<style id="v47-home-redesign">
.hero.view-home{display:block!important;margin:10px 0 18px!important}.hero.view-home .heroDashboard{width:100%!important;max-width:none!important;display:grid!important;grid-template-columns:minmax(0,1fr) minmax(260px,1fr)!important;gap:18px!important;padding:20px!important;border-radius:14px!important;background:var(--panel)!important;border:1px solid var(--line)!important;box-shadow:none!important}.heroDashboard .sectionLabel{font-size:11px;letter-spacing:.08em}.heroDashboard .bigNum{font-size:clamp(28px,4vw,42px)!important;font-weight:850;letter-spacing:-.04em}.heroDashboard .stats{align-self:center}.discover.view-home{margin-top:0!important;padding:18px!important;border:1px solid var(--line)!important;border-radius:14px!important;background:var(--panel)!important}.discoverTop{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.discoverTop h3{margin:0!important;font-size:18px!important}.discoverTop #nextDiscover{order:3}.discoverTop #nextDiscover{display:none!important}.discoverTop #coldBtn{display:inline-flex}.discoverCard{margin-top:14px!important;border-radius:11px!important;border:1px solid var(--line)!important;box-shadow:none!important}
