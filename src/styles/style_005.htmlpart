<style id="mp-v8234-related-details">.mpRelatedAnime{margin:10px 0 14px;padding:9px 11px;border:1px solid var(--line,#e7dfe9);border-radius:10px;background:color-mix(in srgb,var(--accent,#9567b0) 4%,var(--panel,#fff));font-size:12px}.mpRelatedAnime summary{cursor:pointer;font-weight:700}.mpRelatedAnime ul{margin:8px 0 0;padding-left:20px;display:grid;gap:5px}.mpRelatedAnime .mpSmall{margin:8px 0 0}.mpTeamAnswerList span{line-height:1.5}.mpSpeech{overflow-wrap:anywhere}
</style>