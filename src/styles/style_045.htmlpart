<style id="v82-49-vn-catalogue-style">
.vn49View{margin:18px auto 44px;max-width:1500px;padding:clamp(12px,2vw,24px);color:var(--ink,#34283c)}
.vn49Header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:16px}
.vn49Header h2{margin:4px 0;font-size:clamp(22px,3vw,30px)}.vn49Header p{margin:4px 0;color:var(--muted,#86778d);font-size:12px;line-height:1.7}
.vn49Panel{border:1px solid var(--line,#e8dce9);border-radius:14px;background:var(--panel,#fff);padding:14px;margin:10px 0 16px;box-shadow:0 5px 18px #34283c08}
.vn49Toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.vn49Toolbar input,.vn49Toolbar select,.vn49Form input,.vn49Form select{max-width:100%;min-width:150px;border:1px solid var(--line,#e8dce9);border-radius:9px;padding:9px 11px;background:var(--panel,#fff);color:var(--ink,#34283c);font:inherit;font-size:12px}.vn49Toolbar input[type=search]{flex:1;min-width:220px}
.vn49Grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin:14px 0}
.vn49Card{border:1px solid var(--line,#e8dce9);background:var(--panel,#fff);border-radius:12px;overflow:hidden;min-width:0;display:flex;flex-direction:column}
.vn49Cover{width:100%;height:210px;object-fit:cover;background:var(--panel2,#f8f3f8);color:var(--muted,#86778d)}.vn49CoverFallback{height:210px;display:grid;place-items:center;padding:12px;text-align:center;background:var(--panel2,#f8f3f8);color:var(--muted,#86778d);font-size:12px}
.vn49CardBody{padding:10px;display:flex;flex-direction:column;gap:6px;flex:1}.vn49CardTitle{font-weight:800;line-height:1.5;font-size:13px;color:var(--ink,#34283c);text-align:left;border:0;background:transparent;padding:0;cursor:pointer}.vn49Meta{color:var(--muted,#86778d);font-size:11px;line-height:1.6}.vn49Buttons{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto;padding-top:8px}.vn49Buttons button,.vn49LinkButton{border:1px solid var(--line,#e8dce9);border-radius:8px;background:var(--panel,#fff);color:var(--ink,#34283c);padding:7px 9px;font:inherit;font-size:11px;cursor:pointer;text-align:left}.vn49Buttons button:hover,.vn49LinkButton:hover{border-color:var(--accent,#9a69b7)}
.vn49Status{font-size:12px;line-height:1.7;color:var(--muted,#86778d);margin-top:8px;overflow-wrap:anywhere}.vn49Status.error{color:#a63c56}.vn49Status.success{color:#2c795a}.vn49Small{font-size:11px;color:var(--muted,#86778d);line-height:1.65}
.vn49SongList{display:grid;gap:8px;margin-top:12px}.vn49SongRow{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) auto;gap:9px;align-items:center;border:1px solid var(--line,#e8dce9);border-radius:9px;padding:10px 12px;background:var(--panel,#fff);font-size:12px}.vn49SongTitle{font-weight:750;overflow-wrap:anywhere}.vn49Type{white-space:nowrap;color:var(--muted,#86778d);font-size:11px}.vn49TopLink{color:var(--accent,#8a5aae);background:transparent;border:0;padding:0;font:inherit;font-weight:700;text-align:left;cursor:pointer;overflow-wrap:anywhere}
.vn49GroupSubnav[hidden],.vn49View[hidden]{display:none!important}.vn49SourceInfo{margin-top:8px;padding:8px 10px;border-radius:9px;background:var(--panel2,#f8f3f8);font-size:11px;line-height:1.7;color:var(--muted,#86778d)}
.vn49ImportForm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.vn49Form{display:flex;flex-direction:column;gap:6px;min-width:0}.vn49Form label{font-size:11px;font-weight:750}.vn49Full{grid-column:1/-1}.vn49Checkbox{display:flex;gap:8px;align-items:flex-start;font-size:12px;line-height:1.6}
#quizMultiplayerOpen{display:none!important}
@media(max-width:650px){.vn49SongRow{grid-template-columns:1fr;gap:5px}.vn49Cover,.vn49CoverFallback{height:180px}.vn49Grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}.vn49ImportForm{grid-template-columns:minmax(0,1fr)}.vn49Full{grid-column:auto}}
.emqSourceToggleV8248[hidden]{display:none!important}.emqSourceModeV8249{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line,#e8dce9);border-radius:9px;background:var(--panel,#fff);padding:8px 10px;font-size:12px}.emqSourceModeV8249 select{max-width:210px;min-width:150px;border:0;background:transparent;color:var(--ink,#34283c);font:inherit;outline-offset:3px}.emqQuizInfoV8249{margin-top:8px}.emqQuizInfoV8249 .quizInfoList{margin-top:0}.emqQuizInfoV8249 dd{overflow-wrap:anywhere}</style>