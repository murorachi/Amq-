<style id="v63-soft-answer-glow-style">
/* Keep the original quiz UI. Feedback is only a restrained glow around the existing cover area. */
#quizView .quizAnswerFeedbackV61{display:none!important}
#quizView .quizMystery.quiz-answer-correct-v57, #quizView .quizMystery.quiz-answer-wrong-v57{border-color:inherit!important;box-shadow:none!important}
#quizView .quizMystery.quiz-answer-correct-v57::after, #quizView .quizMystery.quiz-answer-wrong-v57::after{content:none!important;display:none!important}
#quizView .quizMystery.quiz-answer-correct-v57:has(.quizAnimeCoverV26:not([hidden])){box-shadow:0 0 9px 2px rgba(68,225,135,.28),0 0 20px 4px rgba(68,225,135,.16)!important;border-color:rgba(86,220,143,.52)!important}
#quizView .quizMystery.quiz-answer-wrong-v57:has(.quizAnimeCoverV26:not([hidden])){box-shadow:0 0 9px 2px rgba(245,83,94,.28),0 0 20px 4px rgba(245,83,94,.16)!important;border-color:rgba(245,95,105,.52)!important}
#quizView .quizMystery.quiz-answer-correct-v57:has(.quizAnimeCoverV26:not([hidden])) .quizAnimeCoverV26{filter:drop-shadow(0 0 5px rgba(75,235,142,.45))!important}
#quizView .quizMystery.quiz-answer-wrong-v57:has(.quizAnimeCoverV26:not([hidden])) .quizAnimeCoverV26{filter:drop-shadow(0 0 5px rgba(255,88,99,.42))!important}
</style>