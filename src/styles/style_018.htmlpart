<style id="v59-quiz-answer-feedback-style">
.dockModeLabelV57{font-size:11px;color:var(--muted);font-weight:750;white-space:nowrap}
#audioDock #dockPlaybackModeV57{max-width:180px;min-width:135px;border:1px solid var(--line);border-radius:9px;background:var(--panel);color:var(--ink);padding:8px 9px;font:inherit;font-size:11px}
/* Answer feedback must remain visible above the revealed anime cover. */
#quizView .quizMystery::after{content:"";position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity .12s ease;border-radius:inherit}
#quizView .quizMystery.quiz-answer-correct-v57{background:#141820!important;border-color:rgba(80,190,120,.95)!important;box-shadow:inset 0 0 0 2px rgba(80,190,120,.85)!important}
#quizView .quizMystery.quiz-answer-correct-v57::after{background:rgba(70,190,115,.32);opacity:1;box-shadow:inset 0 0 0 4px rgba(80,210,125,.85)}
#quizView .quizMystery.quiz-answer-wrong-v57{background:#141820!important;border-color:rgba(225,75,85,.95)!important;box-shadow:inset 0 0 0 2px rgba(225,75,85,.85)!important}
#quizView .quizMystery.quiz-answer-wrong-v57::after{background:rgba(225,65,75,.34);opacity:1;box-shadow:inset 0 0 0 4px rgba(245,85,95,.9)}
@media(max-width:760px){#audioDock #dockPlaybackModeV57{flex:1 1 135px;max-width:none}}
</style>