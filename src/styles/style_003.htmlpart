<style id="v6-cover-catalog">
.catalogHeadTools{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end}.viewModes{display:flex;gap:5px}.viewMode{padding:7px 10px;font-size:11px}.viewMode.active{background:#ffdaeb;border-color:#f1a3c8;color:#8e416e}#retryCoversBtn:disabled{opacity:.4;cursor:default}
.card .cover{position:relative;overflow:hidden;background:linear-gradient(145deg,var(--c1),var(--c2));isolation:isolate}.card .cover .coverFallback{position:absolute;inset:0;display:grid;place-items:center;font-size:36px;color:#fff9;z-index:0}.card .cover .realcover{z-index:1;opacity:1}.card .cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#24192dbb,transparent 76%);z-index:2;pointer-events:none}.card .cover .year, .card .cover .symbol, .card .cover .sticker{z-index:3}.card .cover .symbol{font-size:22px}.card .cover .sticker{position:absolute;right:8px;top:8px;background:#fffdf0d9;border-radius:99px;padding:3px 6px;color:#925b83;text-shadow:none}
.grid.catalog-list{display:flex;flex-direction:column;gap:8px}.grid.catalog-list .card{display:grid;grid-template-columns:92px minmax(0,1fr);text-align:left;min-height:108px}.grid.catalog-list .card .cover{height:auto;min-height:108px;grid-row:1}.grid.catalog-list .card .cover .symbol{font-size:22px}.grid.catalog-list .card .cardbody{display:flex;flex-direction:column;justify-content:center;padding:12px 15px}.grid.catalog-list .card .cardtitle{min-height:0;font-size:14px}.grid.catalog-list .card .sub{white-space:normal}.grid.catalog-list .card .cardfoot{margin-top:8px}.grid.catalog-list .card .tinybar{max-width:320px}.watchCover{position:relative}.watchCardTop{cursor:pointer}.watchCardTop>div:nth-child(2){cursor:pointer}.watchCardName:hover{text-decoration:underline;text-decoration-color:#d18ab6}.detailHero{display:flex;align-items:center;gap:16px;padding-right:42px}.detailCover{width:94px;height:132px;object-fit:cover;border-radius:12px;box-shadow:0 5px 15px #5d3a5b25;display:none;background:#f3e2f0;flex-shrink:0}.detailCover.ready{display:block}.detailHeroText{min-width:0}.detailHeroText h2{margin-top:4px}.detailHeroText .drawerstats{margin-top:10px}
@media(max-width:760px){.catalogHeadTools{width:100%;justify-content:space-between}.grid.catalog-list .card{grid-template-columns:76px minmax(0,1fr);min-height:94px}.grid.catalog-list .card .cover{min-height:94px}.detailHero{gap:10px;padding-right:28px;align-items:flex-start}.detailHeroText h2{font-size:20px;margin-right:0}.detailHeroText .drawerstats{gap:4px}.catalogHeadTools .result{font-size:11px}}

.v10Panel{margin:12px 0 28px}.v10Panel.hidden{display:none}.coverStatus{font-size:11px;color:var(--muted);margin:0 0 10px}.dashIntro{background:#fffdfd;border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-bottom:14px}.dashGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px;margin:12px 0 18px}.dashMetric{background:#fffdfd;border:1px solid var(--line);border-radius:15px;padding:14px}.dashMetric span{display:block;color:var(--muted);font-size:11px}.dashMetric strong{display:block;font-size:25px;margin:5px 0}.dashSection{background:#fffdfd;border:1px solid var(--line);border-radius:15px;padding:14px;margin:12px 0}.dashRow{display:grid;grid-template-columns:86px minmax(50px,1fr) 64px;gap:9px;align-items:center;margin:9px 0;font-size:11px}.dashTrack{height:8px;background:#f0e7f0;border-radius:99px;overflow:hidden}.dashTrack i{display:block;height:100%;background:linear-gradient(90deg,#e9a8cf,#b9a8f4);border-radius:99px}.dashRow em{text-align:right;font-style:normal;color:var(--muted)}
@media(max-width:600px){.dashMetric strong{font-size:21px}}
</style>