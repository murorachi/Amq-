<style id="mp-v8234-fixes">
.mpAnswerFields{display:grid;gap:12px;margin:12px 0}.mpAnswerField{display:grid;gap:5px}.mpAnswerField>label{font-size:12px;font-weight:750;color:var(--muted,#716577)}.mpInputSuggestWrap{position:relative;min-width:0;flex:1}.mpAnswerRow .mpInputSuggestWrap{width:100%}.mpAnswerRow .mpInput{width:100%;min-width:0}.mpSuggest{position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:50;display:grid;max-height:250px;overflow:auto;padding:5px;border:1px solid var(--line,#dfd6e6);border-radius:10px;background:var(--panel,#fff);box-shadow:0 12px 28px #23132a20}.mpSuggest.hidden{display:none}.mpSuggestionOption{border:0;background:transparent;color:var(--text,#34283b);text-align:left;padding:8px 10px;border-radius:6px;font:inherit;overflow-wrap:anywhere;cursor:pointer}.mpSuggestionOption:hover,.mpSuggestionOption.mpSuggestionActive{background:color-mix(in srgb,var(--accent,#9567b0) 13%,var(--panel,#fff))}.mpSubmittedField{font-size:11px;color:var(--muted,#716577)}.mpTeamAnswerList{display:grid;gap:4px;margin:12px 0;padding:10px 12px;border-radius:10px;background:color-mix(in srgb,var(--accent,#9567b0) 6%,var(--panel,#fff));font-size:11px}.mpTeamAnswerList span{overflow-wrap:anywhere}.mpResultCorrect{box-shadow:0 0 0 1px #3da76b88,0 0 15px #3da76b32!important}.mpResultIncorrect{box-shadow:0 0 0 1px #cf526988,0 0 15px #cf526932!important}.mpVideoMount{display:none;margin:10px auto;width:min(100%,720px);border-radius:10px;overflow:hidden;background:#17131c}.mpVideoMount.mpVideoVisible{display:block}.mpVideo{display:block;width:100%;max-height:40vh;object-fit:contain;background:#17131c}.mpResults td{vertical-align:top;overflow-wrap:anywhere}.mpResults td small{display:block;margin-top:3px}.mpPlayPane .mpAnswerRow{align-items:stretch}.mpPlayPane .mpAnswerRow .btn{align-self:stretch;white-space:nowrap}
@media(max-width:760px){.mpPlayPane .mpAnswerRow{flex-direction:row}.mpPlayPane .mpAnswerRow .btn{width:auto}.mpAnswerFields{gap:10px}.mpVideo{max-height:32vh}}
</style>