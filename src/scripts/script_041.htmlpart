<script id="ani-emq-chinese-titles-v8259">
(()=>{
 'use strict';
 const CACHE_KEY='aniEmqChineseTitleCacheV8259',VNDB='https://api.vndb.org/kana',BANGUMI='https://api.bgm.tv/v0/search/subjects';
 const HAN=/[\u3400-\u9fff]/u,KANA=/[\u3040-\u30ff\uff65-\uff9f]/u;
 let cache={};try{const d=JSON.parse(localStorage.getItem(CACHE_KEY)||'{}');if(d&&typeof d==='object')cache=d}catch{}
 let converter=null,converterPromise=null;
 const workMap=new Map(),busy=new Map();
 function api(){return window.__aniEmqAPI}
 function work(id){const a=api();return a?.getWork?.(String(id))||a?.getWorkSummary?.(String(id))||null}
 function vndbIdForWork(id){const w=work(id),v=String(w?.vndbId||w?.vndb_id||'').toLowerCase();return /^v\d+$/.test(v)?v:''}
 function normalize(v){return String(v||'').normalize('NFKC').toLocaleLowerCase().replace(/[\s\p{C}]/gu,'').replace(/[‐‑‒–—―ー\-_/\\:：.,，。!！?？'"「」『』【】()（）\[\]{}]/gu,'')}
 function cleanTitle(v){const s=String(v||'').trim();return s.length<=160&&HAN.test(s)&&!KANA.test(s)?s:''}
 function save(){try{localStorage.setItem(CACHE_KEY,JSON.stringify(cache))}catch(e){console.warn('[EMQ Chinese titles] cache could not be saved',e)}}
 async function getConverter(){if(converter)return converter;if(converterPromise)return converterPromise;converterPromise=new Promise(resolve=>{let finished=false,timer;const done=v=>{if(finished)return;finished=true;clearTimeout(timer);converter=v||null;resolve(converter)};try{if(window.OpenCC&&typeof window.OpenCC.Converter==='function'){done(window.OpenCC.Converter({from:'cn',to:'tw'}));return}}catch{}const script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/opencc-js@1.4.2/dist/umd/full.js';script.async=true;script.onload=()=>{try{done(window.OpenCC&&typeof window.OpenCC.Converter==='function'?window.OpenCC.Converter({from:'cn',to:'tw'}):null)}catch{done(null)}};script.onerror=()=>done(null);timer=setTimeout(()=>done(null),6000);document.head.appendChild(script)});return converterPromise}
 async function traditional(s){const x=String(s||'').trim();if(!x)return '';if(/[\u3400-\u9fff]/u.test(x)){try{const c=await getConverter();if(c)return String(c(x)||x)}catch{}}return x}
 function aliasesFor(id){const v=vndbIdForWork(id);if(!v)return [];const r=cache[v];return Array.isArray(r?.aliases)?r.aliases:[]}
 function titleFor(id){const v=vndbIdForWork(id);if(!v)return '';const r=cache[v];return String(r?.title||r?.aliases?.[0]||'')}
 function serverAliasMap(ids){const wanted=Array.isArray(ids)?new Set(ids.map(String)):null,out={};for(const [vid,r] of Object.entries(cache)){const w=workMap.get(vid);if(!w||!Array.isArray(r?.aliases))continue;if(wanted&&!wanted.has(String(w)))continue;const vals=[r.title,...r.aliases].map(cleanTitle).filter(Boolean),unique=[];for(const x of vals)if(!unique.includes(x)){unique.push(x);if(unique.length>=8)break}if(unique.length)out[String(w)]=unique}return out}
 function cacheRecord(vid,record){const aliases=[];for(const v of [record?.title,...(record?.aliases||[])]){const x=cleanTitle(v);if(x&&!aliases.some(a=>normalize(a)===normalize(x)))aliases.push(x);if(aliases.length>=8)break}cache[vid]={title:aliases[0]||'',aliases,source:record?.source||'vndb',checked:true,at:Date.now()};save()}
 async function fetchVndbBatch(ids){if(!ids.length)return [];const filter=ids.length===1?['id','=',ids[0]]:['or',...ids.map(id=>['id','=',id])];const res=await fetch(`${VNDB}/vn`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filters:filter,fields:'id,title,alttitle,titles{lang,title,latin,official,main},aliases',results:Math.min(100,ids.length),sort:'id'})});if(!res.ok)throw new Error(`VNDB API HTTP ${res.status}`);const data=await res.json();return Array.isArray(data.results)?data.results:[]}
 async function recordFromVndb(vn){const titles=Array.isArray(vn?.titles)?vn.titles:[];const langs=titles.filter(t=>String(t.lang||'').toLowerCase().startsWith('zh')).sort((a,b)=>{const score=t=>{const l=String(t.lang||'').toLowerCase();return l.includes('hant')?0:l==='zh'?1:l.includes('hans')?2:3};return score(a)-score(b)||(Number(!!b.official)-Number(!!a.official))});const candidates=[];for(const t of langs){candidates.push({text:t.title,lang:String(t.lang||'zh')});if(t.latin)candidates.push({text:t.latin,lang:String(t.lang||'zh')})}if(cleanTitle(vn?.title))candidates.push({text:vn.title,lang:'zh'});if(cleanTitle(vn?.alttitle))candidates.push({text:vn.alttitle,lang:'zh'});for(const a of Array.isArray(vn?.aliases)?vn.aliases:[])if(cleanTitle(a))candidates.push({text:a,lang:'zh'});const preferred=[];let hasPrimary=false;for(const c of candidates){const x=cleanTitle(c.text);if(!x)continue;let tt=x;if(!hasPrimary&&!String(c.lang||'').toLowerCase().includes('hant')){tt=await traditional(x)}if(tt&&!preferred.some(a=>normalize(a)===normalize(tt)))preferred.push(tt);if(!preferred.some(a=>normalize(a)===normalize(x)))preferred.push(x);if(!hasPrimary)hasPrimary=true}return {title:preferred[0]||'',aliases:preferred,source:'vndb'}}
 async function queryBangumiExact(id){const vid=vndbIdForWork(id),w=work(id);if(!vid||!w)return null;const vn=cache[vid]||{},workNames=[w.t,w.n,w.title,w.name,vn.originalTitle].filter(x=>typeof x==='string'&&x.trim()).slice(0,4);const compare=new Set([...workNames,...(vn.aliases||[])].map(normalize).filter(Boolean));for(const key of ['title','alttitle'])if(vn[key])compare.add(normalize(vn[key]));for(const title of workNames){try{const res=await fetch(BANGUMI,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({keyword:title,filter:{type:[4]},limit:10,offset:0})});if(!res.ok)continue;const data=await res.json(),items=Array.isArray(data.data)?data.data:[];const matched=items.find(x=>{const n=normalize(x?.name),cn=normalize(x?.name_cn);return (n&&compare.has(n))||(cn&&compare.has(cn))});const zh=cleanTitle(matched?.name_cn);if(zh){const converted=await traditional(zh);return {title:converted||zh,aliases:[converted||zh,zh].filter(Boolean),source:'bangumi'}}}catch(e){console.debug('[EMQ Chinese titles] Bangumi fallback missed',e?.message||e)}}return null}
 async function ensureWorkTitle(id,{bangumiFallback=true}={}){const vid=vndbIdForWork(id);if(!vid)return null;if(busy.has(vid))return busy.get(vid);if(cache[vid]?.checked&&(!bangumiFallback||cache[vid]?.bangumiChecked||cache[vid]?.title))return cache[vid];const p=(async()=>{if(!cache[vid]?.checked){try{const result=await fetchVndbBatch([vid]);const found=result.find(x=>String(x.id).toLowerCase()===vid);if(found){const record=await recordFromVndb(found);cache[vid]={...record,checked:true,source:'vndb',at:Date.now()};save()}else{cache[vid]={title:'',aliases:[],checked:true,source:'vndb',at:Date.now()};save()}}catch(e){console.warn('[EMQ Chinese titles] VNDB lookup deferred:',e?.message||e);return null}}if(bangumiFallback&&!cache[vid]?.title&&!cache[vid]?.bangumiChecked){try{const bg=await queryBangumiExact(id);if(bg){cache[vid]={...cache[vid],...bg,source:'vndb+bangumi',bangumiChecked:true,checked:true,at:Date.now()}}else cache[vid]={...cache[vid],bangumiChecked:true,checked:true,at:Date.now()};save()}catch{cache[vid]={...cache[vid],bangumiChecked:true,checked:true,at:Date.now()};save()}}if(cache[vid]){cache[vid].workId=String(id);workMap.set(vid,String(id));save();try{document.dispatchEvent(new CustomEvent('ani-emq-chinese-titles-ready',{detail:{workIds:[String(id)]}}))}catch{}}return cache[vid]||null})();busy.set(vid,p);try{return await p}finally{busy.delete(vid)}}
 async function ensureTitlesForWorkIds(ids,opts={}){const all=[...new Set((ids||[]).map(String))],out=[];for(const id of all){const vid=vndbIdForWork(id);if(vid)workMap.set(vid,id)}for(const id of all){const vid=vndbIdForWork(id);if(!vid)continue;out.push(await ensureWorkTitle(id,opts))}try{document.dispatchEvent(new CustomEvent('ani-emq-chinese-titles-ready',{detail:{workIds:all}}))}catch{}return out}
 function allKnownAliases(){const out={};for(const [vid,r] of Object.entries(cache)){const id=workMap.get(vid)||String(r.workId||'');if(!id)continue;const vals=[r.title,...(r.aliases||[])].map(cleanTitle).filter(Boolean),unique=[];for(const x of vals)if(!unique.some(y=>normalize(x)===normalize(y))){unique.push(x);if(unique.length>=8)break}if(unique.length)out[id]=unique}return out}
 window.__aniEmqChineseTitleAPIv8259={version:'v8259-vndb-bangumi',getTitle:titleFor,getAliases:aliasesFor,ensureWorkTitle,ensureTitlesForWorkIds,allKnownAliases,serverAliasMap,getCache:()=>JSON.parse(JSON.stringify(cache))};
 document.addEventListener('ani-emq-chinese-titles-ready',()=>{try{window.__aniRefreshChineseSuggestionsV8237?.();const view=document.getElementById('multiplayerView');if(view){view.querySelectorAll('[data-answer-field]').forEach(input=>{if(input.value.trim())window.dispatchEvent(new Event('resize'))});const h=view.querySelector('.mpRevealPane h3');const state=window.__aniMultiplayerUIV82?.getState?.();const q=state?.reveal?.emq?state.reveal:(state?.question?.emq?state.question:null);if(h&&q){const title=window.__aniEmqChineseTitleAPIv8259.getTitle(q.animeId);if(title&&state?.phase==='reveal')h.textContent=title}}}catch{}});
 document.addEventListener('ani-quiz-new-question',e=>{try{const id=String(e?.detail?.songId||'');const a=api();if(!id||!a?.ready||!a.isSong(id))return;let cfg={};try{cfg=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}')}catch{}const target=String(e?.detail?.target||cfg.target||'anime');if(target!=='anime'&&target!=='all'&&cfg.titleLanguage!=='chinese')return;const row=a.getRow(id),meta=a.getMeta(id)||{},workId=String(meta.workId??row?.[0]??'');if(workId)ensureWorkTitle(workId,{bangumiFallback:true}).catch(()=>{})}catch{}});
})();
</script>