<script id="v51-history-blacklist-ui">
(()=>{
 const q=id=>document.getElementById(id);
 const api=()=>window.__aniHistoryAPIv51;const titleForAnime=entry=>{const names=api()?.getAnimeTitles(entry.animeId)||{english:entry.animeEnglish||'未知作品',romaji:entry.animeRomaji||entry.animeEnglish||'未知作品'};const lang=document.getElementById('qsTitleLanguage')?.value||'english';if(lang==='chinese')return window.__aniChineseTitleAPIv8237?.getTitle(entry.animeId)||names.english;return lang==='romaji'?names.romaji:names.english};
 const overlay=document.createElement('div');overlay.className='historyOverlayV51';overlay.id='quizHistoryOverlayV51';overlay.setAttribute('role','dialog');overlay.setAttribute('aria-modal','true');overlay.setAttribute('aria-label','歌曲歷史');
 overlay.innerHTML='<section class="historyDialogV51"><header class="historyHeadV51"><div><div class="detailEyebrow">QUIZ HISTORY</div><h2>歌曲歷史</h2><p id="historySummaryV51">最近 2,000 筆逐題紀錄；長期摘要另行累積保存</p></div><button type="button" class="btn" id="historyCloseV51">關閉 ✕</button></header><div class="historyBodyV51" id="historyBodyV51"></div></section>';
 document.body.appendChild(overlay);
 const button=document.createElement('button');button.type='button';button.className='btn quizHistoryButtonV51';button.id='quizHistoryOpenV51';button.textContent='☷ 歌曲歷史';
 const topButtons=document.querySelector('.quizTop>div:last-child');const settings=q('quizSettingsToggle');if(topButtons&&settings)settings.insertAdjacentElement('afterend',button);else if(topButtons)topButtons.prepend(button);
 const close=()=>overlay.classList.remove('open');
 button.addEventListener('click',()=>{renderHistory();overlay.classList.add('open');setTimeout(()=>q('historyCloseV51')?.focus({preventScroll:true}),0)});q('historyCloseV51').addEventListener('click',()=>{close();setTimeout(()=>button.focus({preventScroll:true}),0)});overlay.addEventListener('click',e=>{if(e.target===overlay){close();setTimeout(()=>button.focus({preventScroll:true}),0)}});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.classList.contains('open')){close();setTimeout(()=>button.focus({preventScroll:true}),0)}});
 function setFamiliarity(songId,value){api()?.setStatus(songId,value);try{document.dispatchEvent(new CustomEvent('ani-quiz-history-updated-v51'))}catch(e){}}
 function renderHistory(){const body=q('historyBodyV51');if(!body)return;const records=[...(api()?.getHistory()||[])].reverse();q('historySummaryV51').textContent=`顯示最近 ${records.length.toLocaleString()} 筆逐題紀錄（上限 2,000） · 長期摘要另行保存 · 黑名單 ${(api()?.getBlacklistCount()||0).toLocaleString()} 首`;
  if(!records.length){body.innerHTML='<div class="historyEmptyV51">還沒有答題紀錄。完成第一題後，這裡就會開始累積每回合的結果。</div>';return}
  const groups=new Map();for(const r of records){const key=r.roundId||'legacy';if(!groups.has(key))groups.set(key,[]);groups.get(key).push(r)}
  body.replaceChildren();let groupIndex=0;
  for(const [roundId,items] of groups){const section=document.createElement('section');section.className='historyRoundV51';const head=document.createElement('div');head.className='historyRoundHeadV51';const left=document.createElement('span');left.textContent=roundId==='legacy'?'舊紀錄':`第 ${items[0].roundNo||groups.size-groupIndex} 回合`;const right=document.createElement('span');const correctCount=items.filter(x=>x.correct).length;right.textContent=`${correctCount}/${items.length} 答對`;head.append(left,right);section.appendChild(head);
   for(const entry of items){const row=document.createElement('article');row.className='historyRowV51 '+(entry.correct?'correctV51':'wrongV51');const songId=String(entry.songId);const song=api()?.getSong(songId);const animeName=titleForAnime(entry);const familiar=Number(api()?.getStatus(songId)||0);const total=api()?.getSongHistorySummary?.(songId)?.total??(api()?.getHistory()||[]).filter(x=>String(x.songId)===songId).length;
    const main=document.createElement('div');main.className='historySongMainV51';const anime=document.createElement('div');anime.className='historyAnimeV51';anime.textContent=animeName;const songName=document.createElement('div');songName.className='historySongTitleV51';songName.textContent=entry.songName||song?.[4]||'未命名歌曲';const artist=document.createElement('div');artist.className='historyArtistV51';artist.textContent=entry.artist||song?.[5]||'歌手未標示';main.append(anime,songName,artist);
    const result=document.createElement('div');result.className='historyResultV51';result.textContent=entry.correct?'✓ 答對':'✕ 答錯／跳過';const meta=document.createElement('div');meta.className='historyStatusV51';meta.setAttribute('aria-label','熟悉度');
    const levels=[[1,'聽過'],[2,'有印象'],[3,'秒答']];for(const [level,label] of levels){const lab=document.createElement('label');const input=document.createElement('input');input.type='checkbox';input.checked=familiar===level;input.setAttribute('aria-label',label);input.addEventListener('change',()=>{if(input.checked)setFamiliarity(songId,level);else if(Number(api()?.getStatus(songId))===level)setFamiliarity(songId,0);renderHistory()});lab.append(input,document.createTextNode(label));meta.appendChild(lab)}
    const actions=document.createElement('div');actions.className='historyRowActionsV51';const count=document.createElement('span');count.className='historyCountV51';count.textContent=`累積紀錄 ${total.toLocaleString()} 次`;actions.appendChild(count);const blackBtn=document.createElement('button');blackBtn.type='button';blackBtn.className='btn historyBlacklistV51';const blacklisted=!!api()?.isBlacklisted(songId);blackBtn.textContent=blacklisted?'已加入黑單':'加入黑單';blackBtn.disabled=blacklisted;blackBtn.title=blacklisted?'請到歌曲詳情頁解除黑單':'將這首歌排除於隨機抽選';blackBtn.addEventListener('click',()=>{api()?.setBlacklisted(songId,true);renderHistory();toast('已加入黑名單；要解除請前往歌曲詳情頁')});actions.appendChild(blackBtn);
    row.append(main,result,meta,actions);section.appendChild(row)}body.appendChild(section);groupIndex++;
  }
 }
 document.addEventListener('ani-quiz-history-updated-v51',()=>{const n=(api()?.getHistory()||[]).length;if(overlay.classList.contains('open'))renderHistory();button.textContent=`☷ 歌曲歷史${n?' ('+n+')':''}`});
 document.addEventListener('ani-blacklist-changed-v51',()=>{if(overlay.classList.contains('open'))renderHistory()});
 document.addEventListener('ani-quiz-new-question',()=>{if(overlay.classList.contains('open'))renderHistory()});
 {const n=(api()?.getHistory()||[]).length;button.textContent=`☷ 歌曲歷史${n?' ('+n+')':''}`;}
})();
</script>