<script>
<!-- AMQ_SPLIT_MODULE:anime_song_database -->
let anime=DB.anime,songs=DB.songs,byAnime=new Map(),songMap=new Map();
const typeNames={1:'OP',2:'ED',3:'插入歌',4:'OST',5:'其他'};
function rebuild(){byAnime=new Map(anime.map(a=>[a[0],a]));songMap=new Map();for(const s of songs){if(!songMap.has(s[0]))songMap.set(s[0],[]);songMap.get(s[0]).push(s)}for(const arr of songMap.values())arr.sort((a,b)=>(a[3]||0)-(b[3]||0));window.byAnime=byAnime;window.__aniEmqAPI?.registerWorks?.(byAnime)}
rebuild();let status=loadStatus(),favorites=loadFavorites(),tab='all',currentId=null,visible=[],currentSong=null,discoverySong=null;
function loadStatus(){try{return JSON.parse(localStorage.getItem('aniCollection_v2')||localStorage.getItem('anisongFieldGuide_v1')||'{}')}catch(e){return {}}}
function loadFavorites(){try{return JSON.parse(localStorage.getItem('aniFavorites_v1')||'[]')}catch(e){return []}}
function save(){try{localStorage.setItem('aniCollection_v2',JSON.stringify(status));document.dispatchEvent(new CustomEvent('ani-familiarity-updated-v51'))}catch(e){toast('儲存空間不足，請先匯出備份')}}function saveFav(){try{localStorage.setItem('aniFavorites_v1',JSON.stringify(favorites))}catch(e){}}
// V51: persistent song blacklist and quiz history.
let blacklistedSongIdsV51=new Set();try{const raw=JSON.parse(localStorage.getItem('aniBlacklistedSongs_v1')||'[]');if(Array.isArray(raw))blacklistedSongIdsV51=new Set(raw.map(String))}catch(e){}
let quizHistoryV51=[];try{const raw=JSON.parse(localStorage.getItem('aniQuizHistory_v1')||'[]');if(Array.isArray(raw))quizHistoryV51=raw.filter(x=>x&&x.songId!=null)}catch(e){}
let quizHistoryCurrentRoundV51=null,quizHistoryRoundSerialV51=quizHistoryV51.reduce((m,x)=>Math.max(m,Number(x.roundNo)||0),0);
const QUIZ_HISTORY_SUMMARY_KEY_V1='aniQuizHistorySummaryV1';
const QUIZ_HISTORY_DETAIL_LIMIT_V1=2000;
const QUIZ_HISTORY_DEDUPE_WINDOW_V1=5000;
const QUIZ_HISTORY_SUMMARY_SAVE_DELAY_V1=30000;
const QUIZ_HISTORY_SUMMARY_SAVE_BATCH_V1=20;
let quizHistorySummaryV1=null,quizHistorySummaryPendingV1=0,quizHistorySummarySaveTimerV1=null,quizHistorySummarySaveFailedV1=false,quizHistorySummarySaveWarningShownV1=false;
let quizHistorySummaryRecoveryRawV1=null,quizHistorySummaryPersistenceBlockedV1=false;
let quizHistoryProcessedIdsV1=new Set();
function nearNumberV1(a,b){return Number.isFinite(Number(a))&&Number.isFinite(Number(b))&&Math.abs(Number(a)-Number(b))<=Math.max(1e-7,Math.abs(Number(b))*1e-9)}
function validCountV1(n){return Number.isInteger(n)&&n>=0}
function isValidQuizHistorySummaryV1(x){
 if(!x||typeof x!=='object'||x.schemaVersion!==1||!validCountV1(x.total)||!validCountV1(x.correct)||!validCountV1(x.wrong)||x.total!==x.correct+x.wrong||!validCountV1(x.elapsedCount)||x.elapsedCount>x.total||!Number.isFinite(x.elapsedSum)||x.elapsedSum<0||(x.elapsedCount===0&&x.elapsedSum!==0))return false;
 if(!x.bySong||typeof x.bySong!=='object'||Array.isArray(x.bySong)||!x.byDay||typeof x.byDay!=='object'||Array.isArray(x.byDay)||!Array.isArray(x.processedIds)||x.processedIds.length>QUIZ_HISTORY_DEDUPE_WINDOW_V1||!x.processedIds.every(v=>typeof v==='string'&&v.length>0)||new Set(x.processedIds).size!==x.processedIds.length)return false;
 if(x.total>0&&(!Array.isArray(x.last)||x.last.length<3||!Number.isFinite(Number(x.last[0]))||String(x.last[1]??'')===''||![0,1].includes(Number(x.last[2]))))return false;
 if(x.total===0&&x.last!==null)return false;
 let st=0,sc=0,sw=0,se=0,ss=0;
 for(const row of Object.values(x.bySong)){
  if(!Array.isArray(row)||row.length<8||!validCountV1(row[0])||row[0]<1||!validCountV1(row[1])||!validCountV1(row[2])||row[0]!==row[1]+row[2]||!validCountV1(row[3])||row[3]>row[0]||!Number.isFinite(row[4])||row[4]<0||(row[3]===0&&row[4]!==0)||!validCountV1(row[5])||row[5]>row[3]||row[5]>row[1]||!Number.isFinite(Number(row[6]))||Number(row[6])<0||!(row[7]===null||row[7]===0||row[7]===1))return false;
  st+=row[0];sc+=row[1];sw+=row[2];se+=row[3];ss+=row[4];
 }
 if(st!==x.total||sc!==x.correct||sw!==x.wrong||se!==x.elapsedCount||!nearNumberV1(ss,x.elapsedSum))return false;
 let dt=0,dc=0,dw=0,de=0,ds=0;
 for(const [day,row] of Object.entries(x.byDay)){
  if(!/^\d{4}-\d{2}-\d{2}$/.test(day)||!Array.isArray(row)||row.length<5||!validCountV1(row[0])||row[0]<1||!validCountV1(row[1])||!validCountV1(row[2])||row[0]!==row[1]+row[2]||!validCountV1(row[3])||row[3]>row[0]||!Number.isFinite(row[4])||row[4]<0||(row[3]===0&&row[4]!==0))return false;
  const dayStamp=Date.parse(day+'T00:00:00.000Z');if(!Number.isFinite(dayStamp)||new Date(dayStamp).toISOString().slice(0,10)!==day)return false;
  dt+=row[0];dc+=row[1];dw+=row[2];de+=row[3];ds+=row[4];
 }
 if(!(dt===x.total&&dc===x.correct&&dw===x.wrong&&de===x.elapsedCount&&nearNumberV1(ds,x.elapsedSum)))return false;
 if(x.total>0){const lr=x.bySong[String(x.last[1])];if(!lr||Number(lr[6])!==Number(x.last[0])||Number(lr[7])!==Number(x.last[2]))return false}
 return true;
}
function preserveInvalidQuizSummaryV1(raw){
 if(raw==null)return true;
 const base='aniQuizHistorySummaryRecoveryV1';
 try{const existing=localStorage.getItem(base);if(existing===raw)return true;const key=existing===null?base:`${base}_${Date.now()}_${Math.random().toString(36).slice(2,6)}`;localStorage.setItem(key,raw);return true}catch(e){console.warn('Invalid long-term quiz summary could not be quarantined',e);return false}
}
function quizHistoryInstantThresholdV1(){try{const x=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');return Math.max(1,Number(x.instantSec)||5)}catch(e){return 5}}
function quizHistoryEntryKeyV1(entry){if(entry?.id!=null&&String(entry.id))return String(entry.id);return 'legacy:'+[entry?.songId,entry?.at,entry?.correct,entry?.answer,entry?.roundId].map(x=>String(x??'')).join('|')}
function emptyQuizHistorySummaryV1(){return {schemaVersion:1,createdAt:new Date().toISOString(),baseline:{sourceRecordCount:0,mayBeTruncated:false,migratedAt:new Date().toISOString()},total:0,correct:0,wrong:0,elapsedCount:0,elapsedSum:0,last:null,bySong:{},byDay:{},processedIds:[],processedCursor:0}}
function addQuizHistorySummaryEntryV1(entry){
 if(!quizHistorySummaryV1||!entry||entry.songId==null)return false;
 const key=quizHistoryEntryKeyV1(entry);if(quizHistoryProcessedIdsV1.has(key))return false;
 const sid=String(entry.songId),correct=entry.correct===true||entry.correct===1||String(entry.correct).toLowerCase()==='true';
 const parsedAt=Date.parse(entry.at||''),at=Number.isFinite(parsedAt)?parsedAt:Date.now(),day=new Date(at).toISOString().slice(0,10);
 const elapsed=entry.elapsed!==null&&entry.elapsed!==undefined&&Number.isFinite(Number(entry.elapsed))&&Number(entry.elapsed)>=0?Number(entry.elapsed):null;
 quizHistorySummaryV1.total++;
 if(correct)quizHistorySummaryV1.correct++;else quizHistorySummaryV1.wrong++;
 if(elapsed!==null){quizHistorySummaryV1.elapsedCount++;quizHistorySummaryV1.elapsedSum+=elapsed}
 const row=quizHistorySummaryV1.bySong[sid]||(quizHistorySummaryV1.bySong[sid]=[0,0,0,0,0,0,0,null]);
 row[0]++;if(correct)row[1]++;else row[2]++;if(elapsed!==null){row[3]++;row[4]+=elapsed;if(correct&&elapsed>quizHistoryInstantThresholdV1())row[5]++}
 if(at>=Number(row[6]||0)){row[6]=at;row[7]=correct?1:0}
 const dayRow=quizHistorySummaryV1.byDay[day]||(quizHistorySummaryV1.byDay[day]=[0,0,0,0,0]);dayRow[0]++;if(correct)dayRow[1]++;else dayRow[2]++;if(elapsed!==null){dayRow[3]++;dayRow[4]+=elapsed}
 if(!quizHistorySummaryV1.last||at>=Number(quizHistorySummaryV1.last[0]||0))quizHistorySummaryV1.last=[at,sid,correct?1:0];
 if(quizHistorySummaryV1.processedIds.length<QUIZ_HISTORY_DEDUPE_WINDOW_V1)quizHistorySummaryV1.processedIds.push(key);else{const cursor=(Number(quizHistorySummaryV1.processedCursor)||0)%QUIZ_HISTORY_DEDUPE_WINDOW_V1;const old=quizHistorySummaryV1.processedIds[cursor];if(old!==undefined)quizHistoryProcessedIdsV1.delete(old);quizHistorySummaryV1.processedIds[cursor]=key;quizHistorySummaryV1.processedCursor=(cursor+1)%QUIZ_HISTORY_DEDUPE_WINDOW_V1}quizHistoryProcessedIdsV1.add(key)
 return true;
}
function rebuildQuizHistoryProcessedIdsV1(){quizHistoryProcessedIdsV1=new Set(Array.isArray(quizHistorySummaryV1?.processedIds)?quizHistorySummaryV1.processedIds.map(String):[])}
function persistQuizHistorySummaryV1(showWarning=false){
 if(window.__aniSuppressPersistenceForRestoreV828)return false;
 if(!quizHistorySummaryV1)return false;
 if(quizHistorySummarySaveTimerV1){clearTimeout(quizHistorySummarySaveTimerV1);quizHistorySummarySaveTimerV1=null}
 if(quizHistorySummaryPersistenceBlockedV1){quizHistorySummarySaveFailedV1=true;if(showWarning&&!quizHistorySummarySaveWarningShownV1&&typeof window.toast==='function'){quizHistorySummarySaveWarningShownV1=true;window.toast('長期答題摘要格式異常，原始資料暫時受到保護。請先匯出完整備份，再進行修復。')}return false}
 try{localStorage.setItem(QUIZ_HISTORY_SUMMARY_KEY_V1,JSON.stringify(quizHistorySummaryV1));quizHistorySummaryPendingV1=0;quizHistorySummarySaveFailedV1=false;return true}
 catch(e){quizHistorySummarySaveFailedV1=true;console.warn('Long-term quiz summary could not be saved',e);if(showWarning&&!quizHistorySummarySaveWarningShownV1&&typeof window.toast==='function'){quizHistorySummarySaveWarningShownV1=true;window.toast('長期答題摘要儲存失敗。請先匯出完整備份，並檢查瀏覽器儲存空間。')}return false}
}
function scheduleQuizHistorySummarySaveV1(){quizHistorySummaryPendingV1++;if(quizHistorySummaryPendingV1>=QUIZ_HISTORY_SUMMARY_SAVE_BATCH_V1){persistQuizHistorySummaryV1(true);return}if(!quizHistorySummarySaveTimerV1)quizHistorySummarySaveTimerV1=setTimeout(()=>persistQuizHistorySummaryV1(true),QUIZ_HISTORY_SUMMARY_SAVE_DELAY_V1)}
function syncQuizHistorySummaryFromRecentV1(){
 if(!quizHistorySummaryV1)return false;let changed=false;
 const entries=quizHistoryV51.slice().sort((a,b)=>(Date.parse(a.at||'')||0)-(Date.parse(b.at||'')||0));
 for(const entry of entries)if(addQuizHistorySummaryEntryV1(entry))changed=true;
 if(changed)persistQuizHistorySummaryV1(false);return changed;
}
function initQuizHistorySummaryV1(){
 let rawStored=null,stored=null;try{rawStored=localStorage.getItem(QUIZ_HISTORY_SUMMARY_KEY_V1);stored=JSON.parse(rawStored||'null')}catch(e){}
 if(isValidQuizHistorySummaryV1(stored)){
  quizHistorySummaryV1=stored;rebuildQuizHistoryProcessedIdsV1();syncQuizHistorySummaryFromRecentV1();return;
 }
 if(rawStored!==null){quizHistorySummaryRecoveryRawV1=rawStored;const preserved=preserveInvalidQuizSummaryV1(rawStored);quizHistorySummaryPersistenceBlockedV1=!preserved;if(preserved)quizHistorySummaryRecoveryRawV1=null;else console.error('Long-term quiz summary is invalid; preserving original stored value until a recovery backup is exported.')}
 quizHistorySummaryV1=emptyQuizHistorySummaryV1();
 const seed=quizHistoryV51.slice().sort((a,b)=>(Date.parse(a.at||'')||0)-(Date.parse(b.at||'')||0));
 quizHistorySummaryV1.baseline={sourceRecordCount:seed.length,mayBeTruncated:seed.length>=QUIZ_HISTORY_DETAIL_LIMIT_V1,migratedAt:new Date().toISOString()};
 rebuildQuizHistoryProcessedIdsV1();for(const entry of seed)addQuizHistorySummaryEntryV1(entry);
 persistQuizHistorySummaryV1(false);
}
function flushQuizHistorySummaryV1(){return persistQuizHistorySummaryV1(true)}
initQuizHistorySummaryV1();
const QUIZ_TARGET_SUMMARY_KEY_V80='aniQuizTargetSummaryV1';
const QUIZ_TARGET_NAMES_V80=['anime','title','artist','unknown'];
const QUIZ_TARGET_DEDUPE_WINDOW_V80=5000;
let quizTargetSummaryV80=null,quizTargetSummaryPendingV80=0,quizTargetSummarySaveTimerV80=null,quizTargetSummaryWriteBlockedV80=false,quizTargetSummaryWarnedV80=false;
let quizTargetProcessedIdsV80=new Set(),quizTargetSummaryRecoveryRawV80=null;
function emptyQuizTargetSummaryV80(){return {schemaVersion:1,createdAt:new Date().toISOString(),baseline:{legacyTargetUnknownCount:0,sourceRecordCount:0,mayBeIncomplete:true,migratedAt:new Date().toISOString()},total:0,byTarget:{anime:[0,0,0,0,0],title:[0,0,0,0,0],artist:[0,0,0,0,0],unknown:[0,0,0,0,0]},bySongTarget:{},byDayTarget:{},processedIds:[],processedCursor:0}}
function isValidTargetRowV80(r,full=true){if(!Array.isArray(r)||(full&&r.length<8)||(!full&&r.length<5)||!validCountV1(r[0])||!validCountV1(r[1])||!validCountV1(r[2])||r[0]!==r[1]+r[2]||!validCountV1(r[3])||r[3]>r[0]||!Number.isFinite(r[4])||r[4]<0||(r[3]===0&&r[4]!==0))return false;if(full&&(!validCountV1(r[5])||r[5]>r[3]||r[5]>r[1]||!Number.isFinite(Number(r[6]))||Number(r[6])<0||!(r[7]===null||r[7]===0||r[7]===1)))return false;return true}
function isValidQuizTargetSummaryV80(x){
 if(!x||typeof x!=='object'||x.schemaVersion!==1||!validCountV1(x.total)||!x.byTarget||typeof x.byTarget!=='object'||!x.bySongTarget||typeof x.bySongTarget!=='object'||Array.isArray(x.bySongTarget)||!x.byDayTarget||typeof x.byDayTarget!=='object'||Array.isArray(x.byDayTarget)||!Array.isArray(x.processedIds)||x.processedIds.length>QUIZ_TARGET_DEDUPE_WINDOW_V80||!x.processedIds.every(v=>typeof v==='string'&&v.length>0)||new Set(x.processedIds).size!==x.processedIds.length||!validCountV1(x.processedCursor)||x.processedCursor>=QUIZ_TARGET_DEDUPE_WINDOW_V80)return false;
 let overall=0;
 for(const target of QUIZ_TARGET_NAMES_V80){const row=x.byTarget[target];if(!isValidTargetRowV80(row,false))return false;overall+=row[0];let st=0,sc=0,sw=0,se=0,ss=0;
  for(const targets of Object.values(x.bySongTarget)){if(!targets||typeof targets!=='object'||Array.isArray(targets))return false;for(const key of Object.keys(targets))if(!QUIZ_TARGET_NAMES_V80.includes(key))return false;const r=targets[target];if(r===undefined)continue;if(!isValidTargetRowV80(r,true))return false;st+=r[0];sc+=r[1];sw+=r[2];se+=r[3];ss+=r[4]}
  if(st!==row[0]||sc!==row[1]||sw!==row[2]||se!==row[3]||!nearNumberV1(ss,row[4]))return false;
  let dt=0,dc=0,dw=0,de=0,ds=0;
  for(const [day,targets] of Object.entries(x.byDayTarget)){if(!/^\d{4}-\d{2}-\d{2}$/.test(day)||!targets||typeof targets!=='object'||Array.isArray(targets))return false;for(const key of Object.keys(targets))if(!QUIZ_TARGET_NAMES_V80.includes(key))return false;const r=targets[target];if(r===undefined)continue;if(!isValidTargetRowV80(r,false))return false;const stamp=Date.parse(day+'T00:00:00.000Z');if(!Number.isFinite(stamp)||new Date(stamp).toISOString().slice(0,10)!==day)return false;dt+=r[0];dc+=r[1];dw+=r[2];de+=r[3];ds+=r[4]}
  if(dt!==row[0]||dc!==row[1]||dw!==row[2]||de!==row[3]||!nearNumberV1(ds,row[4]))return false;
 }
 return overall===x.total;
}
function quizTargetEntryKeyV80(entry){return quizHistoryEntryKeyV1(entry)}
function addQuizTargetSummaryEntryV80(entry){
 if(!quizTargetSummaryV80||!entry||entry.songId==null)return false;const key=quizTargetEntryKeyV80(entry);if(quizTargetProcessedIdsV80.has(key))return false;
 const target=QUIZ_TARGET_NAMES_V80.includes(entry.target)?entry.target:'unknown';const sid=String(entry.songId);const correct=entry.correct===true||entry.correct===1||String(entry.correct).toLowerCase()==='true';const parsed=Date.parse(entry.at||''),at=Number.isFinite(parsed)?parsed:Date.now(),day=new Date(at).toISOString().slice(0,10);const elapsed=entry.elapsed!==null&&entry.elapsed!==undefined&&Number.isFinite(Number(entry.elapsed))&&Number(entry.elapsed)>=0?Number(entry.elapsed):null;
 const global=quizTargetSummaryV80.byTarget[target];global[0]++;if(correct)global[1]++;else global[2]++;if(elapsed!==null){global[3]++;global[4]+=elapsed}
 const targets=quizTargetSummaryV80.bySongTarget[sid]||(quizTargetSummaryV80.bySongTarget[sid]={});const row=targets[target]||(targets[target]=[0,0,0,0,0,0,0,null]);row[0]++;if(correct)row[1]++;else row[2]++;if(elapsed!==null){row[3]++;row[4]+=elapsed;if(correct&&elapsed>quizHistoryInstantThresholdV1())row[5]++}if(at>=Number(row[6]||0)){row[6]=at;row[7]=correct?1:0}
 const days=quizTargetSummaryV80.byDayTarget[day]||(quizTargetSummaryV80.byDayTarget[day]={});const dr=days[target]||(days[target]=[0,0,0,0,0]);dr[0]++;if(correct)dr[1]++;else dr[2]++;if(elapsed!==null){dr[3]++;dr[4]+=elapsed}
 quizTargetSummaryV80.total++;if(quizTargetSummaryV80.processedIds.length<QUIZ_TARGET_DEDUPE_WINDOW_V80)quizTargetSummaryV80.processedIds.push(key);else{const cursor=(Number(quizTargetSummaryV80.processedCursor)||0)%QUIZ_TARGET_DEDUPE_WINDOW_V80;const old=quizTargetSummaryV80.processedIds[cursor];if(old!==undefined)quizTargetProcessedIdsV80.delete(old);quizTargetSummaryV80.processedIds[cursor]=key;quizTargetSummaryV80.processedCursor=(cursor+1)%QUIZ_TARGET_DEDUPE_WINDOW_V80}quizTargetProcessedIdsV80.add(key);return true;
}
function preserveInvalidQuizTargetSummaryV80(raw){if(raw==null)return true;const base='aniQuizTargetSummaryRecoveryV1';try{const existing=localStorage.getItem(base);if(existing===raw)return true;const key=existing===null?base:`${base}_${Date.now()}_${Math.random().toString(36).slice(2,6)}`;localStorage.setItem(key,raw);return true}catch(e){console.warn('Invalid target summary could not be quarantined',e);return false}}
function persistQuizTargetSummaryV80(showWarning=false){if(window.__aniSuppressPersistenceForRestoreV828)return false;if(!quizTargetSummaryV80)return false;if(quizTargetSummarySaveTimerV80){clearTimeout(quizTargetSummarySaveTimerV80);quizTargetSummarySaveTimerV80=null}if(quizTargetSummaryWriteBlockedV80){if(showWarning&&!quizTargetSummaryWarnedV80&&typeof window.toast==='function'){quizTargetSummaryWarnedV80=true;window.toast('答題目標摘要格式異常，原始資料受到保護。請先匯出完整備份。')}return false}try{localStorage.setItem(QUIZ_TARGET_SUMMARY_KEY_V80,JSON.stringify(quizTargetSummaryV80));quizTargetSummaryPendingV80=0;return true}catch(e){console.warn('Target summary save failed',e);if(showWarning&&!quizTargetSummaryWarnedV80&&typeof window.toast==='function'){quizTargetSummaryWarnedV80=true;window.toast('答題目標摘要儲存失敗，請先匯出完整備份並檢查儲存空間。')}return false}}
function scheduleQuizTargetSummarySaveV80(){quizTargetSummaryPendingV80++;if(quizTargetSummaryPendingV80>=20){persistQuizTargetSummaryV80(true);return}if(!quizTargetSummarySaveTimerV80)quizTargetSummarySaveTimerV80=setTimeout(()=>persistQuizTargetSummaryV80(true),30000)}
function initQuizTargetSummaryV80(){let raw=null,stored=null;try{raw=localStorage.getItem(QUIZ_TARGET_SUMMARY_KEY_V80);stored=JSON.parse(raw||'null')}catch(e){}if(isValidQuizTargetSummaryV80(stored)){quizTargetSummaryV80=stored;quizTargetProcessedIdsV80=new Set(stored.processedIds.map(String));let changed=false;for(const entry of quizHistoryV51.slice().sort((a,b)=>(Date.parse(a.at||'')||0)-(Date.parse(b.at||'')||0)))if(addQuizTargetSummaryEntryV80(entry))changed=true;if(changed)persistQuizTargetSummaryV80(false);return}
 if(raw!==null){quizTargetSummaryRecoveryRawV80=raw;quizTargetSummaryWriteBlockedV80=!preserveInvalidQuizTargetSummaryV80(raw);if(!quizTargetSummaryWriteBlockedV80)quizTargetSummaryRecoveryRawV80=null}
 quizTargetSummaryV80=emptyQuizTargetSummaryV80();const seed=quizHistoryV51.slice().sort((a,b)=>(Date.parse(a.at||'')||0)-(Date.parse(b.at||'')||0));const historicalTotal=Number(quizHistorySummaryV1?.total)||seed.length;quizTargetSummaryV80.baseline={sourceRecordCount:seed.length,legacyTargetUnknownCount:Math.max(0,historicalTotal-seed.length),mayBeIncomplete:historicalTotal>seed.length||seed.length>=QUIZ_HISTORY_DETAIL_LIMIT_V1,migratedAt:new Date().toISOString()};quizTargetProcessedIdsV80=new Set();for(const entry of seed)addQuizTargetSummaryEntryV80(entry);persistQuizTargetSummaryV80(false)}
function flushQuizTargetSummaryV80(){return persistQuizTargetSummaryV80(true)}
initQuizTargetSummaryV80();
document.addEventListener('visibilitychange',()=>{if(!window.__aniSuppressPersistenceForRestoreV828&&document.visibilityState==='hidden'){flushQuizTargetSummaryV80();flushQuizHistorySummaryV1()}});
window.addEventListener('pagehide',()=>{if(!window.__aniSuppressPersistenceForRestoreV828){flushQuizHistorySummaryV1();flushQuizTargetSummaryV80()}});
function isBlacklistedSongV51(id){return blacklistedSongIdsV51.has(String(id))}
function setBlacklistedSongV51(id,blocked){const key=String(id);if(blocked)blacklistedSongIdsV51.add(key);else blacklistedSongIdsV51.delete(key);try{localStorage.setItem('aniBlacklistedSongs_v1',JSON.stringify([...blacklistedSongIdsV51]))}catch(e){toast('黑名單儲存失敗，請檢查瀏覽器儲存空間')}document.dispatchEvent(new CustomEvent('ani-blacklist-changed-v51',{detail:{songId:key,blocked:!!blocked}}));return !!blocked}
function beginQuizHistoryRoundV51(){quizHistoryRoundSerialV51++;quizHistoryCurrentRoundV51='r'+Date.now()+'-'+quizHistoryRoundSerialV51}
function saveQuizHistoryV51(entry){if(window.__aniSuppressPersistenceForRestoreV828)return;quizHistoryV51.push(entry);if(quizHistoryV51.length>QUIZ_HISTORY_DETAIL_LIMIT_V1)quizHistoryV51=quizHistoryV51.slice(-QUIZ_HISTORY_DETAIL_LIMIT_V1);try{localStorage.setItem('aniQuizHistory_v1',JSON.stringify(quizHistoryV51))}catch(e){toast('歌曲歷史儲存空間不足，舊紀錄仍保留在本次頁面中')}if(addQuizHistorySummaryEntryV1(entry))scheduleQuizHistorySummarySaveV1();if(addQuizTargetSummaryEntryV80(entry))scheduleQuizTargetSummarySaveV80();document.dispatchEvent(new CustomEvent('ani-quiz-history-updated-v51'))}
function recordQuizHistoryV51(song,correct,submittedAnswer,elapsed,label,target='unknown'){if(!song)return;if(!quizHistoryCurrentRoundV51)beginQuizHistoryRoundV51();const isEmq=!!window.__aniEmqAPI?.isSong?.(song[1]);const a=isEmq?(window.__aniEmqAPI?.getWorkSummary?.(song[0])||null):byAnime.get(song[0]);const targetKey=['anime','title','artist'].includes(target)?target:'unknown';const workTitle=String(a?.[1]||'未知作品'),workAlt=String(a?.[2]||workTitle);const entry={id:'qh'+Date.now()+'-'+Math.random().toString(36).slice(2,8),roundId:quizHistoryCurrentRoundV51,roundNo:quizHistoryRoundSerialV51,at:new Date().toISOString(),songId:String(song[1]),animeId:String(song[0]),source:isEmq?'emq':'amq',workKind:isEmq?'visual_novel_game':'anime',workTitle,workAliases:isEmq?(window.__aniEmqAPI?.getAliases?.(song[1])?.work||[]):[],songName:String(song[4]||'未命名歌曲'),artist:String(song[5]||'歌手未標示'),animeEnglish:workTitle,animeRomaji:workAlt,target:targetKey,validAudio:true,correct:!!correct,answer:String(submittedAnswer||''),elapsed:Number.isFinite(elapsed)&&elapsed>=0?elapsed:null,result:String(label||'')};saveQuizHistoryV51(entry)}

function st(id){const raw=status[id];if(raw===undefined)return 0;if(raw===null||raw==='')return null;let n=null;if(typeof raw==='number'&&Number.isFinite(raw))n=raw;else if(typeof raw==='string'&&/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(raw.trim()))n=Number(raw);return n!==null&&Number.isInteger(n)&&n>=0&&n<=3?n:null}function statsFor(aid){const list=songMap.get(aid)||[];let heard=0,known=0,instant=0;for(const s of list){const n=st(s[1]);if(n>=1)heard++;if(n>=2)known++;if(n>=3)instant++}return {total:list.length,heard,known,instant,progress:list.length?heard/list.length:0}}
function allStats(){let heard=0,known=0,explored=0,series=0;for(const s of songs){const n=st(s[1]);if(n>=1)heard++;if(n>=2)known++}for(const a of anime){const x=statsFor(a[0]);if(x.heard)explored++;if(x.total&&x.heard===x.total)series++}return {heard,known,explored,series}}
function updateStats(){const x=allStats();document.getElementById('collected').innerHTML=`${x.heard.toLocaleString()} <small>/ ${songs.length.toLocaleString()} 首</small>`;document.getElementById('mainProgress').style.width=(x.heard/Math.max(1,songs.length)*100)+'%';document.getElementById('percent').textContent=(x.heard/Math.max(1,songs.length)*100).toFixed(2)+'% 已認識';document.getElementById('animeCollected').textContent=x.explored.toLocaleString()+' 部作品';document.getElementById('heardCount').textContent=x.heard.toLocaleString();document.getElementById('knownCount').textContent=x.known.toLocaleString();document.getElementById('seriesCount').textContent=x.series.toLocaleString()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function colors(a){let n=Math.abs((a[0]*9301+49297)%233280)/233280,h=Math.floor(n*360);return [`hsl(${h} 77% 84%)`,`hsl(${(h+75)%360} 75% 79%)`]}
/* V6 cover loader: cached by MAL ID and loaded lazily to avoid hammering the image API. */
let aniCoverCacheV6={};try{aniCoverCacheV6=JSON.parse(localStorage.getItem('aniCoverCacheV12')||'{}')}catch(e){}
const coverQueueV6=[];let coverBusyV6=false;
function coverCacheSaveV6(){try{localStorage.setItem('aniCoverCacheV12',JSON.stringify(aniCoverCacheV6))}catch(e){}}
function applyCoverV6(img,url,alternate=''){
 if(!img||!url)return;
 img.onload=()=>{img.classList.add('realcover');img.dataset.coverDone='1';img.dataset.coverQueued='';img.dataset.coverFailed='';img.dataset.altCoverUrl='';if(img.id==='detailCover')img.classList.add('ready');if(typeof coverDiagV10!=='undefined'){coverDiagV10.ok++;if(typeof updateCoverStatusV10==='function')updateCoverStatusV10()}};
 img.onerror=()=>{
  if(alternate&&img.dataset.altTried!=='1'){img.dataset.altTried='1';img.src=alternate;return}
  img.classList.remove('ready');img.style.display='none';img.removeAttribute('src');img.dataset.coverDone='';img.dataset.coverQueued='';img.dataset.coverFailed='1';
  const badKey=img.dataset.ann;if(badKey&&aniCoverCacheV6[badKey]){delete aniCoverCacheV6[badKey];coverCacheSaveV6()}
  if(typeof coverDiagV10!=='undefined'){coverDiagV10.fail++;if(typeof updateCoverStatusV10==='function')updateCoverStatusV10('已取得封面網址，但圖片本身載入失敗。可重試；若 ANN 圖片也失敗，可能是外部圖片伺服器限制。')}
 };
 img.dataset.altTried='';img.referrerPolicy='no-referrer';img.style.display='block';img.src=url;if(img.id==='detailCover')img.style.display='block';
}
function queueCoverV6(a,img){
 if(!img||!a)return;
 const ann=Number(a[0]);img.dataset.ann=String(ann||'');img.dataset.mal=String(Number(a[6])||'');
 if(!ann){img.dataset.coverDone='1';return}
 const key=String(ann),cached=aniCoverCacheV6[key];
 if(cached&&cached.url&&cached.until>Date.now()){applyCoverV6(img,cached.url,cached.alternate||'');return}
 // Negative results are not authoritative: ANN can return partial data or transient failures.
 // Retry them when a card is rendered again instead of hiding covers for 30 minutes.
 if(img.dataset.coverQueued==='1')return;
 img.dataset.coverQueued='1';img.dataset.coverDone='';coverQueueV6.push({ann,key,img,aid:a[0],mal:Number(a[6])||0});processCoverQueueV6()
}

let coverQueueTimerV12=null;
function processCoverQueueV6(){if(coverQueueTimerV12||coverBusyV6)return;coverQueueTimerV12=setTimeout(()=>{coverQueueTimerV12=null;processCoverQueueV12()},180)}
let catalogModeV6='grid',renderLimitV6=180;try{catalogModeV6=localStorage.getItem('aniCatalogModeV6')||'grid'}catch(e){}
function applyCatalogModeV6(){const g=document.getElementById('grid');if(g)g.classList.toggle('catalog-list',catalogModeV6==='list');document.querySelectorAll('.viewMode').forEach(b=>b.classList.toggle('active',b.dataset.mode===catalogModeV6))}
document.querySelectorAll('.viewMode').forEach(b=>b.addEventListener('click',()=>{catalogModeV6=b.dataset.mode;try{localStorage.setItem('aniCatalogModeV6',catalogModeV6)}catch(e){}applyCatalogModeV6();render()}));




function makeSongRow(s){const row=document.createElement('div');row.className='songrow';row.dataset.id=s[1];const type=typeNames[s[2]]||'歌曲';row.innerHTML=`<div class="songnum">${String(s[3]||'•').padStart(2,'0')}</div><div><div class="songname">${esc(s[4]||'未命名歌曲')}</div><div class="songmeta">${esc(s[5]||'歌手未標示')} · ${type}${s[6]?' · 難度 '+s[6]:''}</div></div><div class="songactions"><button class="statusbtn listenBtn" data-act="listen">▶ 聽歌</button><button class="statusbtn blacklistSongBtnV51 ${isBlacklistedSongV51(s[1])?'on':''}" data-blacklist="1">${isBlacklistedSongV51(s[1])?'解除黑單':'加入黑單'}</button>${[['聽過',1],['有印象',2],['秒答',3]].map(([label,n])=>`<button class="statusbtn ${st(s[1])===n?'on':''}" data-s="${n}">${label}</button>`).join('')}<button class="statusbtn ${st(s[1])===0?'on':''}" data-s="0">重設</button></div>`;row.querySelector('[data-act="listen"]').addEventListener('click',()=>listenSong(s));const blacklistBtnV51=row.querySelector('[data-blacklist]');if(blacklistBtnV51)blacklistBtnV51.addEventListener('click',()=>{const next=!isBlacklistedSongV51(s[1]);setBlacklistedSongV51(s[1],next);blacklistBtnV51.textContent=next?'解除黑單':'加入黑單';blacklistBtnV51.classList.toggle('on',next);toast(next?'已加入黑名單，之後不會隨機抽到':'已解除黑名單，歌曲可重新參與抽選')});row.querySelectorAll('button[data-s]').forEach(b=>b.addEventListener('click',()=>{const n=Number(b.dataset.s);if(n===0)delete status[s[1]];else status[s[1]]=n;save();row.querySelectorAll('button[data-s]').forEach(x=>x.classList.toggle('on',Number(x.dataset.s)===st(s[1])));refreshDetail();updateStats();render()}));return row}
function renderArtists(){
 const q=document.getElementById('search').value.trim().toLowerCase();
 const groups=new Map();
 for(const song of songs){const artist=String(song[5]||'').trim();if(!artist)continue;let g=groups.get(artist);if(!g){g={name:artist,songs:[],anime:new Set(),heard:0};groups.set(artist,g)}g.songs.push(song);g.anime.add(song[0]);if(st(song[1])>=1)g.heard++}
 let arr=[...groups.values()].filter(g=>!q||g.name.toLowerCase().includes(q)||g.songs.some(song=>String(song[4]||'').toLowerCase().includes(q)));
 const sort=document.getElementById('sort').value;if(sort==='songs')arr.sort((a,b)=>b.songs.length-a.songs.length);else arr.sort((a,b)=>a.name.localeCompare(b.name,'ja'));
 const grid=document.getElementById('grid');grid.innerHTML='';visible=[];
 const limit=renderLimitV6||180;
 for(const g of arr.slice(0,limit)){const hue=Math.abs([...g.name].reduce((n,ch)=>n+ch.charCodeAt(0),0))%360;const el=document.createElement('button');el.className='card artistCard';el.innerHTML=`<div class="cover" style="--c1:hsl(${hue} 75% 84%);--c2:hsl(${(hue+65)%360} 70% 77%)"><span class="coverFallback">🎤</span><span class="symbol">♫</span><span class="year">${g.anime.size} 部作品</span><span class="sticker">${g.heard}/${g.songs.length}</span></div><div class="cardbody"><div class="cardtitle">${esc(g.name)}</div><div class="sub">${g.songs.length} 首收錄歌曲</div><div class="cardfoot"><span class="pill">已聽過 ${g.heard} 首</span><span class="pill">${g.anime.size} 部作品</span></div><div class="tinybar"><span style="width:${g.songs.length?g.heard/g.songs.length*100:0}%"></span></div></div>`;el.addEventListener('click',()=>openArtist(g));grid.appendChild(el)}
 applyCatalogModeV6();document.getElementById('empty').classList.toggle('hidden',arr.length!==0);document.getElementById('resultCount').textContent=`${arr.length.toLocaleString()} 位歌手`+(arr.length>limit?` · 顯示前 ${limit} 位`:'');document.getElementById('sectionTitle').textContent='歌手索引';document.getElementById('sectionDesc').textContent='';const more=document.getElementById('loadMoreBtn');if(more)more.textContent=arr.length>limit?`再顯示 ${Math.min(180,arr.length-limit)} 位歌手`:'已顯示全部歌手';if(more)more.disabled=arr.length<=limit;const counter=document.getElementById('gridCounter');if(counter)counter.textContent=`目前顯示 ${Math.min(limit,arr.length).toLocaleString()} / ${arr.length.toLocaleString()}`;
}
function openArtist(g){
 currentId=null;
 document.getElementById('detailTitle').textContent=g.name;document.getElementById('detailSub').textContent='歌手索引 · 依 AniSongDB 收錄歌曲整理';
 const known=g.songs.filter(s=>st(s[1])>=2).length,instant=g.songs.filter(s=>st(s[1])>=3).length;
 document.getElementById('detailStats').innerHTML=`<span class="pill">${g.songs.length} 首歌曲</span><span class="pill">${g.anime.size} 部作品</span><span class="pill">${known} 首有印象</span><span class="pill">${instant} 首能秒答</span>`;
 const box=document.getElementById('songlist');box.innerHTML='';const list=[...g.songs].sort((a,b)=>String(a[4]||'').localeCompare(String(b[4]||''),'ja'));for(const song of list)box.appendChild(makeSongRow(song));
 document.getElementById('overlay').classList.add('open');document.body.style.overflow='hidden';
}
function openAnime(id){currentId=id;const a=byAnime.get(id),list=songMap.get(id)||[],x=statsFor(id);document.getElementById('detailTitle').textContent=a[1];document.getElementById('detailSub').textContent=[a[2],a[3],a[4]].filter(Boolean).join(' · ');const dc=document.getElementById('detailCover');if(dc){dc.removeAttribute('src');dc.classList.remove('ready');dc.dataset.ann=String(a[0]||'');dc.dataset.mal=String(a[6]||'');dc.dataset.coverDone='';dc.dataset.coverQueued='';dc.style.display='block';if(a[0]){const ck=String(a[0]),cc=aniCoverCacheV6[ck];if(cc?.url&&cc.until>Date.now())applyCoverV6(dc,cc.url,cc.alternate||'');else queueCoverV6(a,dc)}}document.getElementById('detailStats').innerHTML=`<span class="pill">${x.total} 首歌曲</span><span class="pill">${x.heard} 首已認識</span><span class="pill">${x.instant} 首能秒答</span>`;const box=document.getElementById('songlist');box.innerHTML='';if(!list.length)box.innerHTML='<div class="empty">這部作品目前沒有收錄歌曲。</div>';for(const s of list)box.appendChild(makeSongRow(s));document.getElementById('overlay').classList.add('open');document.body.style.overflow='hidden'}
function refreshDetail(){if(!currentId)return;const x=statsFor(currentId);document.getElementById('detailStats').innerHTML=`<span class="pill">${x.total} 首歌曲</span><span class="pill">${x.heard} 首已認識</span><span class="pill">${x.instant} 首能秒答</span>`}
function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');if(window.__aniToastHideTimerV82_14!==undefined&&window.__aniToastHideTimerV82_14!==null)clearTimeout(window.__aniToastHideTimerV82_14);window.__aniToastHideTimerV82_14=setTimeout(()=>{el.classList.remove('show');window.__aniToastHideTimerV82_14=null},2600)}
const AUDIO_UNAVAILABLE_KEY_V857='aniAudioUnavailableSongsV857';
function audioUnavailableRowsV857(){try{const o=JSON.parse(localStorage.getItem(AUDIO_UNAVAILABLE_KEY_V857)||'{}');return o&&typeof o==='object'&&!Array.isArray(o)?o:{}}catch{return {}}}
function audioFilesV857(song){try{return mediaFiles(song).filter(x=>x.kind==='audio').map(x=>String(x.file||'').trim()).filter(Boolean)}catch{return []}}
function audioSignatureV857(song){return JSON.stringify(audioFilesV857(song).slice().sort())}
function audioEligibleV857(song){if(!song||song[1]==null)return false;const files=audioFilesV857(song);if(!files.length)return false;const key=String(song[1]),rows=audioUnavailableRowsV857(),entry=rows[key],signature=audioSignatureV857(song);if(entry&&String(entry.signature||'')===signature)return false;if(entry){delete rows[key];try{localStorage.setItem(AUDIO_UNAVAILABLE_KEY_V857,JSON.stringify(rows))}catch{}}return true}
function markAudioUnavailableV857(song,reason='playback-failed'){if(!song||song[1]==null)return false;const key=String(song[1]),rows=audioUnavailableRowsV857();rows[key]={signature:audioSignatureV857(song),reason:String(reason).slice(0,80),at:new Date().toISOString()};try{localStorage.setItem(AUDIO_UNAVAILABLE_KEY_V857,JSON.stringify(rows));document.dispatchEvent(new CustomEvent('ani-audio-unavailable-v857',{detail:{songId:key,signature:rows[key].signature,reason}}));return true}catch(e){console.warn('Could not save unavailable-audio marker',e);return false}}
window.__aniAudioHealthV857={eligible:audioEligibleV857,markUnavailable:markAudioUnavailableV857,signature:audioSignatureV857,files:audioFilesV857,clearChanged:audioEligibleV857};
function songSourceV857(song){return window.__aniEmqAPI?.isSong?.(song?.[1])?'emq':'amq'}
function songPoolForModeV857(mode){const out=[];if(mode!=='emq')for(const song of songs){if(songSourceV857(song)!=='amq')continue;if(!audioEligibleV857(song)||isBlacklistedSongV51(song[1])||window.__aniIsAnimeWorkBlacklistedV825?.(song[0]))continue;out.push(song)}if(mode!=='amq'&&window.__aniEmqAPI?.ready)for(const song of (window.__aniEmqAPI.getRows?.()||[])){if(!audioEligibleV857(song)||isBlacklistedSongV51(song[1])||window.__aniIsAnimeWorkBlacklistedV825?.(song[0]))continue;out.push(song)}return out}
function randomSong(modeOverride='dock'){let mode=modeOverride;if(mode==='dock'||mode==='discover'||!['amq','mixed','emq'].includes(mode)){const key=mode==='discover'?'aniRandomSourceModeV857:discover':'aniRandomSourceModeV857:dock';try{mode=localStorage.getItem(key)||document.getElementById(mode==='discover'?'discoverSourceModeV857':'dockRandomSourceModeV857')?.value||'amq'}catch{mode='amq'}}if(!['amq','mixed','emq'].includes(mode))mode='amq';const amq=mode==='emq'?[]:songPoolForModeV857('amq'),emq=mode==='amq'?[]:songPoolForModeV857('emq');let chosen=[];if(mode==='amq')chosen=amq;else if(mode==='emq')chosen=emq;else if(amq.length&&emq.length)chosen=Math.random()<2/3?amq:emq;else chosen=amq.length?amq:emq;if(!chosen.length)return null;const unseen=chosen.filter(song=>!st(song[1]));const pool=unseen.length?unseen:chosen;return pool[Math.floor(Math.random()*pool.length)]}
function ensureDiscoveryCardV60(){let card=document.getElementById('discoverCard');if(card)return card;let section=document.querySelector('.discover.view-home');if(!section){const wrap=document.querySelector('.wrap')||document.body;section=document.createElement('section');section.className='discover view-home';section.innerHTML='<div class="discoverTop"><div><h3>歌曲探索</h3></div></div>';wrap.prepend(section)}card=document.createElement('div');card.className='discoverCard';card.id='discoverCard';card.innerHTML='<div class="discArt">♫</div><div><div class="discName">準備好探索了嗎？</div><div class="discMeta">先抽取一首歌曲。</div></div><button class="btn primary" id="discoverListen">播放歌曲 ↗</button>';section.appendChild(card);return card;}
function putSongCoverV857(image,song,work,isEmq){if(!image||!song)return;image.alt=(work?.[1]||'作品')+' 封面';image.loading='lazy';image.style.width='100%';image.style.height='100%';image.style.objectFit='cover';image.onerror=()=>{image.remove()};if(isEmq){Promise.resolve(window.__aniVnCoverAPIv857?.getCoverUrl?.(song[0])).then(url=>{if(url&&image.isConnected)image.src=url}).catch(()=>{});return}if(work&&typeof queueCoverV6==='function'){queueCoverV6(work,image);return}}
function showDiscovery(song){const discoveryCard=ensureDiscoveryCardV60();if(!discoveryCard)return;if(!song){discoverySong=null;discoveryCard.innerHTML='<div class="discArt">♫</div><div><div class="discName">目前來源沒有可播放的歌曲</div><div class="discMeta">可切換 AMQ／混合／EMQ，或更新曲庫與音源。</div></div><button class="btn" id="discAnother">重新抽選 ↻</button>';const retry=document.getElementById('discAnother');if(retry)retry.onclick=()=>showDiscovery(randomSong('discover'));return}discoverySong=song;const isEmq=!!window.__aniEmqAPI?.isSong?.(song[1]),work=isEmq?(window.__aniEmqAPI?.getWorkSummary?.(song[0])||null):byAnime.get(song[0]);discoveryCard.innerHTML=`<div class="discArt">${['♫','✦','♡','✧','♪'][Math.abs(Number(song[1])||0)%5]}</div><div><div class="discName">${esc(song[4]||'未命名歌曲')}</div><div class="discMeta">${esc(song[5]||'歌手未標示')}<br>${esc(work?.[1]||'未知作品')} · ${esc(work?.[5]||'年代未知')} · ${typeNames[song[2]]||'歌曲'}${isEmq?' · EMQ':''}</div><div class="discBtns"><button class="btn primary" id="discPlay">▶ 去聽這首</button><button class="btn" id="discMark">♡ 標記聽過</button><button class="btn" id="discAnime">查看作品</button></div></div><button class="btn" id="discAnother">換一首 ↻</button>`;const art=document.querySelector('#discoverCard .discArt');if(art&&work){const image=document.createElement('img');art.replaceChildren(image);putSongCoverV857(image,song,work,isEmq);if(!isEmq&&image.isConnected){const observer=new MutationObserver(async()=>{if(image.dataset.coverFailed!=='1')return;observer.disconnect();const mal=Number(work[6])||0;if(!mal)return;try{const response=await fetch('https://api.jikan.moe/v4/anime/'+mal);if(!response.ok)throw Error('cover fallback');const data=await response.json();const url=data?.data?.images?.jpg?.large_image_url||data?.data?.images?.webp?.large_image_url||data?.data?.images?.jpg?.image_url;if(url&&image.isConnected)image.src=url}catch{image.remove()}});observer.observe(image,{attributes:true,attributeFilter:['data-cover-failed']})}}const playBtn=document.getElementById('discPlay'),markBtn=document.getElementById('discMark'),workBtn=document.getElementById('discAnime'),anotherBtn=document.getElementById('discAnother');if(playBtn)playBtn.onclick=()=>listenSong(song);if(markBtn)markBtn.onclick=()=>{status[song[1]]=Math.max(1,st(song[1]));save();updateStats();render();toast('已把這首歌放進收藏進度 ♡')};if(workBtn)workBtn.onclick=()=>{if(isEmq&&typeof openQuizFloatingDetailV8239==='function')openQuizFloatingDetailV8239('anime',song[0],workBtn);else openAnime(song[0])};if(anotherBtn)anotherBtn.onclick=()=>showDiscovery(randomSong('discover'))}

document.getElementById('randomBtn')?.addEventListener('click',()=>showDiscovery(randomSong('discover')));document.getElementById('nextDiscover').onclick=()=>showDiscovery(randomSong('discover'));document.getElementById('discoverListen').onclick=()=>{if(!discoverySong)showDiscovery(randomSong('discover'));if(discoverySong)listenSong(discoverySong)};
function initRandomSourceSelectorsV857(){
 const modes={amq:'只聽 AMQ',mixed:'混合',emq:'只聽 EMQ'};
 for(const [id,key] of [['discoverSourceModeV857','aniRandomSourceModeV857:discover'],['dockRandomSourceModeV857','aniRandomSourceModeV857:dock']]){
  const el=document.getElementById(id);if(!el||el.dataset.v857Bound==='1')continue;el.dataset.v857Bound='1';
  let saved='amq';try{saved=localStorage.getItem(key)||'amq'}catch{}
  if(!['amq','mixed','emq'].includes(saved))saved='amq';el.value=saved;
  el.addEventListener('change',()=>{
   const value=['amq','mixed','emq'].includes(el.value)?el.value:'amq';try{localStorage.setItem(key,value)}catch{}
   if(id==='discoverSourceModeV857'){
    const cold=document.getElementById('coldBtn');
    if(cold){cold.disabled=value!=='amq';cold.title=value==='amq'?'從尚未標記且 difficulty 不高於 20 的 AMQ 歌曲中抽選':'低難度篩選只適用 AMQ'}
    showDiscovery(randomSong('discover'));
   }
  });
 }
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initRandomSourceSelectorsV857,{once:true});else initRandomSourceSelectorsV857();
document.addEventListener('ani-app-navigation',()=>initRandomSourceSelectorsV857());

document.getElementById('listenNext').onclick=()=>{if(!currentId)return;const list=(songMap.get(currentId)||[]).filter(s=>!isBlacklistedSongV51(s[1]));if(!list.length)return;let i=currentSong?list.findIndex(s=>s[1]===currentSong[1]):-1;let s=list[(i+1)%list.length];listenSong(s)};document.getElementById('listenRandom').onclick=()=>{if(!currentId)return;const list=(songMap.get(currentId)||[]).filter(s=>!isBlacklistedSongV51(s[1]));if(list.length)listenSong(list[Math.floor(Math.random()*list.length)])};
document.getElementById('search').addEventListener('input',render);['decade','type','sort'].forEach(id=>document.getElementById(id).addEventListener('change',render));document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));tab=b.dataset.tab;render()}));document.getElementById('close').onclick=()=>{document.getElementById('overlay').classList.remove('open');document.body.style.overflow=''};document.getElementById('overlay').addEventListener('click',e=>{if(e.target.id==='overlay'){e.currentTarget.classList.remove('open');document.body.style.overflow=''}});
document.getElementById('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:5,exportedAt:new Date().toISOString(),status,favorites,animeWatch,songTags,playHistory,queueIds,blacklistedSongs:[...blacklistedSongIdsV51],quizHistory:quizHistoryV51},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ani-collection-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);toast('收藏備份已匯出')};document.getElementById('importBtn').onclick=()=>document.getElementById('importFile').click();document.getElementById('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const d=JSON.parse(await f.text()),src=d.status||d;if(!src||typeof src!=='object'||Array.isArray(src))throw Error();for(const [k,v] of Object.entries(src)){if(songs.some(s=>String(s[1])===String(k))){const n=Number(v);if(n>=1&&n<=3)status[k]=n}}if(Array.isArray(d.favorites))favorites=[...new Set([...favorites,...d.favorites])];if(d.animeWatch&&typeof d.animeWatch==='object')Object.assign(animeWatch,d.animeWatch);if(d.songTags&&typeof d.songTags==='object')Object.assign(songTags,d.songTags);if(d.playHistory&&typeof d.playHistory==='object')Object.assign(playHistory,d.playHistory);if(Array.isArray(d.blacklistedSongs)){blacklistedSongIdsV51=new Set([...blacklistedSongIdsV51,...d.blacklistedSongs.map(String)]);try{localStorage.setItem('aniBlacklistedSongs_v1',JSON.stringify([...blacklistedSongIdsV51]))}catch(e){}}if(Array.isArray(d.quizHistory)){quizHistoryV51=[...quizHistoryV51,...d.quizHistory].slice(-2000);try{localStorage.setItem('aniQuizHistory_v1',JSON.stringify(quizHistoryV51))}catch(e){}}if(Array.isArray(d.queueIds))queueIds=[...new Set([...queueIds,...d.queueIds.map(Number)])];save();saveFav();saveObj('aniAnimeWatch_v1',animeWatch);saveObj('aniSongTags_v1',songTags);saveObj('aniPlayHistory_v1',playHistory);saveObj('aniPlayQueue_v1',queueIds);updateStats();render();window.renderWatchlistV5?.();toast('收藏進度已匯入')}catch(err){toast('檔案格式不正確，匯入失敗')}e.target.value=''};
// Database refresh: try live catalog endpoint first; if blocked, allow a catalog_dump.json upload.
function normalizeDump(d){const aa=[];for(const [key,v] of Object.entries(d.anime||{})){const id=Number(key),vt=v.animeVintage||'',m=vt.match(/(\d{4})/),mal=(v.linked_ids||{}).myanimelist||0;aa.push([id,v.animeENName||v.animeJPName||`Anime ${id}`,v.animeJPName||'',vt,v.animeType||v.animeCategory||'',m?Number(m[1]):0,Number(mal)||0])}const ss=(d.songs||[]).map(s=>[Number(s.annId)||0,Number(s.annSongId)||0,Number(s.songType)||0,Number(s.songNumber)||0,s.songName||'',s.songArtist||'',s.songDifficulty!=null&&String(s.songDifficulty).trim()!==''&&Number.isFinite(Number(s.songDifficulty))?Number(s.songDifficulty):null,Number(s.songLength)||0,Number(s.amqSongId)||0,s.audio||'',s.MQ||'',s.HQ||'']);return {anime:aa,songs:ss}}
async function storeDB(db){return new Promise((resolve,reject)=>{const req=indexedDB.open('aniCollectionDB',1);req.onupgradeneeded=()=>req.result.createObjectStore('cache');req.onerror=()=>reject(req.error);req.onsuccess=()=>{const tx=req.result.transaction('cache','readwrite');tx.objectStore('cache').put(db,'catalog');tx.oncomplete=()=>{req.result.close();resolve()};tx.onerror=()=>reject(tx.error)}})}
async function loadDB(){return new Promise((resolve)=>{try{const req=indexedDB.open('aniCollectionDB',1);req.onupgradeneeded=()=>req.result.createObjectStore('cache');req.onerror=()=>resolve(null);req.onsuccess=()=>{const tx=req.result.transaction('cache','readonly'),r=tx.objectStore('cache').get('catalog');r.onsuccess=()=>{req.result.close();resolve(r.result||null)};r.onerror=()=>{req.result.close();resolve(null)}}}catch(e){resolve(null)}})}
function isValidCatalogSnapshotV8239(db){
 if(!db||!Array.isArray(db.anime)||!Array.isArray(db.songs)||!db.anime.length||!db.songs.length)return false;
 const animeIds=new Set(),songIds=new Set();
 for(const row of db.anime){if(!Array.isArray(row)||row.length<2)return false;const id=Number(row[0]);if(!Number.isSafeInteger(id)||id<=0||animeIds.has(String(id))||!String(row[1]??'').trim())return false;animeIds.add(String(id))}
 for(const row of db.songs){if(!Array.isArray(row)||row.length<6)return false;const id=Number(row[1]);if(!Number.isSafeInteger(id)||id<=0||songIds.has(String(id))||!String(row[4]??'').trim())return false;songIds.add(String(id))}
 return true;
}
async function useDB(db){
 if(!isValidCatalogSnapshotV8239(db))throw new Error('曲庫結構不正確，或作品／歌曲 ID 無效、重複');
 const oldSongRows=new Map(songs.map(s=>[String(s[1]),JSON.stringify(s)]));
 const oldAnimeRows=new Map(anime.map(a=>[String(a[0]),JSON.stringify(a)]));
 const nextDB={...db,__catalogMeta:{schemaVersion:1,source:'AniSongDB catalog_dump',updatedAt:new Date().toISOString(),animeCount:db.anime.length,songCount:db.songs.length}};
 // Persist first: a storage failure must not leave only an in-memory update that disappears on reload.
 await storeDB(nextDB);
 DB=nextDB;anime=DB.anime;songs=DB.songs;rebuild();save();updateStats();render();
 const nextSongRows=new Map(songs.map(s=>[String(s[1]),JSON.stringify(s)]));
 const nextAnimeRows=new Map(anime.map(a=>[String(a[0]),JSON.stringify(a)]));
 const addedSongs=[...nextSongRows.keys()].filter(id=>!oldSongRows.has(id)).length;
 const removedSongs=[...oldSongRows.keys()].filter(id=>!nextSongRows.has(id)).length;
 const changedSongs=[...nextSongRows.keys()].filter(id=>oldSongRows.has(id)&&oldSongRows.get(id)!==nextSongRows.get(id)).length;
 const changedAnime=[...nextAnimeRows.keys()].filter(id=>oldAnimeRows.has(id)&&oldAnimeRows.get(id)!==nextAnimeRows.get(id)).length;
 toast(`曲庫已更新並保存：${anime.length.toLocaleString()} 部動畫、${songs.length.toLocaleString()} 首歌曲；新增 ${addedSongs}、移除 ${removedSongs}、修正歌曲 ${changedSongs} 首／動畫 ${changedAnime} 部。玩家進度已保留。`);
}
document.getElementById('updateBtn').onclick=async()=>{const b=document.getElementById('updateBtn');b.disabled=true;b.textContent='更新中…';try{const r=await fetch('https://anisongdb.com/api/catalog_dump',{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const d=await r.json();if(!d.anime||!d.songs)throw Error('格式不符');await useDB(normalizeDump(d))}catch(e){toast('線上更新受阻，請選擇最新 catalog_dump.json');document.getElementById('catalogFile').click()}finally{b.disabled=false;b.textContent='↻ 更新資料庫'}};document.getElementById('catalogFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const d=JSON.parse(await f.text());if(!d.anime||!d.songs)throw Error();await useDB(normalizeDump(d))}catch(err){toast('匯入未完成：格式錯誤或本機保存失敗，原有曲庫保留')}e.target.value=''};
(async()=>{try{const cached=await loadDB();if(isValidCatalogSnapshotV8239(cached)){DB=cached;anime=DB.anime;songs=DB.songs;rebuild()}}catch(e){console.warn('Saved catalog snapshot could not be loaded; using the embedded catalog.',e)}updateStats();render();showDiscovery(randomSong('discover'));})();


/* === Collection room v6: in-page player, list sync, batch actions, discovery === */
let animeWatch=loadObj('aniAnimeWatch_v1',{}), songTags=loadObj('aniSongTags_v1',{}), playHistory=loadObj('aniPlayHistory_v1',{}), queueIds=loadArr('aniPlayQueue_v1'), selectionMode=false, selectedAnime=new Set(), renderLimit=180, aniListTokenLive='', aniListUserLive='', lastPlayIndex=-1, audioFallbackIndex=0, currentPlayingId=null;
const audioEl=document.getElementById('audioPlayer');
const audioHosts=['https://nawdist.animemusicquiz.com/','https://naedist.animemusicquiz.com/','https://eudist.animemusicquiz.com/'];
function loadObj(k,d){try{const v=JSON.parse(localStorage.getItem(k)||'null');return v&&typeof v==='object'&&!Array.isArray(v)?v:d}catch(e){return d}}
function loadArr(k){try{const v=JSON.parse(localStorage.getItem(k)||'[]');return Array.isArray(v)?v:[]}catch(e){return []}}
function saveObj(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){toast('儲存空間不足，請先匯出完整備份')}}
function watchStatus(id){return animeWatch[String(id)]?.status||'none'}
function setWatchStatus(id,stt,source='manual'){if(stt==='none')delete animeWatch[String(id)];else animeWatch[String(id)]={status:stt,source,updatedAt:new Date().toISOString()};saveObj('aniAnimeWatch_v1',animeWatch)}
const watchNames={completed:'看過',current:'正在看',planning:'想看',paused:'暫停',dropped:'棄番',repeating:'重看中'};
function statusMap(s){return ({COMPLETED:'completed',CURRENT:'current',PLANNING:'planning',PAUSED:'paused',DROPPED:'dropped',REPEATING:'repeating'})[String(s||'').toUpperCase()]||'none'}
function getSong(id){return songs.find(s=>String(s[1])===String(id))||window.__aniEmqAPI?.getRow?.(id)||null}
function findAnimeByMal(mal){return anime.find(a=>Number(a[6])===Number(mal))}
function normalizeTitle(t){return String(t||'').toLowerCase().normalize('NFKC').replace(/[\s\p{P}\p{S}]/gu,'')}
function findAnimeByTitle(title){const n=normalizeTitle(title);if(!n)return null;return anime.find(a=>[a[1],a[2]].some(t=>normalizeTitle(t)===n))||null}
function showSyncStatus(t){document.getElementById('syncStatus').textContent=t}
function openSync(){document.getElementById('syncModal').classList.add('open')}
function closeSync(){document.getElementById('syncModal').classList.remove('open')}
document.getElementById('syncOpenBtn').onclick=openSync;document.getElementById('syncCloseBtn').onclick=closeSync;
document.getElementById('syncModal').addEventListener('click',e=>{if(e.target.id==='syncModal')closeSync()});

// Audio filenames come from AniSongDB; AMQ media mirrors serve the corresponding files.
const videoEl=document.getElementById('videoPlayer');let mediaCandidates=[],mediaCandidateIndex=0,mediaHostIndex=0;
function mediaFiles(s){if(window.__aniEmqAPI?.isSong?.(s?.[1]))return (window.__aniEmqAPI.getAudioUrls(s[1])||[]).map(file=>({file,kind:'audio',direct:true}));const out=[];for(const [file,kind] of [[s?.[9],'audio'],[s?.[10],'video'],[s?.[11],'video']]){const f=String(file||'').split('/').pop().trim();if(f&&!out.some(x=>x.file===f))out.push({file:f,kind})}return out}
function setDockStatus(t){document.getElementById('dockStatus').textContent=t}
function updateDock(song){const isEmq=!!(song&&window.__aniEmqAPI?.isSong?.(song[1])),work=song?(isEmq?window.__aniEmqAPI?.getWorkSummary?.(song[0]):byAnime.get(song[0])):null;document.getElementById('dockTitle').textContent=song?(song[4]||'未命名歌曲'):'動畫歌播放器已準備好';document.getElementById('dockSubtitle').textContent=song?[song[5],work?.[1],typeNames[song[2]]||'歌曲'].filter(Boolean).join(' · '):'選擇歌曲即可在本頁播放';document.getElementById('playerTitle').textContent=song?(song[4]||'未命名歌曲'):'選一首歌開始探索';document.getElementById('playerSub').textContent=song?[song[5],work?.[1],typeNames[song[2]]||'歌曲'].filter(Boolean).join(' · '):'使用本頁播放器播放歌曲';const cover=document.getElementById('dockCoverV33');if(cover){cover.hidden=true;cover.removeAttribute('src');if(song&&work&&!document.body.classList.contains('quiz-mode')){cover.alt=(work[1]||'作品')+' 封面';const serial=String(song[1]);const show=url=>{if(url&&cover.isConnected&&String(currentSong?.[1])===serial){cover.onload=()=>{cover.hidden=false};cover.onerror=()=>{cover.hidden=true};cover.src=url}};if(isEmq)Promise.resolve(window.__aniVnCoverAPIv857?.getCoverUrl?.(song[0])).then(show).catch(()=>{});else if(typeof queueCoverV6==='function'){cover.addEventListener('load',()=>{cover.hidden=false},{once:true});cover.addEventListener('error',()=>{cover.hidden=true},{once:true});queueCoverV6(work,cover)}}}const detailDisc=document.querySelector('.playerDisc');if(detailDisc){detailDisc.replaceChildren();detailDisc.textContent='♫';detailDisc.style.background='conic-gradient(#ff8fba,#c3a8ff,#a0e8d4,#ff8fba)';if(song&&work){const img=document.createElement('img');img.alt=(work[1]||'作品')+' 封面';img.loading='lazy';img.style.cssText='width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block';img.onerror=()=>{img.remove();detailDisc.textContent='♫'};detailDisc.replaceChildren(img);if(isEmq)Promise.resolve(window.__aniVnCoverAPIv857?.getCoverUrl?.(song[0])).then(url=>{if(url&&img.isConnected)img.src=url}).catch(()=>{});else if(typeof queueCoverV6==='function'){const proxy={...detailDisc};queueCoverV6(work,img)}}}document.querySelectorAll('[data-dock-status]').forEach(b=>{const n=Number(b.dataset.dockStatus);b.classList.toggle('on',!!song&&st(song[1])===n);b.disabled=!song})}
let mediaSelectionSerialV80=0,mediaHistoryRecordedSerialV80=-1,currentMediaElementV80=null,currentMediaAutoPlayV8262=true;let mediaFallbackTimerV8261=0,mediaFallbackTokenV8261=0;function clearMediaFallbackTimerV8261(){if(mediaFallbackTimerV8261){clearTimeout(mediaFallbackTimerV8261);mediaFallbackTimerV8261=0}mediaFallbackTokenV8261++}
function startMediaCandidate(){clearMediaFallbackTimerV8261();const token=++mediaFallbackTokenV8261;if(!currentSong||!mediaCandidates.length){setDockStatus('沒有可用的音訊或影片檔名；請嘗試其他歌曲');return}const c=mediaCandidates[mediaCandidateIndex];const url=c.direct?c.file:audioHosts[mediaHostIndex]+encodeURIComponent(c.file);const el=c.kind==='audio'?audioEl:videoEl;currentMediaElementV80=el;if(c.kind==='audio'){videoEl.pause();videoEl.removeAttribute('src');videoEl.style.display='none';audioEl.style.display='block'}else{audioEl.pause();audioEl.removeAttribute('src');audioEl.style.display='none';videoEl.style.display='block'}el.src=url;setDockStatus(`載入${c.kind==='audio'?'音訊':'影片音軌'} · 備援來源 ${mediaCandidateIndex+1}/${mediaCandidates.length}${c.direct?'':' · 鏡像 '+(mediaHostIndex+1)+'/'+audioHosts.length}`);el.addEventListener('canplay',()=>{if(token===mediaFallbackTokenV8261)clearMediaFallbackTimerV8261()},{once:true});el.addEventListener('playing',()=>{if(token===mediaFallbackTokenV8261)clearMediaFallbackTimerV8261()},{once:true});mediaFallbackTimerV8261=setTimeout(()=>{if(token!==mediaFallbackTokenV8261||!currentSong||currentMediaElementV80!==el)return;if(el.readyState<2){setDockStatus('此音源載入逾時，正在嘗試下一個備援來源…');advanceMediaFallback()}else clearMediaFallbackTimerV8261()},12000);el.load();const sourceUrl=url;if(!currentMediaAutoPlayV8262){setDockStatus('音源已載入，請按播放器播放鍵開始');return}const p=el.play();if(p&&p.catch)p.catch(err=>{if(el.src!==sourceUrl)return;if(err?.name==='NotAllowedError'){clearMediaFallbackTimerV8261();setDockStatus('瀏覽器尚未允許自動播放；請按播放器播放鍵。');if(document.body.classList.contains('quiz-mode')){const manual=document.getElementById('quizManualPlayV8262');if(manual){manual.hidden=false;manual.disabled=false}}}else if(!el.error){setDockStatus('此音源無法啟動，正在嘗試下一個備援來源…');advanceMediaFallback()}})}
function advanceMediaFallback(){clearMediaFallbackTimerV8261();if(mediaCandidates[mediaCandidateIndex]?.direct){if(mediaCandidateIndex<mediaCandidates.length-1){mediaCandidateIndex++;mediaHostIndex=0;startMediaCandidate();return}markAudioUnavailableV857(currentSong,'all-direct-audio-candidates-failed');setDockStatus('這首歌的所有音源均無法載入，已暫時排除。');document.getElementById('playerSub').textContent='來源網址變更後會自動重新納入候選。';if(document.body.classList.contains('quiz-mode')){const audioState=document.getElementById('quizAudioState');if(audioState)audioState.textContent='音源候選全部失敗，本題已標記為暫時不可用。';window.__aniQuizHandleAudioFailureV857?.(currentSong)}return}if(mediaHostIndex<audioHosts.length-1){mediaHostIndex++;startMediaCandidate();return}if(mediaCandidateIndex<mediaCandidates.length-1){mediaCandidateIndex++;mediaHostIndex=0;startMediaCandidate();return}markAudioUnavailableV857(currentSong,'all-audio-video-mirrors-failed');setDockStatus('音訊來源均無法播放，已暫時排除這首歌。');document.getElementById('playerSub').textContent='來源網址／曲庫更新後會自動重新檢查。';if(document.body.classList.contains('quiz-mode'))window.__aniQuizHandleAudioFailureV857?.(currentSong)}
function recordSuccessfulPlaybackV80(el){if(!currentSong||el!==currentMediaElementV80||mediaHistoryRecordedSerialV80===mediaSelectionSerialV80)return false;const key=String(currentSong[1]),prior=playHistory[key],next={...(prior&&typeof prior==='object'?prior:{}),count:Math.max(0,Number(prior?.count)||0)+1,lastPlayed:new Date().toISOString()};playHistory[key]=next;try{localStorage.setItem('aniPlayHistory_v1',JSON.stringify(playHistory))}catch(e){if(prior===undefined)delete playHistory[key];else playHistory[key]=prior;toast('播放紀錄儲存失敗，請檢查瀏覽器儲存空間');mediaHistoryRecordedSerialV80=mediaSelectionSerialV80;return false}mediaHistoryRecordedSerialV80=mediaSelectionSerialV80;if(currentId)refreshDetail();document.dispatchEvent(new CustomEvent('ani-song-playback-recorded-v80',{detail:{songId:key,at:next.lastPlayed}}));return true}
function listenSong(s,options={}){if(!s)return;currentMediaAutoPlayV8262=typeof options?.autoPlay==='boolean'?options.autoPlay:true;currentSong=s;currentPlayingId=String(s[1]);mediaSelectionSerialV80++;mediaHistoryRecordedSerialV80=-1;currentMediaElementV80=null;updateDock(s);if(queueIds.length){const ix=queueIds.indexOf(Number(s[1]));lastPlayIndex=ix>=0?ix:lastPlayIndex}mediaCandidates=mediaFiles(s);mediaCandidateIndex=0;mediaHostIndex=0;audioEl.pause();videoEl.pause();if(mediaCandidates.length)startMediaCandidate();else setDockStatus('這首歌沒有可用的音訊檔名，請嘗試其他歌曲');if(currentId)refreshDetail()}
audioEl.addEventListener('error',()=>{if(currentSong&&mediaCandidates[mediaCandidateIndex]?.kind==='audio')advanceMediaFallback()});videoEl.addEventListener('error',()=>{if(currentSong&&mediaCandidates[mediaCandidateIndex]?.kind==='video')advanceMediaFallback()});
function hideQuizManualPlayButtonV8262(){const button=document.getElementById('quizManualPlayV8262');if(button){button.hidden=true;button.disabled=false;button.textContent='▶ 播放音訊'}}audioEl.addEventListener('playing',()=>{currentMediaAutoPlayV8262=true;hideQuizManualPlayButtonV8262();setDockStatus(window.__aniEmqAPI?.isSong?.(currentSong?.[1])?'正在播放 · EMQ 音訊來源':'正在播放 · AMQ 音訊鏡像');recordSuccessfulPlaybackV80(audioEl)});videoEl.addEventListener('playing',()=>{currentMediaAutoPlayV8262=true;hideQuizManualPlayButtonV8262();setDockStatus('正在播放 · AMQ 影片鏡像');recordSuccessfulPlaybackV80(videoEl)});audioEl.addEventListener('pause',()=>{if(!audioEl.ended&&audioEl.style.display!=='none')setDockStatus('已暫停')});videoEl.addEventListener('pause',()=>{if(!videoEl.ended&&videoEl.style.display!=='none')setDockStatus('已暫停')});audioEl.addEventListener('ended',()=>{if(!document.body.classList.contains('quiz-mode')&&!document.body.classList.contains('relations-mode'))playNext()});videoEl.addEventListener('ended',()=>{if(!document.body.classList.contains('quiz-mode')&&!document.body.classList.contains('relations-mode'))playNext()});
document.getElementById('playPauseBtn').onclick=()=>{if(!currentSong){const s=queueIds.length?getSong(queueIds[0]):randomSong('dock');if(s)listenSong(s);return}const el=videoEl.style.display!=='none'?videoEl:audioEl;if(el.paused)el.play().catch(()=>{});else el.pause()};
function playNext(){if(!currentSong)return;let next=null;if(queueIds.length){let idx=queueIds.indexOf(Number(currentSong[1]));if(idx<0)idx=-1;for(let i=idx+1;i<queueIds.length;i++){next=getSong(queueIds[i]);if(next)break}}if(!next&&currentId){const l=songMap.get(currentId)||[],i=l.findIndex(x=>String(x[1])===String(currentSong[1]));if(l.length)next=l[(i+1)%l.length]}if(!next)next=randomSong('dock');if(next)listenSong(next)}
function playPrevious(){if(!currentSong)return;let prev=null;if(queueIds.length){let idx=queueIds.indexOf(Number(currentSong[1]));if(idx>0)prev=getSong(queueIds[idx-1])}if(!prev&&currentId){const l=songMap.get(currentId)||[],i=l.findIndex(x=>String(x[1])===String(currentSong[1]));if(l.length)prev=l[(i<=0?l.length:i)-1]}if(prev)listenSong(prev)}
document.getElementById('nextSongBtn').onclick=playNext;document.getElementById('prevSongBtn').onclick=playPrevious;
function addQueue(s){if(!s)return;const id=Number(s[1]);if(!queueIds.includes(id))queueIds.push(id);saveObj('aniPlayQueue_v1',queueIds);toast('已加入待聽佇列');renderQueue()}
function removeQueue(id){queueIds=queueIds.filter(x=>Number(x)!==Number(id));saveObj('aniPlayQueue_v1',queueIds);renderQueue()}
function renderQueue(){const box=document.getElementById('queueList');if(!box)return;box.innerHTML='';if(!queueIds.length){box.innerHTML='<div class="empty">待聽佇列目前是空的。</div>';return}queueIds.forEach((id,i)=>{const s=getSong(id);if(!s)return;const isEmq=!!window.__aniEmqAPI?.isSong?.(s[1]),a=isEmq?window.__aniEmqAPI?.getWorkSummary?.(s[0]):byAnime.get(s[0]);const row=document.createElement('div');row.className='songrow';row.innerHTML=`<div class="songnum">${i+1}</div><div><div class="songname">${esc(s[4]||'未命名歌曲')}</div><div class="songmeta">${esc(s[5]||'歌手未標示')} · ${esc(a?.[1]||'未知作品')}${isEmq?' · EMQ':''}</div></div><div class="songactions"><button class="statusbtn" data-play>▶ 播放</button><button class="statusbtn" data-up>↑</button><button class="statusbtn" data-down>↓</button><button class="statusbtn" data-remove>移除</button></div>`;row.querySelector('[data-play]').onclick=()=>listenSong(s);row.querySelector('[data-remove]').onclick=()=>removeQueue(id);row.querySelector('[data-up]').onclick=()=>{if(i>0){[queueIds[i-1],queueIds[i]]=[queueIds[i],queueIds[i-1]];saveObj('aniPlayQueue_v1',queueIds);renderQueue()}};row.querySelector('[data-down]').onclick=()=>{if(i<queueIds.length-1){[queueIds[i+1],queueIds[i]]=[queueIds[i],queueIds[i+1]];saveObj('aniPlayQueue_v1',queueIds);renderQueue()}};box.appendChild(row)})}
document.getElementById('queueBtn').onclick=()=>{renderQueue();document.getElementById('queueModal').classList.add('open')};document.getElementById('queueCloseBtn').onclick=()=>document.getElementById('queueModal').classList.remove('open');document.getElementById('queueModal').addEventListener('click',e=>{if(e.target.id==='queueModal')e.currentTarget.classList.remove('open')});document.getElementById('clearQueueBtn').onclick=()=>{queueIds=[];saveObj('aniPlayQueue_v1',queueIds);renderQueue()};document.getElementById('playQueueBtn').onclick=()=>{const s=getSong(queueIds[0]);if(s){document.getElementById('queueModal').classList.remove('open');listenSong(s)}};

// Extend song rows with queue, personal tags, play history and source fallback.
makeSongRow=function(s){const row=document.createElement('div');row.className='songrow';row.dataset.id=s[1];const type=typeNames[s[2]]||'歌曲';const tag=songTags[String(s[1])]||'',hist=playHistory[String(s[1])];row.innerHTML=`<div class="songnum">${String(s[3]||'•').padStart(2,'0')}</div><div><div class="songname">${esc(s[4]||'未命名歌曲')}</div><div class="songmeta">${esc(s[5]||'歌手未標示')} · ${type}${s[6]?' · 難度 '+s[6]:''}${hist?.count?' · 播放 '+hist.count+' 次':''}</div>${tag?`<div class="songtags">✎ ${esc(tag)}</div>`:''}</div><div class="songactions"><button class="statusbtn listenBtn" data-act="listen">▶ 播放</button><button class="statusbtn queueBtn" data-act="queue">＋佇列</button>${[['聽過',1],['有印象',2],['秒答',3]].map(([label,n])=>`<button class="statusbtn ${st(s[1])===n?'on':''}" data-s="${n}">${label}</button>`).join('')}<details class="songMoreMenuV844"><summary aria-label="更多歌曲操作">更多</summary><div class="songMoreActionsV844"><button class="statusbtn" data-act="tag">編輯標籤</button><button class="statusbtn ${st(s[1])===0?'on':''}" data-s="0">重設熟悉度</button></div></details></div>`;row.querySelector('[data-act="listen"]').onclick=()=>listenSong(s);row.querySelector('[data-act="queue"]').onclick=()=>addQueue(s);row.querySelector('[data-act="tag"]').onclick=()=>{const val=prompt('替這首歌加一個辨識標籤，例如：80年代、電子鼓、男聲熱血、夏日感。留空可刪除。',songTags[String(s[1])]||'');if(val===null)return;if(val.trim())songTags[String(s[1])]=val.trim();else delete songTags[String(s[1])];saveObj('aniSongTags_v1',songTags);document.dispatchEvent(new CustomEvent('ani-song-tag-updated-v80',{detail:{songId:String(s[1]),tag:songTags[String(s[1])]||''}}));openAnime(currentId)};row.querySelectorAll('button[data-s]').forEach(b=>b.addEventListener('click',()=>{const n=Number(b.dataset.s);if(n===0)delete status[s[1]];else status[s[1]]=n;save();row.querySelectorAll('button[data-s]').forEach(x=>x.classList.toggle('on',Number(x.dataset.s)===st(s[1])));refreshDetail();updateStats();render()}));return row};

// Catalog rendering; cover loading is intentionally disabled.
function render(){if(tab==='artists'){renderArtists();return}const q=document.getElementById('search').value.trim().toLowerCase(),dec=document.getElementById('decade').value,typ=document.getElementById('type').value,sort=document.getElementById('sort').value;let arr=anime.filter(a=>{if(typ!=='all'&&a[4]!==typ)return false;if(dec==='pre'&&(!a[5]||a[5]>=1980))return false;if(dec!=='all'&&dec!=='pre'&&(!a[5]||Math.floor(a[5]/10)*10!==Number(dec)))return false;const ss=statsFor(a[0]),ws=watchStatus(a[0]),wf=document.getElementById('watchFilter')?.value||'all';if(wf==='watched'&&ws!=='completed')return false;if(wf==='notwatched'&&ws==='completed')return false;if(wf==='unmarked'&&ws!=='none')return false;if(wf==='current'&&ws!=='current')return false;if(tab==='progress'&&!ss.heard)return false;if(tab==='unexplored'&&ss.heard)return false;const ff=document.getElementById('familiarityFilter')?.value||'all',tf=(document.getElementById('tagFilter')?.value||'').trim().toLowerCase();const animeSongs=songMap.get(a[0])||[];if(ff!=='all'&&!animeSongs.some(s=>ff==='unmarked'?st(s[1])===0:ff==='heard'?st(s[1])===1:ff==='known'?st(s[1])===2:st(s[1])===3))return false;if(tf&&!animeSongs.some(s=>(songTags[String(s[1])]||'').toLowerCase().includes(tf)))return false;if(q){const zhNames=(window.__aniChineseTitleAPIv8237?.getAliases(a[0])||[]).join(' ');const inA=(a[1]+' '+a[2]+' '+a[3]+' '+zhNames).toLowerCase().includes(q);const inS=(songMap.get(a[0])||[]).some(s=>(s[4]+' '+s[5]+' '+(songTags[String(s[1])]||'')).toLowerCase().includes(q));if(!inA&&!inS)return false}return true});if(sort==='name')arr.sort((a,b)=>{const x=String(a[1]||'').toLowerCase(),y=String(b[1]||'').toLowerCase();return x<y?-1:x>y?1:0});else if(sort==='songs')arr.sort((a,b)=>(songMap.get(b[0])||[]).length-(songMap.get(a[0])||[]).length);else if(sort==='progress')arr.sort((a,b)=>statsFor(b[0]).progress-statsFor(a[0]).progress);else if(sort==='random')arr.sort(()=>Math.random()-.5);else arr.sort((a,b)=>(a[5]||9999)-(b[5]||9999)||a[1].localeCompare(b[1]));visible=arr;const grid=document.getElementById('grid');grid.innerHTML='';const subset=arr.slice(0,renderLimit);for(const a of subset){const ss=songMap.get(a[0])||[],x=statsFor(a[0]),c=colors(a),year=a[5]||'年代未知',sym=['♫','✦','♡','✧','♪','✺','◇','☆','♬'][a[0]%9],ws=watchStatus(a[0]);const el=document.createElement('div');el.className='card'+(selectedAnime.has(Number(a[0]))?' selected':'');el.setAttribute('role','button');el.tabIndex=0;el.innerHTML=`<label class="cardSelect" title="選取這部作品"><input type="checkbox" ${selectedAnime.has(Number(a[0]))?'checked':''}> 選取</label><div class="cover" style="--c1:${c[0]};--c2:${c[1]}"><span class="coverFallback">${sym}</span><img class="realcover" alt="${esc(a[1])} 封面" loading="lazy" style="display:block"><button class="cardManage" type="button" aria-label="管理 ${esc(a[1])}" title="快速管理">⋯</button><span class="symbol">${sym}</span><span class="year">${esc(year)} · ${esc(a[4]||'')}</span><span class="sticker">${x.heard?'♡':'✧'}</span></div><div class="cardbody"><div class="cardtitle">${esc(a[1])}</div><div class="sub">${esc(a[2]||a[3]||'作品資料')}</div>${ws!=='none'?`<span class="watchpill ${esc(ws)}">${esc(watchNames[ws]||ws)}</span>`:''}<div class="cardfoot"><span class="pill">♫ ${ss.length} 首</span><span class="pill">${x.heard}/${x.total}</span></div><div class="tinybar"><span style="width:${x.progress*100}%"></span></div></div>`;const cb=el.querySelector('input[type=checkbox]');cb.onchange=e=>{e.stopPropagation();if(e.target.checked)selectedAnime.add(Number(a[0]));else selectedAnime.delete(Number(a[0]));el.classList.toggle('selected',selectedAnime.has(Number(a[0])));updateSelectionHint()};el.onclick=e=>{if(e.target.closest('.cardSelect,.cardManage'))return;if(selectionMode){if(selectedAnime.has(Number(a[0])))selectedAnime.delete(Number(a[0]));else selectedAnime.add(Number(a[0]));render();updateSelectionHint()}else openAnime(a[0])};el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();el.click()}};if(selectionMode)el.classList.add('selectionMode');el.querySelector('.cardManage')?.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();window.__aniOpenPracticeManagerV825?.(a[0])});grid.appendChild(el);const coverImg=el.querySelector('img.realcover');if(coverImg){coverImg.dataset.mal=String(a[6]||'');coverImg.style.display='block';queueCoverV6(a,coverImg)}}document.body.classList.toggle('selectionMode',selectionMode);document.getElementById('empty').classList.toggle('hidden',arr.length!==0);document.getElementById('resultCount').textContent=`${arr.length.toLocaleString()} 部作品`;document.getElementById('loadMoreWrap').style.display=arr.length>renderLimit?'block':'none';document.getElementById('loadMoreBtn').textContent=`再顯示 ${Math.min(180,arr.length-renderLimit)} 部作品`;document.getElementById('gridCounter').textContent=`目前顯示 ${Math.min(arr.length,renderLimit).toLocaleString()} / ${arr.length.toLocaleString()} 部`;document.getElementById('sectionTitle').textContent=tab==='progress'?'已探索作品':tab==='unexplored'?'未探索作品':'動畫圖鑑';document.getElementById('sectionDesc').textContent=tab==='progress'?'至少有一首歌曲已標記為「聽過」的作品；這裡代表探索進度，不是手動收藏。':tab==='unexplored'?'尚未有歌曲標記為「聽過」的作品。':'';updateSelectionHint()}
// Existing render listeners stay attached to the overridden function.
const watchFilter=document.createElement('select');watchFilter.id='watchFilter';watchFilter.innerHTML='<option value="all">所有看番狀態</option><option value="watched">只看已看過</option><option value="notwatched">尚未標記為看完</option><option value="unmarked">只看未標記</option><option value="current">正在看</option>';watchFilter.style.cssText='border:1px solid #e8d7e8;background:#fff;border-radius:10px;padding:9px 10px;color:var(--ink);font:inherit;font-size:12px';document.querySelector('.toolbar').appendChild(watchFilter);
watchFilter.addEventListener('change',()=>{renderLimit=180;renderLimitV6=180;render()});
const familiarityFilter=document.createElement('select');familiarityFilter.id='familiarityFilter';familiarityFilter.innerHTML='<option value="all">所有歌曲熟悉度</option><option value="unmarked">未標記歌曲</option><option value="heard">聽過</option><option value="known">有印象</option><option value="instant">能秒答</option>';familiarityFilter.style.cssText=watchFilter.style.cssText;document.querySelector('.toolbar').appendChild(familiarityFilter);
const tagFilter=document.createElement('input');tagFilter.id='tagFilter';tagFilter.placeholder='篩選自訂標籤…';tagFilter.setAttribute('aria-label','篩選自訂標籤');tagFilter.style.cssText='min-width:145px;max-width:210px;border:1px solid #e8d7e8;background:#fff;border-radius:10px;padding:9px 10px;color:var(--ink);font:inherit;font-size:12px';document.querySelector('.toolbar').appendChild(tagFilter);
const runTagFilters=()=>{renderLimit=180;renderLimitV6=180;render()};familiarityFilter.addEventListener('change',runTagFilters);tagFilter.addEventListener('input',()=>{clearTimeout(window.__tagFilterTimer);window.__tagFilterTimer=setTimeout(runTagFilters,180)});

document.getElementById('loadMoreBtn').onclick=()=>{renderLimit+=180;renderLimitV6=renderLimit;render()};
function updateSelectionHint(){const n=selectedAnime.size;document.getElementById('selectionHint').textContent=selectionMode?`批次選取已開啟：已選 ${n} 部作品。先篩選／搜尋，再按「選取目前顯示」只會選取目前畫面顯示的作品。`:`批次選取未開啟。${n?`目前保留 ${n} 部已選作品。`:''}`;document.getElementById('selectModeBtn').textContent=selectionMode?'✓ 結束批次選取':'□ 批次選取';const scope=document.getElementById('batchScopeSummaryV844');if(scope){let songCount=0;selectedAnime.forEach(id=>{const rows=songMap.get(Number(id))||songMap.get(id)||[];songCount+=rows.length});scope.textContent=n?`已選 ${n.toLocaleString()} 部動畫，共 ${songCount.toLocaleString()} 首收錄歌曲。作品狀態／自訂清單／手動補強影響動畫；熟悉度／待聽／間隔複習影響歌曲。黑名單操作會影響所選作品的所有歌曲。`:'尚未選取作品。選取後會顯示動畫數與歌曲數，並說明各批次動作的作用範圍。'}}
document.getElementById('selectModeBtn').onclick=()=>{selectionMode=!selectionMode;render();updateSelectionHint()};document.getElementById('selectVisibleBtn').onclick=()=>{selectionMode=true;visible.slice(0,renderLimit).forEach(a=>selectedAnime.add(Number(a[0])));render();updateSelectionHint()};document.getElementById('clearSelectionBtn').onclick=()=>{selectedAnime.clear();render();updateSelectionHint()};
document.getElementById('applyBulkWatchBtn').onclick=()=>{if(!selectedAnime.size){toast('請先選取作品');return}const stt=document.getElementById('bulkWatchStatus').value;if(selectedAnime.size>100&&!confirm(`即將批次更新 ${selectedAnime.size} 部作品的看番狀態，確定繼續？`))return;selectedAnime.forEach(id=>setWatchStatus(id,stt));render();toast(`已更新 ${selectedAnime.size} 部作品的看番狀態`)};
document.getElementById('applyBulkSongBtn').onclick=()=>{if(!selectedAnime.size){toast('請先選取作品');return}const n=Number(document.getElementById('bulkSongStatus').value);if(selectedAnime.size>100&&!confirm(`即將批次更新 ${selectedAnime.size} 部作品的全部歌曲熟悉度。這不代表歌曲真的已經學會，確定繼續？`))return;let count=0;selectedAnime.forEach(id=>(songMap.get(id)||[]).forEach(s=>{if(n===0)delete status[s[1]];else status[s[1]]=n;count++}));save();updateStats();render();toast(`已處理 ${count.toLocaleString()} 首歌曲。記得：這是批次標記，不代表每首真的都聽過。`)};
document.getElementById('queueSelectedBtn').onclick=()=>{if(!selectedAnime.size){toast('請先選取作品');return}if(selectedAnime.size>100&&!confirm(`即將把 ${selectedAnime.size} 部作品的歌曲加入待聽佇列，確定繼續？`))return;let n=0;selectedAnime.forEach(id=>(songMap.get(id)||[]).forEach(s=>{if(!queueIds.includes(Number(s[1]))){queueIds.push(Number(s[1]));n++}}));saveObj('aniPlayQueue_v1',queueIds);toast(`已將 ${n.toLocaleString()} 首新歌曲加入待聽佇列`)};

// AniList import. Public lists work without a token; private lists need an access token pasted by the user.
document.getElementById('aniListAuthorizeBtn').onclick=()=>{const id=document.getElementById('aniListClientId').value.trim();if(!id){showSyncStatus('請先填入 AniList Client ID。');return}const u='https://anilist.co/api/v2/oauth/authorize?client_id='+encodeURIComponent(id)+'&response_type=token';window.open(u,'_blank','noopener');showSyncStatus('已開啟 AniList 授權頁。完成授權後，將 access token 複製回此視窗。')};
document.getElementById('aniListImportBtn').onclick=async()=>{const username=document.getElementById('aniListUsername').value.trim();const token=document.getElementById('aniListToken').value.trim();if(!username){showSyncStatus('請先輸入 AniList 使用者 ID 或名稱。');return}aniListTokenLive=token;aniListUserLive=username;showSyncStatus('正在讀取 AniList 清單…');const numericId=/^\d+$/.test(username);const query=numericId?`query ($id: Int) { MediaListCollection(userId: $id, type: ANIME) { lists { entries { status progress media { id idMal title { english romaji native } } } } } }`:`query ($name: String) { MediaListCollection(userName: $name, type: ANIME) { lists { entries { status progress media { id idMal title { english romaji native } } } } } }`;try{const headers={'Content-Type':'application/json','Accept':'application/json'};if(token)headers.Authorization='Bearer '+token;const variables=numericId?{id:Number(username)}:{name:username};const r=await fetch('https://graphql.anilist.co',{method:'POST',headers,body:JSON.stringify({query,variables})});const j=await r.json();if(!r.ok||j.errors)throw Error(j.errors?.map(x=>x.message).join('; ')||`HTTP ${r.status}`);const lists=j.data?.MediaListCollection?.lists||[];let matched=0,unmatched=0,updated=0;const misses=[];for(const list of lists)for(const e of (list.entries||[])){const m=e.media||{};let a=m.idMal?findAnimeByMal(m.idMal):null;if(!a){const titles=[m.title?.english,m.title?.romaji,m.title?.native].filter(Boolean);for(const t of titles){a=findAnimeByTitle(t);if(a)break}}if(a){setWatchStatus(a[0],statusMap(e.status),'AniList');matched++;updated++}else{unmatched++;if(m.title?.english||m.title?.romaji)misses.push(m.title.english||m.title.romaji)}}render();window.renderWatchlistV5?.();showSyncStatus(`匯入完成。\n成功配對：${matched} 部\n未能配對：${unmatched} 部\n\n${misses.slice(0,35).join('\n')}${misses.length>35?'\n…其餘略':''}\n\n只匯入看番狀態，沒有修改歌曲熟悉度。`);toast(`AniList 匯入完成：配對 ${matched} 部作品`)}catch(e){showSyncStatus(`匯入失敗：${e.message}\n\n若是私密清單，請確認 access token 有效；也可能是 API 暫時限流。`)} };

// Public MyAnimeList username import via jikan-edge. The old public Jikan API was discontinued in October 2026.
// This importer accepts a username only; it does not attempt to resolve numeric user IDs.
document.getElementById('malUsernameImportBtn').onclick=async()=>{
  const input=document.getElementById('malUsername');
  const button=document.getElementById('malUsernameImportBtn');
  const username=(input.value||'').trim();
  if(!username){showSyncStatus('請輸入 MyAnimeList 帳號名稱。');return}
  if(/^\d+$/.test(username)){showSyncStatus('這裡只接受 MyAnimeList 帳號名稱，不接受數字 ID。請輸入個人頁網址中的帳號名稱。');return}
  if(!/^[A-Za-z0-9_-]{1,32}$/.test(username)){showSyncStatus('帳號名稱格式不正確。請確認只包含英文字母、數字、底線或連字號，且長度不超過 32 個字元。');return}
  button.disabled=true;button.textContent='正在偵測…';
  try{
    let pageNo=1,entries=[],pages=0;
    const pageSize=300;
    while(pages<100){
      const url=`https://jikan.lucashdo.com/v1/users/${encodeURIComponent(username)}/animelist?page=${pageNo}&limit=${pageSize}`;
      const response=await fetch(url,{headers:{Accept:'application/json'}});
      let payload={};try{payload=await response.json()}catch(_){/* handled below */}
      if(!response.ok){
        const message=payload?.error?.message||payload?.message;
        if(response.status===404)throw Error('找不到此帳號，或該帳號的動畫清單不是公開的。');
        if(response.status===403)throw Error('服務拒絕讀取此清單。請確認清單為公開狀態。');
        if(response.status===429)throw Error('外部資料服務目前限流，請稍後再試。');
        throw Error(message||`外部資料服務回應 HTTP ${response.status}`);
      }
      if(payload?.error)throw Error(payload.error.message||'外部資料服務回報錯誤。');
      const batch=Array.isArray(payload.data)?payload.data:(Array.isArray(payload.data?.data)?payload.data.data:[]);
      entries.push(...batch);pages++;
      if(batch.length<pageSize)break;
      pageNo++;
      await new Promise(resolve=>setTimeout(resolve,1000));
    }
    if(!entries.length)throw Error('沒有讀到任何動畫作品。請確認帳號名稱正確、清單公開，或外部資料服務目前可用。');
    const map={watching:'current',currently_watching:'current',current:'current',completed:'completed',complete:'completed',on_hold:'paused',onhold:'paused',paused:'paused',dropped:'dropped',plan_to_watch:'planning',plantowatch:'planning',planning:'planning'};
    // jikan-edge's response is not schema-identical to Jikan v4. Status may be
    // a string or nested; top-level status may instead describe the anime airing state.
    const normalizeMALStatus=value=>{
      if(value==null)return null;
      const key=String(value).trim().toLowerCase().replace(/[\s-]+/g,'_');
      return map[key]||null;
    };
    const getMALListStatus=entry=>{
      const containers=[entry?.listStatus,entry?.list_status,entry?.myListStatus,entry?.my_list_status,entry?.userListStatus,entry?.user_list_status,entry?.watchStatus,entry?.watch_status,entry?.watchingStatus,entry?.watching_status,entry?.node?.listStatus,entry?.node?.list_status,entry?.anime?.listStatus,entry?.anime?.list_status,entry?.user?.listStatus];
      for(const container of containers){
        if(typeof container==='string'){
          const normalized=normalizeMALStatus(container);if(normalized)return {status:normalized,raw:container};
        }else if(container&&typeof container==='object'){
          for(const key of ['status','watchStatus','watch_status','watchingStatus','watching_status','state']){
            const normalized=normalizeMALStatus(container[key]);if(normalized)return {status:normalized,raw:container[key]};
          }
          if(container.isRewatching===true||container.is_rewatching===true)return {status:'repeating',raw:'rewatching'};
        }
      }
      for(const key of ['watchStatus','watch_status','watchingStatus','watching_status','status']){
        const normalized=normalizeMALStatus(entry?.[key]);
        if(normalized)return {status:normalized,raw:entry[key]};
      }
      if(entry?.isRewatching===true||entry?.is_rewatching===true)return {status:'repeating',raw:'rewatching'};
      return null;
    };
    // Build an exact, normalized title index for local catalog entries. A title is
    // used only when it identifies one unique local anime, avoiding arbitrary matches.
    const titleIndex=new Map();
    for(const a of anime){
      for(const title of [a[1],a[2]]){
        const key=normalizeTitle(title);
        if(!key)continue;
        const ids=titleIndex.get(key)||new Set();ids.add(a[0]);titleIndex.set(key,ids);
      }
    }
    const findUniqueTitleMatch=(titles)=>{
      const candidates=new Set();
      for(const title of titles){
        const key=normalizeTitle(title);if(!key)continue;
        const ids=titleIndex.get(key);
        if(ids&&ids.size===1)for(const id of ids)candidates.add(id);
      }
      if(candidates.size!==1)return null;
      const id=[...candidates][0];return anime.find(a=>String(a[0])===String(id))||null;
    };
    let matched=0,matchedById=0,matchedByTitle=0,unmatched=0,missingStatus=0;const misses=[],missingStatusExamples=[];
    for(const entry of entries){
      const node=entry.node||entry.anime||entry;
      const malId=node.malId||node.mal_id||node.id;
      let item=malId?findAnimeByMal(malId):null;
      let matchMethod='id';
      const titleCandidates=[node.title,node.titleEnglish,node.titleJapanese,node.title_english,node.title_japanese,node.title_romanji,node.titleRomaji].filter(Boolean);
      if(!item){item=findUniqueTitleMatch(titleCandidates);matchMethod='title'}
      if(!item){unmatched++;if(titleCandidates[0])misses.push(titleCandidates[0]);continue}
      const resolvedStatus=getMALListStatus(entry);
      const status=resolvedStatus?.status||null;
      if(!status){missingStatus++;if(missingStatusExamples.length<8){const title=titleCandidates[0]||node.title||'(無標題)';const nested=entry.listStatus??entry.list_status??entry.myListStatus??entry.my_list_status??entry.watchStatus??entry.watch_status;missingStatusExamples.push(`${title} [欄位:${Object.keys(entry||{}).join(',')}; status=${String(entry.status??'∅')}; listStatus=${typeof nested==='object'?JSON.stringify(nested):String(nested??'∅')}]`)}continue}
      setWatchStatus(item[0],status,'MAL');matched++;
      if(matchMethod==='id')matchedById++;else matchedByTitle++;
    }
    render();window.renderWatchlistV5?.();
    showSyncStatus(`MAL 匯入完成：${username}\n讀取作品：${entries.length} 部\n成功匯入：${matched} 部\n  依 MAL ID 配對：${matchedById} 部\n  依作品名稱配對：${matchedByTitle} 部\n未能配對：${unmatched} 部\n狀態無法辨識：${missingStatus} 部\n\n只更新動畫觀看狀態，不會修改歌曲熟悉度。${misses.length?'\n\n未配對範例：\n'+misses.slice(0,25).join('\n'):''}`);
    toast(`MAL 匯入完成：成功匯入 ${matched} 部作品`);
  }catch(error){showSyncStatus(`MAL 使用者清單匯入失敗：${error.message}\n\n目前改用 jikan-edge 讀取公開動畫清單，不再呼叫已停止服務的 api.jikan.moe，也不會把數字 ID 轉換成帳號名稱。若仍失敗，請確認帳號名稱及清單公開設定；外部服務也可能暫時無法使用。`)}
  finally{button.disabled=false;button.textContent='偵測並匯入 MyAnimeList'}
};

// Full backup: app-owned data, including EMQ custom lists/overrides and the FSRS schedule.
document.getElementById('exportBtn').onclick=()=>{try{const allowed=new Set(['aniAmqProfileV1','aniAmqPPRecordsV1','aniAmqProfileRecoveryV1','aniAmqPPRecordsRecoveryV1','aniAnimeAliases_v1','aniAnimeWatch_v1','aniBlacklistedSongs_v1','aniBlacklistedAnime_v1','aniManualWeakAnimeV1','aniCustomPracticeListsV1','aniCustomPracticeListsRecoveryV825','aniManualWeakAnimeRecoveryV825','aniBlacklistedAnimeRecoveryV825','aniCatalogModeV6','aniVNWatchlistV1','aniCollectionThemeV18','aniCollection_v2','aniDockMutedV57','aniDockVolumeV57','aniFavorites_v1','aniLearningPlanProgressV1','aniPlayHistory_v1','aniPlayQueue_v1','aniQuizHistorySummaryRecoveryOriginalV1','aniQuizHistorySummaryRecoveryV1','aniQuizHistorySummaryV1','aniQuizHistory_v1','aniQuizPlanBackupSettingsV72','aniQuizSettingsV14','aniQuizCustomListScopeInvalidV8265','aniMultiplayerAmqListScopeInvalidV8265','aniMultiplayerEmqListScopeInvalidV8265','aniQuizTargetSummaryRecoveryOriginalV1','aniQuizTargetSummaryRecoveryV1','aniQuizTargetSummaryV1','aniQuizVndbCharacterV36','aniQuizVolume','aniQuizRevealVideoV835','aniMultiplayerGameMediaV835','aniSongTags_v1','aniSrsScheduleV1','anisongFieldGuide_v1','aniEmqWorkListsV8254','aniEmqWorkListsSelectedV8254','aniEmqAudioOverridesV8254']);const patterns=[/^aniQuizHistorySummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,/^aniQuizTargetSummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,/^aniSrsScheduleRecoveryV1_\d+$/,/^aniCustomPracticeListsRecoveryV825_\d+$/,/^aniManualWeakAnimeRecoveryV825_\d+$/,/^aniBlacklistedAnimeRecoveryV825_\d+$/];const appStorage={};for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k&&k!=='aniCoverCacheV12'&&((allowed.has(k)&&k!=='aniQuizPlanBackupSettingsV72')||patterns.some(rx=>rx.test(k)))){const v=localStorage.getItem(k);if(v!==null)appStorage[k]=v}}const pending=localStorage.getItem('aniQuizPlanBackupSettingsV72');if(pending)appStorage.aniQuizSettingsV14=pending;const data={format:'ani-collection-workspace',version:4,exportedAt:new Date().toISOString(),status,favorites,animeWatch,songTags,playHistory,queueIds,appStorage};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ani-collection-workspace-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500);toast('完整收藏室備份已匯出，包含 EMQ 清單與學習排程')}catch(err){toast('備份匯出失敗，請確認瀏覽器儲存空間')}};
document.getElementById('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;let reloadAfterImport=false;try{const d=JSON.parse(await f.text());const src=d.status||d;if(!src||typeof src!=='object'||Array.isArray(src))throw Error('status');if(d.appStorage&&typeof d.appStorage==='object'&&!Array.isArray(d.appStorage)){const allowed=new Set(['aniAmqProfileV1','aniAmqPPRecordsV1','aniAmqProfileRecoveryV1','aniAmqPPRecordsRecoveryV1','aniAnimeAliases_v1','aniAnimeWatch_v1','aniBlacklistedSongs_v1','aniBlacklistedAnime_v1','aniManualWeakAnimeV1','aniCustomPracticeListsV1','aniCustomPracticeListsRecoveryV825','aniManualWeakAnimeRecoveryV825','aniBlacklistedAnimeRecoveryV825','aniCatalogModeV6','aniVNWatchlistV1','aniCollectionThemeV18','aniCollection_v2','aniDockMutedV57','aniDockVolumeV57','aniFavorites_v1','aniLearningPlanProgressV1','aniPlayHistory_v1','aniPlayQueue_v1','aniQuizHistorySummaryRecoveryOriginalV1','aniQuizHistorySummaryRecoveryV1','aniQuizHistorySummaryV1','aniQuizHistory_v1','aniQuizPlanBackupSettingsV72','aniQuizSettingsV14','aniQuizCustomListScopeInvalidV8265','aniMultiplayerAmqListScopeInvalidV8265','aniMultiplayerEmqListScopeInvalidV8265','aniQuizTargetSummaryRecoveryOriginalV1','aniQuizTargetSummaryRecoveryV1','aniQuizTargetSummaryV1','aniQuizVndbCharacterV36','aniQuizVolume','aniQuizRevealVideoV835','aniMultiplayerGameMediaV835','aniSongTags_v1','aniSrsScheduleV1','anisongFieldGuide_v1','aniEmqWorkListsV8254','aniEmqWorkListsSelectedV8254','aniEmqAudioOverridesV8254','aniMultiplayerPersonalSettingsV82']);const patterns=[/^aniQuizHistorySummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,/^aniQuizTargetSummaryRecoveryV1_\d+_[a-z0-9]{1,4}$/,/^aniSrsScheduleRecoveryV1_\d+$/,/^aniCustomPracticeListsRecoveryV825_\d+$/,/^aniManualWeakAnimeRecoveryV825_\d+$/,/^aniBlacklistedAnimeRecoveryV825_\d+$/];for(const [k,v] of Object.entries(d.appStorage)){if(typeof v==='string'&&k!=='aniCoverCacheV12'&&((allowed.has(k)&&k!=='aniQuizPlanBackupSettingsV72')||patterns.some(rx=>rx.test(k)))){localStorage.setItem(k,v);reloadAfterImport=true}}}for(const [k,v] of Object.entries(src)){const numericId=Number(k),isSongId=Number.isSafeInteger(numericId)&&numericId>0;if(isSongId){const n=Number(v);if(n>=1&&n<=3)status[k]=n;else if(n===0)delete status[k]}}if(Array.isArray(d.favorites))favorites=[...new Set([...favorites,...d.favorites])];if(d.animeWatch&&typeof d.animeWatch==='object')animeWatch={...animeWatch,...d.animeWatch};if(d.songTags&&typeof d.songTags==='object')songTags={...songTags,...d.songTags};if(d.playHistory&&typeof d.playHistory==='object')playHistory={...playHistory,...d.playHistory};if(Array.isArray(d.queueIds))queueIds=[...new Set([...queueIds,...d.queueIds.map(Number).filter(n=>Number.isSafeInteger(n)&&n>0)])];save();saveFav();saveObj('aniAnimeWatch_v1',animeWatch);saveObj('aniSongTags_v1',songTags);saveObj('aniPlayHistory_v1',playHistory);saveObj('aniPlayQueue_v1',queueIds);updateStats();render();toast(reloadAfterImport?'完整收藏資料與 EMQ／學習設定已匯入，正在重新載入。':'完整收藏資料已匯入');if(reloadAfterImport)setTimeout(()=>window.location.reload(),350)}catch(err){console.error('Workspace backup import failed',err);toast('備份格式不正確或儲存失敗，匯入未完成')}finally{e.target.value=''}};

// Random discovery has a low-difficulty option and can be used as a blind listening prompt.
const discTop=document.querySelector('.discoverTop');const coldBtn=document.createElement('button');coldBtn.id='coldBtn';coldBtn.className='btn primary';coldBtn.textContent='抽低難度未探索歌';coldBtn.title='從尚未標記且 difficulty 不高於 20 的歌曲中抽選';discTop.appendChild(coldBtn);coldBtn.onclick=()=>{const mode=document.getElementById('discoverSourceModeV857')?.value||'amq';if(mode!=='amq'){toast('低難度歌曲只適用 AMQ，請將探索來源切換為 AMQ。');return}const pool=songs.filter(s=>!isBlacklistedSongV51(s[1])&&!st(s[1])&&audioEligibleV857(s)&&Number(s[6])>0&&Number(s[6])<=20);const s=pool.length?pool[Math.floor(Math.random()*pool.length)]:randomSong('discover');showDiscovery(s);if(s)toast(pool.length?`從 ${pool.length.toLocaleString()} 首未標記低難度歌曲中抽選`:'沒有符合條件的歌曲，改為一般隨機探索')};
// Keep normal song discovery and queue access; blind listening belongs to the dedicated quiz page.
const oldShowDiscovery=showDiscovery;showDiscovery=function(s){oldShowDiscovery(s);if(!s)return;const box=ensureDiscoveryCardV60();if(!box)return;const actions=box.querySelector('.discBtns');if(actions){let q=actions.querySelector('[data-v71-queue]');if(!q){q=document.createElement('button');q.className='btn';q.dataset.v71Queue='1';q.textContent='＋加入待聽';actions.appendChild(q)}q.onclick=()=>addQueue(s)}};

// Make legacy controls point to the in-page player too.

document.getElementById('listenNext').onclick=playNext;document.getElementById('listenRandom').onclick=()=>{const s=randomSong('dock');if(s)listenSong(s)};
// Home-level blind/reveal flow removed; use the dedicated quiz practice page for that.

// Add the anime watch status into detail header without conflating it with song progress.
const oldOpenAnime=openAnime;openAnime=function(id){oldOpenAnime(id);const a=byAnime.get(id);if(!a)return;const h=document.getElementById('detailSub');const ws=watchStatus(id);let row=document.getElementById('detailWatchTools');if(!row){row=document.createElement('div');row.id='detailWatchTools';row.style.cssText='display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px';h.after(row)}row.innerHTML=`<span class="pill">看番狀態：${esc(watchNames[ws]||'未標記')}</span><select id="detailWatchSelect" class="detailWatchSelectV843"><option value="none">未標記</option><option value="completed">看過</option><option value="current">正在看</option><option value="planning">想看</option><option value="paused">暫停</option><option value="dropped">棄番</option><option value="repeating">重看中</option></select><a class="btn" style="padding:7px 9px;font-size:10px" href="https://myanimelist.net/anime/${Number(a[6])||''}" target="_blank" rel="noopener">MAL ↗</a>`;const sel=document.getElementById('detailWatchSelect');sel.value=ws;sel.onchange=()=>{setWatchStatus(id,sel.value);render();openAnime(id)}};
// Detail header cover caching already exists; render cover cards will populate gradually.
(async()=>{try{const cached=await loadDB();if(cached&&cached.songs?.length>songs.length){DB=cached;anime=DB.anime;songs=DB.songs;rebuild()}}catch(e){}updateStats();render();showDiscovery(randomSong('discover'));renderQueue();updateDock(null);updateSelectionHint();
// Public, narrow bridge for the quiz-history UI and quiz closure.
window.__aniHistoryAPIv51={
 isBlacklisted:id=>isBlacklistedSongV51(id)||!!window.__aniIsAnimeWorkBlacklistedV825?.(id),
 setBlacklisted:(id,blocked)=>setBlacklistedSongV51(id,blocked),
 getBlacklistCount:()=>blacklistedSongIdsV51.size,
 getHistory:()=>quizHistoryV51,
 getHistorySummary:()=>quizHistorySummaryV1,
 getTargetHistorySummary:()=>quizTargetSummaryV80,
 flushTargetHistorySummary:()=>flushQuizTargetSummaryV80(),
 getSongTag:id=>String(songTags[String(id)]||''),
 setSongTag:(id,value)=>{const key=String(id),old=songTags[key],tag=String(value||'').trim().slice(0,100);if(!songs.some(s=>String(s[1])===key)&&!window.__aniEmqAPI?.isSong?.(key))return {ok:false,reason:'missing'};if(tag)songTags[key]=tag;else delete songTags[key];try{localStorage.setItem('aniSongTags_v1',JSON.stringify(songTags))}catch(e){if(old===undefined)delete songTags[key];else songTags[key]=old;return {ok:false,reason:'storage'}}document.dispatchEvent(new CustomEvent('ani-song-tag-updated-v80',{detail:{songId:key,tag:songTags[key]||''}}));return {ok:true,tag:songTags[key]||''}},
 getSongHistorySummary:id=>{const r=quizHistorySummaryV1?.bySong?.[String(id)];return r?{total:Number(r[0])||0,correct:Number(r[1])||0,wrong:Number(r[2])||0,elapsedCount:Number(r[3])||0,elapsedSum:Number(r[4])||0,slow:Number(r[5])||0,lastAt:Number(r[6])?new Date(Number(r[6])).toISOString():'',lastCorrect:r[7]===null||r[7]===undefined?null:!!r[7]}:null},
 record:(song,correct,answer,elapsed,label,target='unknown')=>recordQuizHistoryV51(song,correct,answer,elapsed,label,target),
 beginRound:()=>beginQuizHistoryRoundV51(),
 getSong:id=>songs.find(s=>String(s[1])===String(id))||window.__aniEmqAPI?.getRow?.(id)||null,
 getAnimeTitles:id=>{const a=window.__aniEmqAPI?.getWorkSummary?.(id)||byAnime.get(Number(id))||byAnime.get(id);return {english:String(a?.[1]||'未知作品'),romaji:String(a?.[2]||a?.[1]||'未知作品')}},
 // Read-only unified snapshots for learning analytics. The homepage's AMQ-only catalogue statistics remain untouched.
 getAnimeRecords:()=>[...anime.map(a=>({id:String(a[0]),title:String(a[1]||''),romaji:String(a[2]||''),vintage:String(a[3]||''),type:String(a[4]||'Other'),year:Number(a[5])||0,malId:String(a[6]||''),source:'amq',workKind:'anime'})),...(window.__aniEmqAPI?.getWorks?.()||[]).map(w=>({id:String(w.i),title:String(w.t||''),romaji:String(w.n||w.t||''),vintage:Number(w.y)>0?String(w.y):'',type:'Other',year:Number(w.y)||0,malId:'',vndbId:String(w.vndbId||''),source:'emq',workKind:'visual_novel_game'}))],
 getSongRecords:()=>[...songs.map(s=>({id:String(s[1]),animeId:String(s[0]),type:Number(s[2])||5,number:Number(s[3])||0,title:String(s[4]||''),artist:String(s[5]||''),difficulty:Number(s[6])||0,source:'amq',workKind:'anime'})),...(window.__aniEmqAPI?.getRows?.()||[]).map(s=>({id:String(s[1]),animeId:String(s[0]),type:Number(s[2])||5,number:Number(s[3])||0,title:String(s[4]||''),artist:String(s[5]||''),difficulty:null,source:'emq',workKind:'visual_novel_game'}))],
 getPersonalSnapshot:()=>({status:{...status},favorites:[...favorites],songTags:{...songTags},playHistory:{...playHistory},queueIds:[...queueIds]}),
 getStatus:id=>st(id),
 setStatus:(id,value)=>{const key=String(id);if(Number(value)>0)status[key]=Number(value);else delete status[key];save();try{updateStats();render()}catch(e){console.warn('Status refresh failed',e)}document.dispatchEvent(new CustomEvent('ani-familiarity-updated-v51'))},
 refresh:()=>{try{updateStats();render()}catch(e){}}
};
})();

</script>