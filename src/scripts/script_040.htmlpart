<script id="v82-54-emq-audio-lists-batch">
(()=>{
'use strict';
const KEY='aniEmqWorkListsV8254',SELECTED_KEY='aniEmqWorkListsSelectedV8254',OVERRIDES_KEY='aniEmqAudioOverridesV8254',SETTINGS_KEY='aniQuizSettingsV14';
const INVALID_SCOPE_KEY_V8265='aniQuizCustomListScopeInvalidV8265';
const $=id=>document.getElementById(id), esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let db=loadDb(),selectedWorks=new Set(),selectedVns=new Set(),managerListId='',mounted=false,apiPatched=false,originalCombine=null;
function loadDb(){try{const d=JSON.parse(localStorage.getItem(KEY)||'{"version":1,"lists":[]}');if(!d||!Array.isArray(d.lists))throw 0;return {version:1,lists:d.lists.filter(x=>x&&typeof x==='object').map((x,i)=>({id:String(x.id||`emq-${i}`),name:String(x.name||'未命名清單').trim().slice(0,80)||'未命名清單',workIds:unique(x.workIds),vndbIds:unique(x.vndbIds),songIds:unique(x.songIds),createdAt:x.createdAt||new Date().toISOString(),updatedAt:x.updatedAt||new Date().toISOString()}))}}catch{return {version:1,lists:[]}}}
<!-- AMQ_SPLIT_MODULE:emq_list_normalization -->
function saveDb(next){const clean={version:1,lists:next.lists.map(l=>({...l,workIds:unique(l.workIds),vndbIds:unique(l.vndbIds),songIds:unique(l.songIds)}))};try{localStorage.setItem(KEY,JSON.stringify(clean));db=clean;renderManager();refreshBatchSelectors();renderQuizPicker();return true}catch(e){alert('無法儲存 EMQ 清單，可能是瀏覽器儲存空間不足。原本資料未確認有變更。');return false}}
function api(){return window.__aniEmqAPI}
function emqReady(){return !!api()?.ready}
function safeSettings(){try{return JSON.parse(localStorage.getItem(SETTINGS_KEY)||'{}')}catch{return {}}}
function getOverrides(){try{const x=JSON.parse(localStorage.getItem(OVERRIDES_KEY)||'{}');return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}catch{return {}}}
function getSelectedIds(){const picker=$('emqWorkListOptionsV8254');let ids=[];if(picker)ids=[...picker.querySelectorAll('[data-emq-work-list-id]:checked')].map(x=>String(x.value));else{try{ids=JSON.parse(localStorage.getItem(SELECTED_KEY)||'[]').map(String)}catch{ids=[]}}return unique(ids).filter(id=>db.lists.some(l=>l.id===id))}
<!-- AMQ_SPLIT_MODULE:emq_list_membership -->function makeId(){return `emql-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,8)}`}
function createList(name){const clean=String(name||'').trim().replace(/\s+/g,' ').slice(0,80);if(!clean){alert('請輸入清單名稱。');return ''}if(db.lists.some(x=>x.name.toLocaleLowerCase()===clean.toLocaleLowerCase())){alert('已存在同名清單，請換一個名稱。');return ''}const now=new Date().toISOString(),id=makeId();if(saveDb({version:1,lists:[...db.lists,{id,name:clean,workIds:[],vndbIds:[],songIds:[],createdAt:now,updatedAt:now}]})){managerListId=id;return id}return ''}
function addMembers(listId,workIds,vnIds){const list=db.lists.find(x=>x.id===String(listId));if(!list)return false;const works=new Set(list.workIds),vns=new Set(list.vndbIds);for(const wid of workIds){works.add(String(wid));const w=api()?.getWork?.(wid);if(w?.vndbId)vns.add(String(w.vndbId))}for(const vid of vnIds){vns.add(String(vid));const w=api()?.getWorkByVndbId?.(vid);if(w?.i!=null)works.add(String(w.i))}return saveDb({version:1,lists:db.lists.map(l=>l.id===list.id?{...l,workIds:[...works],vndbIds:[...vns],updatedAt:new Date().toISOString()}:l)})}
function removeMembers(listId,workIds,vnIds){const list=db.lists.find(x=>x.id===String(listId));if(!list)return false;const works=new Set(list.workIds),vns=new Set(list.vndbIds);for(const wid of workIds){works.delete(String(wid));const w=api()?.getWork?.(wid);if(w?.vndbId)vns.delete(String(w.vndbId))}for(const vid of vnIds){vns.delete(String(vid));const w=api()?.getWorkByVndbId?.(vid);if(w?.i!=null)works.delete(String(w.i))}return saveDb({version:1,lists:db.lists.map(l=>l.id===list.id?{...l,workIds:[...works],vndbIds:[...vns],updatedAt:new Date().toISOString()}:l)})}
function escapeText(v){return esc(v)}
function refreshBatchSelectors(){for(const id of ['emqCatalogBulkListV8254','emqVnListBulkListV8254','emqAllWorksBulkListV8254']){const el=$(id);if(!el)continue;const current=el.value;el.innerHTML='<option value="">選擇要整理的清單</option>'+db.lists.map(l=>`<option value="${esc(l.id)}">${esc(l.name)} · ${l.workIds.length} 部作品</option>`).join('');if(db.lists.some(l=>l.id===current))el.value=current}}
function listOptionsHtml(selected=[]){return db.lists.map(l=>`<label><input type="checkbox" data-emq-work-list-id value="${esc(l.id)}" ${selected.includes(l.id)?'checked':''}><span>${esc(l.name)} <small>(${listSongCount(l).toLocaleString()} 首)</small></span></label>`).join('')||'<p class="emqListSmallV8254">目前沒有 EMQ 自訂清單。請到「我的清單 → EMQ 自訂清單」建立。</p>'}
function renderQuizPicker(){const root=$('emqWorkListOptionsV8254');if(!root)return;let saved=[],malformed=false;const raw=localStorage.getItem(SELECTED_KEY);if(raw!==null){try{const parsed=JSON.parse(raw);if(!Array.isArray(parsed)||parsed.some(id=>id===null||id===undefined||typeof id==='object'||typeof id==='boolean'||String(id).trim()===''))malformed=true;else saved=parsed.map(String)}catch{malformed=true}}const missing=saved.some(id=>!db.lists.some(l=>String(l.id)===id));if(missing||malformed){try{localStorage.setItem(INVALID_SCOPE_KEY_V8265,'1')}catch{}}root.innerHTML=listOptionsHtml(saved.filter(id=>db.lists.some(l=>String(l.id)===id)));const summary=$('emqWorkListSummaryV8254');if(summary){const names=saved.map(id=>db.lists.find(l=>l.id===id)?.name).filter(Boolean);const invalid=(()=>{try{return localStorage.getItem(INVALID_SCOPE_KEY_V8265)==='1'}catch{return false}})();summary.textContent=missing||malformed||invalid?`清單選取失效：${names.length?names.join('、')+'；':''}請重新指定 EMQ 自訂清單，暫不擴大範圍。`:names.length?`EMQ 範圍：${names.join('、')}`:'不限制 EMQ 自訂清單';summary.title=summary.textContent}}
function mountQuizPicker(){const quick=document.querySelector('#quizView .quizQuickSettings');if(!quick||$('emqWorkListPickerV8254'))return;const box=document.createElement('details');box.className='emqWorkListPickerV8254';box.id='emqWorkListPickerV8254';box.innerHTML='<summary id="emqWorkListSummaryV8254">EMQ 自訂清單（不限制）</summary><div id="emqWorkListOptionsV8254" class="emqWorkListOptionsV8254" role="group" aria-label="EMQ 自訂練習清單"></div><small class="emqListSmallV8254">只篩選 EMQ 歌曲；混合模式中的 AMQ 歌曲仍依原本的動畫清單條件出題。</small><button type="button" class="btn" data-emq-open-manager>管理 EMQ 自訂清單</button>';quick.append(box);renderQuizPicker()}
function mountManager(){const root=$('watchlistView'),tabs=root?.querySelector('.mylistModeTabs');if(!root||!tabs)return;if(!$('emqListsModeTabV8254')){const b=document.createElement('button');b.type='button';b.className='btn';b.id='emqListsModeTabV8254';b.textContent='EMQ 自訂清單';tabs.append(b)}if(!$('emqListsWorkV8254')){const panel=document.createElement('div');panel.id='emqListsWorkV8254';panel.className='hidden';panel.innerHTML='<div class="emqListManagerShellV8254"><header class="emqListManagerHeadV8254"><div><h2>EMQ 自訂清單</h2><p>可從 EMQ 圖鑑或 VN 清單批次加入作品。清單與 AMQ 動畫清單分開保存，不改動 VNDB 原始狀態或答題紀錄。</p></div><button type="button" class="btn" data-emq-open-catalog>前往 VN 圖鑑</button></header><form id="emqListCreateFormV8254" class="emqListCreateV8254"><input id="emqListNewNameV8254" maxlength="80" placeholder="例如：冷門美少女遊戲 OP" aria-label="EMQ 自訂清單名稱"><button class="btn primary" type="submit">＋ 建立清單</button></form><div id="emqListManagerStatusV8254" class="emqListSmallV8254" role="status" aria-live="polite"></div><div id="emqListGridV8254" class="emqListGridV8254"></div><section class="emqAllWorksPanelV8254" id="emqAllWorksPanelV8254"><header><h3>全部 EMQ 作品</h3><p class="emqListSmallV8254">搜尋作品名稱、別名、歌曲名稱或歌手。這裡包含所有 EMQ 作品，也包含未連結 VNDB 的作品；勾選後可批次加入／移出自訂清單。</p></header><div class="emqAllWorksToolbarV8254"><input id="emqAllWorksSearchV8254" type="search" autocomplete="off" placeholder="搜尋作品／歌曲／歌手" aria-label="搜尋全部 EMQ 作品"><button class="btn" type="button" id="emqAllWorksClearV8254">清除搜尋</button><span class="emqListSmallV8254" id="emqAllWorksCountV8254" role="status" aria-live="polite">等待 EMQ 曲庫載入…</span></div><div id="emqAllWorksBulkPanelV8254" class="emqBulkToolbarV8254"><button class="btn" type="button" data-emq-bulk-select="allworks">選取目前顯示</button><button class="btn" type="button" data-emq-bulk-clear="allworks">清除選取</button><select id="emqAllWorksBulkListV8254" aria-label="目標 EMQ 自訂清單"><option value="">選擇要整理的清單</option></select><button class="btn primary" type="button" data-emq-bulk-add="allworks">加入所選</button><button class="btn" type="button" data-emq-bulk-remove="allworks">移出所選</button><p class="emqBulkStatusV8254" id="emqAllWorksBulkStatusV8254" role="status" aria-live="polite">這裡涵蓋全部 EMQ 作品，不受 VNDB 連結是否存在影響。</p></div><div id="emqAllWorksGridV8254" class="emqAllWorksGridV8254"></div><div><button class="btn" type="button" id="emqAllWorksMoreV8254">載入更多作品</button></div></section><section id="emqListMembersPanelV8254" class="vn49Panel" hidden></section></div>';root.append(panel)}
 if(!tabs.dataset.emqListBoundV8254){tabs.dataset.emqListBoundV8254='1';tabs.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.id==='emqListsModeTabV8254'){e.preventDefault();e.stopPropagation();showManager();return}if(['watchModeTab','customModeTab'].includes(b.id))hideManager()})}
 const form=$('emqListCreateFormV8254');if(form&&!form.dataset.bound){form.dataset.bound='1';form.addEventListener('submit',e=>{e.preventDefault();const input=$('emqListNewNameV8254'),id=createList(input.value);if(id){input.value='';renderManager();alert('已建立 EMQ 自訂清單。')}})}
}
function showManager(){const root=$('watchlistView'),base=$('watchlistWork'),legacy=$('customListsWork'),panel=$('emqListsWorkV8254'),tabs=root?.querySelector('.mylistModeTabs');if(!root||!panel)return;root.classList.remove('hidden');root.hidden=false;base?.classList.add('hidden');legacy?.classList.add('hidden');panel.classList.remove('hidden');for(const b of tabs?.querySelectorAll('button')||[])b.classList.toggle('active',b.id==='emqListsModeTabV8254');managerListId=managerListId&&db.lists.some(l=>l.id===managerListId)?managerListId:'';renderManager()}
function hideManager(){const panel=$('emqListsWorkV8254');panel?.classList.add('hidden');const tab=$('emqListsModeTabV8254');tab?.classList.remove('active')}
function managerMembersHtml(list){const out=[];const usedVn=new Set();for(const wid of list.workIds){const w=api()?.getWork?.(wid),title=w?.t||w?.n||`EMQ 作品 ${wid}`,songs=api()?.getSongsForWork?.(wid)||[];if(w?.vndbId)usedVn.add(String(w.vndbId));out.push(`<div class="emqListMemberV8254"><div><strong>${esc(title)}</strong><span class="meta">作品 ID ${esc(wid)} · ${songs.length} 首 EMQ 歌曲${w?.vndbId?' · '+esc(w.vndbId):''}</span></div><button class="btn" type="button" data-emq-list-remove-work="${esc(wid)}" data-emq-list-id="${esc(list.id)}">移除</button></div>`)}for(const vid of list.vndbIds.filter(v=>!usedVn.has(v))){const w=api()?.getWorkByVndbId?.(vid);out.push(`<div class="emqListMemberV8254"><div><strong>${esc(w?.t||w?.n||'VNDB 作品')}</strong><span class="meta">${esc(vid)} · ${w?'已找到 EMQ 對應作品':'尚無 EMQ 對應歌曲'}</span></div><button class="btn" type="button" data-emq-list-remove-vn="${esc(vid)}" data-emq-list-id="${esc(list.id)}">移除</button></div>`)}return out.join('')||'<p class="emqListSmallV8254">清單目前沒有作品。可以從 VN 圖鑑或 VN 清單選取後批次加入。</p>'}
let allWorkIndexCacheV8254=null,allWorkVisibleLimitV8254=72;
function buildAllWorkIndexV8254(){if(allWorkIndexCacheV8254)return allWorkIndexCacheV8254;const a=api();if(!a?.ready)return [];const byWork=new Map();for(const row of a.getRows?.()||[]){const wid=String(row?.[0]??'');if(!byWork.has(wid))byWork.set(wid,[]);const id=row?.[1],meta=a.getMeta?.(id)||{},aliases=a.getAliases?.(id)||{};byWork.get(wid).push([row?.[4],row?.[5],row?.[12],row?.[13],meta.workTitle,meta.workAlt,...(aliases.title||[]),...(aliases.artist||[]),...(aliases.work||[])].filter(Boolean).join(' '))}allWorkIndexCacheV8254=(a.getWorks?.()||[]).map(w=>{const id=String(w.i),title=String(w.t||w.n||`EMQ 作品 ${id}`),items=byWork.get(id)||[];return {id,title,alt:String(w.n||''),year:Number(w.y)||0,vndbId:String(w.vndbId||''),songs:items.length,search:[title,w.n,w.vndbId,...items].filter(Boolean).join(' ').toLocaleLowerCase()}}).sort((x,y)=>x.title.localeCompare(y.title,'zh-Hant',{sensitivity:'base'}));return allWorkIndexCacheV8254}
function renderAllWorksV8254(reset=false){const grid=$('emqAllWorksGridV8254');if(!grid)return;if(reset)allWorkVisibleLimitV8254=72;const index=buildAllWorkIndexV8254(),query=String($('emqAllWorksSearchV8254')?.value||'').trim().toLocaleLowerCase(),filtered=query?index.filter(x=>x.search.includes(query)):index,shown=filtered.slice(0,allWorkVisibleLimitV8254),count=$('emqAllWorksCountV8254');if(count)count.textContent=index.length?`共 ${index.length.toLocaleString()} 部作品，符合 ${filtered.length.toLocaleString()} 部，顯示 ${shown.length.toLocaleString()} 部`:'EMQ 曲庫尚未載入。';grid.innerHTML=shown.map(w=>`<article class="emqAllWorkCardV8254" data-emq-work-card="${esc(w.id)}"><input type="checkbox" data-emq-batch-card="allworks" data-emq-work-id="${esc(w.id)}" data-emq-vndb-id="${esc(w.vndbId)}" aria-label="選取 ${esc(w.title)}" ${selectedWorks.has(w.id)?'checked':''}><div class="emqAllWorkInfoV8254"><strong>${esc(w.title)}</strong><small>${w.year?`年份 ${w.year} · `:''}${w.songs} 首歌曲${w.vndbId?' · '+esc(w.vndbId):' · 未連結 VNDB'}</small></div></article>`).join('')||'<p class="emqListSmallV8254">沒有符合的 EMQ 作品。請更改搜尋條件。</p>';const more=$('emqAllWorksMoreV8254');if(more){more.hidden=shown.length>=filtered.length;more.disabled=shown.length>=filtered.length}const bulk=$('emqAllWorksBulkStatusV8254');if(bulk)bulk.textContent=`目前選取 ${selectedWorks.size} 部 EMQ 作品、${selectedVns.size} 個 VNDB 作品。搜尋與分頁不會刪除選取狀態。`}
function mountAllWorksBrowserV8254(){const input=$('emqAllWorksSearchV8254'),clear=$('emqAllWorksClearV8254'),more=$('emqAllWorksMoreV8254'),grid=$('emqAllWorksGridV8254');if(!input||input.dataset.bound==='1')return;input.dataset.bound='1';input.addEventListener('input',()=>renderAllWorksV8254(true));clear?.addEventListener('click',()=>{input.value='';renderAllWorksV8254(true);input.focus()});more?.addEventListener('click',()=>{allWorkVisibleLimitV8254+=72;renderAllWorksV8254(false)});grid?.addEventListener('change',e=>{const cb=e.target;if(!cb.matches('[data-emq-batch-card="allworks"]'))return;const wid=String(cb.dataset.emqWorkId||''),vid=String(cb.dataset.emqVndbId||'');if(cb.checked)selectedWorks.add(wid);else selectedWorks.delete(wid);if(vid){if(cb.checked)selectedVns.add(vid);else selectedVns.delete(vid)}updateSelectedStatus('allworks')});renderAllWorksV8254(true)}
function renderManager(){const grid=$('emqListGridV8254');if(!grid)return;refreshBatchSelectors();grid.innerHTML=db.lists.map(l=>`<article class="emqListCardV8254"><h3>${esc(l.name)}</h3><p>${l.workIds.length} 部 EMQ 作品 · ${l.vndbIds.length} 個 VNDB 關聯 · ${listSongCount(l).toLocaleString()} 首曲目</p><div class="actions"><button class="btn primary" type="button" data-emq-list-start="${esc(l.id)}">練習此清單</button><button class="btn" type="button" data-emq-list-members="${esc(l.id)}">管理成員</button><button class="btn" type="button" data-emq-list-rename="${esc(l.id)}">重新命名</button><button class="btn" type="button" data-emq-list-delete="${esc(l.id)}">刪除</button></div></article>`).join('')||'<p class="emqListSmallV8254">尚未建立清單。可在上方建立，或從 VN 圖鑑／VN 清單批次加入作品時建立。</p>';const status=$('emqListManagerStatusV8254');if(status)status.textContent=`共 ${db.lists.length} 份清單。成員數以 EMQ 曲庫與 VNDB 連結交集計算，尚無音樂對應的 VN 會保留於清單中。`;const panel=$('emqListMembersPanelV8254'),list=db.lists.find(l=>l.id===managerListId);if(panel){panel.hidden=!list;panel.innerHTML=list?`<div class="emqListManagerHeadV8254"><div><h3>${esc(list.name)} · 成員</h3><p>移除只會更新這份自訂清單，不會刪除歌曲、VNDB 清單狀態或答題紀錄。</p></div><button class="btn" type="button" data-emq-list-close-members>收起</button></div><div class="emqListMembersV8254">${managerMembersHtml(list)}</div>`:''}}
function songIdsForList(list){return listSongIds(list)}
function startList(id){const l=db.lists.find(x=>x.id===String(id));if(!l)return;const ids=[...songIdsForList(l)];if(!ids.length){alert('這份清單目前沒有可出題的 EMQ 歌曲。作品仍會保留；可先確認 VNDB 關聯或改選其他清單。');return}let settings=safeSettings();settings.emqMode='emq';settings.includeEmq=true;try{localStorage.setItem(SETTINGS_KEY,JSON.stringify(settings));localStorage.setItem(SELECTED_KEY,JSON.stringify([l.id]));localStorage.removeItem(INVALID_SCOPE_KEY_V8265)}catch{}const mode=$('qsEmqModeV8249');if(mode){mode.value='emq';mode.dispatchEvent(new Event('change',{bubbles:true}))}window.__aniNavigateApp?.('quiz');setTimeout(()=>{renderQuizPicker();const start=$('quizStart');if(start)start.click()},200)}
function addFromUi(kind,add=true){const select=$(kind==='catalog'?'emqCatalogBulkListV8254':kind==='list'?'emqVnListBulkListV8254':'emqAllWorksBulkListV8254'),listId=select?.value;if(!listId){alert('請先建立或選擇一份 EMQ 自訂清單。');return}if(!selectedWorks.size&&!selectedVns.size){alert('請先勾選至少一個作品。');return}const works=[...selectedWorks],vns=[...selectedVns];const ok=add?addMembers(listId,works,vns):removeMembers(listId,works,vns);if(ok){const st=$(kind==='catalog'?'emqCatalogBulkStatusV8254':kind==='list'?'emqVnListBulkStatusV8254':'emqAllWorksBulkStatusV8254');if(st)st.textContent=`已${add?'加入':'移除'}所選項目。清單中的 VNDB 關聯與曲目數已更新。`;renderManager();renderQuizPicker();renderAllWorksV8254(false)}}
function mountBulkToolbar(kind){const grid=$(kind==='catalog'?'vn49Grid':'vn49ListGrid');if(!grid)return;const id=kind==='catalog'?'emqCatalogBulkPanelV8254':'emqVnListBulkPanelV8254';if($(id))return;const panel=document.createElement('section');panel.id=id;panel.className='vn49Panel emqBulkPanelV8254';panel.innerHTML=`<div class="emqBulkToolbarV8254"><button class="btn" type="button" data-emq-bulk-select="${kind}">選取目前顯示</button><button class="btn" type="button" data-emq-bulk-clear="${kind}">清除選取</button><select id="${kind==='catalog'?'emqCatalogBulkListV8254':'emqVnListBulkListV8254'}" aria-label="目標 EMQ 自訂清單"><option value="">選擇要整理的清單</option></select><button class="btn primary" type="button" data-emq-bulk-add="${kind}">加入所選</button><button class="btn" type="button" data-emq-bulk-remove="${kind}">移出所選</button><button class="btn" type="button" data-emq-open-manager>管理清單</button></div><p class="emqBulkStatusV8254" id="${kind==='catalog'?'emqCatalogBulkStatusV8254':'emqVnListBulkStatusV8254'}" role="status" aria-live="polite">勾選卡片後選擇目標清單；VN List 中尚未和 EMQ 曲庫對應的作品也能先保存。</p>`;grid.insertAdjacentElement('beforebegin',panel);refreshBatchSelectors()}
function decorateCards(kind){if(kind==='allworks'){renderAllWorksV8254(false);return}const grid=$(kind==='catalog'?'vn49Grid':'vn49ListGrid');if(!grid)return;for(const card of grid.querySelectorAll('.vn49Card')){if(card.dataset.emqBatchDecorated==='1')continue;let wid='',vid='';if(kind==='catalog'){const b=card.querySelector('[data-vn49-work]');wid=String(b?.dataset.vn49Work||'');if(wid){const w=api()?.getWork?.(wid);vid=String(w?.vndbId||'')}}else{const a=[...card.querySelectorAll('a[href]')].find(x=>/^https:\/\/vndb\.org\/v\d+$/i.test(x.href));vid=a?String(a.href.match(/\/(v\d+)$/i)?.[1]||''):'';if(!vid)vid=String(card.querySelector('[data-vn49-cover]')?.dataset.vn49Id||'')}
 if(!wid&&!vid)continue;card.dataset.emqBatchDecorated='1';card.dataset.emqWorkId=wid;card.dataset.emqVndbId=vid;const body=card.querySelector('.vn49CardBody')||card;const label=document.createElement('label');label.className='emqBatchSelectV8254';label.innerHTML=`<input type="checkbox" data-emq-batch-card="${kind}" aria-label="批次選取作品"> 選取`;body.insertBefore(label,body.firstChild);const input=label.querySelector('input');input.checked=kind==='catalog'?selectedWorks.has(wid):selectedVns.has(vid);input.addEventListener('change',()=>{if(kind==='catalog'){if(input.checked)selectedWorks.add(wid);else selectedWorks.delete(wid);if(vid){if(input.checked)selectedVns.add(vid);else selectedVns.delete(vid)}}else{if(input.checked)selectedVns.add(vid);else selectedVns.delete(vid);const w=api()?.getWorkByVndbId?.(vid);if(w?.i!=null){if(input.checked)selectedWorks.add(String(w.i));else selectedWorks.delete(String(w.i))}}updateSelectedStatus(kind)})}}
function updateSelectedStatus(kind){document.querySelectorAll('[data-emq-batch-card]').forEach(cb=>{const k=cb.dataset.emqBatchCard,card=cb.closest('.vn49Card'),wid=String(cb.dataset.emqWorkId||card?.dataset.emqWorkId||''),vid=String(cb.dataset.emqVndbId||card?.dataset.emqVndbId||'');cb.checked=k==='list'?selectedVns.has(vid):selectedWorks.has(wid)});const st=$(kind==='catalog'?'emqCatalogBulkStatusV8254':kind==='list'?'emqVnListBulkStatusV8254':'emqAllWorksBulkStatusV8254');if(st)st.textContent=`目前選取 ${selectedWorks.size} 部 EMQ 作品、${selectedVns.size} 個 VNDB 作品。選取可跨圖鑑與 VN 清單保留，批次動作只影響目標 EMQ 清單。`;if(kind==='allworks')renderAllWorksV8254(false);}
function observeGrid(kind){const grid=$(kind==='catalog'?'vn49Grid':'vn49ListGrid');if(!grid||grid.dataset.emqObserverV8254==='1')return;grid.dataset.emqObserverV8254='1';new MutationObserver(()=>decorateCards(kind)).observe(grid,{childList:true});decorateCards(kind)}
function mountBatch(){mountManager();mountBulkToolbar('catalog');mountBulkToolbar('list');observeGrid('catalog');observeGrid('list');mountAllWorksBrowserV8254();mountQuizPicker();refreshBatchSelectors();renderQuizPicker();renderAllWorksV8254(false)}
function installApi(){const a=api();if(!a?.ready||apiPatched)return;apiPatched=true;
 const originalUrls=a.getAudioUrls.bind(a);a.getAudioUrls=(id)=>{const out=[],add=u=>{const v=String(u||'').trim();if(v&&!out.includes(v))out.push(v)},asianMirror=u=>String(u||'').replace(/^https?:\/\/erogemusicquiz\.com(?=\/selfhoststorage\/userup\/)/i,'https://asiadist.erogemusicquiz.com');const override=getOverrides()[String(id)];if(override)add(override);for(const raw of originalUrls(id)){const u=String(raw||'').trim();if(!u)continue;const asian=asianMirror(u);if(asian!==u)add(asian);add(u);const m=u.match(/^(https?:\/\/[^/]+\/selfhoststorage\/userup)\/weba\/([0-9a-f-]+)\.weba(?:([?#].*)?)?$/i);if(m){const webm=`${m[1]}/${m[2]}.webm${m[3]||''}`,asianWebm=asianMirror(webm);if(asianWebm!==webm)add(asianWebm);add(webm)}}return out};
 const originalManifest=a.getMultiplayerManifest?.bind(a);if(originalManifest)a.getMultiplayerManifest=ids=>originalManifest(ids).map(row=>({...row,audioCandidates:a.getAudioUrls(row.id)}));
 originalCombine=a.combinePool?.bind(a);if(originalCombine)a.combinePool=(base,settings,focusMode,roundSeen,lastId,focusIds)=>{const ids=getSelectedIds();const invalidScope=(()=>{try{return localStorage.getItem(INVALID_SCOPE_KEY_V8265)==='1'}catch{return false}})();if(!ids.length&&!invalidScope)return originalCombine(base,settings,focusMode,roundSeen,lastId,focusIds,null);if(!ids.length&&invalidScope)return originalCombine(base,settings,focusMode,roundSeen,lastId,focusIds,new Set());const selectedSongs=new Set();for(const id of ids){const l=db.lists.find(x=>x.id===id);if(l)for(const sid of listSongIds(l))selectedSongs.add(String(sid))}return originalCombine(base,settings,focusMode,roundSeen,lastId,focusIds,selectedSongs)};
}
function mountAudioTools(){const status=$('quizStatus');if(!status||$('emqAudioToolPanelV8254'))return;const panel=document.createElement('div');panel.id='emqAudioToolPanelV8254';panel.className='emqAudioToolPanelV8254';panel.hidden=true;panel.innerHTML='<div id="emqAudioToolStatusV8254">EMQ 音源備援資訊</div><div class="emqAudioToolActionsV8254"><button type="button" class="btn" id="emqAudioSetOverrideV8254">設定替代音源</button><button type="button" class="btn" id="emqAudioClearOverrideV8254">清除替代音源</button></div>';status.insertAdjacentElement('afterend',panel);$('emqAudioSetOverrideV8254').addEventListener('click',()=>{const q=window.__aniQuizStateV45?.quizSong;if(!q||!api()?.isSong?.(q[1]))return;const id=String(q[1]),old=getOverrides()[id]||'';const raw=prompt('請貼上這首歌的 HTTPS 直連音訊網址（例如可直接播放的 MP3／WebM／WebA）。VNDB、MusicBrainz 等作品介紹頁不是音訊來源。網址只保存在這個瀏覽器。',old);if(raw===null)return;let url='';try{const u=new URL(raw.trim());if(u.protocol!=='https:'||!u.hostname||!(/\.(mp3|m4a|ogg|opus|weba|webm|wav|aac|flac)(?:$|[?#])/i.test(u.pathname+u.search+u.hash)||confirm('網址沒有常見音訊副檔名。仍要把它當作音訊來源嘗試嗎？')))throw Error('invalid')}catch{alert('請輸入有效的 HTTPS 音訊直連網址。');return}const all=getOverrides();all[id]=url||raw.trim();try{localStorage.setItem(OVERRIDES_KEY,JSON.stringify(all))}catch{alert('無法保存替代音源，可能是儲存空間不足。');return}window.listenSong?.(q);updateAudioTools(id)});$('emqAudioClearOverrideV8254').addEventListener('click',()=>{const q=window.__aniQuizStateV45?.quizSong;if(!q)return;const all=getOverrides();delete all[String(q[1])];try{localStorage.setItem(OVERRIDES_KEY,JSON.stringify(all))}catch{}window.listenSong?.(q);updateAudioTools(String(q[1]))});}
 function updateAudioTools(id){const q=window.__aniQuizStateV45?.quizSong,tool=$('emqAudioToolPanelV8254'),note=$('emqAudioToolStatusV8254');if(!tool||!q)return;const songId=String(id||q[1]);const active=api()?.isSong?.(songId);tool.hidden=true;if(!active)return;const urls=api()?.getAudioUrls?.(songId)||[],override=getOverrides()[songId];if(note)note.textContent=`本題 EMQ 音源候選 ${urls.length} 個${urls.some(x=>/\/userup\/[^/]+\.webm(?:[?#]|$)/i.test(x))?'，包含同 UUID 的 WebM 備援':''}。若所有連結失效，可設定替代直連網址；自訂網址只保存在本機。${override?'已設定本機替代音源。':''}`;const clear=$('emqAudioClearOverrideV8254');if(clear)clear.hidden=!override}
 document.addEventListener('ani-quiz-new-question',e=>{setTimeout(()=>{const id=e.detail?.songId;updateAudioToolAfterQuestion(id)},0)});
 function updateAudioToolAfterQuestion(id){mountAudioTools();const q=window.__aniQuizStateV45?.quizSong;if(q)updateAudioTools(id||q[1])}
 document.addEventListener('ani-emq-library-ready-v8248',()=>{allWorkIndexCacheV8254=null;installApi();mountBatch();mountAudioTools();if(typeof optionCache!=='undefined')optionCache={};try{closeQuizSuggestions?.()}catch{} });
 document.addEventListener('change',e=>{if(e.target?.matches?.('#qsEmqModeV8249,#quizTarget')){if(typeof optionCache!=='undefined')optionCache={};try{closeQuizSuggestions?.()}catch{}}if(e.target?.matches?.('#emqWorkListOptionsV8254 [data-emq-work-list-id]')){try{localStorage.removeItem(INVALID_SCOPE_KEY_V8265)}catch{}const ids=getSelectedIds();try{localStorage.setItem(SELECTED_KEY,JSON.stringify(ids))}catch{}const summary=$('emqWorkListSummaryV8254');if(summary){const names=ids.map(id=>db.lists.find(l=>l.id===id)?.name).filter(Boolean);summary.textContent=names.length?`EMQ 範圍：${names.join('、')}`:'EMQ 自訂清單（不限制）'}}});
 document.addEventListener('click',e=>{const t=e.target.closest?.('button');if(!t)return;if(t.matches('[data-emq-open-manager]')){e.preventDefault();window.__aniVnLibraryV8249?.openEmqLists?.();setTimeout(()=>{if(!$('emqListsWorkV8254')?.classList.contains('hidden'))return;mountManager();showManager()},240);return}if(t.matches('[data-emq-open-catalog]')){window.__aniVnLibraryV8249?.openCatalog?.();return}if(t.matches('[data-emq-bulk-select]')){const kind=t.dataset.emqBulkSelect,grid=$(kind==='catalog'?'vn49Grid':kind==='list'?'vn49ListGrid':'emqAllWorksGridV8254');if(kind==='allworks'){for(const cb of grid?.querySelectorAll('[data-emq-batch-card="allworks"]')||[]){const wid=String(cb.dataset.emqWorkId||''),vid=String(cb.dataset.emqVndbId||'');if(wid)selectedWorks.add(wid);if(vid)selectedVns.add(vid)}}else{for(const card of grid?.querySelectorAll('.vn49Card')||[]){const cb=card.querySelector('[data-emq-batch-card]');if(cb&&!cb.checked){cb.checked=true;cb.dispatchEvent(new Event('change',{bubbles:true}))}}}updateSelectedStatus(kind);return}if(t.matches('[data-emq-bulk-clear]')){const kind=t.dataset.emqBulkClear;selectedWorks.clear();selectedVns.clear();document.querySelectorAll('[data-emq-batch-card]').forEach(x=>x.checked=false);updateSelectedStatus(kind);return}if(t.matches('[data-emq-bulk-add]')||t.matches('[data-emq-bulk-remove]')){const kind=t.dataset.emqBulkAdd||t.dataset.emqBulkRemove;addFromUi(kind,t.matches('[data-emq-bulk-add]'));return}if(t.matches('[data-emq-list-start]')){startList(t.dataset.emqListStart);return}if(t.matches('[data-emq-list-members]')){managerListId=t.dataset.emqListMembers;renderManager();return}if(t.matches('[data-emq-list-rename]')){const l=db.lists.find(x=>x.id===t.dataset.emqListRename);if(!l)return;const name=prompt('新的 EMQ 清單名稱：',l.name);if(name===null)return;const clean=name.trim().slice(0,80);if(!clean){alert('清單名稱不能空白。');return}if(db.lists.some(x=>x.id!==l.id&&x.name.toLocaleLowerCase()===clean.toLocaleLowerCase())){alert('已存在同名清單。');return}saveDb({version:1,lists:db.lists.map(x=>x.id===l.id?{...x,name:clean,updatedAt:new Date().toISOString()}:x)});return}if(t.matches('[data-emq-list-delete]')){const l=db.lists.find(x=>x.id===t.dataset.emqListDelete);if(!l||!confirm(`刪除「${l.name}」？只會刪除這份清單，不會刪除歌曲、VNDB 狀態或答題紀錄。`))return;saveDb({version:1,lists:db.lists.filter(x=>x.id!==l.id)});if(managerListId===l.id)managerListId='';try{localStorage.setItem(SELECTED_KEY,JSON.stringify(getSelectedIds().filter(x=>x!==l.id)));localStorage.removeItem(INVALID_SCOPE_KEY_V8265)}catch{}return}if(t.matches('[data-emq-list-remove-work]')){removeMembers(t.dataset.emqListId,[t.dataset.emqListRemoveWork],[]);return}if(t.matches('[data-emq-list-remove-vn]')){removeMembers(t.dataset.emqListId,[],[t.dataset.emqListRemoveVn]);return}if(t.matches('[data-emq-list-close-members]')){managerListId='';renderManager();return}});
 document.addEventListener('ani-app-navigation',e=>{if(e.detail?.view!=='watchlist')hideManager();else if($('emqListsWorkV8254')&&!$('emqListsWorkV8254').classList.contains('hidden')){setTimeout(showManager,0)}mountQuizPicker()});
 document.addEventListener('error',e=>{if(e.target?.matches?.('#audioPlayer')){const id=window.__aniQuizStateV45?.quizSong?.[1];if(id&&api()?.isSong?.(id)){mountAudioTools();const q=window.__aniQuizStateV45?.quizSong;updateAudioTools(q?.[1])}}},true);
 function init(){if(mounted)return;mounted=true;mountBatch();mountAudioTools();installApi();if(typeof optionCache!=='undefined')optionCache={};}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>