<script id="v82-45-scene-background-settings">
(()=>{
 'use strict';
 const DB_NAME='AniSongSceneBackgroundsV1',DB_VERSION=1,STORE='sceneBackgrounds',MAX_FILE_BYTES=12*1024*1024,MAX_DIMENSION=8192,MAX_PIXELS=40000000;
 const $=(sel,root=document)=>root.querySelector(sel);
 const sceneLabels={home:'首頁',explore:'歌曲探索',catalog:'動畫圖鑑',vnCatalog:'VN 圖鑑',watchlist:'動漫清單',vnList:'VN 清單',customLists:'自訂清單',practice:'學習計畫／練習工作台',quiz:'猜歌練習',dashboard:'統計儀表板',multiplayer:'多人模式',detail:'動畫詳情頁',settings:'背景設定面板'};
 const sceneKeys=Object.keys(sceneLabels);
 const state={db:null,ready:false,configs:new Map(),urls:new Map(),tempBlob:null,tempName:'',tempUrl:'',busy:false};
 let layer=null,modal=null,shadeEl=null,sceneSelect=null,fileInput=null,opacityInput=null,fitSelect=null,posSelect=null,preview=null,statusEl=null,applyBtn=null,applyAllBtn=null,clearBtn=null,detailObserver=null,readyPromise=null;
 const notify=msg=>{try{if(typeof window.toast==='function')window.toast(msg);else if(typeof window.showToast==='function')window.showToast(msg);else console.info('[AMQ背景設定]',msg)}catch{console.info('[AMQ背景設定]',msg)}};
 function openDb(){return new Promise((resolve,reject)=>{if(!window.indexedDB){reject(new Error('瀏覽器不支援 IndexedDB，無法安全儲存圖片。'));return}const req=indexedDB.open(DB_NAME,DB_VERSION);req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(STORE))db.createObjectStore(STORE,{keyPath:'scene'})};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error||new Error('無法開啟背景圖片儲存區。'))})}
 function tx(mode,work){return new Promise((resolve,reject)=>{if(!state.db){reject(new Error('背景圖片儲存區尚未準備好。'));return}const transaction=state.db.transaction(STORE,mode),store=transaction.objectStore(STORE);let result;try{result=work(store)}catch(e){reject(e);return}transaction.oncomplete=()=>resolve(result?.result??result);transaction.onerror=()=>reject(transaction.error||new Error('背景圖片儲存失敗。'));transaction.onabort=()=>reject(transaction.error||new Error('背景圖片儲存已取消。'))})}
 function getAll(){return new Promise((resolve,reject)=>{const req=state.db.transaction(STORE,'readonly').objectStore(STORE).getAll();req.onsuccess=()=>resolve(req.result||[]);req.onerror=()=>reject(req.error||new Error('無法讀取背景設定。'))})}
 function revokeUrl(scene){const old=state.urls.get(scene);if(old){try{URL.revokeObjectURL(old)}catch{}state.urls.delete(scene)}}
 function makeUrl(scene,blob){revokeUrl(scene);if(blob instanceof Blob){const url=URL.createObjectURL(blob);state.urls.set(scene,url);return url}return ''}
 function currentView(){try{const view=window.__aniGetActiveViewV82?.()||'home';if(view==='catalog'&&$('#vnCatalogView')&&!$('#vnCatalogView').hidden)return 'vnCatalog';if(view==='watchlist'){if($('#vnListView')&&!$('#vnListView').hidden)return 'vnList';const custom=$('#customListsWork'),customTab=$('#customModeTab');if(custom&&((!custom.hidden&&!custom.classList.contains('hidden'))||customTab?.classList.contains('active')))return 'customLists'}return view}catch{return 'home'}}
 function viewScene(view=currentView()){if(view==='learningPlan'||view==='practice')return 'practice';if(sceneKeys.includes(view)&&view!=='detail'&&view!=='settings')return view;return 'home'}
 function configUrl(scene){const config=state.configs.get(scene);return config?.blob instanceof Blob?(state.urls.get(scene)||makeUrl(scene,config.blob)):''}
 function safeDim(value){const n=Number(value);return Number.isFinite(n)?Math.max(0,Math.min(.8,n)):.28}
 function safeFit(value){return value==='contain'?'contain':'cover'}
 function safePos(value){return ['center center','center top','center bottom','left center','right center'].includes(value)?value:'center center'}
 function cssUrl(url){return url?`url(\"${String(url).replaceAll('\"','%22')}\")`:'none'}
 function applyScene(view=currentView()){
  if(!layer)return;const scene=viewScene(view),cfg=state.configs.get(scene),url=configUrl(scene);document.body.dataset.amqScene=scene;document.body.classList.toggle('amq-custom-bg-active',!!url);layer.classList.toggle('amq-has-scene-image',!!url);
  layer.style.setProperty('--amq-scene-image',cssUrl(url));layer.style.setProperty('--amq-scene-dim',String(safeDim(cfg?.dim)));layer.style.setProperty('--amq-scene-fit',safeFit(cfg?.fit));layer.style.setProperty('--amq-scene-position',safePos(cfg?.position));
 }
 function applyDetail(){const drawer=$('#overlay .drawer');if(!drawer)return;const cfg=state.configs.get('detail'),url=configUrl('detail');drawer.classList.toggle('amq-scene-detail-bg',!!url);if(url){drawer.style.setProperty('--amq-detail-image',cssUrl(url));drawer.style.setProperty('--amq-detail-dim',String(safeDim(cfg?.dim)));drawer.style.setProperty('--amq-detail-fit',safeFit(cfg?.fit));drawer.style.setProperty('--amq-detail-position',safePos(cfg?.position));}else{for(const prop of ['--amq-detail-image','--amq-detail-dim','--amq-detail-fit','--amq-detail-position'])drawer.style.removeProperty(prop)}}
 function currentDetailOpen(){const overlay=$('#overlay');if(!overlay)return false;const cs=getComputedStyle(overlay);return !overlay.hidden&&cs.display!=='none'&&cs.visibility!=='hidden'&&Number(cs.opacity||1)!==0}
 function applyDialogBg(){if(!modal)return;const cfg=state.configs.get('settings'),url=configUrl('settings');if(url){modal.classList.add('amq-settings-has-bg');modal.style.setProperty('--amq-settings-image',cssUrl(url));modal.style.setProperty('--amq-settings-dim',String(safeDim(cfg?.dim)));modal.style.setProperty('--amq-settings-fit',safeFit(cfg?.fit));modal.style.setProperty('--amq-settings-position',safePos(cfg?.position));}else{modal.classList.remove('amq-settings-has-bg');for(const p of ['--amq-settings-image','--amq-settings-dim','--amq-settings-fit','--amq-settings-position'])modal.style.removeProperty(p)}}
 function currentPreviewUrl(){const previewUrl=state.tempUrl||configUrl(sceneSelect.value);return previewUrl}
 function updatePreview(){if(!preview)return;const url=currentPreviewUrl(),dim=safeDim(Number(opacityInput.value)/100),fit=safeFit(fitSelect.value),pos=safePos(posSelect.value);preview.style.backgroundImage=url?`linear-gradient(rgba(14,10,20,${dim}),rgba(14,10,20,${dim})),${cssUrl(url)}`:'none';preview.style.backgroundSize=url?`cover,${fit}`:'cover';preview.style.backgroundPosition=url?`center,${pos}`:'center';preview.style.backgroundRepeat='no-repeat,no-repeat';preview.style.backgroundColor='var(--surface-muted)';preview.querySelector('span').textContent=url?`${sceneLabels[sceneSelect.value]} · 背景預覽`:'尚未設定背景';applyBtn.disabled=state.busy||!url;if(applyAllBtn)applyAllBtn.disabled=state.busy||!url;clearBtn.disabled=state.busy||!state.configs.has(sceneSelect.value)}
 function status(message,kind='info'){if(!statusEl)return;statusEl.textContent=message;statusEl.dataset.kind=kind}
 function resetTemp(){state.tempBlob=null;state.tempName='';if(state.tempUrl){try{URL.revokeObjectURL(state.tempUrl)}catch{}state.tempUrl=''}if(fileInput)fileInput.value=''}
 function fillSettings(scene){resetTemp();const cfg=state.configs.get(scene);opacityInput.value=String(Math.round(safeDim(cfg?.dim)*100));fitSelect.value=safeFit(cfg?.fit);posSelect.value=safePos(cfg?.position);status(cfg?(cfg.name?`目前圖片：${cfg.name}`:'此場景已設定背景。'):'此場景使用預設背景。');updatePreview();applyDialogBg()}
 async function readSceneFile(file){if(!file)throw new Error('請先選擇背景圖片。');if(!/^image\/(png|jpeg|webp|gif)$/i.test(file.type))throw new Error('只接受 PNG、JPG、WebP 或 GIF 圖片。');if(file.size<=0||file.size>MAX_FILE_BYTES)throw new Error('圖片大小需大於 0，且不可超過 12 MB。');let bitmap;try{bitmap=await createImageBitmap(file)}catch{throw new Error('無法讀取這張圖片，請改用 PNG、JPG、WebP 或 GIF。')}try{if(bitmap.width>MAX_DIMENSION||bitmap.height>MAX_DIMENSION||bitmap.width*bitmap.height>MAX_PIXELS)throw new Error('圖片尺寸過大；寬高不可超過 8192 px，總像素不可超過 4000 萬。')}finally{bitmap.close?.()}return file}
 async function applySelected(){if(state.busy)return;const scene=sceneSelect.value;let old=state.configs.get(scene),blob=state.tempBlob||old?.blob;if(!(blob instanceof Blob)){status('請先選擇一張圖片。','error');return}state.busy=true;applyBtn.disabled=true;clearBtn.disabled=true;status('正在儲存背景圖片…');try{const name=state.tempName||(old?.name||'背景圖片'),record={scene,name,blob,dim:safeDim(Number(opacityInput.value)/100),fit:safeFit(fitSelect.value),position:safePos(posSelect.value),updatedAt:Date.now()};await tx('readwrite',store=>store.put(record));state.configs.set(scene,record);makeUrl(scene,blob);resetTemp();applyScene();applyDetail();applyDialogBg();fillSettings(scene);notify(`已保存「${sceneLabels[scene]}」背景。`)}catch(e){console.error('Scene background save failed:',e);status(`保存失敗：${e?.message||'瀏覽器儲存空間不足。'} 原有背景未主動刪除。`,'error');notify('背景圖片保存失敗；原有背景已保留。')}finally{state.busy=false;updatePreview()}}
 async function applyAllSelected(){if(state.busy)return;const scene=sceneSelect.value,old=state.configs.get(scene),blob=state.tempBlob||old?.blob;if(!(blob instanceof Blob)){status('請先選擇一張圖片，或選取已有背景的場景。','error');return}state.busy=true;applyBtn.disabled=true;if(applyAllBtn)applyAllBtn.disabled=true;clearBtn.disabled=true;status(`正在儲存至全部 ${sceneKeys.length} 個介面…`);const name=state.tempName||(old?.name||'背景圖片'),dim=safeDim(Number(opacityInput.value)/100),fit=safeFit(fitSelect.value),position=safePos(posSelect.value),records=sceneKeys.map(target=>({scene:target,name,blob,dim,fit,position,updatedAt:Date.now()}));try{await tx('readwrite',store=>{for(const record of records)store.put(record)});for(const record of records){state.configs.set(record.scene,record);makeUrl(record.scene,record.blob)}resetTemp();applyScene();applyDetail();applyDialogBg();fillSettings(scene);status(`已套用至全部 ${sceneKeys.length} 個介面。`, 'success');notify(`背景圖片已套用至全部 ${sceneKeys.length} 個介面。`)}catch(e){console.error('Apply background to all scenes failed:',e);status(`套用失敗：${e?.message||'瀏覽器儲存空間不足。'} 原有背景未主動刪除。`,'error');notify('套用所有介面背景失敗；原有背景已保留。')}finally{state.busy=false;updatePreview()}}
async function clearSelected(){if(state.busy)return;const scene=sceneSelect.value;if(!state.configs.has(scene)){status('這個場景目前沒有自訂背景。');return}if(!confirm(`確定清除「${sceneLabels[scene]}」的背景圖片？其他場景與學習資料不會改變。`))return;state.busy=true;try{await tx('readwrite',store=>store.delete(scene));state.configs.delete(scene);revokeUrl(scene);resetTemp();applyScene();applyDetail();applyDialogBg();fillSettings(scene);notify(`已清除「${sceneLabels[scene]}」背景。`)}catch(e){console.error('Scene background clear failed:',e);status(`清除失敗：${e?.message||'瀏覽器儲存錯誤。'}`,'error')}finally{state.busy=false;updatePreview()}}
 function openModal(){if(!modal||!shadeEl)return;shadeEl.hidden=false;shadeEl.setAttribute('aria-hidden','false');const cur=viewScene();sceneSelect.value=cur;fillSettings(cur);applyDialogBg();$('#sceneBgClose')?.focus({preventScroll:true})}
 function closeModal(){if(!modal||!shadeEl)return;resetTemp();shadeEl.hidden=true;shadeEl.setAttribute('aria-hidden','true');$('#sceneBackgroundOpen')?.focus({preventScroll:true})}
 function installModal(){const shade=document.createElement('div');shade.id='amqSceneBgShade';shade.hidden=true;shade.setAttribute('aria-hidden','true');shade.innerHTML=`<section id="amqSceneBgDialog" role="dialog" aria-modal="true" aria-labelledby="sceneBgTitle" tabindex="-1"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px"><div><h2 id="sceneBgTitle">自訂場景背景</h2><p class="sceneBgIntro">圖片保存在目前瀏覽器，不會上傳到伺服器；匯出完整備份時會一併包含各介面的背景圖片。</p></div><button type="button" class="btn" id="sceneBgClose" aria-label="關閉背景設定">×</button></div><div class="sceneBgGrid"><div><div class="sceneBgField"><label for="sceneBgScene">要設定的場景</label><select id="sceneBgScene">${sceneKeys.map(k=>`<option value="${k}">${sceneLabels[k]}</option>`).join('')}</select></div><div class="sceneBgField"><label for="sceneBgFile">背景圖片（PNG／JPG／WebP／GIF，最大 12 MB）</label><input id="sceneBgFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif"/></div><div class="sceneBgField"><label for="sceneBgDim">背景遮罩：<output id="sceneBgDimValue">28%</output></label><input id="sceneBgDim" type="range" min="0" max="80" step="5" value="30"/></div><div class="sceneBgField"><label for="sceneBgFit">圖片填滿方式</label><select id="sceneBgFit"><option value="cover">填滿場景（可能裁切）</option><option value="contain">完整顯示（可能留白）</option></select></div><div class="sceneBgField"><label for="sceneBgPosition">圖片焦點</label><select id="sceneBgPosition"><option value="center center">置中</option><option value="center top">靠上</option><option value="center bottom">靠下</option><option value="left center">靠左</option><option value="right center">靠右</option></select></div></div><div><div class="sceneBgPreview" id="sceneBgPreview"><span>尚未設定背景</span></div><p id="sceneBgStatus" class="sceneBgStatus" role="status" aria-live="polite">正在讀取背景設定…</p></div></div><div class="sceneBgActions"><button type="button" class="btn danger" id="sceneBgClear">清除此場景背景</button><button type="button" class="btn" id="sceneBgCancel">取消</button><button type="button" class="btn primary" id="sceneBgApply">套用到場景</button><button type="button" class="btn primary" id="sceneBgApplyAll">套用至全部 ${sceneKeys.length} 個介面</button></div></section>`;document.body.appendChild(shade);shadeEl=shade;modal=$('#amqSceneBgDialog',shade);sceneSelect=$('#sceneBgScene',shade);fileInput=$('#sceneBgFile',shade);opacityInput=$('#sceneBgDim',shade);fitSelect=$('#sceneBgFit',shade);posSelect=$('#sceneBgPosition',shade);preview=$('#sceneBgPreview',shade);statusEl=$('#sceneBgStatus',shade);applyBtn=$('#sceneBgApply',shade);applyAllBtn=$('#sceneBgApplyAll',shade);clearBtn=$('#sceneBgClear',shade);
  $('#sceneBgDimValue',shade).textContent=`${opacityInput.value}%`;$('#sceneBgDimValue',shade).value=opacityInput.value+'%';
  $('#sceneBackgroundOpen')?.addEventListener('click',openModal);$('#sceneBgClose',shade).addEventListener('click',closeModal);$('#sceneBgCancel',shade).addEventListener('click',closeModal);shade.addEventListener('click',e=>{if(e.target===shade)closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!shade.hidden)closeModal()});sceneSelect.addEventListener('change',()=>fillSettings(sceneSelect.value));
  opacityInput.addEventListener('input',()=>{$('#sceneBgDimValue',shade).textContent=opacityInput.value+'%';$('#sceneBgDimValue',shade).value=opacityInput.value+'%';updatePreview()});fitSelect.addEventListener('change',updatePreview);posSelect.addEventListener('change',updatePreview);
  fileInput.addEventListener('change',async()=>{const file=fileInput.files?.[0];resetTemp();if(!file){updatePreview();return}try{state.tempBlob=await readSceneFile(file);state.tempName=file.name.slice(0,180);state.tempUrl=URL.createObjectURL(state.tempBlob);status(`預覽中：${state.tempName}。按「套用到場景」後才會保存。`);updatePreview()}catch(e){resetTemp();status(e.message||'圖片無法使用。','error');updatePreview()}});
  applyBtn.addEventListener('click',applySelected);applyAllBtn.addEventListener('click',applyAllSelected);clearBtn.addEventListener('click',clearSelected);
 }
 async function init(){layer=document.createElement('div');layer.id='amqSceneBackgroundLayer';layer.setAttribute('aria-hidden','true');document.body.insertBefore(layer,document.body.firstChild);installModal();document.addEventListener('ani-app-navigation',()=>queueMicrotask(()=>applyScene(currentView())));document.addEventListener('click',e=>{if(e.target.closest?.('#customModeTab,#watchModeTab'))queueMicrotask(()=>applyScene(currentView()))},true);document.addEventListener('click',e=>{if(e.target.closest?.('#close'))queueMicrotask(applyDetail)},true);const overlay=$('#overlay');if(overlay){detailObserver=new MutationObserver(()=>{applyDetail()});detailObserver.observe(overlay,{attributes:true,attributeFilter:['class','style','hidden']})}
  try{state.db=await openDb();state.ready=true;for(const rec of await getAll()){if(rec&&sceneKeys.includes(rec.scene)&&rec.blob instanceof Blob){state.configs.set(rec.scene,rec);makeUrl(rec.scene,rec.blob)}}applyScene();applyDetail();applyDialogBg();if(statusEl)status('背景設定已載入。')}catch(e){console.warn('Scene background storage unavailable:',e);notify(`場景背景暫不可用：${e?.message||'IndexedDB 無法存取。'}`);applyScene()}
 }
 readyPromise=init();
 window.__aniSceneBackgroundsV1=Object.freeze({list:()=>Object.fromEntries([...state.configs].map(([k,v])=>[k,{name:v.name,dim:v.dim,fit:v.fit,position:v.position,updatedAt:v.updatedAt}])),getScene:viewScene,refresh:()=>{applyScene();applyDetail();applyDialogBg()},exportBackup:async()=>{await readyPromise;const records=(await getAll()).filter(r=>r&&sceneKeys.includes(r.scene)&&r.blob instanceof Blob),assets=[],scenes=[],assetKeys=new Map();let totalBytes=0;for(const r of records){let binary='',bytes=new Uint8Array(await r.blob.arrayBuffer());for(let i=0;i<bytes.length;i+=32768)binary+=String.fromCharCode(...bytes.subarray(i,Math.min(i+32768,bytes.length)));const base64=btoa(binary),sig=r.blob.type+'|'+base64;let assetKey=assetKeys.get(sig);if(!assetKey){totalBytes+=r.blob.size;if(totalBytes>60*1024*1024)throw new Error('自訂背景圖片總量超過完整備份的 60 MB 安全上限；請先減少或壓縮背景圖片。');assetKey='asset'+(assets.length+1);assetKeys.set(sig,assetKey);assets.push({key:assetKey,type:r.blob.type,size:r.blob.size,base64})}scenes.push({scene:r.scene,name:String(r.name||'背景圖片'),dim:safeDim(r.dim),fit:safeFit(r.fit),position:safePos(r.position),updatedAt:Number(r.updatedAt)||Date.now(),assetKey})}return {schemaVersion:1,assets,scenes}},prepareBackupRestore:async data=>{await readyPromise;const allowedTypes=new Set(['image/png','image/jpeg','image/webp','image/gif']);if(!data||data.schemaVersion!==1||!Array.isArray(data.assets)||!Array.isArray(data.scenes)||data.assets.length>sceneKeys.length||data.scenes.length>sceneKeys.length)throw new Error('完整備份中的背景資料結構不正確。');const assetMap=new Map();let totalBytes=0;for(const a of data.assets){if(!a||typeof a.key!=='string'||assetMap.has(a.key)||!allowedTypes.has(a.type)||typeof a.base64!=='string'||!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(a.base64))throw new Error('完整備份中的背景圖片資料不正確。');const binary=atob(a.base64);if(binary.length!==Number(a.size)||binary.length<=0||binary.length>MAX_FILE_BYTES)throw new Error('背景圖片大小或內容不正確。');totalBytes+=binary.length;if(totalBytes>60*1024*1024)throw new Error('背景圖片總量超過 60 MB 上限。');const bytes=new Uint8Array(binary.length);for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);assetMap.set(a.key,new Blob([bytes],{type:a.type}))}const seen=new Set(),prepared=[];for(const r of data.scenes){if(!r||!sceneKeys.includes(r.scene)||seen.has(r.scene)||!assetMap.has(r.assetKey))throw new Error('背景場景清單包含無效或重複項目。');seen.add(r.scene);prepared.push({scene:r.scene,name:String(r.name||'背景圖片').slice(0,180),blob:assetMap.get(r.assetKey),dim:safeDim(r.dim),fit:safeFit(r.fit),position:safePos(r.position),updatedAt:Number(r.updatedAt)||Date.now()})}if(!prepared.length&&data.assets.length)throw new Error('背景備份包含圖片但沒有場景參照。');return prepared},restoreBackup:async records=>{await readyPromise;if(!Array.isArray(records))throw new Error('背景還原資料不正確。');await tx('readwrite',store=>{store.clear();for(const r of records){if(!r||!sceneKeys.includes(r.scene)||!(r.blob instanceof Blob))throw new Error('背景還原資料包含無效場景。');store.put(r)}});for(const key of state.configs.keys())revokeUrl(key);state.configs.clear();for(const r of records){state.configs.set(r.scene,r);makeUrl(r.scene,r.blob)}applyScene();applyDetail();applyDialogBg();if(sceneSelect)fillSettings(viewScene());return true}});

})();
</script>