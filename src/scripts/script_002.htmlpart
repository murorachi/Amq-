<script>
(()=>{
// App navigation and personal watchlist view.
let activeView='home', watchFilter='all';
const watchStatusLabels={current:'觀看中',completed:'已看完',paused:'暫停',dropped:'已棄番',planning:'計畫觀看',repeating:'重看中'};
function showView(view){
 const allowed=new Set(['home','explore','catalog','watchlist','dashboard','learningPlan','practice','quiz','multiplayer']);if(!allowed.has(view))view='home';
 const previousView=activeView,body=document.body,wasQuiz=body.classList.contains('quiz-mode');activeView=view;
 body.classList.remove('ui-home-menu','ui-settings-open','ui-explore-open','multiplayer-mode');
 if(view!=='quiz'&&wasQuiz)window.__aniDeactivateQuizV82?.();
 const onHome=view==='home'||view==='explore';document.querySelectorAll('.view-home').forEach(el=>el.classList.toggle('hidden',!onHome));
 document.querySelectorAll('.view-catalog').forEach(el=>el.classList.toggle('hidden',view!=='catalog'));
 document.getElementById('watchlistView')?.classList.toggle('hidden',view!=='watchlist');
 document.getElementById('dashboardPanel')?.classList.toggle('hidden',view!=='dashboard');document.getElementById('learningPlanPanel')?.classList.toggle('hidden',view!=='learningPlan'&&view!=='practice');
 const quizView=document.getElementById('quizView');if(quizView)quizView.classList.toggle('hidden',view!=='quiz');
 const multiplayerView=document.getElementById('multiplayerView');if(multiplayerView)multiplayerView.classList.toggle('hidden',view!=='multiplayer');
 if(view==='home')body.classList.add('ui-home-menu');else if(view==='explore')body.classList.add('ui-explore-open');else if(view==='multiplayer')body.classList.add('multiplayer-mode');
 if(view==='catalog'){if(!['all','progress','unexplored','artists'].includes(tab))tab='all';document.querySelectorAll('.tabs .tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));render()}
 if(view==='watchlist')renderWatchlist();
 if(view==='dashboard'){if(typeof renderDashboardV10==='function')renderDashboardV10();window.__aniRenderLearningInsightsV82?.()}
 if(view==='practice'||view==='learningPlan')window.__aniRenderPracticeHubV825?.();
 if(view==='quiz'){body.classList.remove('relations-mode');window.__aniEnterQuizV82?.()}
 document.dispatchEvent(new CustomEvent('ani-app-navigation',{detail:{view,previousView}}));window.scrollTo({top:0,behavior:'instant'});
}
window.__aniNavigateApp=showView;window.__aniGetActiveViewV82=()=>activeView;
function renderWatchlist(){const q=(document.getElementById('watchSearch')?.value||'').trim().toLowerCase(),sort=document.getElementById('watchSort')?.value||'name';let items=anime.filter(a=>watchStatus(a[0])!=='none'&&(watchFilter==='all'||watchStatus(a[0])===watchFilter));if(q)items=items.filter(a=>(a[1]+' '+a[2]).toLowerCase().includes(q));if(sort==='year')items.sort((a,b)=>(b[5]||0)-(a[5]||0)||a[1].localeCompare(b[1]));else if(sort==='status')items.sort((a,b)=>(Object.keys(watchStatusLabels).indexOf(watchStatus(a[0]))-Object.keys(watchStatusLabels).indexOf(watchStatus(b[0])))||a[1].localeCompare(b[1]));else items.sort((a,b)=>a[1].localeCompare(b[1]));const grid=document.getElementById('watchGrid');grid.innerHTML='';const all=anime.filter(a=>watchStatus(a[0])!=='none');document.getElementById('watchSummary').textContent=`${items.length.toLocaleString()} 部作品 · 清單共 ${all.length.toLocaleString()} 部`;document.querySelectorAll('.watchTab').forEach(b=>{b.classList.toggle('active',b.dataset.watch===watchFilter);const n=all.filter(a=>watchFilter==='all'?true:watchStatus(a[0])===b.dataset.watch).length;b.textContent=(b.dataset.watch==='all'?'全部':watchStatusLabels[b.dataset.watch])+' '+n});for(const a of items){const card=document.createElement('article');card.className='watchCard';card.dataset.animeId=String(a[0]);const [c1,c2]=colors(a);card.innerHTML=`<div class="watchCardTop"><div class="watchCover" style="background:linear-gradient(145deg,${c1},${c2})"><span>♫</span><img class="realcover" alt="" loading="lazy" style="display:block"></div><div style="min-width:0"><div class="watchCardName">${esc(a[1])}</div><div class="watchCardMeta">${esc(a[5]||'年代未知')} · ${esc(a[4]||'作品')}</div><div class="watchCardMeta">${(songMap.get(a[0])||[]).length} 首歌曲</div></div></div><select aria-label="動畫觀看狀態" data-status><option value="current">觀看中</option><option value="completed">已看完</option><option value="paused">暫停</option><option value="dropped">已棄番</option><option value="planning">計畫觀看</option><option value="repeating">重看中</option><option value="none">移出清單</option></select><div class="watchCardActions"><button class="btn" data-open>作品詳情</button></div>`;const watchCoverImg=card.querySelector('.realcover');watchCoverImg.dataset.mal=String(a[6]||'');if('IntersectionObserver' in window){const watchCoverObserver=new IntersectionObserver(entries=>{entries.forEach(en=>{if(en.isIntersecting){queueCoverV6(a,watchCoverImg);watchCoverObserver.disconnect()}})},{rootMargin:'180px'});watchCoverObserver.observe(watchCoverImg)}else queueCoverV6(a,watchCoverImg);card.querySelector('.watchCardTop').addEventListener('click',()=>openAnime(a[0]));const select=card.querySelector('[data-status]');select.value=watchStatus(a[0]);select.onchange=()=>{setWatchStatus(a[0],select.value);renderWatchlist();if(activeView==='catalog')render()};card.querySelector('[data-open]').onclick=()=>openAnime(a[0]);grid.appendChild(card)}document.getElementById('watchEmpty').classList.toggle('hidden',items.length>0)}
window.renderWatchlistV5=renderWatchlist;
document.getElementById('watchSearch').addEventListener('input',renderWatchlist);document.getElementById('watchSort').addEventListener('change',renderWatchlist);document.querySelectorAll('.watchTab').forEach(b=>b.addEventListener('click',()=>{watchFilter=b.dataset.watch;renderWatchlist()}));
// Keep the dedicated list current after imports and bulk status changes.
showView('home');renderWatchlist();

})();
</script>