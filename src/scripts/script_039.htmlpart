<script id="v82-49-vn-library-navigation-script">
(()=>{
'use strict';
const $=id=>document.getElementById(id), safe=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])), API='https://api.vndb.org/kana';
const SOURCE_KEY='aniQuizSettingsV14', VN_LIST_KEY='aniVNWatchlistV1', COVER_KEY='aniVNDBCoversV8249';
const state={catalogKind:'anime',listKind:'anime',homeGroup:'',workId:'',artist:'',search:'',year:'all',renderLimit:72,vnListSearch:'',vnListStatus:'all',vnList:[],vnDetails:new Map(),covers:{},coverLoading:new Set(),coverFailed:new Set(),busy:false};
try{state.covers=JSON.parse(localStorage.getItem(COVER_KEY)||'{}')||{}}catch{state.covers={}}
function api(){return window.__aniEmqAPI}
function works(){return (api()?.getWorks?.()||[]).filter(w=>w.vndbId)}
function songRows(){return api()?.getRows?.()||[]}
function titleOfWork(w){const d=state.vnDetails.get(String(w?.vndbId||''));return String(d?.title||w?.t||w?.n||'未知作品')}
function aliasesOfWork(w){const d=state.vnDetails.get(String(w?.vndbId||''));return [...new Set([w?.t,w?.n,...(Array.isArray(w?.wa)?w.wa:[]),d?.title,d?.alttitle,...(Array.isArray(d?.aliases)?d.aliases:[])].map(x=>String(x||'').trim()).filter(Boolean))]}
function coverFor(w){const d=state.vnDetails.get(String(w?.vndbId||''));return String(d?.image?.thumbnail||d?.image?.url||state.covers[String(w?.vndbId||'')]||'')}
function saveCoverCache(){try{const entries=Object.entries(state.covers);if(entries.length>1800)state.covers=Object.fromEntries(entries.slice(-1800));localStorage.setItem(COVER_KEY,JSON.stringify(state.covers))}catch{}}
function status(root,msg,kind=''){if(!root)return;root.textContent=msg||'';root.classList.toggle('error',kind==='error');root.classList.toggle('success',kind==='success')}
function emqReady(){return !!api()?.ready}
function appendViews(){const wrap=document.querySelector('.wrap');if(!wrap)return; if(!$('vnCatalogView')){const sec=document.createElement('section');sec.id='vnCatalogView';sec.className='vn49View hidden';sec.hidden=true;sec.innerHTML=`<header class="vn49Header"><div><div class="sectionLabel">VNDB · EMQ CATALOGUE</div><h2>VN 圖鑑</h2><p>從 EMQ 曲庫的 VNDB 關聯整理作品。封面與補充標題由 VNDB API 取得；作品是否有歌曲，以 EMQ 曲庫實際收錄為準。</p></div><button class="btn" type="button" data-vn49-home>返回主選單</button></header><section class="vn49Panel"><div class="vn49Toolbar"><input id="vn49Search" type="search" autocomplete="off" placeholder="搜尋遊戲名稱、別名或 VNDB ID"><select id="vn49Year"><option value="all">所有年代</option><option value="old">2000 年以前</option><option value="2000">2000–2009</option><option value="2010">2010–2019</option><option value="2020">2020 年以後</option></select><button class="btn" id="vn49Clear" type="button">清除篩選</button></div><div class="vn49SourceInfo">封面採用 VNDB API 提供的 thumbnail／image URL，不把封面檔另存到 HTML。若瀏覽器封鎖跨網域請求，圖鑑仍能搜尋 EMQ 已知作品，但封面會顯示未載入狀態。</div><div id="vn49CatalogStatus" class="vn49Status" role="status" aria-live="polite"></div><button class="btn" id="vn49RetryCovers" type="button" hidden>重新載入 VNDB 封面</button></section><section id="vn49SongPanel" class="vn49Panel" hidden></section><div id="vn49Grid" class="vn49Grid"></div><div class="vn49Toolbar"><button class="btn" id="vn49More" type="button">載入更多作品</button><span id="vn49Count" class="vn49Small"></span></div></section>`;wrap.append(sec)}
if(!$('vnListView')){const sec=document.createElement('section');sec.id='vnListView';sec.className='vn49View hidden';sec.hidden=true;sec.innerHTML=`<header class="vn49Header"><div><div class="sectionLabel">VNDB · PERSONAL LIST</div><h2>VN 清單</h2><p>用 VNDB 使用者名稱匯入自己的視覺小說清單。清單資料獨立保存於這個瀏覽器，不會改動「動漫清單」或「自訂清單」。</p></div><button class="btn" type="button" data-vn49-home>返回主選單</button></header><section class="vn49Panel"><div class="vn49ImportForm"><div class="vn49Form"><label for="vn49User">VNDB 使用者名稱或 ID</label><input id="vn49User" autocomplete="username" placeholder="VNDB username 或 u123"></div><div class="vn49Form"><label for="vn49Token">VNDB API Token（可留空）</label><input id="vn49Token" type="password" autocomplete="off" placeholder="只在本次匯入使用，不會保存"></div><div class="vn49Small vn49Full">公開清單可先不填 Token。若你的清單為私人清單，需提供具有 listread 權限的 Token。請不要提供 VNDB 帳號密碼。</div><div class="vn49Toolbar vn49Full"><button class="btn primary" id="vn49Import" type="button">匯入 VNDB 清單</button><button class="btn" id="vn49Reload" type="button">重新載入本機清單</button></div></div><div id="vn49ImportStatus" class="vn49Status" role="status" aria-live="polite"></div></section><section class="vn49Panel"><div class="vn49Toolbar"><input id="vn49ListSearch" type="search" placeholder="搜尋你的 VN 清單"><select id="vn49ListStatus"><option value="all">所有狀態</option><option value="playing">正在玩</option><option value="finished">已完成</option><option value="wishlist">想玩</option><option value="stalled">擱置</option><option value="dropped">已放棄</option><option value="other">其他／未分類</option></select><span id="vn49ListCount" class="vn49Small"></span></div><div id="vn49ListGrid" class="vn49Grid"></div></section></section>`;wrap.append(sec)}}
function addHomeGroups(){const nav=$('amqHomePrimaryNav');if(!nav||nav.dataset.vn49Ready==='1')return;nav.dataset.vn49Ready='1';const old=$('amqLearningCenterSubmenu');old?.remove();nav.innerHTML=`<button class="home-menu-card home-menu-quiz" type="button" data-vn49-action="group" data-group="mode"><span class="home-card-copy"><b>模式選擇</b></span><i aria-hidden="true"></i></button><button class="home-menu-card home-menu-catalog" type="button" data-vn49-action="group" data-group="catalog"><span class="home-card-copy"><b>動漫遊戲</b></span><i aria-hidden="true"></i></button><button class="home-menu-card home-menu-learning-center" type="button" data-vn49-action="group" data-group="learning" aria-haspopup="true"><span class="home-card-copy"><b>學習中心</b></span><i aria-hidden="true"></i></button><button class="home-menu-card home-menu-watchlist" type="button" data-vn49-action="group" data-group="lists" aria-haspopup="true"><span class="home-card-copy"><b>收藏清單</b></span><i aria-hidden="true"></i></button>`;
const sub=document.createElement('section');sub.id='amqHomeSubmenuV8249';sub.className='amqLearningCenterSubmenu vn49GroupSubnav';sub.hidden=true;sub.setAttribute('aria-label','主要功能子項目');nav.insertAdjacentElement('afterend',sub);sub.innerHTML='<div class="amqHomeSubmenuHead"><button type="button" class="amqSubmenuBack" data-vn49-action="back">‹ 返回</button><strong id="vn49SubTitle">功能</strong></div><nav class="home-menu-list amqHomePrimaryGrid" id="vn49SubItems"></nav>';
}
const GROUPS={mode:{title:'模式選擇',items:[['單人猜歌','navigate','quiz'],['多人對戰','navigate','multiplayer']]},catalog:{title:'動漫遊戲',items:[['動畫圖鑑','navigate','catalog'],['VN 圖鑑','navigate','vnCatalog']]},learning:{title:'學習中心',items:[['學習計畫','navigate','learningPlan'],['統計儀表板','navigate','dashboard']]},lists:{title:'收藏清單',items:[['動漫清單','navigate','watchlist'],['VN 清單','navigate','vnList'],['自訂清單','navigate','customLists']]}};
function showGroup(group){const nav=$('amqHomePrimaryNav'),sub=$('amqHomeSubmenuV8249');if(!nav||!sub||!GROUPS[group])return;state.homeGroup=group;nav.hidden=true;sub.hidden=false;$('vn49SubTitle').textContent=GROUPS[group].title;$('vn49SubItems').innerHTML=GROUPS[group].items.map(([label,act,dest])=>`<button class="home-menu-card" type="button" data-vn49-action="${act}" data-dest="${dest}"><span class="home-card-copy"><b>${label}</b></span><i aria-hidden="true"></i></button>`).join('');sub.querySelector('[data-vn49-action="navigate"]')?.focus({preventScroll:true})}
function showHomeGroups(){const nav=$('amqHomePrimaryNav'),sub=$('amqHomeSubmenuV8249');state.homeGroup='';if(nav)nav.hidden=false;if(sub)sub.hidden=true}
function saveMode(kind,value){state[kind]=value}
function openVnCatalog(opts={}){state.catalogKind='vn';state.workId=opts.workId?String(opts.workId):'';state.artist=opts.artist||'';state.search=opts.search||'';state.renderLimit=72;window.__aniNavigateApp?.('catalog')}
function openVnList(){state.listKind='vn';window.__aniNavigateApp?.('watchlist')}
function goTo(dest){window.__aniSetHomeMenuOpenV846?.(false);showHomeGroups();if(dest==='vnCatalog'){openVnCatalog();return}if(dest==='vnList'){openVnList();return}if(dest==='customLists'){state.listKind='anime';window.__aniNavigateApp?.('watchlist');setTimeout(()=>$('customModeTab')?.click(),0);return}state.catalogKind='anime';state.listKind='anime';window.__aniNavigateApp?.(dest)}
function toggleViews(view){const vnCat=$('vnCatalogView'),vnList=$('vnListView'),catalogs=[...document.querySelectorAll('.view-catalog')],watch=$('watchlistView');if(vnCat){const show=view==='catalog'&&state.catalogKind==='vn';vnCat.hidden=!show;vnCat.classList.toggle('hidden',!show);catalogs.forEach(el=>el.classList.toggle('hidden',view!=='catalog'||show));if(show)renderVnCatalog()}if(vnList){const show=view==='watchlist'&&state.listKind==='vn';vnList.hidden=!show;vnList.classList.toggle('hidden',!show);if(watch)watch.classList.toggle('hidden',view!=='watchlist'||show);if(show)renderVnList()}}
function coverMarkup(url,title,id=''){return url?`<img class="vn49Cover" loading="lazy" src="${safe(url)}" alt="${safe(title)} 封面" data-vn49-cover data-vn49-id="${safe(id)}" data-vn49-title="${safe(title)}">`:`<div class="vn49CoverFallback">封面尚未載入<br><span class="vn49Small">${safe(title)}</span></div>`}
function workSongs(w){return api()?.getSongsForWork?.(w.i)||[]}
function songType(s){return ({1:'OP／片頭曲',2:'ED／片尾曲',3:'插入歌',4:'其他歌曲',5:'未分類'})[Number(s?.[2])||5]||'未分類'}
function renderSongRows(rows){if(!rows.length)return '<div class="vn49Status">這個作品目前沒有收錄在已匯入的 EMQ 曲庫裡的歌曲。</div>';return `<div class="vn49SongList">${rows.map(s=>`<div class="vn49SongRow"><div><div class="vn49SongTitle">${safe(s[4]||'未命名歌曲')}</div><div class="vn49Small">${safe((api()?.getMeta?.(s[1])||{}).workTitle||'')}</div></div><div><button type="button" class="vn49TopLink" data-vn49-artist="${safe(s[5]||'')}" title="查看這位歌手收錄的歌曲">${safe(s[5]||'未標示歌手')}</button></div><div class="vn49Type">${safe(songType(s))}</div></div>`).join('')}</div>`}
function renderSelectedSongPanel(){const root=$('vn49SongPanel');if(!root)return;let list=[],title='',meta='';if(state.workId){const w=api()?.getWork?.(state.workId);if(!w){root.hidden=true;root.innerHTML='';return}list=workSongs(w);title=titleOfWork(w);meta=`VNDB：${safe(w.vndbId||'無連結')} · ${list.length.toLocaleString()} 首 EMQ 曲目`;root.innerHTML=`<div class="vn49Header"><div><h3>${safe(title)}</h3><div class="vn49Meta">${meta}</div></div><div class="vn49Buttons"><button type="button" class="btn" id="vn49BackSongs">返回 VN 圖鑑</button>${w.vndbId?`<a class="vn49LinkButton" href="https://vndb.org/${safe(w.vndbId)}" target="_blank" rel="noopener noreferrer">開啟 VNDB</a>`:''}</div></div>${coverMarkup(coverFor(w),title,w.vndbId).replace('class="vn49Cover"','class="vn49Cover" style="width:150px;height:200px;border-radius:8px"')}${renderSongRows(list)}`;root.hidden=false;if(w.vndbId)ensureCoverDetails([w]);return}
if(state.artist){list=api()?.getSongsByArtist?.(state.artist)||[];title=`歌手：${state.artist}`;root.innerHTML=`<div class="vn49Header"><div><h3>${safe(title)}</h3><div class="vn49Meta">共 ${list.length.toLocaleString()} 首 EMQ 曲目</div></div><button type="button" class="btn" id="vn49BackSongs">返回 VN 圖鑑</button></div>${renderSongRows(list)}`;root.hidden=false;return}
root.hidden=true;root.innerHTML=''}
function filteredWorks(){const query=state.search.trim().toLocaleLowerCase(),year=state.year;return works().filter(w=>{const meta=state.vnDetails.get(String(w.vndbId||''));const text=[...aliasesOfWork(w),w.vndbId||'',meta?.released||''].join(' ').toLocaleLowerCase();if(query&&!text.includes(query))return false;const y=Number(String(meta?.released||w.y||'').slice(0,4))||Number(w.y)||0;if(year==='old'&&(!y||y>=2000))return false;if(year==='2000'&&(y<2000||y>2009))return false;if(year==='2010'&&(y<2010||y>2019))return false;if(year==='2020'&&y<2020)return false;return true}).sort((a,b)=>String(a.t||a.n||a.vndbId||'').localeCompare(String(b.t||b.n||b.vndbId||''),'en'))}
async function ensureCoverDetails(targetWorks){
 const items=targetWorks.filter(w=>w?.vndbId&&!state.vnDetails.has(String(w.vndbId))&&!state.coverLoading.has(String(w.vndbId))&&!state.coverFailed.has(String(w.vndbId)));
 if(!items.length)return;
 const failed=[];let received=0;
 for(let start=0;start<items.length;start+=30){
  const ids=items.slice(start,start+30).map(w=>String(w.vndbId));ids.forEach(id=>state.coverLoading.add(id));
  try{
   const res=await fetch(`${API}/vn`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filters:ids.length===1?['id','=',ids[0]]:['or',...ids.map(id=>['id','=',id])],fields:'id,title,alttitle,aliases,released,image{url,thumbnail,sexual,violence}',results:ids.length,sort:'id'})});
   if(!res.ok){const err=new Error(`VNDB HTTP ${res.status}`);err.status=res.status;throw err}
   const data=await res.json();const found=Array.isArray(data.results)?data.results:(Array.isArray(data.items)?data.items:[]);const got=new Set();
   for(const d of found){if(!d?.id)continue;const id=String(d.id);got.add(id);state.vnDetails.set(id,d);if(d.image?.thumbnail||d.image?.url)state.covers[id]=d.image.thumbnail||d.image.url;received++}
   for(const id of ids)if(!got.has(id))state.vnDetails.set(id,{id,image:null});
  }catch(e){ids.forEach(id=>{state.coverFailed.add(id);failed.push(id)})}
  finally{ids.forEach(id=>state.coverLoading.delete(id))}
 }
 saveCoverCache();
 if(!$('vnCatalogView')?.hidden)renderVnCatalog(false);else if(state.workId)renderSelectedSongPanel();
 const root=$('vn49CatalogStatus'),retry=$('vn49RetryCovers');
 if(retry)retry.hidden=!failed.length;
 if(root&&failed.length)status(root,`VNDB 封面查詢失敗 ${failed.length} 筆（已取得 ${received} 筆補充資料）。可能是外部 API／跨網域連線暫時不可用；可按「重新載入 VNDB 封面」重試。`,'error');
 else if(root&&received===0&&items.length)status(root,'VNDB 已回應，但目前顯示的作品沒有可用封面；仍可透過作品名稱與 VNDB 連結查看。');
 else if(root&&!state.workId&&!state.artist)status(root,`封面資料已取得 ${received} 筆。若個別封面圖片失效，會自動嘗試原始圖片網址。`,'success');
}
window.__aniVnCoverAPIv857={async getCoverUrl(workId){let w=api()?.getWork?.(String(workId))||api()?.getWork?.(Number(workId));if(!w)return '';let url=coverFor(w);if(url)return url;if(w.vndbId){if(!state.vnDetails.has(String(w.vndbId))&&!state.coverLoading.has(String(w.vndbId))&&!state.coverFailed.has(String(w.vndbId)))await ensureCoverDetails([w]);url=coverFor(w)}return url||''},getCachedCover(workId){const w=api()?.getWork?.(String(workId))||api()?.getWork?.(Number(workId));return w?coverFor(w):''}};
async function retryVisibleCovers(){
 const targets=state.workId?[api()?.getWork?.(state.workId)].filter(Boolean):state.artist?[]:filteredWorks().slice(0,state.renderLimit);
 if(!targets.length){status($('vn49CatalogStatus'),'目前沒有可重試的 VNDB 作品。');return}
 for(const w of targets){const id=String(w.vndbId||'');if(!id)continue;state.coverFailed.delete(id);state.vnDetails.delete(id);delete state.covers[id]}
 const retry=$('vn49RetryCovers');if(retry)retry.hidden=true;
 saveCoverCache();renderVnCatalog(false);await ensureCoverDetails(targets);
}
function handleVnCoverImageError(event){
 const img=event.target;if(!(img instanceof HTMLImageElement)||!img.matches('img[data-vn49-cover]'))return;
 const id=String(img.dataset.vn49Id||''),detail=state.vnDetails.get(id),full=String(detail?.image?.url||'');
 if(full&&full!==img.currentSrc&&full!==img.src&&img.dataset.vn49TriedFull!=='1'){img.dataset.vn49TriedFull='1';img.src=full;return}
 if(id){delete state.covers[id];state.coverFailed.add(id);saveCoverCache()}const retry=$('vn49RetryCovers');if(retry)retry.hidden=false;const catalogStatus=$('vn49CatalogStatus');if(catalogStatus&&!$('vnCatalogView')?.hidden)status(catalogStatus,'部分 VNDB 封面圖片無法載入；可按「重新載入 VNDB 封面」再次嘗試。','error');const fallback=document.createElement('div');fallback.className='vn49CoverFallback';fallback.textContent='封面載入失敗';const label=document.createElement('span');label.className='vn49Small';label.textContent=img.dataset.vn49Title||img.alt.replace(/ 封面$/,'');fallback.append(document.createElement('br'),label);img.replaceWith(fallback);
}
function renderVnCatalog(fetchCovers=true){const root=$('vnCatalogView');if(!root||root.hidden||!emqReady())return;const all=filteredWorks(),grid=$('vn49Grid'),statusEl=$('vn49CatalogStatus');if(state.workId||state.artist){grid.innerHTML='';$('vn49More').hidden=true;$('vn49Count').textContent='';renderSelectedSongPanel();return}renderSelectedSongPanel();$('vn49More').hidden=all.length<=state.renderLimit;const visible=all.slice(0,state.renderLimit);grid.innerHTML=visible.map(w=>{const url=coverFor(w),y=Number(String(state.vnDetails.get(String(w.vndbId))?.released||w.y||'').slice(0,4))||Number(w.y)||0;return `<article class="vn49Card">${coverMarkup(url,titleOfWork(w),w.vndbId)}<div class="vn49CardBody"><button type="button" class="vn49CardTitle" data-vn49-work="${safe(w.i)}">${safe(titleOfWork(w))}</button><div class="vn49Meta">${y||'年代未知'} · ${workSongs(w).length.toLocaleString()} 首曲目</div><div class="vn49Meta">${safe(w.vndbId)}</div><div class="vn49Buttons"><button type="button" data-vn49-work="${safe(w.i)}">查看曲目</button><a class="vn49LinkButton" href="https://vndb.org/${safe(w.vndbId)}" target="_blank" rel="noopener noreferrer">VNDB</a></div></div></article>`}).join('');$('vn49Count').textContent=`顯示 ${visible.length.toLocaleString()} / ${all.length.toLocaleString()} 部 VNDB 關聯作品`;if(!all.length)status(statusEl,'沒有符合條件的 VNDB 關聯作品。');else status(statusEl,`已載入 ${all.length.toLocaleString()} 部 VNDB 關聯作品。封面按目前顯示頁分批載入。`);if(fetchCovers)ensureCoverDetails(visible)}
function storedVnList(){try{const x=JSON.parse(localStorage.getItem(VN_LIST_KEY)||'{}');return Array.isArray(x.items)?x.items:[]}catch{return []}}
function normalizedListStatus(item){const labels=(item.labels||[]).map(x=>String(x.label||'').toLocaleLowerCase());const blob=labels.join(' ');if(blob.includes('playing')||blob.includes('正在玩'))return 'playing';if(blob.includes('finished')||blob.includes('已完成'))return 'finished';if(blob.includes('wishlist')||blob.includes('wish list')||blob.includes('想玩'))return 'wishlist';if(blob.includes('stalled')||blob.includes('擱置'))return 'stalled';if(blob.includes('dropped')||blob.includes('已放棄'))return 'dropped';return 'other'}
function listStatusName(k){return ({playing:'正在玩',finished:'已完成',wishlist:'想玩',stalled:'擱置',dropped:'已放棄',other:'其他／未分類'})[k]||'其他／未分類'}
function renderVnList(){const root=$('vnListView');if(!root||root.hidden)return;state.vnList=storedVnList();const q=String($('vn49ListSearch')?.value||state.vnListSearch||'').trim().toLocaleLowerCase(),st=$('vn49ListStatus')?.value||state.vnListStatus,items=state.vnList.filter(x=>{const w=x.vn||{};const text=[w.title,w.alttitle,x.vndbId,...(Array.isArray(w.aliases)?w.aliases:[])].join(' ').toLocaleLowerCase();return(!q||text.includes(q))&&(st==='all'||normalizedListStatus(x)===st)});$('vn49ListCount').textContent=`${items.length.toLocaleString()} / ${state.vnList.length.toLocaleString()} 部`;const grid=$('vn49ListGrid');grid.innerHTML=items.map(x=>{const w=x.vn||{},vid=String(x.id||x.vndbId||''),t=String(w.title||w.alttitle||vid),cover=String(w.image?.thumbnail||w.image?.url||state.covers[vid]||''),work=api()?.getWorkByVndbId?.(vid);return `<article class="vn49Card">${coverMarkup(cover,t,vid)}<div class="vn49CardBody"><div class="vn49CardTitle">${safe(t)}</div><div class="vn49Meta">${safe(vid)} · ${safe(listStatusName(normalizedListStatus(x)))}</div><div class="vn49Meta">${safe(w.released||'年代未知')} ${x.vote?`· VNDB 評分 ${(Number(x.vote)/10).toFixed(1)}`:''}</div><div class="vn49Buttons"><a class="vn49LinkButton" href="https://vndb.org/${safe(vid)}" target="_blank" rel="noopener noreferrer">VNDB 作品頁</a>${work?`<button type="button" data-vn49-work="${safe(work.i)}">查看 EMQ 曲目</button>`:'<span class="vn49Small">EMQ 目前未收錄此 VN 的歌曲</span>'}</div></div></article>`}).join('');if(!items.length)grid.innerHTML='<div class="vn49Status">目前沒有符合的 VN 清單項目。可以匯入 VNDB 清單，或調整搜尋與狀態篩選。</div>'}
async function importVnList(){if(state.busy)return;const root=$('vn49ImportStatus'),raw=$('vn49User').value.trim(),token=$('vn49Token').value.trim();if(!raw){status(root,'請輸入 VNDB 使用者名稱或 u123 ID。','error');return}state.busy=true;$('vn49Import').disabled=true;status(root,'正在查詢 VNDB 使用者…');try{const ures=await fetch(`${API}/user?q=${encodeURIComponent(raw)}`);if(!ures.ok)throw new Error(`使用者查詢失敗（HTTP ${ures.status}）`);const um=await ures.json(),u=um[raw]||Object.values(um).find(x=>x&&(String(x.id)===raw||String(x.username).toLowerCase()===raw.toLowerCase()));if(!u?.id)throw new Error('找不到這個 VNDB 使用者。請檢查名稱或 ID。');const items=[];let page=1,more=true;while(more&&page<=100){const headers={'Content-Type':'application/json'};if(token)headers.Authorization=`token ${token}`;const res=await fetch(`${API}/ulist`,{method:'POST',headers,body:JSON.stringify({user:u.id,fields:'id,added,voted,lastmod,vote,started,finished,labels{id,label},vn.id,vn.title,vn.alttitle,vn.aliases,vn.released,vn.image{url,thumbnail,sexual,violence}',results:100,page,sort:'id'})});if(res.status===401)throw new Error('VNDB 拒絕存取。若清單是私人清單，請使用具 listread 權限的 API Token。');if(!res.ok)throw new Error(`清單讀取失敗（HTTP ${res.status}）`);const data=await res.json();for(const it of (Array.isArray(data.results)?data.results:(Array.isArray(data.items)?data.items:[]))){const vid=String(it.id||it.vn?.id||'');if(!vid)continue;items.push({...it,vndbId:vid,labels:Array.isArray(it.labels)?it.labels:[]});const c=it.vn?.image?.thumbnail||it.vn?.image?.url;if(c)state.covers[vid]=c}more=!!data.more;page++;status(root,`正在匯入 VNDB 清單：${items.length.toLocaleString()} 部…`)}const pack={userId:u.id,username:u.username||raw,importedAt:new Date().toISOString(),items};localStorage.setItem(VN_LIST_KEY,JSON.stringify(pack));state.vnList=items;saveCoverCache();$('vn49Token').value='';renderVnList();status(root,`匯入完成：${items.length.toLocaleString()} 部 VN，帳號 ${u.username||raw}。Token 未保存。`+(more?'（已達本次 10,000 筆安全上限，尚有更多項目未匯入。）':''),'success')}catch(e){status(root,`匯入失敗：${e.message}。如果你是從 file:// 直接開啟本機 HTML，瀏覽器也可能限制跨網域請求。`,'error')}finally{state.busy=false;$('vn49Import').disabled=false}}
function applyModeSelection(mode){const el=$('qsEmqModeV8249'),box=$('qsEmqEnabled');if(!['amq','mixed','emq'].includes(mode))mode='amq';if(el)el.value=mode;if(box){box.checked=mode!=='amq';if(api()?.ready)box.disabled=false}const enabled=mode!=='amq';const option=$('quizTarget')?.querySelector('option[value="anime"]');if(option)option.textContent=enabled?'作品名稱（動畫／遊戲）':'動畫作品';const settings=(()=>{try{return JSON.parse(localStorage.getItem(SOURCE_KEY)||'{}')}catch{return {}}})();settings.emqMode=mode;settings.includeEmq=enabled;try{localStorage.setItem(SOURCE_KEY,JSON.stringify(settings))}catch{}window.__aniEmqToggleChangedV1?.(enabled,mode);api()?.setEnabled?.(enabled);const st=$('emqSourceStatusV8248');if(st&&api()?.ready){status(st,mode==='amq'?'目前只使用 AMQ 動畫歌曲。':mode==='mixed'?'目前混合 AMQ 動畫歌曲與 EMQ／VN 歌曲。':'EMQ／VN 歌曲已啟用。')} }
function mountEmqModeSelect(){const legacy=$('qsEmqToggleLabelV8248');if(legacy){legacy.hidden=true;legacy.style.display='none'}const old=$('qsEmqModeV8249');if(old)return;const quick=$('quizPool')?.closest('label');if(!quick)return;const wrap=document.createElement('label');wrap.className='emqSourceModeV8249';wrap.innerHTML='<span>曲庫</span><select id="qsEmqModeV8249" aria-label="猜歌曲庫來源"><option value="amq">AMQ 動畫歌曲</option><option value="mixed">AMQ + EMQ 混合</option><option value="emq">只出 EMQ／VN 歌曲</option></select>';quick.insertAdjacentElement('afterend',wrap);let mode='amq';try{const saved=JSON.parse(localStorage.getItem(SOURCE_KEY)||'{}');mode=['amq','mixed','emq'].includes(saved.emqMode)?saved.emqMode:(saved.includeEmq?'mixed':'amq')}catch{}wrap.querySelector('select').value=mode;wrap.querySelector('select').addEventListener('change',e=>applyModeSelection(e.target.value));applyModeSelection(mode)}
function openWorkInCatalog(id){const w=api()?.getWork?.(id);if(!w){status($('vn49CatalogStatus'),'找不到這個作品。','error');return}state.catalogKind='vn';state.workId=String(w.i);state.artist='';state.search='';state.renderLimit=72;window.__aniNavigateApp?.('catalog')}
function openArtistInCatalog(name){if(!name)return;state.catalogKind='vn';state.workId='';state.artist=String(name);state.search='';state.renderLimit=72;window.__aniNavigateApp?.('catalog')}
function mountQuizEmqInfo(){const song=window.__aniQuizStateV45?.quizSong;if(!song||!api()?.isSong?.(song[1])){const panel=$('emqQuizInfoV8249');panel?.remove();$('quizInfoContentV30')?.querySelector('.quizInfoList')?.style.removeProperty('display');return}const info=$('quizInfoContentV30');if(!info)return;const row=api().getRow(song[1]),m=api().getMeta?.(song[1])||{},w=api().getWork?.(m.workId)||{};if(!row)return;let panel=$('emqQuizInfoV8249');if(!panel){panel=document.createElement('div');panel.id='emqQuizInfoV8249';panel.className='emqQuizInfoV8249';const list=info.querySelector('.quizInfoList');if(list)list.insertAdjacentElement('afterend',panel);else info.append(panel)}const list=info.querySelector('.quizInfoList');if(list)list.style.display='none';const markup=`<dl class="quizInfoList"><dt>遊戲</dt><dd><button type="button" class="vn49TopLink" data-vn49-open-work="${safe(m.workId)}">${safe(m.workTitle||w.t||'未知作品')}</button></dd><dt>歌名</dt><dd>${safe(row[4]||'未命名歌曲')}</dd><dt>歌手</dt><dd><button type="button" class="vn49TopLink" data-vn49-open-artist="${safe(row[5]||'')}" title="查看這位歌手有哪些歌">${safe(row[5]||'未標示')}</button></dd><dt>類型</dt><dd>${safe(songType(row))}</dd></dl>`;if(panel.innerHTML!==markup)panel.innerHTML=markup}
function mountMultiplayerInfo(){const s=window.__aniMultiplayerUIV82?.getState?.();if(!s||s.phase!=='reveal'||!s.reveal?.emq)return;const pane=document.querySelector('#multiplayerView .mpRevealPane');if(!pane)return;let panel=$('mpEmqInfoV8249');if(!panel){panel=document.createElement('section');panel.id='mpEmqInfoV8249';panel.className='vn49Panel';pane.insertBefore(panel,pane.querySelector('.mpSongInfo')||pane.firstChild)}const r=s.reveal;const markup=`<div class="vn49SongRow"><div><div class="vn49Meta">遊戲</div><button type="button" class="vn49TopLink" data-vn49-open-work="${safe(r.animeId)}">${safe(r.animeEnglish||r.animeRomaji||'未知作品')}</button></div><div><div class="vn49Meta">歌手</div><button type="button" class="vn49TopLink" data-vn49-open-artist="${safe(r.artist||'')}">${safe(r.artist||'未標示')}</button></div><div><div class="vn49Meta">類型</div>${safe(({1:'OP／片頭曲',2:'ED／片尾曲',3:'插入歌',4:'其他歌曲',5:'未分類'})[Number(r.songType)||5])}<div class="vn49Meta">歌名：${safe(r.songTitle||'未命名歌曲')}</div></div></div>`;if(panel.innerHTML!==markup)panel.innerHTML=markup}
function init(){appendViews();addHomeGroups();mountEmqModeSelect();if($('vn49Reload'))$('vn49Reload').addEventListener('click',renderVnList);$('vn49Import')?.addEventListener('click',importVnList);$('vn49ListSearch')?.addEventListener('input',e=>{state.vnListSearch=e.target.value;renderVnList()});$('vn49ListStatus')?.addEventListener('change',e=>{state.vnListStatus=e.target.value;renderVnList()});$('vn49Search')?.addEventListener('input',e=>{state.search=e.target.value;state.renderLimit=72;renderVnCatalog()});$('vn49Year')?.addEventListener('change',e=>{state.year=e.target.value;state.renderLimit=72;renderVnCatalog()});$('vn49Clear')?.addEventListener('click',()=>{state.search='';state.year='all';state.workId='';state.artist='';state.renderLimit=72;$('vn49Search').value='';$('vn49Year').value='all';renderVnCatalog()});$('vn49More')?.addEventListener('click',()=>{state.renderLimit+=72;renderVnCatalog()});$('vnCatalogView')?.addEventListener('click',e=>{const work=e.target.closest('[data-vn49-work]');if(work){state.workId=String(work.dataset.vn49Work);state.artist='';renderVnCatalog();return}const artist=e.target.closest('[data-vn49-artist]');if(artist){openArtistInCatalog(artist.dataset.vn49Artist);return}if(e.target.closest('#vn49BackSongs')){state.workId='';state.artist='';renderVnCatalog();return}const home=e.target.closest('[data-vn49-home]');if(home){window.__aniNavigateApp?.('home');window.__aniSetHomeMenuOpenV846?.(true);return}});$('vnListView')?.addEventListener('click',e=>{const w=e.target.closest('[data-vn49-work]');if(w){openWorkInCatalog(w.dataset.vn49Work);return}if(e.target.closest('[data-vn49-home]')){window.__aniNavigateApp?.('home');window.__aniSetHomeMenuOpenV846?.(true)}});
// Use capture and a unique action namespace, avoiding collision with the legacy home click router.
$('amqHomeOverlay')?.addEventListener('click',e=>{const b=e.target.closest('[data-vn49-action]');if(!b)return;e.preventDefault();e.stopPropagation();if(b.dataset.vn49Action==='group'){showGroup(b.dataset.group);return}if(b.dataset.vn49Action==='back'){showHomeGroups();return}if(b.dataset.vn49Action==='navigate'){goTo(b.dataset.dest);return}},true);
$('amqMainIcon')?.addEventListener('click',()=>{showHomeGroups()},false);
document.addEventListener('ani-app-navigation',e=>{const view=e.detail?.view;if(view==='catalog'&&state.catalogKind!=='vn')state.catalogKind='anime';if(view==='watchlist'&&state.listKind!=='vn')state.listKind='anime';toggleViews(view);if(view==='quiz'){const saved=(()=>{try{return JSON.parse(localStorage.getItem(SOURCE_KEY)||'{}')}catch{return {}}})();applyModeSelection(['amq','mixed','emq'].includes(saved.emqMode)?saved.emqMode:(saved.includeEmq?'mixed':'amq'));mountQuizEmqInfo()}if(view==='multiplayer')mountMultiplayerInfo()});
document.addEventListener('ani-multiplayer-state-rendered-v8258',()=>mountMultiplayerInfo());document.addEventListener('ani-quiz-new-question',()=>mountQuizEmqInfo());document.addEventListener('quiz-v35-answered',()=>requestAnimationFrame(mountQuizEmqInfo));document.addEventListener('ani-emq-library-ready-v8248',()=>{mountEmqModeSelect();mountQuizEmqInfo();if(!$('vn49CatalogStatus'))appendViews()});document.addEventListener('error',handleVnCoverImageError,true);document.addEventListener('click',e=>{if(e.target.closest?.('#vn49RetryCovers')){e.preventDefault();retryVisibleCovers();return}const w=e.target.closest('[data-vn49-open-work]');if(w){e.preventDefault();openWorkInCatalog(w.dataset.vn49OpenWork);return}const a=e.target.closest('[data-vn49-open-artist]');if(a){e.preventDefault();openArtistInCatalog(a.dataset.vn49OpenArtist)}});
// Restore the dedicated VN list without storing any VNDB API token.
state.vnList=storedVnList();const savedMode=(()=>{try{return JSON.parse(localStorage.getItem(SOURCE_KEY)||'{}').emqMode||''}catch{return ''}})();if(savedMode)applyModeSelection(savedMode);renderVnList();toggleViews(window.__aniGetActiveViewV82?.()||'home')}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
window.__aniVnLibraryV8249={openCatalog:openVnCatalog,openList:openVnList,openEmqLists:()=>{state.listKind='anime';window.__aniNavigateApp?.('watchlist');setTimeout(()=>document.getElementById('emqListsModeTabV8254')?.click(),120)},renderCatalog:renderVnCatalog,renderList:renderVnList,getStats:()=>({works:works().length,songs:songRows().length,vndbLinked:works().length,localVnList:storedVnList().length})};
})();
</script>