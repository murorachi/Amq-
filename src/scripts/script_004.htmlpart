<!-- AMQ_SPLIT_MODULE:quiz_suggestion_renderer -->function revealAnswer(resultText=''){if(!quizSong)return;const isEmq=!!window.__aniEmqAPI?.isSong?.(quizSong[1]),a=isEmq?(window.__aniEmqAPI?.getWorkSummary?.(quizSong[0])||null):byAnime.get(quizSong[0]);const workLabel=isEmq?'視覺小說／遊戲作品':'動畫作品';document.getElementById('quizPrompt').textContent=quizSong[4]||'未命名歌曲';document.getElementById('quizSubprompt').textContent=[quizSong[5]||'歌手未標示',a?.[1]||'未知作品',a?.[5]||'年代未知'].filter(Boolean).join(' · ');const box=document.getElementById('quizResult');const familiarityNote=currentQuestionTarget==='anime'?`作品辨認熟悉度：${['未標記','聽過','有印象','秒答'][st(quizSong[1])]||'未標記'}`:'輔助練習不修改作品辨認熟悉度';box.innerHTML=`<b>${resultText?esc(resultText):'答案揭曉'}</b><br>歌曲：${esc(quizSong[4]||'未命名歌曲')}<br>歌手：${esc(quizSong[5]||'未標示')}<br>${workLabel}：${esc(a?.[1]||'未知作品')}<br>${esc(familiarityNote)}`;box.classList.remove('hidden');document.getElementById('quizNext').disabled=false;document.getElementById('quizSubmit').disabled=true;document.getElementById('quizSkip').disabled=true;document.getElementById('quizSuggestions').classList.remove('open');const target=document.getElementById('quizTarget');if(target)target.disabled=false}
function skipUnplayedQuizQuestionV80(source='manual'){
 if(!quizSong||quizFinished)return false;
 quizFinished=true;if(quizClipTimer)clearTimeout(quizClipTimer);if(typeof clearQuizPlaybackV30==='function')clearQuizPlaybackV30();
 if(activeFocusModeV72)activeFocusSongIdsV72=activeFocusSongIdsV72.filter(id=>String(id)!==String(quizSong[1]));
 try{window.__aniQuizPlanV1?.removeFocusSong?.(quizSong[1])}catch(e){}
 const msg='音訊未成功播放，本題略過且不計入答題歷史、熟悉度或間隔排程。';const statusEl=document.getElementById('quizStatus');if(statusEl)statusEl.textContent=msg;
 try{revealAnswer(msg)}catch(e){const r=document.getElementById('quizResult');if(r){r.textContent=msg;r.classList.remove('hidden')}document.getElementById('quizNext')?.removeAttribute('disabled')}
 document.dispatchEvent(new CustomEvent('ani-quiz-unplayed',{detail:{songId:String(quizSong[1]),target:currentQuestionTarget,source}}));return true;
}
function classifyQuiz(correct,submittedAnswer=''){
 if(document.body.classList.contains('quiz-round-paused')){const s=document.getElementById('quizStatus');if(s)s.textContent='本輪已暫停，請先按「繼續」再提交或跳過。';return}
 if(!quizSong||quizFinished)return;
 if(!quizAudioStarted){skipUnplayedQuizQuestionV80('classify');return}
 quizFinished=true;
 if(quizClipTimer)clearTimeout(quizClipTimer);
 if(typeof clearQuizPlaybackV30==='function')clearQuizPlaybackV30();
 const stop=Number.isFinite(quizAnswerStopAt)&&quizAnswerStopAt>0?quizAnswerStopAt:performance.now();
 const elapsed=quizStartedAt>0?Math.max(0,(stop-quizStartedAt)/1000):null;
 const target=['anime','title','artist'].includes(currentQuestionTarget)?currentQuestionTarget:'anime';
 const updatesFamiliarity=target==='anime';
 let level=null,old=st(quizSong[1]),final=old;
 if(updatesFamiliarity){level=correct?(elapsed!==null&&elapsed<=quizSettings.instantSec?3:2):1;final=quizSettings.keepHigher?Math.max(old,level):level;if(final>0)status[quizSong[1]]=final;else delete status[quizSong[1]];try{save();updateStats();updateQuizCounts();render()}catch(err){console.error('Quiz stats refresh failed',err)}}
 quizRound++;
 const isEmqQuestion=!!window.__aniEmqAPI?.isSong?.(quizSong),workLabel=isEmqQuestion?'作品':'動畫';const activeSourceMode=quizSettings?.emqMode||((quizSettings?.includeEmq)?'mixed':'amq');const targetLabel=target==='anime'?(activeSourceMode==='mixed'?'作品辨認':(isEmqQuestion?'作品辨認':'動畫辨認')):target==='title'?'歌曲名稱':'歌手';
 const label=updatesFamiliarity?(correct?(level===3?`${workLabel}秒答 · ${elapsed.toFixed(1)} 秒`:`${workLabel}答對 · ${elapsed===null?'時間未知':elapsed.toFixed(1)+' 秒'} · 標記為「有印象」`):`${workLabel}答錯／跳過 · 標記為「聽過」`):`${targetLabel}輔助練習${correct?'答對':'答錯／跳過'}${elapsed===null?'':' · '+elapsed.toFixed(1)+' 秒'}（未修改作品辨認熟悉度）`;
 try{window.__aniHistoryAPIv51?.record(quizSong,!!correct,submittedAnswer,elapsed,label,target)}catch(err){console.error('Quiz history record failed',err)}
 if(activeFocusModeV72)activeFocusSongIdsV72=activeFocusSongIdsV72.filter(id=>String(id)!==String(quizSong[1]));
 const statusEl=document.getElementById('quizStatus');if(statusEl)statusEl.textContent=label+(updatesFamiliarity&&quizSettings.keepHigher&&old>level?'；原本熟悉度較高，保留原等級。':'');
 const roundLabel=document.getElementById('quizRoundLabel');if(roundLabel)roundLabel.textContent=quizSettings.count?`本回合 ${quizRound}/${quizSettings.count}`:`自由練習 · 已完成 ${quizRound} 題`;
 const progress=document.getElementById('quizRoundProgress');if(progress)progress.style.width=quizSettings.count?`${Math.min(100,quizRound/quizSettings.count*100)}%`:'0%';
 try{revealAnswer(label)}catch(err){console.error('Quiz reveal failed',err);const result=document.getElementById('quizResult');if(result){result.textContent=`${label}。答案：${quizSong[4]||''} · ${quizSong[5]||''}`;result.classList.remove('hidden')}document.getElementById('quizNext')?.removeAttribute('disabled')}
 document.dispatchEvent(new CustomEvent('quiz-v35-answered',{detail:{correct:!!correct,answer:String(submittedAnswer||''),elapsed,songId:String(quizSong?.[1]??''),target,validAudio:true,familiarityUpdated:updatesFamiliarity}}));
}
function submitQuiz(fromTimer=false, options={}){
 if(document.body.classList.contains('quiz-round-paused')){const s=document.getElementById('quizStatus');if(s)s.textContent='本輪已暫停，請先按「繼續」再提交答案。';return}
 if(!quizSong||quizFinished)return;
 const field=document.getElementById('quizAnswer');
 const raw=options&&Object.prototype.hasOwnProperty.call(options,'rawAnswer')?String(options.rawAnswer??''):String(field?.value??'');
 const input=raw.trim();
 const force=!!options?.force;
 if(!input&&!fromTimer&&!force){
   const status=document.getElementById('quizStatus');if(status)status.textContent='輸入答案後按 Enter；時間結束會自動揭曉。';
   return;
 }
 if(!quizAudioStarted){if(fromTimer||force){skipUnplayedQuizQuestionV80(fromTimer?'timer':'forced-submit')}else{const status=document.getElementById('quizStatus');if(status)status.textContent='音訊尚未成功播放，請重試播放；本題不會被計為答錯。';}return}
 quizAnswerStopAt=performance.now();
 // Submitted answers do not stop playback; the current clip continues through reveal/buffer.
 let correct=false;
 const normalizeAnswer=x=>String(x??'').normalize('NFKC').toLocaleLowerCase().replace(/[\s\p{C}]/gu,'');
 try{
   const type=answerField();let aliases=[];
   const emqAliases=window.__aniEmqAPI?.getAliases?.(quizSong[1])||{};
   if(type==='anime'){const a=window.__aniEmqAPI?.getWorkSummary?.(quizSong[0])||byAnime.get(quizSong[0]);aliases=[a?.[1],a?.[2],...(window.__aniChineseTitleAPIv8237?.getAliases(quizSong[0])||[]),...(emqAliases.work||[])];}
   else if(type==='artist'){aliases=[quizSong[5],quizSong[11],quizSong[14],...(emqAliases.artist||[])];}
   else{aliases=[quizSong[4],quizSong[12],quizSong[13],...(emqAliases.title||[])];}
   const candidate=normalizeAnswer(input),valid=aliases.map(normalizeAnswer).filter(Boolean);
   correct=!!candidate&&valid.includes(candidate);
   // If the same normalized song title by the same artist is attached to multiple anime,
   // any of those anime titles is accepted for an anime-target question.
   if(!correct&&candidate&&type==='anime'&&!window.__aniEmqAPI?.isSong?.(quizSong)){
     const songTitle=normalizeAnswer(quizSong[4]),songArtist=normalizeAnswer(quizSong[5]);
     if(songTitle&&songArtist){
       const relatedIds=new Set(songs.filter(s=>normalizeAnswer(s[4])===songTitle&&normalizeAnswer(s[5])===songArtist).map(s=>String(s[0])));
       for(const aid of relatedIds){const other=byAnime.get(Number(aid));if(other&&[other[1],other[2],...(window.__aniChineseTitleAPIv8237?.getAliases(aid)||[])].some(t=>normalizeAnswer(t)===candidate)){correct=true;break;}}
     }
   }
   if(!correct&&candidate&&quizSettings.acceptPartial&&candidate.length>=4)correct=valid.some(alias=>candidate.length>=Math.ceil(alias.length*.55)&&(alias.startsWith(candidate)||alias.includes(candidate)));
   console.debug('[Quiz answer check]',{type,input,aliases,normalizedInput:candidate,correct,songId:quizSong[1],forced:force});
 }catch(err){console.error('Quiz answer evaluation failed',err);correct=false}
 document.dispatchEvent(new CustomEvent('ani-quiz-answer-submitted',{detail:{answer:raw,correct,at:quizAnswerStopAt,forced:force}}));
 // Forced empty submissions are deliberate skips and must still enter reveal/buffer.
 classifyQuiz(correct,raw);
}

function updateQuizAllAnswersV857(){const target=document.getElementById('quizTarget')?.value,wrap=document.getElementById('quizAllAnswersV857'),show=target==='all';if(wrap)wrap.classList.toggle('hidden',!show);if(wrap)wrap.querySelectorAll('input').forEach(input=>{input.disabled=!show||quizFinished||!quizAudioStarted||document.body.classList.contains('quiz-round-paused')});const main=document.getElementById('quizAnswer');if(main&&show){main.placeholder='輸入作品名稱（動畫／遊戲）';}else if(main){main.placeholder='輸入答案，選擇下拉建議後按 Enter…'}}
function evaluateQuizTargetAnswerV857(type,value){const input=String(value??'').trim();if(!input||!quizSong)return false;<!-- AMQ_SPLIT_MODULE:quiz_answer_target_normalization -->const emqSong=!!window.__aniEmqAPI?.isSong?.(quizSong),emqMeta=emqSong?(window.__aniEmqAPI?.getMeta?.(quizSong[1])||{}):{},emqWorkId=String(emqMeta.workId??quizSong[0]),aliases=window.__aniEmqAPI?.getAliases?.(quizSong[1])||{};let values=[];if(type==='anime'){const work=window.__aniEmqAPI?.getWorkSummary?.(quizSong[0])||byAnime.get(quizSong[0]);const zhAliases=emqSong?(window.__aniEmqChineseTitleAPIv8259?.getAliases?.(emqWorkId)||[]):(window.__aniChineseTitleAPIv8237?.getAliases?.(quizSong[0])||[]);values=[work?.[1],work?.[2],...(emqSong?[window.__aniEmqChineseTitleAPIv8259?.getTitle?.(emqWorkId)]:[]),...zhAliases,...(aliases.work||[])];}else if(type==='artist')values=[quizSong[5],quizSong[11],quizSong[14],...(aliases.artist||[])];else values=[quizSong[4],quizSong[12],quizSong[13],...(aliases.title||[])];const candidate=normalize(input),valid=values.map(normalize).filter(Boolean);let correct=!!candidate&&valid.includes(candidate);if(!correct&&candidate&&type==='anime'&&!window.__aniEmqAPI?.isSong?.(quizSong)){const title=normalize(quizSong[4]),artist=normalize(quizSong[5]);if(title&&artist){const related=new Set(songs.filter(row=>normalize(row[4])===title&&normalize(row[5])===artist).map(row=>String(row[0])));for(const id of related){const work=byAnime.get(Number(id));if(work&&[work[1],work[2],...(window.__aniChineseTitleAPIv8237?.getAliases?.(id)||[])].some(v=>normalize(v)===candidate)){correct=true;break}}}}if(!correct&&quizSettings.acceptPartial&&candidate.length>=4)correct=valid.some(alias=>candidate.length>=Math.ceil(alias.length*.55)&&(alias.startsWith(candidate)||alias.includes(candidate)));return correct}
function submitQuizAllV857(fromTimer=false,options={}){if(document.body.classList.contains('quiz-round-paused')){const status=document.getElementById('quizStatus');if(status)status.textContent='本輪已暫停，請先按「繼續」再提交答案。';return}if(!quizSong||quizFinished)return;const values={anime:String(options.rawAnswer??document.getElementById('quizAnswer')?.value??'').trim(),artist:String(document.getElementById('quizAnswerArtistV857')?.value??'').trim(),title:String(document.getElementById('quizAnswerTitleV857')?.value??'').trim()};const force=!!options.force;if(!Object.values(values).some(Boolean)&&!fromTimer&&!force){const status=document.getElementById('quizStatus');if(status)status.textContent='請至少輸入作品、歌手或歌曲名稱其中一項。';return}if(!quizAudioStarted){if(fromTimer||force)skipUnplayedQuizQuestionV80('all-target-unplayed');else{const status=document.getElementById('quizStatus');if(status)status.textContent='音訊尚未成功播放，本題不會被計為答錯。';}return}quizAnswerStopAt=performance.now();const stop=quizAnswerStopAt,start=Number(quizStartedAt)||0,elapsed=start>0?Math.max(0,(stop-start)/1000):null;const correct={anime:evaluateQuizTargetAnswerV857('anime',values.anime),artist:evaluateQuizTargetAnswerV857('artist',values.artist),title:evaluateQuizTargetAnswerV857('title',values.title)};const savedTarget=currentQuestionTarget;currentQuestionTarget='anime';classifyQuiz(correct.anime,values.anime);currentQuestionTarget=savedTarget;for(const field of ['artist','title']){const label=(field==='artist'?'歌手辨認':'歌曲名稱辨認')+(correct[field]?'答對':'答錯／未作答')+(elapsed===null?'':' · '+elapsed.toFixed(1)+' 秒');try{window.__aniHistoryAPIv51?.record(quizSong,!!correct[field],values[field],elapsed,label,field)}catch(err){console.error('Multi-target history record failed',err)}}const result=document.getElementById('quizResult');if(result){const line=(field,label)=>`<div><b>${label}</b>：${values[field]?esc(values[field]):'（未作答）'} · <strong>${correct[field]?'答對':'未答對'}</strong></div>`;result.innerHTML=`<b>本題結果</b>${line('anime','作品')}${line('artist','歌手')}${line('title','歌曲')}`;result.classList.remove('hidden')}const status=document.getElementById('quizStatus');if(status)status.textContent=`三項結果：作品 ${correct.anime?'答對':'未答對'}、歌手 ${correct.artist?'答對':'未答對'}、歌曲 ${correct.title?'答對':'未答對'}。作品答案負責更新原有熟悉度；另外兩項分別記錄答題結果。`;['quizAnswerArtistV857','quizAnswerTitleV857'].forEach(id=>{const field=document.getElementById(id);if(field)field.disabled=true})}
const submitQuizCoreV857=submitQuiz;submitQuiz=function(fromTimer=false,options={}){if(document.getElementById('quizTarget')?.value==='all')return submitQuizAllV857(fromTimer,options);return submitQuizCoreV857(fromTimer,options)};
window.__aniQuizHandleAudioFailureV857=(song)=>{if(!song||!quizSong||String(song[1])!==String(quizSong[1])||quizFinished)return false;skipUnplayedQuizQuestionV80('audio-failed');const id=String(song[1]);setTimeout(()=>{if(quizActive&&quizSong&&String(quizSong[1])===id&&quizFinished&&!document.body.classList.contains('quiz-round-paused'))nextQuiz()},350);return true};

