function clearQuizAutoNextTimersV30(){if(quizAutoNextTimerV30!==null){clearTimeout(quizAutoNextTimerV30);quizAutoNextTimerV30=null}if(quizAutoNextTickV30!==null){clearInterval(quizAutoNextTickV30);quizAutoNextTickV30=null}}
function renderQuizAutoNextV30(){
 if(!countdownV30)return;
 if(quizAutoNextPausedV30){const left=Math.ceil(Math.max(0,Number(quizAutoNextRemainingMsV30)||0)/1000);countdownV30.classList.remove('hidden');countdownV30.textContent=`自動切題已暫停 · 尚餘 ${left} 秒`;return}
 if(!quizAutoNextDeadlineV30)return;
 const left=Math.ceil(Math.max(0,quizAutoNextDeadlineV30-performance.now())/1000);
 countdownV30.classList.remove('hidden');countdownV30.textContent=`${left} 秒後自動進入下一題`;
}
function clearQuizAutoNextV30(){clearQuizAutoNextTimersV30();quizAutoNextDeadlineV30=0;quizAutoNextRemainingMsV30=null;quizAutoNextPausedV30=false;if(countdownV30){countdownV30.classList.add('hidden');countdownV30.textContent=''}}
function startQuizAutoNextV30(delayMs){
 clearQuizAutoNextTimersV30();quizAutoNextPausedV30=false;quizAutoNextRemainingMsV30=null;
 const ms=Math.max(0,Math.min(30000,Number(delayMs)||0));quizAutoNextDeadlineV30=performance.now()+ms;renderQuizAutoNextV30();
 quizAutoNextTickV30=setInterval(renderQuizAutoNextV30,150);
 quizAutoNextTimerV30=setTimeout(()=>{
  clearQuizAutoNextTimersV30();quizAutoNextDeadlineV30=0;quizAutoNextRemainingMsV30=null;quizAutoNextPausedV30=false;
  if(countdownV30){countdownV30.classList.add('hidden');countdownV30.textContent=''}
  if(!document.body.classList.contains('quiz-round-paused')&&quizActive&&!quizRootV30.classList.contains('hidden'))nextQuiz();
 },ms);
}
function pauseQuizAutoNextV30(){
 if(quizAutoNextPausedV30||!quizAutoNextDeadlineV30)return false;
 quizAutoNextRemainingMsV30=Math.max(0,quizAutoNextDeadlineV30-performance.now());quizAutoNextDeadlineV30=0;quizAutoNextPausedV30=true;clearQuizAutoNextTimersV30();renderQuizAutoNextV30();return true;
}
function resumeQuizAutoNextV30(){
 if(!quizAutoNextPausedV30||quizAutoNextRemainingMsV30===null)return false;
 const remaining=Math.max(0,Number(quizAutoNextRemainingMsV30)||0);startQuizAutoNextV30(remaining);return true;
}
window.__aniQuizAutoNextV30={clear:()=>clearQuizAutoNextV30(),pause:()=>pauseQuizAutoNextV30(),resume:()=>resumeQuizAutoNextV30(),getState:()=>({paused:quizAutoNextPausedV30,remainingMs:quizAutoNextPausedV30?quizAutoNextRemainingMsV30:(quizAutoNextDeadlineV30?Math.max(0,quizAutoNextDeadlineV30-performance.now()):null),scheduled:!!(quizAutoNextDeadlineV30||quizAutoNextPausedV30)})};
function clearQuizPlaybackV30(){if(quizPlaybackTickerV30){clearInterval(quizPlaybackTickerV30);quizPlaybackTickerV30=null}if(quizStopTimerV30){clearTimeout(quizStopTimerV30);quizStopTimerV30=null}quizClipDeadlineV30=0}
function updateQuizPlaybackV30(){const fill=document.getElementById('quizPlaybackFillV30'),remaining=document.getElementById('quizRemainingV30'),state=document.getElementById('quizPlaybackStateV30');const duration=Math.max(5,Number(quizSettings.clip)||20);const left=quizClipDeadlineV30?Math.max(0,(quizClipDeadlineV30-Date.now())/1000):0;const revealed=quizRootV30.classList.contains('is-revealed');if(fill)fill.style.width=quizClipDeadlineV30?`${Math.min(100,Math.max(0,(1-left/duration)*100))}%`:'0%';if(remaining)remaining.textContent=revealed?'答案已揭曉':quizClipDeadlineV30?`剩餘 ${Math.ceil(left)} 秒`:'剩餘 -- 秒';if(state){if(audioEl&&!audioEl.paused&&quizClipDeadlineV30)state.textContent='正在播放';else if(revealed)state.textContent='答案已揭曉';else state.textContent='等待播放'}}
let quizPauseClockStartedAtV82=null,quizPausedElapsedV82=null;
// Public bridge for V42's separate IIFE: lexical quiz clocks must be adjusted in their owning closure.
window.__aniQuizPauseClockV82={
 pause(at=performance.now()){
  if(quizPauseClockStartedAtV82!==null)return quizPausedElapsedV82;
  const now=Number(at);quizPauseClockStartedAtV82=Number.isFinite(now)?now:performance.now();
  quizPausedElapsedV82=quizAudioStarted&&quizStartedAt>0?Math.max(0,(quizPauseClockStartedAtV82-quizStartedAt)/1000):null;
  return quizPausedElapsedV82;
 },
 resume(at=performance.now()){
  if(quizPauseClockStartedAtV82===null)return 0;
  const now=Number(at),resumedAt=Number.isFinite(now)?now:performance.now();
  const delta=Math.max(0,resumedAt-quizPauseClockStartedAtV82);
  quizPauseClockStartedAtV82=null;quizPausedElapsedV82=null;
  if(delta>0){
   if(quizStartedAt>0)quizStartedAt+=delta;
   if(quizClipDeadlineV30>0)quizClipDeadlineV30+=delta;
  }
  updateQuizPlaybackV30();
  return delta;
 },
 getPausedElapsed(){return quizPauseClockStartedAtV82===null?null:quizPausedElapsedV82},
 reset(){quizPauseClockStartedAtV82=null;quizPausedElapsedV82=null}
