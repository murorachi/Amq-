// Planner bridge: persist settings, refresh the existing settings controls, and retain the old quiz workflow.
window.__aniQuizPlanV1={
 applySettings(overrides={}){
  const ids=Object.prototype.hasOwnProperty.call(overrides,'focusSongIds')&&Array.isArray(overrides.focusSongIds)?[...new Set(overrides.focusSongIds.map(String))]:[];
  const regular={...overrides};delete regular.focusSongIds;
  if(ids.length&&!activeFocusOriginalSettingsV72){try{activeFocusOriginalSettingsV72=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');localStorage.setItem('aniQuizPlanBackupSettingsV72',JSON.stringify(activeFocusOriginalSettingsV72));activeFocusOriginalPoolV72=document.getElementById('quizPool')?.value||'unmarked'}catch(e){activeFocusOriginalSettingsV72={}}}
  const next={...quizSettings,...regular,focusSongIds:[]};
  activeFocusSongIdsV72=ids;activeFocusModeV72=ids.length>0; // Volatile session constraint: never trap later ordinary quizzes in an old review list.
  try{localStorage.setItem('aniQuizSettingsV14',JSON.stringify(next))}catch(e){}
  loadQuizSettings();
  const poolSelect=document.getElementById('quizPool');if(poolSelect&&ids.length)poolSelect.value='all';
  readQuizSettingsUI();
  quizRound=0;quizRoundSeen.clear();quizRoundTarget=quizSettings.count;lastQuestionId=null;quizSong=null;quizFinished=false;
  return true;
 },
 clearFocus(){
  activeFocusSongIdsV72=[];activeFocusModeV72=false;quizSettings.focusSongIds=[];
  let backup=activeFocusOriginalSettingsV72;
  if(!backup){try{const raw=localStorage.getItem('aniQuizPlanBackupSettingsV72');if(raw)backup=JSON.parse(raw)}catch(e){}}
  try{if(backup){localStorage.setItem('aniQuizSettingsV14',JSON.stringify(backup));activeFocusOriginalSettingsV72=null;localStorage.removeItem('aniQuizPlanBackupSettingsV72')}else{const saved=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');saved.focusSongIds=[];localStorage.setItem('aniQuizSettingsV14',JSON.stringify(saved))}}catch(e){}
  try{loadQuizSettings();readQuizSettingsUI()}catch(e){}
  const poolSelect=document.getElementById('quizPool');if(poolSelect&&activeFocusOriginalPoolV72)poolSelect.value=activeFocusOriginalPoolV72;
  activeFocusOriginalPoolV72=null;
 },
 getSettings:()=>({...quizSettings}),
 getFocusCount:()=>activeFocusSongIdsV72.length,
 removeFocusSong:id=>{activeFocusSongIdsV72=activeFocusSongIdsV72.filter(x=>String(x)!==String(id));return activeFocusSongIdsV72.length}
};
})();</script>