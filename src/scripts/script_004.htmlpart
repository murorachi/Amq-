// Audio clip countdown and progress. Revealing never pauses the current audio.
function startQuizPlaybackTickerV30(){
 // A media element may emit `playing` again after pause/resume or a brief buffering stall.
 // Keep the existing deadline/ticker for the current question instead of resetting to full time.
 if(!quizActive||!quizSong||quizFinished)return;
 if(quizPlaybackTickerV30&&quizClipDeadlineV30>0){updateQuizPlaybackV30();return;}
 clearQuizPlaybackV30();
 const duration=Math.max(1,Number(quizSettings.clip)||20);
 quizClipDeadlineV30=Date.now()+duration*1000;
 updateQuizPlaybackV30();
 quizPlaybackTickerV30=setInterval(()=>{
   if(document.body.classList.contains('quiz-round-paused'))return;
   /* V82.1: freeze the clip timer while the pause control is active. */
   if(!quizActive||!quizSong||quizFinished){clearQuizPlaybackV30();return}
   const left=Math.max(0,(quizClipDeadlineV30-Date.now())/1000);
   updateQuizPlaybackV30();
   if(left<=0){clearQuizPlaybackV30();submitQuiz(true);updateQuizPlaybackV30()}
 },100)
}
