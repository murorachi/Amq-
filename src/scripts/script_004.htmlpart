 const input=document.getElementById('quizAnswer');if(input){input.value='';input.disabled=true;document.getElementById('quizSubmit').disabled=true;document.getElementById('quizSkip').disabled=true}
 const target=document.getElementById('quizTarget');if(target)target.disabled=false;
 ['quizAnswerArtistV857','quizAnswerTitleV857'].forEach(id=>{const field=document.getElementById(id);if(field){field.value='';field.disabled=true}});
 const allFields=document.getElementById('quizAllAnswersV857');if(allFields)allFields.classList.add('hidden');
 quizSong=null;lastQuestionId=null;quizRound=0;quizRoundSeen.clear();quizRoundTarget=quizSettings.count||0;currentQuestionTarget=target&&['anime','title','artist','all'].includes(target.value)?target.value:(quizSettings.target||'anime');
 const root=document.getElementById('quizView');if(root){root.classList.add('hidden');root.classList.remove('is-revealed')}
 const prompt=document.getElementById('quizPrompt'),subprompt=document.getElementById('quizSubprompt');if(prompt)prompt.textContent='猜歌已結束';if(subprompt)subprompt.textContent='按「開始新題」開始新回合。已保存的設定與學習紀錄不會清除。';
