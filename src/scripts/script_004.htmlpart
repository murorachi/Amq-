<script>
(()=>{
const wrap=document.querySelector('.wrap');
if(!wrap){return}
const make=(tag,attrs={},html='')=>{const e=document.createElement(tag);for(const [k,v] of Object.entries(attrs))if(k==='class')e.className=v;else if(k==='style')e.style.cssText=v;else e.setAttribute(k,v);e.innerHTML=html;return e};
const quiz=make('section',{id:'quizView',class:'quizView hidden'},`
 <div class="quizTop"><div><h2>猜歌遊戲</h2></div><div style="display:flex;gap:7px;flex-wrap:wrap"><button class="btn" id="quizThemeToggle" type="button">☾ 暗色模式</button><button class="btn" id="quizExit">返回收藏室</button></div></div>
 <div class="quizQuickSettings"><label>猜什麼 <select id="quizTarget"><option value="title">歌曲名稱</option><option value="artist">歌手</option><option value="anime">動畫作品</option><option value="all">作品＋歌手＋歌曲</option></select></label><label>快速範圍 <select id="quizPool"><option value="unmarked">未標記歌曲</option><option value="heard">聽過／有印象</option><option value="all">全部歌曲</option><option value="hard">難度 0–20 且未標記</option><option value="tagged">有自訂標籤的歌曲</option></select></label><div class="quizCustomListsControl"><span>自訂清單</span><details id="qsCustomListsPicker"><summary id="qsCustomListSummary">不限制（依其他條件）</summary><div id="qsCustomListOptions" role="group" aria-label="自訂練習清單範圍"></div></details><select id="qsCustomListId" class="hidden" aria-hidden="true" tabindex="-1"><option value=""></option></select><small class="quizCustomScopeSummaryV844" id="quizCustomScopeSummaryV844" role="status" aria-live="polite"></small></div><label><input id="quizAutoNext" type="checkbox"> 答題後自動下一題</label></div>
 <div class="quizRoundBar"><span id="quizRoundProgress"></span></div><div id="quizRoundLabel" style="font-size:11px;color:var(--muted);margin-bottom:10px">自由練習 · 尚未開始</div>
 <div class="quizGrid"><div class="quizStage"><div class="quizMystery"><img id="quizAnimeCoverV26" class="quizAnimeCoverV26" alt="動畫封面" loading="lazy" hidden><div><div class="note">♫ ?</div><b id="quizPrompt">準備抽取第一首歌曲</b><small id="quizSubprompt">歌名、歌手、動畫資訊暫時隱藏</small></div></div>
 <div class="quizControls quizSkipControls"><button class="btn" id="quizManualPlayV8262" type="button" hidden>▶ 播放音訊</button><button class="btn" id="quizSkip" type="button">跳過</button></div>
 <div class="quizSuggest"><input class="quizAnswerInput" id="quizAnswer" lang="en" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" inputmode="text" enterkeyhint="go" placeholder="輸入答案，選擇下拉建議後按 Enter…"><div class="quizSuggestions" id="quizSuggestions" role="listbox"></div></div><div id="quizAllAnswersV857" class="quizAllAnswersV857 hidden"><label>歌手／演唱者<input id="quizAnswerArtistV857" class="quizAnswerInput" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="輸入歌手名稱"></label><label>歌曲名稱<input id="quizAnswerTitleV857" class="quizAnswerInput" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="輸入歌曲名稱"></label></div>
 <div class="quizControls"><button class="btn primary" id="quizSubmit">確認答案</button><button class="btn" id="quizNext" disabled>下一題 →</button><span id="quizTimerDisplay" style="font-size:12px;color:var(--muted)">--</span></div>
 <div class="quizStatus" id="quizStatus">點「開始新題」抽歌。播放開始後才計時。</div><div class="quizResult hidden" id="quizResult"></div>
 <div class="quizStats"><div class="quizStat"><b id="quizHeardCount">0</b><span>聽過</span></div><div class="quizStat"><b id="quizKnownCount">0</b><span>有印象</span></div><div class="quizStat"><b id="quizInstantCount">0</b><span>秒答</span></div></div></div>
 <aside class="quizSide"><button class="quizSettingsToggle" id="quizSettingsToggle" type="button"><span>⚙ 出題設定（細項）</span><span id="quizSettingsChevron">＋</span></button><div id="quizSettingsBody" class="hidden">
 <div class="quizSetting"><h4>題數與播放</h4><div class="settingRow"><label>每回合題數 <input id="qsCount" type="number" min="0" max="500" step="5" value="25"></label><label>音訊播放秒數 <input id="qsClip" type="number" min="5" max="120" step="5" value="20"></label></div><div class="settingRow"><label style="width:100%">Sample 段落位置 <input id="qsSamplePosition" type="range" min="0" max="100" step="1" value="0" style="width:min(100%,420px);vertical-align:middle"> <b id="qsSamplePositionValue">0%</b></label></div><div class="settingRow"><button class="btn" id="qsRandomSample" type="button" aria-pressed="true">隨機 Sample：開</button><span style="font-size:11px;color:var(--muted)">開啟後每首歌隨機抽取播放段落</span></div><div class="settingRow"><label style="width:100%">AMQ 小人角色 VNDB ID <input id="qsVndbCharacterId" type="text" placeholder="例如 c123" autocomplete="off" style="max-width:220px"></label><button class="btn" id="qsLoadVndbCharacter" type="button">載入角色圖片</button><span id="qsVndbStatus" style="font-size:11px;color:var(--muted)"></span></div><div class="settingRow"><label><input id="qsAutoPlay" type="checkbox" checked> 抽題後自動播放</label></div><div class="settingRow"><label><input id="qsAutoNext" type="checkbox"> 答題後自動下一題</label></div></div>
 <div class="quizSetting"><h4>年代範圍</h4><div class="settingRow"><label>從 <input id="qsYearMin" type="number" min="1900" max="2100" value="1924"></label><label>到 <input id="qsYearMax" type="number" min="1900" max="2100" value="2026"></label></div><div class="settingRow"><label><input id="qsUnknownYear" type="checkbox" checked> 包含年份未知</label></div><div class="checkGrid"><label><input type="checkbox" name="qsSeason" value="Winter" checked> 冬季</label><label><input type="checkbox" name="qsSeason" value="Spring" checked> 春季</label><label><input type="checkbox" name="qsSeason" value="Summer" checked> 夏季</label><label><input type="checkbox" name="qsSeason" value="Fall" checked> 秋季</label></div></div>
 <div class="quizSetting"><h4>作品類型</h4><div class="checkGrid"><label><input type="checkbox" name="qsAnimeType" value="TV" checked> TV</label><label><input type="checkbox" name="qsAnimeType" value="OVA" checked> OVA</label><label><input type="checkbox" name="qsAnimeType" value="Movie" checked> 劇場版</label><label><input type="checkbox" name="qsAnimeType" value="Special" checked> Special</label><label><input type="checkbox" name="qsAnimeType" value="ONA" checked> ONA</label><label><input type="checkbox" name="qsAnimeType" value="Other" checked> 其他類型</label></div></div>
 <div class="quizSetting"><h4>歌曲類型</h4><div class="checkGrid"><label><input type="checkbox" name="qsSongType" value="1" checked> OP</label><label><input type="checkbox" name="qsSongType" value="2" checked> ED</label><label><input type="checkbox" name="qsSongType" value="3" checked> 插入歌</label><label><input type="checkbox" name="qsSongType" value="4" checked> OST</label><label><input type="checkbox" name="qsSongType" value="5" checked> 其他</label></div><div class="settingRow"><label>難度最低 <input id="qsDiffMin" type="number" min="0" max="100" value="0"></label><label>最高 <input id="qsDiffMax" type="number" min="0" max="100" value="100"></label></div></div>
 <div class="quizSetting"><h4>熟悉度與收藏範圍</h4><div class="checkGrid"><label><input type="checkbox" name="qsStatus" value="0" checked> 未標記</label><label><input type="checkbox" name="qsStatus" value="1" checked> 聽過</label><label><input type="checkbox" name="qsStatus" value="2" checked> 有印象</label><label><input type="checkbox" name="qsStatus" value="3" checked> 秒答</label></div><div class="settingRow" style="margin-top:12px"><label><input id="qsWatchStatusFilterEnabled" type="checkbox"> 依看番狀態篩選出題範圍</label></div><div class="checkGrid" id="qsWatchStatusGrid"><label><input type="checkbox" name="qsWatchStatus" value="current" checked> 正在觀看</label><label><input type="checkbox" name="qsWatchStatus" value="completed" checked> 已看完</label><label><input type="checkbox" name="qsWatchStatus" value="paused" checked> 暫停觀看</label><label><input type="checkbox" name="qsWatchStatus" value="dropped" checked> 已棄番</label><label><input type="checkbox" name="qsWatchStatus" value="planning" checked> 計畫觀看</label></div><div class="toolhint">啟用後，只會出現勾選狀態的動畫；未標記看番狀態與「重看中」不會被納入這五類。</div><div class="settingRow"><label><input id="qsWatchlistOnly" type="checkbox"> 只出已加入我的清單的動畫</label></div><div class="settingRow"><label><input id="qsTagsOnly" type="checkbox"> 只出有自訂標籤的歌曲</label></div><label style="display:block;margin-top:8px">標籤包含文字 <input id="qsTagText" type="text" placeholder="例如：80年代、夏日感、電子鼓"></label></div>
 <div class="quizSetting"><h4>答題判定</h4><div class="settingRow"><label>秒答上限（秒） <input id="qsInstantSec" type="number" min="1" max="30" value="5"></label></div><div class="settingRow"><label><input id="qsAcceptPartial" type="checkbox"> 允許答案包含關鍵字（較寬鬆）</label></div><div class="settingRow"><label><input id="qsKeepHigher" type="checkbox" checked> 不因答錯降低既有熟悉度</label></div></div>
 <div class="settingRow"><button class="btn primary" id="quizApplySettings" type="button">套用設定並開始</button><button class="btn" id="quizResetSettings" type="button">恢復預設</button></div></div>
 <h3 style="margin-top:16px">熟悉度自動分類</h3><ul class="quizRule"><li><b>答錯／跳過 → 聽過</b></li><li><b>答對但較慢 → 有印象</b></li><li><b>在設定秒數內答對 → 秒答</b></li><li>原本較高的熟悉度可選擇保留。</li></ul><div class="quizSource" id="quizAudioState">只播放音訊，不顯示影片。音訊來源可能受外部服務影響。</div><button class="btn primary" id="quizStart" style="width:100%;margin-top:12px">開始新題 ✨</button></aside></div>`);
wrap.append(quiz);



let quizActive=false,quizSong=null,quizStartedAt=0,quizFinished=false,quizAudioStarted=false,lastQuestionId=null,currentQuestionTarget='anime';
Object.defineProperty(window,'__aniQuizStateV45',{configurable:true,get:()=>({quizSong,quizSettings,quizFinished,quizActive,quizAudioStarted,quizStartedAt,currentQuestionTarget})});
const originalMediaFiles=window.mediaFiles;
// Functions declared in the previous classic script are global bindings, so the quiz can reuse the existing mirror player.
const norm=x=>String(x??'').normalize('NFKC').toLocaleLowerCase().replace(/[\s\p{P}\p{S}\p{C}]/gu,'');
<!-- AMQ_SPLIT_MODULE:quiz_target_value -->
function enterSpecial(which='quiz'){document.body.classList.remove('ui-home-menu','ui-explore-open','ui-settings-open','relations-mode');document.body.classList.add('quiz-mode');quizActive=true;audioEl.controls=false;audioEl.style.display='none';document.getElementById('quizView').classList.remove('hidden');{document.getElementById('dockTitle').textContent='猜歌模式';document.getElementById('dockSubtitle').textContent='答案已隱藏';document.getElementById('playerTitle').textContent='猜歌模式';document.getElementById('playerSub').textContent='答案已隱藏';if(window.videoEl){videoEl.pause();videoEl.style.display='none'}if(!quizSong){document.getElementById('quizPrompt').textContent='準備開始猜歌';document.getElementById('quizSubprompt').textContent='按右側「開始新題」抽取第一首歌曲';document.getElementById('quizStatus').textContent='尚未開始。先調整出題設定，再按「開始新題」。'}}document.getElementById('dockMeta')?.removeAttribute('style');window.scrollTo({top:0,behavior:'instant'})}
function deactivateQuizModeV82(){try{if(typeof window.__aniQuizStopStateV82==='function')window.__aniQuizStopStateV82()}catch(err){console.error('Quiz leave cleanup failed',err)}document.body.classList.remove('quiz-mode','relations-mode','quiz-round-paused');quizActive=false;audioEl.controls=true;audioEl.style.display='';if(typeof currentSong!=='undefined'&&currentSong)updateDock(currentSong);else updateDock(null)}
window.__aniEnterQuizV82=()=>enterSpecial('quiz');window.__aniDeactivateQuizV82=deactivateQuizModeV82;
function exitSpecial(){deactivateQuizModeV82();window.__aniNavigateApp?.('home')}
const quizDefaults={target:'anime',count:25,clip:20,samplePosition:0,randomSample:true,vndbCharacterId:'',yearMin:1924,yearMax:2026,diffMin:0,diffMax:100,instantSec:5,unknownYear:true,noRepeat:true,autoPlay:true,autoNext:true,includeEmq:false,emqMode:'amq',watchlistOnly:false,tagsOnly:false,tagText:'',acceptPartial:false,keepHigher:true,watchStatusFilterEnabled:false,watchStatuses:['current','completed','paused','dropped','planning'],seasons:['Winter','Spring','Summer','Fall'],animeTypes:['TV','OVA','Movie','Special','ONA','Other'],songTypes:[1,2,3,4,5],statuses:[0,1,2,3]};
let quizSettings={...quizDefaults},activeFocusSongIdsV72=[],activeFocusModeV72=false,activeFocusOriginalSettingsV72=null,activeFocusOriginalPoolV72=null,quizRound=0,quizRoundTarget=25,quizRoundSeen=new Set(),quizClipTimer=null,quizOptionFocus=-1,quizAnswerStopAt=0;
function readQuizSettingsUI(){const g=id=>document.getElementById(id);quizSettings={count:Math.max(0,Math.min(500,Number(g('qsCount').value)||0)),clip:Math.max(5,Math.min(120,Number(g('qsClip').value)||20)),samplePosition:Math.max(0,Math.min(100,Number(g('qsSamplePosition')?.value)||0)),randomSample:g('qsRandomSample')?.getAttribute('aria-pressed')==='true',vndbCharacterId:g('qsVndbCharacterId')?.value.trim()||'',target:['anime','title','artist','all'].includes(g('quizTarget')?.value)?g('quizTarget').value:'anime',yearMin:window.__aniCandidatePoolPolicyV8265.settingNumber(g('qsYearMin').value,1924),yearMax:window.__aniCandidatePoolPolicyV8265.settingNumber(g('qsYearMax').value,2026),diffMin:window.__aniCandidatePoolPolicyV8265.settingNumber(g('qsDiffMin').value,0),diffMax:window.__aniCandidatePoolPolicyV8265.settingNumber(g('qsDiffMax').value,100),instantSec:Math.max(1,Math.min(30,Number(g('qsInstantSec').value)||5)),autoNextDelay:Math.max(1,Math.min(30,Number(g('qsAutoNextDelay')?.value)||5)),titleLanguage:g('qsTitleLanguage')?.value||'english',visualizerMode:g('qsVisualizerMode')?.value||'wave',unknownYear:g('qsUnknownYear').checked,noRepeat:true,autoPlay:g('qsAutoPlay').checked,autoNext:g('qsAutoNext').checked,includeEmq:!!g('qsEmqEnabled')?.checked,emqMode:['amq','mixed','emq'].includes(g('qsEmqModeV8249')?.value)?g('qsEmqModeV8249').value:(quizSettings.emqMode||'amq'),watchlistOnly:g('qsWatchlistOnly').checked,watchStatusFilterEnabled:g('qsWatchStatusFilterEnabled')?.checked||false,watchStatuses:[...document.querySelectorAll('[name=qsWatchStatus]:checked')].map(x=>x.value),tagsOnly:g('qsTagsOnly').checked,tagText:g('qsTagText').value.trim().toLowerCase(),acceptPartial:g('qsAcceptPartial').checked,keepHigher:g('qsKeepHigher').checked,seasons:[...document.querySelectorAll('[name=qsSeason]:checked')].map(x=>x.value),animeTypes:[...document.querySelectorAll('[name=qsAnimeType]:checked')].map(x=>x.value),songTypes:[...document.querySelectorAll('[name=qsSongType]:checked')].map(x=>Number(x.value)),statuses:[...document.querySelectorAll('[name=qsStatus]:checked')].map(x=>Number(x.value)),focusSongIds:Array.isArray(quizSettings.focusSongIds)?quizSettings.focusSongIds.map(String):[],customListIds:typeof window.__aniSelectedCustomListIdsV825==='function'?window.__aniSelectedCustomListIdsV825():(Array.isArray(quizSettings.customListIds)?quizSettings.customListIds.map(String):(quizSettings.customListId?[String(quizSettings.customListId)]:[])),customListId:(typeof window.__aniSelectedCustomListIdsV825==='function'?window.__aniSelectedCustomListIdsV825():(Array.isArray(quizSettings.customListIds)?quizSettings.customListIds.map(String):(quizSettings.customListId?[String(quizSettings.customListId)]:[]))).length===1?(typeof window.__aniSelectedCustomListIdsV825==='function'?window.__aniSelectedCustomListIdsV825()[0]:(Array.isArray(quizSettings.customListIds)?quizSettings.customListIds[0]:quizSettings.customListId||'')):''};try{localStorage.setItem('aniQuizSettingsV14',JSON.stringify(quizSettings))}catch(e){}applyQuizDisplaySettingsV30?.();}
function loadQuizSettings(){try{const storageKey='aniQuizSettingsV14',selectionSemanticsKey='aniQuizSelectionSemanticsV8265',raw=localStorage.getItem(storageKey),x=JSON.parse(raw||'{}');quizSettings={...quizDefaults,...x};if(!['anime','title','artist','all'].includes(quizSettings.target))quizSettings.target='anime';if(localStorage.getItem(selectionSemanticsKey)!=='1'){const migrated={...x};let changed=false;for(const k of ['seasons','animeTypes','songTypes','statuses','watchStatuses'])if(Array.isArray(x[k])&&x[k].length===0&&Array.isArray(quizDefaults[k])&&quizDefaults[k].length>0){quizSettings[k]=[...quizDefaults[k]];migrated[k]=[...quizDefaults[k]];changed=true}if(changed&&raw!==null)localStorage.setItem(storageKey,JSON.stringify(migrated));localStorage.setItem(selectionSemanticsKey,'1')}for(const k of ['seasons','animeTypes','songTypes','statuses','watchStatuses'])if(!Array.isArray(quizSettings[k]))quizSettings[k]=[];if(typeof quizSettings.unknownYear!=='boolean')quizSettings.unknownYear=false;if(!Array.isArray(quizSettings.focusSongIds))quizSettings.focusSongIds=[]}catch(e){quizSettings={...quizDefaults,seasons:[...quizDefaults.seasons],animeTypes:[...quizDefaults.animeTypes],songTypes:[...quizDefaults.songTypes],statuses:[...quizDefaults.statuses],focusSongIds:[]}}
// V82.61: migrate legacy settings once. Preserve an existing non-zero fixed Sample position; otherwise enable random Sample.
try{const migrationKey='aniV8261RandomSampleDefaultMigrated';if(localStorage.getItem(migrationKey)!=='1'){const saved=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');const hasExplicitFixedSample=Number(saved.samplePosition)>0&&saved.randomSample!==true;quizSettings.randomSample=!hasExplicitFixedSample;saved.randomSample=quizSettings.randomSample;saved.noRepeat=true;delete saved.enterSubmitEnabled;localStorage.setItem('aniQuizSettingsV14',JSON.stringify(saved));localStorage.setItem(migrationKey,'1')}}catch{}
quizSettings.noRepeat=true;const g=id=>document.getElementById(id);for(const [id,key] of [['qsCount','count'],['qsClip','clip'],['qsSamplePosition','samplePosition'],['qsVndbCharacterId','vndbCharacterId'],['qsYearMin','yearMin'],['qsYearMax','yearMax'],['qsDiffMin','diffMin'],['qsDiffMax','diffMax'],['qsInstantSec','instantSec'],['qsTagText','tagText']])g(id).value=quizSettings[key];for(const [id,key] of [['qsUnknownYear','unknownYear'],['qsAutoPlay','autoPlay'],['qsAutoNext','autoNext'],['qsWatchlistOnly','watchlistOnly'],['qsWatchStatusFilterEnabled','watchStatusFilterEnabled'],['qsTagsOnly','tagsOnly'],['qsAcceptPartial','acceptPartial'],['qsKeepHigher','keepHigher']])g(id).checked=!!quizSettings[key];if(g('qsEmqEnabled'))g('qsEmqEnabled').checked=!!quizSettings.includeEmq;if(g('qsEmqModeV8249'))g('qsEmqModeV8249').value=['amq','mixed','emq'].includes(quizSettings.emqMode)?quizSettings.emqMode:(quizSettings.includeEmq?'mixed':'amq');for(const [name,key] of [['qsSeason','seasons'],['qsAnimeType','animeTypes'],['qsSongType','songTypes'],['qsStatus','statuses'],['qsWatchStatus','watchStatuses']])document.querySelectorAll(`[name=${name}]`).forEach(el=>el.checked=(quizSettings[key]||[]).map(String).includes(String(el.value)));if(g('quizTarget'))g('quizTarget').value=quizSettings.target||'anime';if(g('qsTitleLanguage'))g('qsTitleLanguage').value=quizSettings.titleLanguage||'english';if(g('qsAutoNextDelay'))g('qsAutoNextDelay').value=quizSettings.autoNextDelay||5;if(g('qsVisualizerMode'))g('qsVisualizerMode').value=quizSettings.visualizerMode||'wave';const rs=g('qsRandomSample');if(rs){rs.setAttribute('aria-pressed',String(!!quizSettings.randomSample));rs.textContent='隨機 Sample：'+(quizSettings.randomSample?'開':'關');rs.classList.toggle('primary',!!quizSettings.randomSample)}}
<!-- AMQ_SPLIT_MODULE:candidate_pool_policy -->
<!-- AMQ_SPLIT_MODULE:get_quiz_pool -->
const __aniEmqGetQuizPoolBaseV8248=getQuizPool;getQuizPool=function(){const base=__aniEmqGetQuizPoolBaseV8248();const mixed=window.__aniEmqAPI?.combinePool?.(base,quizSettings,activeFocusModeV72,quizRoundSeen,lastQuestionId,activeFocusSongIdsV72);const rows=(Array.isArray(mixed)?mixed:base);const health=window.__aniAudioHealthV857;const healthy=health?rows.filter(song=>health.eligible(song)):rows;if(rows.length&&!healthy.length){const status=document.getElementById('quizStatus');if(status)status.textContent='目前篩選範圍沒有可播放的音源；無音源歌曲已暫時排除，來源資料更新後會自動重新納入。'}const scopeFilter=window.__aniApplyQuizCustomListScopeV8265;let scoped=healthy;if(typeof scopeFilter==='function'){try{const result=scopeFilter(healthy,!!activeFocusModeV72);scoped=Array.isArray(result)?result:[]}catch(error){console.error('Custom-list candidate scope failed closed',error);scoped=[]}}else if(!activeFocusModeV72){const ids=Array.isArray(quizSettings?.customListIds)?quizSettings.customListIds:[];let invalid=false;try{invalid=localStorage.getItem('aniQuizCustomListScopeInvalidV8265')==='1'}catch{}if(ids.length||quizSettings?.customListId||invalid){scoped=[];const status=document.getElementById('quizStatus');if(status)status.textContent='自訂清單範圍驗證尚未載入，已停止抽題以避免擴大候選範圍。請重新載入頁面。'}}return scoped};
function updateQuizCounts(){let h=0,k=0,i=0;for(const s of [...songs,...(quizSettings.includeEmq?(window.__aniEmqAPI?.getRows?.()||[]):[])]){const n=st(s[1]);if(n>=1)h++;if(n>=2)k++;if(n>=3)i++}document.getElementById('quizHeardCount').textContent=h.toLocaleString();document.getElementById('quizKnownCount').textContent=k.toLocaleString();document.getElementById('quizInstantCount').textContent=i.toLocaleString()}
window.__aniEmqToggleChangedV1=(enabled,mode)=>{quizSettings.includeEmq=!!enabled;if(['amq','mixed','emq'].includes(mode))quizSettings.emqMode=mode;else if(!enabled)quizSettings.emqMode='amq';else if(!['mixed','emq'].includes(quizSettings.emqMode))quizSettings.emqMode='mixed';try{localStorage.setItem('aniQuizSettingsV14',JSON.stringify(quizSettings))}catch(e){}try{updateQuizCounts()}catch(e){}};
function hideAnswer(){document.getElementById('quizResult').classList.add('hidden');document.getElementById('quizAnswer').value='';['quizAnswerArtistV857','quizAnswerTitleV857'].forEach(id=>{const field=document.getElementById(id);if(field){field.value='';field.disabled=true}});updateQuizAllAnswersV857();closeQuizSuggestions();document.getElementById('quizSuggestions').classList.remove('open');document.getElementById('quizNext').disabled=true;document.getElementById('quizSubmit').disabled=false;document.getElementById('quizSkip').disabled=false;document.getElementById('quizPrompt').textContent='♫ 盲聽中';document.getElementById('quizSubprompt').textContent='猜測目前選定的目標，音訊開始後計時';quizFinished=false;quizStartedAt=0;quizAnswerStopAt=0;quizAudioStarted=false;const target=document.getElementById('quizTarget');if(target)target.disabled=true}
function nextQuiz(){if(document.body.classList.contains('quiz-round-paused')){const s=document.getElementById('quizStatus');if(s)s.textContent='本輪已暫停，請先按「繼續」再切換題目。';return}if(typeof clearQuizPlaybackV30==='function')clearQuizPlaybackV30();if(window.audioEl)audioEl.pause();if(quizClipTimer)clearTimeout(quizClipTimer);if(window.videoEl){videoEl.pause();videoEl.removeAttribute('src');videoEl.style.display='none'}if(!quizSettings||!quizSettings.statuses)readQuizSettingsUI();if(quizRoundTarget===0)quizRoundTarget=quizSettings.count||0;if(quizSettings.count>0&&quizRound>=quizSettings.count){quizActive=false;quizFinished=true;quizAudioStarted=false;quizStartedAt=0;try{window.__aniQuizPauseClockV82?.reset?.()}catch(e){}try{clearQuizPlaybackV30()}catch(e){}try{clearQuizAutoNextV30()}catch(e){}document.getElementById('quizStatus').textContent=`本回合完成：${quizRound} 題。按「開始新題」開始新回合。`;document.getElementById('quizRoundLabel').textContent=`回合完成 · ${quizRound}/${quizSettings.count}`;document.getElementById('quizRoundProgress').style.width='100%';quizRound=0;quizRoundSeen.clear();quizRoundTarget=quizSettings.count;return}const pool=getQuizPool();if(!pool.length){quizSong=null;quizFinished=true;quizAudioStarted=false;quizStartedAt=0;document.getElementById('quizPrompt').textContent='目前沒有可播放的歌曲';document.getElementById('quizSubprompt').textContent='請調整曲庫來源、篩選條件，或更新音源資料。';document.getElementById('quizAnswer').value='';document.getElementById('quizAnswer').disabled=true;document.getElementById('quizSubmit').disabled=true;document.getElementById('quizSkip').disabled=true;document.getElementById('quizNext').disabled=true;document.getElementById('quizTimerDisplay').textContent='--';document.getElementById('quizAllAnswersV857')?.classList.add('hidden');return}quizSong=window.__aniEmqAPI?.chooseQuestion?.(pool,quizSettings,activeFocusModeV72)||pool[Math.floor(Math.random()*pool.length)];quizAnswerStopAt=0;quizStartedAt=0;quizAudioStarted=false;currentQuestionTarget=['anime','title','artist','all'].includes(document.getElementById('quizTarget')?.value)?document.getElementById('quizTarget').value:(quizSettings.target||'anime');quizSettings.target=currentQuestionTarget;lastQuestionId=quizSong[1];document.dispatchEvent(new CustomEvent('ani-quiz-new-question',{detail:{songId:quizSong[1],target:currentQuestionTarget}}));quizRoundSeen.add(String(quizSong[1]));hideAnswer();document.getElementById('quizStatus').textContent='先聽音訊，再輸入答案。按播放後開始計時。';document.getElementById('quizAudioState').textContent='正在準備音訊…';document.getElementById('quizRoundLabel').textContent=quizSettings.count?`本回合 ${quizRound+1}/${quizSettings.count}`:`自由練習 · 第 ${quizRound+1} 題`;document.getElementById('quizRoundProgress').style.width=quizSettings.count?`${Math.min(100,quizRound/quizSettings.count*100)}%`:'0%';document.getElementById('quizTimerDisplay').textContent='--';playQuizAudio();updateQuizCounts()} 
function playQuizAudio(){if(document.body.classList.contains('quiz-round-paused')){const s=document.getElementById('quizStatus');if(s)s.textContent='本輪已暫停，請先按「繼續」再播放音訊。';return}if(!quizSong)return;const manualPlayBtnV8262=document.getElementById('quizManualPlayV8262');if(manualPlayBtnV8262){manualPlayBtnV8262.hidden=quizSettings?.autoPlay!==false;manualPlayBtnV8262.disabled=false;manualPlayBtnV8262.textContent='▶ 播放音訊'}quizActive=true;try{const original=mediaFiles;window.mediaFiles=function(s){const all=original(s);return quizActive?all.filter(x=>x.kind==='audio'):all};listenSong(quizSong,{autoPlay:quizSettings?.autoPlay!==false});window.mediaFiles=original;document.getElementById('dockTitle').textContent='猜歌模式';document.getElementById('dockSubtitle').textContent='答案已隱藏';document.getElementById('playerTitle').textContent='猜歌模式';document.getElementById('playerSub').textContent='答案已隱藏';if(videoEl){videoEl.pause();videoEl.removeAttribute('src');videoEl.style.display='none'}document.getElementById('quizAudioState').textContent=mediaFiles(quizSong).some(x=>x.kind==='audio')?(quizSettings?.autoPlay===false?'音源已準備，按播放器播放後開始計時。':'音訊鏡像正在載入。'):'這首歌沒有音訊鏡像檔，無法在本頁播放。';}catch(e){document.getElementById('quizAudioState').textContent='音訊載入失敗；可以跳過或換下一題。'}}
