  async function startAudioIfNeeded(q){if(!q?.questionId)return;const id=String(q.questionId);if(state.audioSongId!==id){if(state.nextAudioSongId!==id||state.nextAudioLoadedFor!==id)await prepareAudio(q);if(state.nextAudioSongId!==id||state.nextAudioLoadedFor!==id){const el=$('mpRunningAudioStatus');if(el)el.textContent='音訊仍在載入中，完成後會自動開始。';return}activateNextAudio(id)}else if(state.audioLoadedFor!==id){await prepareAudio(q);if(state.audioSongId!==id&&state.nextAudioLoadedFor===id)activateNextAudio(id)}if(state.audioLoadedFor!==id)return;const a=makeAudio();if(state.audioStartedFor===id){if(a.paused&&state.phase==='running'){try{await a.play()}catch{}}await startVideoIfNeeded();return}state.audioStartedFor=id;try{a.currentTime=randomSampleStartV8261(q,a);if(!a.src){a.src=state.audioCandidates[state.audioCandidateIndex]||q.audioCandidates?.[0]||'';a.load()}await a.play();const el=$('mpRunningAudioStatus');if(el)el.textContent='音訊播放中。若聽不到聲音，請點「重播音訊」。'}catch(e){state.audioStartedFor='';const el=$('mpRunningAudioStatus');if(e?.name==='NotAllowedError'){if(el)el.textContent='瀏覽器未允許自動播放，請點「重播音訊」。'}else{if(el)el.textContent='目前音源無法播放，正在嘗試備用來源…';advanceActiveAudioV8261(id,a).catch(err=>setStatus(err.message,'error'))}}await startVideoIfNeeded()}
 async function replayAudio(){if(state.phase==='preparing'){if(state.lastPolled?.question)await prepareAudio(state.lastPolled.question);return}if(state.phase!=='running')return;state.audioStartedFor='';const a=makeAudio(),id=String(state.lastPolled?.question?.questionId||state.audioSongId);try{a.currentTime=randomSampleStartV8261(state.lastPolled?.question||{questionId:id},a);await a.play();state.audioStartedFor=id}catch(err){if(err?.name==='NotAllowedError')setStatus('瀏覽器阻擋音訊播放，請再點一次重播音訊。','error');else{setStatus('目前音源重播失敗，正在嘗試下一個備用來源。','error');await advanceActiveAudioV8261(id,a)}}}
 async function action(which,body={},timeout=8000){if(!state.session)throw Error('目前沒有連線中的房間。');return request(`/api/rooms/${encodeURIComponent(state.session.roomCode)}/${which}`,{method:'POST',body,timeout})}
 async function configureFromUi(){const checked=selector=>[...view.querySelectorAll(selector+':checked')].map(el=>selector.includes('song-type')?Number(el.value):el.value);const diffA=strictPoolNumber(($('mpHostDiffMin')?.value??$('mpCreateDiffMin')?.value),0,0,100),diffB=strictPoolNumber(($('mpHostDiffMax')?.value??$('mpCreateDiffMax')?.value),100,0,100),yearA=strictPoolNumber(($('mpHostYearMin')?.value??$('mpCreateYearMin')?.value),1900,1900,2100,true),yearB=strictPoolNumber(($('mpHostYearMax')?.value??$('mpCreateYearMax')?.value),2100,1900,2100,true);if(yearA===null||yearB===null)throw new Error('年份範圍包含空白或非法值，請填入 1900–2100 的整數。');if(diffA===null||diffB===null)throw new Error('難度範圍包含空白或非法值，請填入 0–100 的數值。');const c={sourceMode:normalizedSourceMode($('mpHostSourceMode')?.value||$('mpCreateSourceMode')?.value||prefs.sourceMode),questionCount:boundedNumber($('mpHostQuestions')?.value??$('mpCreateQuestions')?.value,10,1,100),secondsPerQuestion:boundedNumber($('mpHostSeconds')?.value??$('mpCreateSeconds')?.value,15,1,180),revealSeconds:boundedNumber($('mpHostReveal')?.value??$('mpCreateReveal')?.value,0,0,60),drawMode:($('mpHostDraw')?.value||$('mpCreateDrawMode')?.value)==='random'?'random':'equal',teamSize:boundedNumber($('mpHostTeam')?.value??$('mpCreateTeamSize')?.value,1,1,8),mode:(($('mpHostMode')?.value||$('mpCreateMode')?.value)==='team'?'team':'individual'),difficultyMode:'all',difficultyMin:diffA,difficultyMax:diffB,yearMin:yearA,yearMax:yearB,unknownYear:$('mpHostUnknownYear')?.checked??$('mpCreateUnknownYear')?.checked??true,animeTypes:view.querySelectorAll('[data-room-anime-type]').length?checked('[data-room-anime-type]'):checked('[data-create-anime-type]'),songTypes:view.querySelectorAll('[data-room-song-type]').length?checked('[data-room-song-type]'):checked('[data-create-song-type]'),seasons:view.querySelectorAll('[data-room-season]').length?checked('[data-room-season]'):checked('[data-create-season]'),autoAdvance:($('mpHostAutoAdvance')?.checked??$('mpCreateAutoAdvance')?.checked??true)};if(c.yearMin>c.yearMax)throw new Error('年份下限不能大於上限。');if(c.difficultyMin>c.difficultyMax)throw new Error('難度下限不能大於上限。');return action('configure',{settings:c})}
 async function doStart(){if(state.apiBusy)return;setBusy(true);try{await configureFromUi();await loadState(true);const ids=candidateSongIds();if(!ids.length)throw Error('目前個人條件沒有任何可用歌曲。請檢查出題曲庫、單人篩選與 AMQ／EMQ 自訂清單範圍。');await action('candidates',{candidateSongIds:ids,emqCandidates:emqManifestForIds(ids),dedicatedEmqSongIds:dedicatedEmqScopeSongIds(ids)},30000);const startSource=normalizedSourceMode($('mpHostSourceMode')?.value||state.lastPolled?.settings?.sourceMode||$('mpCreateSourceMode')?.value||prefs.sourceMode);let chineseSyncWarning='';if((prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese')&&startSource!=='emq'){const titleApi=window.__aniChineseTitleAPIv8237;if(titleApi?.ensureLoaded)await titleApi.ensureLoaded();if(titleApi?.ready){try{await syncChineseTitleAliasesToRoom(true)}catch{chineseSyncWarning='AMQ 中文標題尚未同步；本局仍可遊玩。'}}}await action('start');await loadState(true);setStatus('比賽開始。所有在線玩家音訊就緒後，伺服器才會啟動倒數。'+(chineseSyncWarning?' '+chineseSyncWarning:''),chineseSyncWarning?'info':'success')}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 async function submitAnswer(field,value){const answer=String(value??'').trim();if(!answer){setStatus('請先輸入要提交的答案。','error');return}await submitAllAnswers({[field]:answer})}
 async function submitAllAnswers(overrides=null){if(state.apiBusy||!state.session||state.phase!=='running')return;const source=overrides||Object.fromEntries(['anime','artist','title'].map(field=>[field,$('mpAnswer_'+field)?.value||'']));const answers=Object.fromEntries(['anime','artist','title'].map(field=>[field,String(source[field]??'').trim()]).filter(([,value])=>value));if(!Object.keys(answers).length){setStatus('請至少填寫作品、歌手或歌名其中一欄。','error');return}for(const [field,value] of Object.entries(answers)){if(value.length>200){setStatus('單一答案不可超過 200 個字元。','error');return}state.answerDrafts={...(state.answerDrafts||{}),[field]:value}}setBusy(true);try{const r=await action('answers',{answers});const labels={anime:'動畫',artist:'歌手',title:'歌名'};setStatus(`已一次提交 ${Object.keys(r.newlySubmittedFields||answers).map(x=>labels[x]||x).join('、')}。揭曉前不顯示正誤；截止前可再次提交修正。`,'success');await loadState(true)}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 function answerDraftSummary(){const labels={anime:'動畫',artist:'歌手',title:'歌名'};return ['anime','artist','title'].filter(f=>String(state.answerDrafts?.[f]||'').trim()).map(f=>`${labels[f]}：${String(state.answerDrafts[f]).trim()}`).join(' · ')}
 async function hostAction(which){if(state.apiBusy)return;setBusy(true);try{await action(which);await loadState(true)}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 async function saveConfigAndStart(){await configureFromUi();await doStart()}
 async function leaveRoom(){if(!state.session){releaseLocal();return}const old=state.session;setBusy(true);try{await action('leave');removeReconnect(old);setStatus('已離開房間。','success')}catch(e){setStatus('通知伺服器離房失敗；已清除此分頁的連線資料。','error')}finally{setBusy(false);releaseLocal(false)}}
 async function sendChat(text){const msg=String(text||'').trim();if(!msg)return;if(msg.length>300){setStatus('聊天室訊息最多 300 個字元。','error');return}await action('chat',{text:msg});state.chatDraft='';await loadState(true)}
 function scheduleDraftSend(){if(state.draftSendTimer||state.draftSendBusy||!state.session||state.phase!=='running')return;state.draftSendTimer=setTimeout(flushDraft,55)}
 async function flushDraft(){state.draftSendTimer=null;if(!state.session||state.phase!=='running')return;const body=String(state.draftPendingText||'');if(body===state.lastDraftSent)return;state.draftSendBusy=true;try{await sendDraftUpdate(body);state.lastDraftSent=body}catch(e){if(e.status===429||e.code==='draft_rate_limited'){setTimeout(scheduleDraftSend,70)}else if(state.session&&state.phase==='running'){console.warn('Team draft sync failed',e)}}finally{state.draftSendBusy=false;if(state.draftPendingText!==state.lastDraftSent)scheduleDraftSend()}}
 function updateDraft(text){state.localDraft=String(text||'').slice(0,160);state.draftPendingText=state.localDraft;const own=$('mpOwnSpeech');if(own){own.textContent=state.localDraft||'…';own.classList.toggle('mpSpeechOn',!!state.localDraft)}if(!state.session||state.phase!=='running')return;scheduleDraftSend()}
 function autoSubmitCheck(){clearTimeout(state.autoSubmitTimer);if(!prefs.autoSubmitVerified||state.phase!=='running')return;const input=$('mpAnswer_anime');if(!input||document.activeElement!==input)return;const candidate=input.value.trim();if(!candidate)return;const normal=x=>String(x||'').normalize('NFKC').trim().replace(/\s+/g,' ').toLocaleLowerCase();const exact=(Array.isArray(anime)?anime:[]).some(a=>[a[1],a[2],...(window.__aniChineseTitleAPIv8237?.getAliases(a[0])||[])].some(t=>t&&normal(t)===normal(candidate)));if(exact)state.autoSubmitTimer=setTimeout(()=>{if(state.phase==='running'&&$('mpAnswer_anime')?.value.trim()===candidate)submitAnswer('anime',candidate)},520)}
 async function loadVndbAvatar(){const raw=$('mpVndbId').value.trim();if(!/^c\d+$/i.test(raw)){ $('mpAvatarStatus').textContent='VNDB 角色 ID 格式應為 c12345。';return}const id='c'+raw.slice(1);const status=$('mpAvatarStatus');status.textContent='正在查詢 VNDB 角色…';try{let ch;try{ch=await request(`/api/vndb/character?id=${encodeURIComponent(id)}`,{auth:false,timeout:10000})}catch(proxyError){const r=await fetch('https://api.vndb.org/kana/character',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({filters:['id','=','c'+id.slice(1)],fields:'id,name,image.url',results:1})});if(!r.ok)throw Error('房間服務與瀏覽器直連均無法查詢 VNDB（HTTP '+r.status+'）。');const j=await r.json(),row=j.results?.[0];if(!row)throw proxyError;ch={id:row.id,name:row.name,imageUrl:row.image?.url}}const url=String(ch?.imageUrl||'');if(!url.startsWith('https://'))throw Error('找不到公開的 HTTPS 角色圖片');prefs.avatarId=String(ch.id||id);prefs.avatarUrl=url;savePersonalPrefs(false);localStorage.setItem('aniQuizVndbCharacterV36',JSON.stringify({id:prefs.avatarId,url}));$('mpAvatarPreview').innerHTML=`<img src="${safeText(url)}" alt="VNDB 角色頭像">`;status.textContent='已載入 '+(ch.name||ch.id)+' 的角色圖片。圖片由瀏覽器直接載入，房間服務不儲存圖片檔。'}catch(e){status.textContent='載入失敗：'+e.message}}
 function openExistingImporter(provider){if(provider==='ani'){const val=$('mpAniListUser').value.trim();if(!val){$('mpPersonalStatus').textContent='請先輸入 AniList 使用者 ID／名稱。';return}const input=$('aniListUsername'),button=$('aniListImportBtn');if(!input||!button){$('mpPersonalStatus').textContent='找不到既有 AniList 匯入工具。';return}input.value=val;const token=$('aniListToken');if(token?.value){}button.click();prefs.aniListUser=val;savePersonalPrefs(false);$('mpPersonalStatus').textContent='已呼叫原有 AniList 匯入。請查看匯入視窗的結果。'}else{const val=$('mpMalUser').value.trim();if(!val){$('mpPersonalStatus').textContent='請先輸入 MyAnimeList 帳號名稱。';return}const input=$('malUsername'),button=$('malUsernameImportBtn');if(!input||!button){$('mpPersonalStatus').textContent='找不到既有 MyAnimeList 匯入工具。';return}input.value=val;button.click();prefs.malUser=val;savePersonalPrefs(false);$('mpPersonalStatus').textContent='已呼叫原有 MyAnimeList 匯入。請查看匯入視窗的結果。'}}
 view.addEventListener('click',async e=>{const handoff=e.target.closest('button[data-transfer-host]');if(handoff){e.preventDefault();const targetId=handoff.dataset.transferHost;const target=state.lastPolled?.players?.find(p=>String(p.playerId)===String(targetId));if(!target)return;if(!confirm(`要將房主權限交給「${target.playerName}」嗎？交接後對方可以管理這個房間。`))return;try{await action('transfer-host',{targetPlayerId:targetId});await loadState(true);setStatus(`已將房主權限交給 ${target.playerName}。`,'success')}catch(err){setStatus(err.message||'房主交接失敗。','error')}return}const b=e.target.closest('button[id]');if(!b)return;const id=b.id;try{
  if(b.dataset.submitField){const field=b.dataset.submitField;submitAnswer(field,$('mpAnswer_'+field)?.value||'');return}if(id==='mpSubmitAll'){await submitAllAnswers();return}if(id==='mpBackQuiz'){window.__aniNavigateApp?.('quiz');return}if(id==='mpBackHome'){window.__aniNavigateApp?.('home');return}
  if(id==='mpTogglePersonal'){const p=$('mpPersonalPanel');p.classList.toggle('hidden');b.setAttribute('aria-expanded',String(!p.classList.contains('hidden')));renderCustomListChoices();return}
  if(id==='mpSavePersonal'){savePersonalPrefs(true);return}if(id==='mpImportVnList'){await importVnDbPersonalList();return}if(id==='mpLoadAvatar'){await loadVndbAvatar();return}if(id==='mpImportAniList'){openExistingImporter('ani');return}if(id==='mpImportMal'){openExistingImporter('mal');return}
  if(id==='mpCheckApi'){await checkApi();return}if(id==='mpCreateRoom'){await createRoom();return}if(id==='mpJoinRoom'){await joinRoom();return}if(id==='mpRejoinRoom'){await rejoinRoom();return}
  if(id==='mpStart'){await doStart();return}if(id==='mpSaveRoomSettings'){await configureFromUi();state.roomConfigDirty=false;await loadState(true);setStatus('房間設定已保存。','success');return}
  if(id==='mpSkipQuestion'){if(!confirm('這會讓整個房間跳過目前題目並進入揭曉。已提交的有效答案仍依遊戲規則結算，未作答不計分。'))return;await action('skip',{});await loadState(true);return}if(id==='mpReveal'){await hostAction('reveal');return}if(id==='mpNext'){await hostAction('next');return}if(id==='mpPause'){await hostAction('pause');if(state.audio)try{state.audio.pause()}catch{};if(state.video)try{state.video.pause()}catch{};return}if(id==='mpResume'){await hostAction('resume');return}if(id==='mpLobby'){if(!confirm('結束本局並讓所有玩家回到同一個大廳？已結算紀錄會保留。'))return;await hostAction('lobby');state.playerPage=0;return}
  if(id==='mpLeaveTop'||id==='mpLeaveStopped'){if(!confirm('離開房間？其他玩家的遊戲不會因此停止。'))return;await leaveRoom();return}if(id==='mpReplay'){await replayAudio();return}if(id==='mpRetryAudio'){const q=state.lastPolled?.question;if(q){const sid=String(q.questionId||'');if(state.phase==='running'&&state.audioSongId===sid&&state.audio){await advanceActiveAudioV8261(sid,state.audio)}else{if(state.nextAudioSongId===sid)clearNextAudio();await prepareAudio(q)}}return}
  if(id==='mpPlayerPrev'){state.playerPage=Math.max(0,state.playerPage-1);await loadState(true);return}if(id==='mpPlayerNext'){state.playerPage=Math.min(3,state.playerPage+1);await loadState(true);return}
  if(id==='mpCopyCode'){const code=state.session?.roomCode||'';try{await navigator.clipboard.writeText(code);setStatus('房間代碼已複製。','success')}catch{setStatus('房間代碼：'+code+'（瀏覽器不允許自動複製）')}return}
 }catch(err){setStatus(err.message||'操作失敗。','error')}});
 view.addEventListener('submit',e=>{if(e.target?.id==='mpAnswerForm'){e.preventDefault();submitAllAnswers()}if(e.target?.id==='mpChatForm'){e.preventDefault();const i=$('mpChatInput');const text=i?.value||'';if(i)i.value='';state.chatDraft='';sendChat(text).catch(err=>setStatus(err.message,'error'))}});
 const suggestionCache={};
 window.__aniRefreshChineseSuggestionsV8237=()=>{for(const k of Object.keys(suggestionCache))if(k.startsWith('anime|'))delete suggestionCache[k];for(const field of ['anime','artist','title']){const input=$('mpAnswer_'+field);if(input&&input.value.trim())renderSuggestions(input)}};
 function suggestionValues(field){const mode=selectedSourceMode(),key=field+'|'+mode+'|'+((prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese')?'zh':'base');if(suggestionCache[key])return suggestionCache[key];const vals=new Set();if(field==='anime'){if(mode!=='emq')for(const a of (Array.isArray(anime)?anime:[])){const aliases=(prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese')?(window.__aniChineseTitleAPIv8237?.getAliases(a?.[0])||[]):[];for(const t of [a?.[1],a?.[2],...aliases])if(typeof t==='string'&&t.trim())vals.add(t.trim())}if(mode!=='amq')for(const w of (window.__aniEmqAPI?.getWorks?.()||[]))for(const t of [w?.t,w?.n,...(prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese'?(window.__aniEmqChineseTitleAPIv8259?.getAliases?.(w?.i)||[]):[])])if(typeof t==='string'&&t.trim())vals.add(t.trim())}else{if(mode!=='emq')for(const s of (Array.isArray(songs)?songs:[])){const v=field==='title'?s?.[4]:s?.[5];if(typeof v==='string'&&v.trim())vals.add(v.trim())}if(mode!=='amq')for(const s of (window.__aniEmqAPI?.getRows?.()||[])){const id=s?.[1],aliases=window.__aniEmqAPI?.getAliases?.(id)||{},list=field==='title'?[s?.[4],...(aliases.title||[])]:[s?.[5],...(aliases.artist||[])];for(const v of list)if(typeof v==='string'&&v.trim())vals.add(v.trim())}}suggestionCache[key]=[...vals];return suggestionCache[key]}
 function hideSuggestions(except=null){for(const el of view.querySelectorAll('.mpSuggest'))if(el!==except)el.classList.add('hidden')}
 function renderSuggestions(input){const field=input.dataset.answerField,root=$('mpSuggest_'+field),q=input.value.trim().normalize('NFKC').toLocaleLowerCase();if(!root)return;if(!q){root.classList.add('hidden');root.innerHTML='';return}const values=suggestionValues(field);const matches=[];for(const v of values){const n=v.normalize('NFKC').toLocaleLowerCase();if(n.includes(q)){matches.push({v,n,rank:n.startsWith(q)?0:1});if(matches.length>=36)break}}matches.sort((a,b)=>a.rank-b.rank||a.v.localeCompare(b.v));const top=matches.slice(0,10);const normal=x=>String(x??'').normalize('NFKC').trim().toLocaleLowerCase();const submitted=new Set((state.lastPolled?.ownAnswers||[]).filter(x=>x.field===field).map(x=>normal(x.answer)));const typed=normal(input.value);root.innerHTML=top.map((x,i)=>{const used=submitted.has(normal(x.v)),isTyped=!!typed&&typed===normal(x.v);const cls=`mpSuggestionOption${i===0?' mpSuggestionActive':''}${used?' mpSuggestionUsed':''}${isTyped?' mpSuggestionTyped':''}`;const badge=used?'<span class="mpSuggestionBadge">已提交</span>':isTyped?'<span class="mpSuggestionBadge">目前輸入</span>':'';return `<button type="button" class="${cls}" role="option" aria-selected="${i===0?'true':'false'}" data-suggestion-value="${safeText(x.v)}"><span>${safeText(x.v)}</span>${badge}</button>`}).join('');root.dataset.active='0';root.classList.toggle('hidden',!top.length)}
 view.addEventListener('input',e=>{if(e.target?.closest?.('.mpRoomConfigGrid,.mpFilterGrid'))state.roomConfigDirty=true;if(e.target?.dataset?.answerField){const field=e.target.dataset.answerField;state.answerDrafts={...(state.answerDrafts||{}),[field]:e.target.value};renderSuggestions(e.target);autoSubmitCheck();updateDraft(answerDraftSummary())}if(e.target?.id==='mpChatInput')state.chatDraft=e.target.value;if(e.target?.id==='mpGameVolume'){gameMedia.volume=Math.max(0,Math.min(1,Number(e.target.value)/100));const out=$('mpGameVolumeValue');if(out)out.textContent=Math.round(gameMedia.volume*100)+'%';if(state.audio){state.audio.volume=gameMedia.volume;state.audio.muted=false}if(state.nextAudio){state.nextAudio.volume=gameMedia.volume;state.nextAudio.muted=false}saveGameMedia();}});
 view.addEventListener('keydown',e=>{const input=e.target;if(!input?.dataset?.answerField)return;if(e.key==='Escape'){hideSuggestions();return}if(e.key==='Enter'){if(e.isComposing||e.keyCode===229)return;const box=$('mpSuggest_'+input.dataset.answerField);if(box&&!box.classList.contains('hidden')){const opts=[...box.querySelectorAll('.mpSuggestionOption')];if(opts.length){e.preventDefault();e.stopPropagation();const active=Math.max(0,Math.min(opts.length-1,Number(box.dataset.active||0)));const option=opts[active]||opts[0];const value=option?.dataset?.suggestionValue;if(value!==undefined){const field=input.dataset.answerField;input.value=value;state.answerDrafts={...(state.answerDrafts||{}),[field]:value};hideSuggestions();input.focus({preventScroll:true});try{input.setSelectionRange(input.value.length,input.value.length)}catch{};updateDraft(answerDraftSummary());return}}}e.preventDefault();e.stopPropagation();hideSuggestions();submitAllAnswers();return}const box=$('mpSuggest_'+input.dataset.answerField);if(!box||box.classList.contains('hidden'))return;const opts=[...box.querySelectorAll('.mpSuggestionOption')];if(!opts.length)return;let i=Number(box.dataset.active||0);if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();i=(i+(e.key==='ArrowDown'?1:-1)+opts.length)%opts.length;box.dataset.active=String(i);opts.forEach((b,j)=>{b.classList.toggle('mpSuggestionActive',j===i);b.setAttribute('aria-selected',String(i===j))});opts[i].scrollIntoView({block:'nearest'});}});
 view.addEventListener('click',e=>{const option=e.target.closest('.mpSuggestionOption');if(option){const field=option.closest('.mpSuggest')?.id.replace('mpSuggest_','');const input=$('mpAnswer_'+field),v=option.dataset.suggestionValue;if(input&&v){input.value=v;state.answerDrafts={...(state.answerDrafts||{}),[field]:v};input.focus({preventScroll:true});hideSuggestions();updateDraft(answerDraftSummary())}return}if(!e.target.closest('.mpInputSuggestWrap'))hideSuggestions()});
 view.addEventListener('change',e=>{if(e.target.matches('[data-custom-list]')){invalidAmqListSettingV8265=false;setPersistentScopeFaultV8265(MP_AMQ_SCOPE_INVALID_KEY_V8265,false)}if(e.target.matches('[data-emq-custom-list]')){invalidEmqListSettingV8265=false;setPersistentScopeFaultV8265(MP_EMQ_SCOPE_INVALID_KEY_V8265,false)}if(e.target.matches('[data-custom-list],[data-emq-custom-list],[data-watch-status],[data-mp-song-status]'))savePersonalPrefs(false);if(e.target.matches('#mpQuickPool,#mpWatchlistOnly,#mpWatchStatusFilterEnabled,#mpTagsOnly,#mpTagText,#mpUseVndbList,#mpCreateSourceMode,#mpCreateQuestions,#mpCreateYearMin,#mpCreateYearMax,#mpCreateDiffMin,#mpCreateDiffMax,#mpCreateUnknownYear,[data-create-anime-type],[data-create-song-type],[data-create-season],#mpCreateReveal,#mpCreateAutoAdvance')){persistMultiplayerPrefs(false);if(state.session&&state.phase==='waiting'&&state.lastPolled?.isHost)state.roomConfigDirty=true}if(e.target.id==='mpGameVideoToggle'){gameMedia.showVideo=!!e.target.checked;saveGameMedia();if(!gameMedia.showVideo){if(state.video){try{state.video.pause();state.video.removeAttribute('src');state.video.load()}catch{}}state.videoSongId='';state.videoCandidates=[];state.videoCandidateIndex=0;$('mpVideoMount')?.classList.remove('mpVideoVisible');const status=$('mpVideoStatusV835');if(status)status.textContent='影片已關閉。'}else if(state.lastPolled?.question){prepareVideo(state.lastPolled.question);if(state.phase==='reveal')startVideoIfNeeded().catch(()=>{})}}if(e.target.id==='mpApiBase'){try{base();setHealth('API 位址已更新，尚未測試連線。',null)}catch(err){setHealth(err.message,false)}}if(e.target.id==='mpCreateMode'||e.target.id==='mpHostMode'){const size=$(e.target.id==='mpCreateMode'?'mpCreateTeamSize':'mpHostTeam');if(e.target.value==='team'&&size&&size.value==='1')size.value='2'}if(e.target.closest?.('.mpRoomConfigGrid,.mpFilterGrid'))state.roomConfigDirty=true});
 $('mpRoomCodeInput').addEventListener('input',e=>{e.target.value=e.target.value.toUpperCase().replace(/[^A-Z2-9]/g,'').slice(0,6)});
 document.addEventListener('click',e=>{if(e.target.closest?.('#quizMultiplayerOpen')){e.preventDefault();e.stopPropagation();window.__aniNavigateApp?.('multiplayer')}},true);
 document.addEventListener('ani-app-navigation',e=>{if(e.detail?.view==='multiplayer'){if(state.session?.apiBase)$('mpApiBase').value=state.session.apiBase;restoreOrShow().catch(err=>setStatus(err.message,'error'))}else{stopPoll();stopLive();if(state.audio&&state.phase==='running')try{state.audio.pause()}catch{}}});
 document.addEventListener('ani-chinese-title-map-ready',()=>{if(prefs.chineseSuggestionsEnabled&&state.lastPolled?.settings?.sourceMode!=='emq')queueMicrotask(()=>syncChineseTitleAliasesToRoom().catch(()=>{}));window.__aniRefreshChineseSuggestionsV8237?.()});
 async function restoreOrShow(){if(!state.session)state.session=readSession();try{const saved=localStorage.getItem(BASE_KEY);if(saved)$('mpApiBase').value=saved}catch{}if(state.session){if(state.session.apiBase)$('mpApiBase').value=state.session.apiBase;$('mpRoomCodeInput').value=state.session.roomCode;$('mpPlayerName').value=state.session.playerName||'';await loadState(true);startPoll()}else{$('mpSetup').classList.remove('hidden');$('mpRoomStage').classList.add('hidden');setHealth('尚未測試連線；點擊「測試連線」才會連接本機多人服務。')}}
 try{const b=localStorage.getItem(BASE_KEY);if(b)$('mpApiBase').value=b}catch{}loadMyProfile();state.session=readSession();if(state.session)restoreOrShow();
 $('mpCreateSourceMode')?.addEventListener('change',()=>{prefs.sourceMode=normalizedSourceMode($('mpCreateSourceMode').value);try{localStorage.setItem(PREF_KEY,JSON.stringify(prefs))}catch{}});$('mpChineseSuggestionsEnabled')?.addEventListener('change',()=>{prefs.chineseSuggestionsEnabled=!!$('mpChineseSuggestionsEnabled').checked;try{localStorage.setItem(PREF_KEY,JSON.stringify(prefs))}catch{};delete suggestionCache.anime;window.__aniRefreshChineseSuggestionsV8237?.();if(prefs.chineseSuggestionsEnabled)syncChineseTitleAliasesToRoom().catch(()=>{})});$('mpNameLanguage')?.addEventListener('change',()=>{prefs.displayLanguage=['english','romaji','chinese'].includes($('mpNameLanguage').value)?$('mpNameLanguage').value:'english';try{localStorage.setItem(PREF_KEY,JSON.stringify(prefs))}catch{};for(const k of Object.keys(suggestionCache))if(k.startsWith('anime|'))delete suggestionCache[k];window.__aniRefreshChineseSuggestionsV8237?.();if(prefs.displayLanguage==='chinese')syncChineseTitleAliasesToRoom().catch(()=>{})});window.__aniMultiplayerUIV82=Object.freeze({open:()=>window.__aniNavigateApp?.('multiplayer'),getState:()=>state.lastPolled,getLiveState:()=>({enabled:state.liveEnabled,connected:!!state.liveAuthed,readyState:state.liveSocket?.readyState??3}),checkApi,releaseLocal,prefs:()=>({...prefs})});
})();
</script>