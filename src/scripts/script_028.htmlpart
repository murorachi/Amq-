<script id="v82-34-multiplayer-ui">
(()=>{
 'use strict';
 const ROOT=document.querySelector('.wrap');if(!ROOT||document.getElementById('multiplayerView'))return;
 const SESSION_KEY='aniMultiplayerRoomSessionV2',BASE_KEY='aniMultiplayerApiBaseV1',PREF_KEY='aniMultiplayerPersonalSettingsV82',RECONNECT_KEY='aniMultiplayerReconnectV82',STATS_KEY='aniMultiplayerStatsV82',RECORDED_KEY='aniMultiplayerRecordedV82',GAME_MEDIA_KEY='aniMultiplayerGameMediaV835';
 const safeText=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const $=id=>document.getElementById(id);
 const defaults={displayLanguage:'english',sourceMode:'amq',chineseSuggestionsEnabled:false,autoSubmitVerified:false,quickPool:'all',statuses:[0,1,2,3],watchlistOnly:false,watchStatusFilterEnabled:false,tagsOnly:false,tagText:'',watchStatuses:[],customListIds:[],emqListIds:[],useImportedVnList:false,vnUserName:'',aniListUser:'',malUser:'',avatarId:'',avatarUrl:'',roomFiltersV8259:null};
 function displayAnimeName(animeId,english,romaji){const lang=prefs.displayLanguage||'english';if(lang==='chinese'){const emqZh=window.__aniEmqChineseTitleAPIv8259?.getTitle?.(animeId);if(emqZh)return emqZh;const zh=window.__aniChineseTitleAPIv8237?.getTitle?.(animeId);if(zh)return zh}return lang==='romaji'?(romaji||english||'未知作品'):(english||romaji||'未知作品')}
 function readJson(key,fallback){try{const v=JSON.parse(localStorage.getItem(key)||'null');return v&&typeof v==='object'?v:fallback}catch{return fallback}}
 const persistedPrefs=readJson(PREF_KEY,{});const MP_AMQ_SCOPE_INVALID_KEY_V8265='aniMultiplayerAmqListScopeInvalidV8265',MP_EMQ_SCOPE_INVALID_KEY_V8265='aniMultiplayerEmqListScopeInvalidV8265';const hasPersistentScopeFaultV8265=key=>{try{return localStorage.getItem(key)==='1'}catch{return false}};const setPersistentScopeFaultV8265=(key,value)=>{try{if(value)localStorage.setItem(key,'1');else localStorage.removeItem(key)}catch{}};let prefs={...defaults,...persistedPrefs},invalidAmqListSettingV8265=(Object.prototype.hasOwnProperty.call(persistedPrefs,'customListIds')&&!Array.isArray(persistedPrefs.customListIds))||hasPersistentScopeFaultV8265(MP_AMQ_SCOPE_INVALID_KEY_V8265),invalidEmqListSettingV8265=(Object.prototype.hasOwnProperty.call(persistedPrefs,'emqListIds')&&!Array.isArray(persistedPrefs.emqListIds))||hasPersistentScopeFaultV8265(MP_EMQ_SCOPE_INVALID_KEY_V8265);if(Object.prototype.hasOwnProperty.call(persistedPrefs,'customListIds')&&!Array.isArray(persistedPrefs.customListIds))setPersistentScopeFaultV8265(MP_AMQ_SCOPE_INVALID_KEY_V8265,true);if(Object.prototype.hasOwnProperty.call(persistedPrefs,'emqListIds')&&!Array.isArray(persistedPrefs.emqListIds))setPersistentScopeFaultV8265(MP_EMQ_SCOPE_INVALID_KEY_V8265,true);if(!Array.isArray(prefs.statuses))prefs.statuses=[];if(!Array.isArray(prefs.watchStatuses))prefs.watchStatuses=[];if(!Array.isArray(prefs.customListIds))prefs.customListIds=[];if(!Array.isArray(prefs.emqListIds))prefs.emqListIds=[];delete prefs.autoSkipGuess;delete prefs.autoSkipBuffer;delete prefs.showVideo;delete prefs.vndbWorkIds;
 const savedMedia=readJson(GAME_MEDIA_KEY,{});
 const gameMedia={volume:Number.isFinite(Number(savedMedia.volume))?Math.max(0,Math.min(1,Number(savedMedia.volume))):0.55,showVideo:savedMedia.showVideo===true};
 function saveGameMedia(){try{localStorage.setItem(GAME_MEDIA_KEY,JSON.stringify(gameMedia))}catch{}}
 const view=document.createElement('section');view.id='multiplayerView';view.className='hidden';view.setAttribute('aria-label','多人猜歌房間');
 view.innerHTML=`
  <header class="mpTop"><div><div class="detailEyebrow">ANISONG · MULTIPLAYER</div><h2>多人猜歌房間</h2></div><div class="mpTopActions"><button class="btn" id="mpBackQuiz" type="button">返回單人猜歌</button><button class="btn" id="mpBackHome" type="button">返回首頁</button></div></header>
  <section id="mpSetup">
   <article class="mpCard mpConnection"><div class="mpCardHead"><div><h3>伺服器與個人資料</h3></div><button class="btn" id="mpTogglePersonal" type="button" aria-expanded="false">個人設定</button></div>
    <div class="mpFormInline"><div class="mpFormRow"><label for="mpApiBase">API 位址</label><input class="mpInput" id="mpApiBase" type="url" spellcheck="false" autocomplete="url" value="http://127.0.0.1:8765"></div><div class="mpFormRow"><label for="mpPlayerName">玩家名稱</label><input class="mpInput" id="mpPlayerName" maxlength="28" autocomplete="nickname" placeholder="輸入房間名稱"></div></div>
    <div class="mpGameButtons"><button class="btn" id="mpCheckApi" type="button">測試連線</button><span class="mpSmall" id="mpHealthSummary">尚未測試連線。</span></div>
    <div id="mpPersonalPanel" class="mpPersonalPanel hidden"><div class="mpPersonalColumns">
     <section class="mpPersonalGroup"><h4>頭像與顯示</h4><div class="mpAvatarEdit"><div class="mpAvatarPreview" id="mpAvatarPreview">♫</div><div class="mpAvatarField"><label for="mpVndbId">VNDB 角色 ID</label><div class="mpInputAction"><input class="mpInput" id="mpVndbId" maxlength="24" placeholder="c12345"><button class="btn" id="mpLoadAvatar" type="button">載入</button></div><small id="mpAvatarStatus"></small></div></div>
      <div class="mpFormRow"><label for="mpNameLanguage">預設顯示作品名稱</label><select class="mpSelect" id="mpNameLanguage"><option value="english">English</option><option value="romaji">Romaji</option><option value="chinese">繁體中文（台灣）</option></select></div>
      <label class="mpCheck"><input id="mpChineseSuggestionsEnabled" type="checkbox"><span><b>啟用中文名稱建議下拉選單</b><small>預設關閉；開啟後才會把中文別名加入多人答題建議，英文／羅馬字建議不受影響。</small></span></label>
      <label class="mpCheck"><input id="mpAutoSubmit" type="checkbox"><span><b>確認作品名稱後自動提交</b><small>僅在輸入內容精確符合曲庫作品英文名或羅馬拼音，且輸入暫停後才提交。</small></span></label>
      
      
      
     </section>
     <section class="mpPersonalGroup"><h4>個人候選歌單</h4>
      <div class="mpFormRow"><label for="mpQuickPool">快速出題範圍</label><select class="mpSelect" id="mpQuickPool"><option value="all">全部歌曲</option><option value="unmarked">未標記</option><option value="heard">聽過／知道</option><option value="hard">未標記且難度 0–20（僅 AMQ）</option><option value="tagged">已有自訂標籤</option></select><small class="mpHint">對應單人模式的快速範圍；EMQ 沒有可對應的動畫難度資料。</small></div>
      <label class="mpCheck"><input id="mpWatchlistOnly" type="checkbox"><span><b>只出現在我的收藏／觀看清單中的作品</b><small>此篩選只適用於 AMQ 動畫作品。</small></span></label>
      <label class="mpCheck"><input id="mpWatchStatusFilterEnabled" type="checkbox"><span><b>啟用觀看狀態篩選</b><small>啟用後，僅採用下方所選狀態的 AMQ 作品。</small></span></label>
      <label class="mpCheck"><input id="mpTagsOnly" type="checkbox"><span><b>只出有自訂標籤的歌曲</b><small>依本機歌曲標籤篩選 AMQ／EMQ。</small></span></label>
      <div class="mpFormRow"><label for="mpTagText">標籤包含文字</label><input class="mpInput" id="mpTagText" placeholder="例如：爵士、慢歌、燃曲"></div>
      <div class="mpMiniHeading">歌曲標記狀態（可多選）</div><div class="mpCheckGrid" id="mpSongStatusChoices">
       <label class="mpCheck"><input type="checkbox" value="0" data-mp-song-status><span>未標記</span></label><label class="mpCheck"><input type="checkbox" value="1" data-mp-song-status><span>聽過</span></label><label class="mpCheck"><input type="checkbox" value="2" data-mp-song-status><span>知道答案</span></label><label class="mpCheck"><input type="checkbox" value="3" data-mp-song-status><span>熟悉</span></label>
      </div>
      <div class="mpMiniHeading">匯入 AniList / MyAnimeList</div><div class="mpFormRow"><label for="mpAniListUser">AniList 使用者 ID／名稱</label><div class="mpInputAction"><input class="mpInput" id="mpAniListUser" placeholder="AniList ID 或名稱"><button class="btn" id="mpImportAniList" type="button">匯入</button></div></div>
      <div class="mpFormRow"><label for="mpMalUser">MyAnimeList 帳號名稱</label><div class="mpInputAction"><input class="mpInput" id="mpMalUser" placeholder="MAL 帳號名稱"><button class="btn" id="mpImportMal" type="button">匯入</button></div></div>
      <small class="mpHint">不需提供帳號密碼；匯入後以本機觀看狀態篩選。</small>
      <div class="mpMiniHeading">觀看狀態（可多選）</div><div class="mpCheckGrid" id="mpWatchStatusChoices">
       <label class="mpCheck"><input type="checkbox" value="current" data-watch-status><span>Watching／觀看中</span></label><label class="mpCheck"><input type="checkbox" value="completed" data-watch-status><span>Completed／已看完</span></label><label class="mpCheck"><input type="checkbox" value="repeating" data-watch-status><span>Rewatching／重看中</span></label><label class="mpCheck"><input type="checkbox" value="paused" data-watch-status><span>Paused／暫停</span></label><label class="mpCheck"><input type="checkbox" value="dropped" data-watch-status><span>Dropped／棄番</span></label><label class="mpCheck"><input type="checkbox" value="planning" data-watch-status><span>Plan to watch／想看</span></label>
      </div><div class="mpMiniHeading">AMQ 動畫自訂清單（可多選）</div><div id="mpCustomListChoices" class="mpCustomListChoices"><small>正在讀取本機自訂清單…</small></div><div class="mpMiniHeading">EMQ／VN 自訂清單（可多選）</div><div id="mpEmqCustomListChoices" class="mpCustomListChoices"><small>正在讀取本機 EMQ 清單…</small></div>
      <div class="mpMiniHeading">VNDB 個人清單匯入</div>
      <div class="mpFormRow"><label for="mpVndbUser">VNDB 使用者名稱或 ID</label><input class="mpInput" id="mpVndbUser" autocomplete="username" placeholder="VNDB username 或 u123"></div>
      <div class="mpFormRow"><label for="mpVndbToken">VNDB API Token（可留空）</label><input class="mpInput" id="mpVndbToken" type="password" autocomplete="off" placeholder="僅本次匯入使用，不會保存"></div>
      <div class="mpGameButtons"><button class="btn" id="mpImportVnList" type="button">匯入我的 VNDB 清單</button><label class="mpCheck"><input id="mpUseVndbList" type="checkbox"><span>將已遊玩 VNDB 作品加入 EMQ 篩選</span></label></div>
      <small class="mpHint">匯入帳號清單中的正在玩、已完成、擱置、已放棄或有評分作品；不會把 VNDB 作品 ID 當成歌曲 ID。Token 不會寫入備份或本機設定。</small>
      <div id="mpVndbListStatus" class="mpSmall" role="status" aria-live="polite"></div>
      <div class="mpGameButtons"><button class="btn primary" id="mpSavePersonal" type="button">保存個人設定</button><span id="mpPersonalStatus" class="mpSmall" aria-live="polite"></span></div>
     </section>
    </div></div>
   </article>
   <div class="mpSetupGrid">
    <article class="mpCard"><h3>建立房間</h3>
     <div class="mpFormInline"><div class="mpFormRow"><label for="mpCreateSourceMode">出題曲庫</label><select class="mpSelect" id="mpCreateSourceMode"><option value="amq">AMQ 動畫歌曲</option><option value="mixed">AMQ + EMQ 混合</option><option value="emq">只出 EMQ／VN 歌曲</option></select></div><div class="mpFormRow"><label for="mpCreateQuestions">題目數量</label><select class="mpSelect" id="mpCreateQuestions"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>30</option><option>50</option><option>100</option></select></div><div class="mpFormRow"><label for="mpCreateSeconds">每題作答時間</label><select class="mpSelect" id="mpCreateSeconds"><option value="10">10 秒</option><option value="15" selected>15 秒</option><option value="20">20 秒</option><option value="30">30 秒</option><option value="45">45 秒</option><option value="60">60 秒</option></select></div>
      <div class="mpFormRow"><label for="mpCreateReveal">揭曉時間</label><select class="mpSelect" id="mpCreateReveal"><option value="0">不等待</option><option value="3">3 秒</option><option value="5" selected>5 秒</option><option value="8">8 秒</option><option value="10">10 秒</option><option value="15">15 秒</option></select></div><div class="mpFormRow"><label for="mpCreateDrawMode">題庫分配方式</label><select class="mpSelect" id="mpCreateDrawMode"><option value="random" selected>Random · 完全隨機</option><option value="equal">均單 · 盡可能平均</option></select></div>
      <div class="mpFormRow"><label for="mpCreateMode">遊戲模式</label><select class="mpSelect" id="mpCreateMode"><option value="individual" selected>個人競賽</option><option value="team">組隊合作</option></select></div><div class="mpFormRow"><label for="mpCreateTeamSize">每隊人數</label><select class="mpSelect" id="mpCreateTeamSize"><option value="1" selected>1 人一隊</option><option value="2">2 人一隊</option><option value="3">3 人一隊</option><option value="4">4 人一隊</option><option value="5">5 人一隊</option><option value="6">6 人一隊</option><option value="7">7 人一隊</option><option value="8">8 人一隊</option></select></div><div class="mpFormRow"><label>共同難度範圍（AMQ）</label><div class="mpFormInline"><label>從 <input class="mpInput" id="mpCreateDiffMin" type="number" min="0" max="100" value="0"></label><label>到 <input class="mpInput" id="mpCreateDiffMax" type="number" min="0" max="100" value="100"></label></div><small class="mpHint">與單人模式的難度下限／上限一致；EMQ 沒有可對應的難度資料。</small></div></div><details class="mpCreateAdvanced"><summary>更多出題篩選（年份、作品類型、歌曲類型與季度）</summary><div class="mpFilterGrid mpCreateFilterGrid"><div class="mpFilterGroup"><b>年份</b><div class="mpFormInline"><label>從 <input class="mpInput" id="mpCreateYearMin" type="number" min="1900" max="2100" value="1900"></label><label>到 <input class="mpInput" id="mpCreateYearMax" type="number" min="1900" max="2100" value="2100"></label></div><label class="mpCheck"><input id="mpCreateUnknownYear" type="checkbox" checked><span>包含年份未知的歌曲</span></label></div><div class="mpFilterGroup"><b>動畫作品類型（AMQ）</b><div class="mpFilterChoices"><label><input type="checkbox" data-create-anime-type value="TV" checked>TV</label><label><input type="checkbox" data-create-anime-type value="OVA" checked>OVA</label><label><input type="checkbox" data-create-anime-type value="Movie" checked>Movie</label><label><input type="checkbox" data-create-anime-type value="Special" checked>Special</label><label><input type="checkbox" data-create-anime-type value="ONA" checked>ONA</label><label><input type="checkbox" data-create-anime-type value="Other" checked>Other</label></div></div><div class="mpFilterGroup"><b>歌曲類型</b><div class="mpFilterChoices"><label><input type="checkbox" data-create-song-type value="1" checked>OP</label><label><input type="checkbox" data-create-song-type value="2" checked>ED</label><label><input type="checkbox" data-create-song-type value="3" checked>插入歌</label><label><input type="checkbox" data-create-song-type value="4" checked>其他</label><label><input type="checkbox" data-create-song-type value="5" checked>未分類</label></div></div><div class="mpFilterGroup"><b>季度（AMQ）</b><div class="mpFilterChoices"><label><input type="checkbox" data-create-season value="Winter" checked>Winter</label><label><input type="checkbox" data-create-season value="Spring" checked>Spring</label><label><input type="checkbox" data-create-season value="Summer" checked>Summer</label><label><input type="checkbox" data-create-season value="Fall" checked>Fall</label></div><small class="mpHint">作品類型與季度只套用到 AMQ；歌曲類型和年份也會套用到 EMQ。</small></div></div></details>
     <label class="mpCheck"><input id="mpCreateAutoAdvance" type="checkbox" checked><span><b>揭曉時間結束後自動切題</b></span></label>
     <button class="btn primary mpPrimaryWide" id="mpCreateRoom" type="button">建立房間</button>
    </article>
    <article class="mpCard"><h3>加入或重新加入</h3><p>輸入房間代碼加入；暫時斷線可使用「重新連線」。</p><div class="mpFormRow"><label for="mpRoomCodeInput">六位房間代碼</label><input class="mpInput" id="mpRoomCodeInput" maxlength="6" autocapitalize="characters" spellcheck="false" placeholder="例如 AB23CD"></div><div class="mpFormInline"><button class="btn primary" id="mpJoinRoom" type="button">加入房間</button><button class="btn" id="mpRejoinRoom" type="button">重新連線</button></div></article>
   </div>
  </section>
  <section id="mpRoomStage" class="hidden" aria-live="polite"></section>
  <div id="mpGlobalStatus" class="mpStatus" role="status" aria-live="polite" data-kind="info">請先啟動配套房間服務，再測試連線。</div>`;
 ROOT.append(view);
 const state={session:null,phase:null,lastSignature:'',pollTimer:null,revealTimer:null,finishedKey:'',pollBusy:false,heartbeatBusy:false,apiBusy:false,titleAliasSyncKey:null,titleAliasSyncPromise:null,titleAliasSyncAttemptAt:0,audio:null,audioCandidates:[],audioCandidateIndex:0,audioSongId:'',audioLoadedFor:'',audioStartedFor:'',audioReadyReportedFor:'',audioLoadingFor:'',audioFallbackBusyFor:'',nextAudio:null,nextAudioCandidates:[],nextAudioCandidateIndex:0,nextAudioSongId:'',nextAudioLoadedFor:'',nextAudioLoadingFor:'',nextAudioReadyReportedFor:'',localRemaining:null,remainingAt:0,lastPolled:null,leaving:false,playerPage:0,chatDraft:'',draftSendTimer:null,draftSendBusy:false,draftPendingText:'',lastDraftSent:null,draftHydratedQuestionId:'',autoSubmitTimer:null,focusNextAfterSubmit:null,revealStartedAt:0,revealKey:'',recordedKeys:new Set(),roundKey:'',roomConfigDirty:false,candidateRefreshKey:null,candidateRefreshPromise:null,localDraft:'',draftQuestionId:'',historyCursor:0,historyRoundNo:0,liveSocket:null,liveRetryTimer:null,liveRetryDelay:1000,liveWarned:false,liveEnabled:false,liveAuthed:false};
 function readSession(){try{const x=JSON.parse(sessionStorage.getItem(SESSION_KEY)||'null');return x&&x.roomCode&&x.playerId&&x.token?x:null}catch{return null}}
 function saveSession(s){state.session=s;try{if(s)sessionStorage.setItem(SESSION_KEY,JSON.stringify(s));else sessionStorage.removeItem(SESSION_KEY)}catch{}if(s){const book=readJson(RECONNECT_KEY,{});book[reconnectKey(s.roomCode,s.playerName)]=s;try{localStorage.setItem(RECONNECT_KEY,JSON.stringify(book))}catch{}}}
 function reconnectKey(code,name){return String(code||'').toUpperCase()+'|'+String(name||'').trim().toLocaleLowerCase()}
 function removeReconnect(s){if(!s)return;const book=readJson(RECONNECT_KEY,{});delete book[reconnectKey(s.roomCode,s.playerName)];try{localStorage.setItem(RECONNECT_KEY,JSON.stringify(book))}catch{}}
 function setStatus(message,kind='info'){const el=$('mpGlobalStatus');if(el){el.textContent=message;el.dataset.kind=kind}}
 function setHealth(message,ok=null){const el=$('mpHealthSummary');if(el){el.textContent=message;el.style.color=ok===true?'#26865e':ok===false?'#b34869':''}}
 function normaliseBase(raw){let u;try{u=new URL(String(raw||'').trim())}catch{throw Error('API 位址格式不正確，請輸入完整的 http:// 或 https:// URL。')}if(!['http:','https:'].includes(u.protocol)||u.username||u.password||u.search||u.hash)throw Error('API 位址只接受沒有帳密、查詢參數或片段的 HTTP(S) URL。');return u.origin+u.pathname.replace(/\/+$/,'')}
 function base(){const b=normaliseBase($('mpApiBase').value);$('mpApiBase').value=b;try{localStorage.setItem(BASE_KEY,b)}catch{}return b}
 function authHeaders(){return state.session?{'Authorization':'Bearer '+state.session.token,'X-Player-Id':state.session.playerId}: {}}
 async function request(path,{method='GET',body,auth=true,timeout=8000}={}){const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),timeout);try{const headers={'Accept':'application/json'};if(body!==undefined)headers['Content-Type']='application/json';if(auth)Object.assign(headers,authHeaders());const r=await fetch(base()+path,{method,headers,body:body===undefined?undefined:JSON.stringify(body),cache:'no-store',signal:ctrl.signal});let d={};try{d=await r.json()}catch{}if(!r.ok){const e=Error(d?.error?.message||`API 回應 ${r.status}`);e.code=d?.error?.code||'http_error';e.status=r.status;throw e}return d}catch(e){if(e.name==='AbortError')throw Error('連線逾時。請確認多人伺服器仍在執行。');if(e instanceof TypeError)throw Error('無法連線到房間 API。請確認伺服器、IP、連接埠與網路設定。');throw e}finally{clearTimeout(timer)}}
 function stopPoll(){if(state.pollTimer){clearInterval(state.pollTimer);state.pollTimer=null}state.pollBusy=false}
 function stopAudio(){for(const a of [state.audio,state.nextAudio])if(a){try{a.pause();a.removeAttribute('src');a.load()}catch{}}if(state.video){try{state.video.pause();state.video.removeAttribute('src');state.video.load()}catch{}}state.videoSongId='';state.videoCandidates=[];state.videoCandidateIndex=0;state.video=null;state.audio=null;state.audioSongId='';state.audioLoadedFor='';state.audioStartedFor='';state.audioReadyReportedFor='';state.audioLoadingFor='';state.audioFallbackBusyFor='';state.audioCandidates=[];state.audioCandidateIndex=0;state.nextAudio=null;state.nextAudioCandidates=[];state.nextAudioCandidateIndex=0;state.nextAudioSongId='';state.nextAudioLoadedFor='';state.nextAudioLoadingFor='';state.nextAudioReadyReportedFor=''}
 function releaseLocal(clearSaved=true){const old=state.session;stopPoll();stopLive();stopAudio();saveSession(null);if(clearSaved)removeReconnect(old);state.phase=null;state.lastSignature='';state.lastPolled=null;state.roomConfigDirty=false;$('mpSetup').classList.remove('hidden');$('mpRoomStage').classList.add('hidden');setStatus('已離開房間。','info');}
 function localBlacklisted(s){try{return !!(window.__aniHistoryAPIv51?.isBlacklisted(String(s[1]))||window.__aniIsAnimeWorkBlacklistedV825?.(String(s[0])))}catch{return false}}
 function readCustomLists(){const d=readJson('aniCustomPracticeListsV1',{lists:[]});const a=Array.isArray(d)?d:(Array.isArray(d.lists)?d.lists:[]);return a.filter(x=>x&&Array.isArray(x.animeIds)).map((x,i)=>({id:String(x.id??i),name:String(x.name||'自訂清單'),animeIds:[...new Set(x.animeIds.map(String))]}))}
 function watchStatusFor(aid){try{if(typeof watchStatus==='function')return String(watchStatus(aid)||'none')}catch{}try{const w=JSON.parse(localStorage.getItem('aniAnimeWatch_v1')||'{}');const x=w[String(aid)];return typeof x==='string'?x:String(x?.status||'none')}catch{return 'none'}}
