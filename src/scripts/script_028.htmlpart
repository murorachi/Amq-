  const scopeKey=specificEmq?'emq:'+emqWorkIds.map(String).sort().join(','):'all';
  const key=String(state.session.roomCode||'')+':'+syncVersion+':'+scopeKey;
  if(state.titleAliasSyncKeys instanceof Set&&state.titleAliasSyncKeys.has(key))return {alreadySynced:true};
  if(!force&&Date.now()-state.titleAliasSyncAttemptAt<6000)return null;
  let amqMap={};
  if(!specificEmq&&mode!=='emq'&&(prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese')&&api?.ready)amqMap=api.getServerAliasMap?.()||{};
  let emqMap={};
  if(mode!=='amq'&&(prefs.chineseSuggestionsEnabled||prefs.displayLanguage==='chinese'))emqMap=emqZh?.allKnownAliases?.()||{};
  if(specificEmq&&emqZh){const wanted=new Set(emqWorkIds.map(String));emqMap=Object.fromEntries(Object.entries(emqMap).filter(([id])=>wanted.has(String(id))))}
  const aEntries=Object.entries(amqMap),eEntries=Object.entries(emqMap);
  if(!aEntries.length&&!eEntries.length)return null;
  state.titleAliasSyncAttemptAt=Date.now();
  state.titleAliasSyncPromise=(async()=>{
   let result=null;const size=700,total=Math.max(Math.ceil(aEntries.length/size),Math.ceil(eEntries.length/size));
   for(let i=0;i<total;i++){
    const aChunk=Object.fromEntries(aEntries.slice(i*size,(i+1)*size)),eChunk=Object.fromEntries(eEntries.slice(i*size,(i+1)*size));
    result=await action('title-aliases',{sourceVersion:syncVersion,replace:i===0&&!specificEmq,aliasesByAnimeId:aChunk,emqAliasesByWorkId:eChunk},30000)
   }
   state.titleAliasSyncKeys=state.titleAliasSyncKeys instanceof Set?state.titleAliasSyncKeys:new Set();state.titleAliasSyncKeys.add(key);state.titleAliasSyncKey=key;
   if(state.lastPolled)state.lastPolled.hasChineseTitleMap=true;
   return result
  })().catch(e=>{console.warn('[Chinese titles] multiplayer alias sync deferred:',e?.message||e);if(force)throw e;return null}).finally(()=>{state.titleAliasSyncPromise=null});
  return state.titleAliasSyncPromise
 }
