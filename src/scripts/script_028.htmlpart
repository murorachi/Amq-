  if(includeEmq&&emqApi?.ready){
   const allRows=emqApi.getRows?.()||[];
   for(const song of allRows){const id=String(song?.[1]??''),meta=emqApi.getMeta?.(id)||{},wid=String(song?.[0]??meta.workId??'');if(!id||!String(song?.[4]||'').trim()||!String(song?.[5]||'').trim()||!emqApi.getAudioUrls?.(id)?.length||!window.__aniCandidatePoolPolicyV8265.blacklistAllowed(localBlacklisted(song)))continue;
    const inSelectedList=selectedEmqSongIds.has(id)||selectedEmqWorkIds.has(wid)||selectedEmqVndbIds.has(String(meta.vndbId||'').toLowerCase());
    const inImported=importedWorkIds.has(wid)||playedVndbIds.has(String(meta.vndbId||'').toLowerCase());
    if(hasEmqListScope&&!inSelectedList)continue;
    if(prefs.useImportedVnList&&!inImported)continue;
    // A manually selected EMQ custom list is an explicit pool, matching the single-player EMQ list behavior.
    // VNDB import is only a membership filter and must not silently disable song-status, tag, year or type filters.
    if(hasEmqListScope){ids.push(id);continue}
    if(!passesSharedSongFilters(song,id,{...meta,songType:song?.[2]??meta.songType,year:meta.year},true,false))continue;
    ids.push(id);
   }
  }
  if(mode==='mixed'&&amqSpecificRestriction&&!hasEmqScope)setStatus('目前使用了單人模式中僅適用 AMQ 的篩選（觀看清單、難度、季節或動畫類型），因此混合模式只會貢獻符合條件的 AMQ；選擇 EMQ 自訂清單或啟用 VNDB 個人清單後，才會同時貢獻指定的 EMQ 作品。','info');
  if(prefs.useImportedVnList&&!playedVndbIds.size)setStatus('已啟用 VNDB 個人清單篩選，但尚未匯入可辨識的已遊玩作品。請先匯入 VNDB 使用者清單。','info');
  return [...new Set(ids)];
 }
 // Report the selected EMQ list scope explicitly, so the authoritative server does not re-apply ordinary filters to dedicated-list songs.
function dedicatedEmqScopeSongIds(ids){
 const listIds=new Set((prefs.emqListIds||[]).map(String));if(!listIds.size)return [];
 const selectedLists=readEmqLists().filter(list=>listIds.has(String(list.id))),songIds=new Set(),workIds=new Set(),vndbIds=new Set();
 for(const list of selectedLists){for(const id of (list.songIds||[]))songIds.add(String(id));for(const id of (list.workIds||[]))workIds.add(String(id));for(const id of (list.vndbIds||[]))vndbIds.add(String(id).toLowerCase())}
 const api=window.__aniEmqAPI;
 if(api?.ready)for(const vid of vndbIds){const work=api.getWorkByVndbId?.(vid);if(work?.i!=null)workIds.add(String(work.i))}
 if(!api?.isSong)return [];
 return [...new Set((Array.isArray(ids)?ids:[]).map(String))].filter(id=>{
  if(!api.isSong(id))return false;
  const meta=api.getMeta?.(id)||{},row=api.getRow?.(id),workId=String(meta.workId??row?.[0]??'');
  return songIds.has(id)||workIds.has(workId)||vndbIds.has(String(meta.vndbId||'').toLowerCase());
 });
}
 // The server's bundled canonical catalog is authoritative. Do not transmit tens of thousands of duplicate EMQ rows.
 function emqManifestForIds(_ids){return []}
 function candidateRefreshSignature(s){const r=s?.settings||{};return JSON.stringify({room:{sourceMode:r.sourceMode,yearMin:r.yearMin,yearMax:r.yearMax,unknownYear:r.unknownYear,difficultyMin:r.difficultyMin,difficultyMax:r.difficultyMax,animeTypes:r.animeTypes,songTypes:r.songTypes,seasons:r.seasons},personal:{sourceMode:prefs.sourceMode,quickPool:prefs.quickPool,statuses:prefs.statuses,watchlistOnly:prefs.watchlistOnly,watchStatusFilterEnabled:prefs.watchStatusFilterEnabled,watchStatuses:prefs.watchStatuses,tagsOnly:prefs.tagsOnly,tagText:prefs.tagText,customListIds:prefs.customListIds,emqListIds:prefs.emqListIds,useImportedVnList:prefs.useImportedVnList}})}
 async function refreshMyRoomCandidates(s){if(!state.session||!s||s.phase!=='waiting'||s.isHost)return;const key=String(state.session.roomCode||'')+':'+candidateRefreshSignature(s);if(state.candidateRefreshKey===key||state.candidateRefreshPromise)return;state.candidateRefreshKey=key;state.candidateRefreshPromise=(async()=>{const ids=candidateSongIds(normalizedSourceMode(s.settings?.sourceMode));await action('candidates',{candidateSongIds:ids,emqCandidates:emqManifestForIds(ids),dedicatedEmqSongIds:dedicatedEmqScopeSongIds(ids)},30000);if(!ids.length)setStatus('房間設定已更新，但你的個人篩選目前沒有可提供的歌曲。','error')})().catch(e=>{if(state.candidateRefreshKey===key)state.candidateRefreshKey='';console.warn('[Multiplayer candidates] refresh deferred:',e?.message||e)}).finally(()=>{state.candidateRefreshPromise=null})}
 function invalidatePersonalCandidateScopeV8265(){state.candidateRefreshKey=null;const s=state.lastPolled;if(state.session&&s?.phase==='waiting'&&!s.isHost)queueMicrotask(()=>refreshMyRoomCandidates(state.lastPolled))}
 document.addEventListener('ani-blacklist-changed-v51',invalidatePersonalCandidateScopeV8265);
 document.addEventListener('ani-song-tag-updated-v80',invalidatePersonalCandidateScopeV8265);
 document.addEventListener('ani-familiarity-updated-v51',invalidatePersonalCandidateScopeV8265);
 function createSettings(){const checked=selector=>[...view.querySelectorAll(selector+':checked')].map(el=>selector.includes('song-type')?Number(el.value):el.value);const yearA=strictPoolInput('mpCreateYearMin',1900,1900,2100,true),yearB=strictPoolInput('mpCreateYearMax',2100,1900,2100,true),diffA=strictPoolInput('mpCreateDiffMin',0,0,100),diffB=strictPoolInput('mpCreateDiffMax',100,0,100);if(yearA===null||yearB===null)throw new Error('年份範圍包含空白或非法值，請填入 1900–2100 的整數。');if(diffA===null||diffB===null)throw new Error('難度範圍包含空白或非法值，請填入 0–100 的數值。');if(yearA>yearB)throw new Error('年份下限不能大於上限。');if(diffA>diffB)throw new Error('難度下限不能大於上限。');const cfg={sourceMode:normalizedSourceMode($('mpCreateSourceMode')?.value||prefs.sourceMode),questionCount:boundedNumber($('mpCreateQuestions')?.value,10,1,100),secondsPerQuestion:boundedNumber($('mpCreateSeconds')?.value,15,1,180),revealSeconds:boundedNumber($('mpCreateReveal')?.value,5,0,60),drawMode:$('mpCreateDrawMode')?.value==='random'?'random':'equal',teamSize:Math.max(1,Math.min(8,Number($('mpCreateTeamSize')?.value)||1)),difficultyMode:'all',difficultyMin:diffA,difficultyMax:diffB,yearMin:yearA,yearMax:yearB,unknownYear:!!$('mpCreateUnknownYear')?.checked,animeTypes:checked('[data-create-anime-type]'),songTypes:checked('[data-create-song-type]'),seasons:checked('[data-create-season]'),autoAdvance:!!$('mpCreateAutoAdvance')?.checked,mode:$('mpCreateMode')?.value==='team'?'team':'individual'};prefs.roomFiltersV8259={...cfg};persistMultiplayerPrefs(false);return cfg}
 function loadMyProfile(){try{const p=JSON.parse(localStorage.getItem('aniAmqProfileV1')||'{}');$('mpPlayerName').value=String(p.displayName||p.playerName||p.name||'').slice(0,28)}catch{};try{const av=JSON.parse(localStorage.getItem('aniQuizVndbCharacterV36')||'{}');if(av.id&&!prefs.avatarId)prefs.avatarId=String(av.id);if(av.url&&!prefs.avatarUrl)prefs.avatarUrl=String(av.url)}catch{};seedMultiplayerPrefsFromSolo();renderPersonalPrefs()}
 function setBusy(v){state.apiBusy=v;for(const id of ['mpCheckApi','mpCreateRoom','mpJoinRoom','mpRejoinRoom','mpStart','mpSubmit','mpSubmitAll','mpReveal','mpNext','mpPause','mpResume','mpLobby','mpSaveRoomSettings']){const b=$(id);if(b)b.disabled=v}}
 async function checkApi(){setHealth('正在連線…');try{const h=await request('/api/health',{auth:false,timeout:5000});if(!h.ok)throw Error('伺服器健康檢查失敗。');setHealth(`連線正常 · API v${h.apiVersion} · ${h.roomsInMemory} 個暫存房間`,true);setStatus('房間服務連線正常。','success');return true}catch(e){setHealth(e.message,false);setStatus(e.message,'error');return false}}
 async function createRoom(){if(state.apiBusy)return;setBusy(true);try{savePersonalPrefs(false);const ids=candidateSongIds();if(!ids.length)throw Error('目前個人條件沒有任何可用歌曲。請調整看番狀態、自訂清單或「只貢獻未標記歌曲」設定。');const name=($('mpPlayerName').value||'Player').trim();const payload=await request('/api/rooms',{method:'POST',auth:false,body:{playerName:name,candidateSongIds:ids,emqCandidates:emqManifestForIds(ids),dedicatedEmqSongIds:dedicatedEmqScopeSongIds(ids),settings:createSettings(),avatarId:prefs.avatarId,avatarUrl:prefs.avatarUrl},timeout:30000});saveSession({...payload,apiBase:base(),playerName:name});$('mpRoomCodeInput').value=payload.roomCode;setStatus(`房間 ${payload.roomCode} 已建立。可單人開局，也可以分享代碼邀請朋友。`,'success');await loadState(true);startPoll()}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 async function joinRoom(){if(state.apiBusy)return;setBusy(true);try{savePersonalPrefs(false);const code=($('mpRoomCodeInput').value||'').trim().toUpperCase();if(!/^[A-Z2-9]{6}$/.test(code))throw Error('房間代碼必須是 6 位英數字。');const name=($('mpPlayerName').value||'Player').trim();const ids=candidateSongIds();const payload=await request(`/api/rooms/${encodeURIComponent(code)}/join`,{method:'POST',auth:false,body:{playerName:name,candidateSongIds:ids,emqCandidates:emqManifestForIds(ids),dedicatedEmqSongIds:dedicatedEmqScopeSongIds(ids),sourceMode:selectedSourceMode(),avatarId:prefs.avatarId,avatarUrl:prefs.avatarUrl},timeout:15000});saveSession({...payload,apiBase:base(),playerName:name});setStatus(`已加入房間 ${payload.roomCode}。`,'success');await loadState(true);const joinedMode=selectedSourceMode(state.lastPolled?.settings?.sourceMode||selectedSourceMode());const joinedIds=candidateSongIds(joinedMode);await action('candidates',{candidateSongIds:joinedIds,emqCandidates:emqManifestForIds(joinedIds),dedicatedEmqSongIds:dedicatedEmqScopeSongIds(joinedIds)},30000);startPoll();if(!joinedIds.length)setStatus('已加入房間，但目前曲庫與個人篩選沒有符合歌曲；本局不會貢獻題目。','error')}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 async function rejoinRoom(){if(state.apiBusy)return;setBusy(true);try{const code=($('mpRoomCodeInput').value||'').trim().toUpperCase(),name=($('mpPlayerName').value||'').trim();const book=readJson(RECONNECT_KEY,{});const saved=book[reconnectKey(code,name)];if(!saved)throw Error('沒有找到這組房間代碼與玩家名稱的暫存連線資料。請使用「加入房間」。');$('mpApiBase').value=saved.apiBase||$('mpApiBase').value;await request(`/api/rooms/${encodeURIComponent(code)}/rejoin`,{method:'POST',auth:false,body:{playerId:saved.playerId,token:saved.token},timeout:8000});saveSession(saved);await loadState(true);startPoll();setStatus('已恢復原本玩家身分與分數。若錯過的題目已揭曉，不會補答。','success')}catch(e){setStatus(e.message,'error')}finally{setBusy(false)}}
 function avatarMarkup(p){const url=String(p.avatarUrl||'');return url.startsWith('https://')?`<img src="${safeText(url)}" alt="" loading="lazy" referrerpolicy="no-referrer">`:`<span>${safeText((p.playerName||'?').slice(0,1).toUpperCase())}</span>`}
 function playerCard(p,index,drafts){const polled=state.lastPolled||{},ownAnswers=p.you?(polled.ownAnswers||[]):[],teamAnswers=(polled.teamSubmittedAnswers||[]).filter(x=>x.playerId===p.playerId),submitted=polled.phase==='reveal'?(p.submittedAnswers||[]):(p.you?ownAnswers.map(x=>({field:x.field,answer:x.answer})):teamAnswers.map(x=>({field:x.field,answer:x.answer})));const submittedText=submitted.map(x=>`${({anime:'作品',artist:'歌手',title:'歌名'})[x.field]||x.field}：${x.answer}`).join(' · ');const d=p.you?(state.localDraft||submittedText):(drafts.find(x=>x.playerId===p.playerId)?.text||submittedText);const own=p.you?' mpYou':'';const connected=p.online?'':' mpOffline';const resultClass=polled.phase==='reveal'?(p.questionCorrect?' mpResultCorrect':' mpResultIncorrect'):'';const handoff=polled.isHost&&!p.you&&polled.phase!=='stopped'?`<button class="btn mpHostHandoff" type="button" data-transfer-host="${safeText(p.playerId)}">交接房主</button>`:'';const teamMode=polled.settings?.mode==='team';return `<article class="mpPlayerCard${own}${connected}${resultClass}" data-player-id="${safeText(p.playerId)}"><div${p.you?' id="mpOwnSpeech"':''} class="mpSpeech${d?' mpSpeechOn':''}" aria-label="${safeText(p.playerName)} 答案或輸入狀態">${d?safeText(d):'<span class="mpSpeechEmpty">…</span>'}</div><div class="mpAvatarWrap"><div class="mpAvatar">${avatarMarkup(p)}</div><span class="mpPlayerStatus ${p.hasAnswered?'mpAnswered':p.online?'mpOnline':'mpOfflineDot'}" title="${p.hasAnswered?'已作答':p.online?'在線':'離線'}"></span></div><div class="mpPlayerIdentity"><b>${safeText(p.playerName)}${p.you?'（你）':''}</b><small class="mpPlayerId">ID ${safeText(p.playerId)}</small><small>${teamMode?safeText(p.teamId||'尚未分隊'):'個人競賽'}${p.isHost?' · 房主':''}${p.hasAnswered?' · 已作答':!p.online?' · 離線':''}${polled.phase==='reveal'?(p.questionCorrect?' · 答對':' · 答錯'):''}</small></div><div class="mpPlayerScore"><span>${Number(p.score||0).toLocaleString()} 分</span>${handoff}</div></article>`}
 function relatedAnimeHtml(questionId,r){const target=(Array.isArray(songs)?songs:[]).find(x=>String(x?.[1])===String(questionId));if(!target)return '';const norm=x=>String(x??'').normalize('NFKC').toLocaleLowerCase().replace(/[\s\p{C}]/gu,'');const title=norm(target[4]),artist=norm(target[5]);if(!title||!artist)return '';const byAnime=new Map((Array.isArray(anime)?anime:[]).map(a=>[String(a[0]),a]));const found=new Map();for(const song of (Array.isArray(songs)?songs:[])){if(norm(song?.[4])!==title||norm(song?.[5])!==artist||String(song?.[0])===String(target[0]))continue;const a=byAnime.get(String(song?.[0]));if(a){const name=displayAnimeName(a[0],a[1],a[2]);if(name)found.set(String(a[0]),name)}}const names=[...found.values()].sort((a,b)=>a.localeCompare(b));return `<details class="mpRelatedAnime"><summary>相同歌名與歌手：其他可接受作品（點擊展開）</summary>${names.length?`<ul>${names.map(n=>`<li>${safeText(n)}</li>`).join('')}</ul>`:'<p class="mpSmall">曲庫沒有找到其他同歌名、同歌手的動畫。</p>'}</details>`}
 function resultsTable(rows){const teamMode=state.lastPolled?.settings?.mode==='team';const headers=teamMode?'<th>玩家</th><th>各欄答案與判定</th><th>隊伍結果</th><th>時間</th><th>得分</th>':'<th>玩家</th><th>各欄答案與判定</th><th>時間</th><th>得分</th>';return `<div class="mpTableWrap"><table class="mpResults"><thead><tr>${headers}</tr></thead><tbody>${(rows||[]).map(r=>{const answers=(r.answers||[]).map(x=>`${({anime:'作品',artist:'歌手',title:'歌名'})[x.field]||x.field}：${safeText(x.answer)} <b class="${x.correct?'mpCorrect':'mpWrong'}">${x.correct?'✓':'✗'}</b>`).join('<br>')||'未作答';const time=r.elapsedSeconds==null?'—':Number(r.elapsedSeconds).toFixed(1)+' 秒';const teamFields=(r.teamCorrectFields||[]).map(f=>({anime:'動畫',artist:'歌手',title:'歌名'})[f]||f).join('、');const teamStatus=r.teamCorrect?'隊伍答對':'隊伍答錯';const teamStatusClass=r.teamCorrect?'mpCorrect':'mpWrong';const consensus=(r.teamConsensusAnswers||[]).map(x=>`${({anime:'動畫',artist:'歌手',title:'歌名'})[x.field]||x.field}：${safeText(x.answer)}（${Number(x.votes||0)} 票） <b class="${x.correct?'mpCorrect':'mpWrong'}">${x.correct?'✓':'✗'}</b>${x.tieBroken?'（平手抽選）':''}`).join('<br>');return `<tr><td>${safeText(r.playerName)}</td><td>${answers}</td>${teamMode?`<td class="${teamStatusClass}">${teamStatus}${consensus?`<small class="mpConsensusLine">最終共識：${consensus}</small>`:''}${teamFields?`<small>共同答對：${safeText(teamFields)}</small>`:''}<small>團隊 +${Number(r.teamPointsEarned||0).toLocaleString()} 分</small></td>`:''}<td>${time}</td><td><b>+${Number(r.pointsEarned||0).toLocaleString()}</b>${(r.correctFields||[]).length>1?`<small>（含 ${(r.correctFields.length-1)*250} 額外分）</small>`:''}</td></tr>`}).join('')}</tbody></table></div>`}
 function finalTable(rows){return `<div class="mpTableWrap"><table class="mpResults"><thead><tr><th>排名</th><th>玩家</th><th>答對</th><th>隊伍答對題數</th><th>正確率</th><th>個人分數</th></tr></thead><tbody>${(rows||[]).map((r,i)=>`<tr><td>${i+1}</td><td>${safeText(r.playerName)}${r.online?'':'（離線）'}</td><td>${Number(r.correct||0)} / ${Number(r.answered||0)}</td><td>${Number(r.teamCorrect||0)}</td><td>${(Number(r.accuracy||0)*100).toFixed(1)}%</td><td><b>${Number(r.score||0).toLocaleString()}</b></td></tr>`).join('')}</tbody></table></div>`}
 function questionHistoryTable(rows){return `<div class="mpTableWrap"><table class="mpResults"><thead><tr><th>題次</th><th>作品</th><th>歌曲</th><th>提供正解</th><th>隊伍結果</th></tr></thead><tbody>${(rows||[]).map(q=>{const providers=(q.results||[]).filter(r=>r.correct).map(r=>r.playerName).join('、')||'無';const teams=(q.teams||[]).map(t=>`${t.teamName}：${t.teamCorrect?'答對':'答錯'}`).join('；');return `<tr><td>${q.questionIndex}</td><td>${safeText(displayAnimeName(q.animeId,q.animeEnglish,q.animeRomaji))}</td><td>${safeText(q.songTitle||'未知歌曲')}<small>${safeText(q.artist||'')}</small></td><td>${safeText(providers)}</td><td>${safeText(teams)}</td></tr>`}).join('')}</tbody></table></div>`}
 function mediaControlsMarkup(){return `<div class="mpMediaControlsV835" aria-label="遊戲影音控制"><label class="mpVolumeControlV835" for="mpGameVolume"><span>音量</span><input id="mpGameVolume" type="range" min="0" max="100" step="1" value="${Math.round(gameMedia.volume*100)}" aria-label="歌曲音量"><output id="mpGameVolumeValue">${Math.round(gameMedia.volume*100)}%</output></label><label class="mpVideoToggleV835" for="mpGameVideoToggle"><input id="mpGameVideoToggle" type="checkbox" ${gameMedia.showVideo?'checked':''}><span>緩衝階段顯示影片</span></label><small>影片只會在提交答案後的揭曉／緩衝階段顯示，答題期間不播放畫面。</small></div>`}  
 function currentRoomSettingsMarkup(s){
  const c=s.settings||{},host=!!s.isHost;
  const animeOptions=[['TV','TV'],['OVA','OVA'],['Movie','電影'],['Special','Special'],['ONA','ONA'],['Other','其他']];
  const songOptions=[[1,'OP／片頭曲'],[2,'ED／片尾曲'],[3,'插入歌'],[4,'其他歌曲'],[5,'未分類']];
  const seasonOptions=[['Winter','冬季'],['Spring','春季'],['Summer','夏季'],['Fall','秋季']];
  const animeTypes=Array.isArray(c.animeTypes)?c.animeTypes:animeOptions.map(x=>x[0]);
  const songTypes=Array.isArray(c.songTypes)?c.songTypes:songOptions.map(x=>x[0]);
  const seasons=Array.isArray(c.seasons)?c.seasons:seasonOptions.map(x=>x[0]);
  const disabled=host?'':'disabled';
  return `<section class="mpRoomConfig"><div class="mpCardHead"><div><h3>房間設定</h3><p>${host?'只有大廳階段可以修改；開始後固定到本局結束。':'目前設定由房主決定。'}</p></div></div>
   <div class="mpRoomConfigGrid">
    <label>出題曲庫<select id="mpHostSourceMode" class="mpSelect" ${disabled}><option value="amq" ${String(c.sourceMode||'amq')==='amq'?'selected':''}>AMQ 動畫歌曲</option><option value="mixed" ${String(c.sourceMode||'amq')==='mixed'?'selected':''}>AMQ + EMQ 混合</option><option value="emq" ${String(c.sourceMode||'amq')==='emq'?'selected':''}>只出 EMQ／VN 歌曲</option></select></label>
    <label>題數<select id="mpHostQuestions" class="mpSelect" ${disabled}>${[...new Set([5,10,15,20,25,30,50,100,Number(c.questionCount)||10])].sort((a,b)=>a-b).map(n=>`<option value="${n}" ${Number(c.questionCount)===n?'selected':''}>${n} 題</option>`).join('')}</select></label>
    <label>每題時間<select id="mpHostSeconds" class="mpSelect" ${disabled}>${[10,15,20,30,45,60].map(n=>`<option value="${n}" ${Number(c.secondsPerQuestion)===n?'selected':''}>${n} 秒</option>`).join('')}</select></label>
    <label>揭曉時間<select id="mpHostReveal" class="mpSelect" ${disabled}>${[0,3,5,8,10,15].map(n=>`<option value="${n}" ${Number(c.revealSeconds)===n?'selected':''}>${n===0?'不等待':n+' 秒'}</option>`).join('')}</select></label>
    <label>出題方式<select id="mpHostDraw" class="mpSelect" ${disabled}><option value="random" ${c.drawMode==='random'?'selected':''}>Random · 完全隨機</option><option value="equal" ${c.drawMode==='equal'?'selected':''}>均單 · 盡可能平均</option></select></label>
    <label>遊戲模式<select id="mpHostMode" class="mpSelect" ${disabled}><option value="individual" ${c.mode!=='team'?'selected':''}>個人競賽</option><option value="team" ${c.mode==='team'?'selected':''}>組隊合作</option></select></label>
    <label>每隊人數<select id="mpHostTeam" class="mpSelect" ${disabled}>${Array.from({length:8},(_,i)=>i+1).map(n=>`<option value="${n}" ${Number(c.teamSize)===n?'selected':''}>${n} 人一隊</option>`).join('')}</select></label>
    <div class="mpFormRow"><label>歌曲難度範圍（AMQ）</label><div class="mpFormInline"><label>從 <input id="mpHostDiffMin" class="mpInput" type="number" min="0" max="100" step="1" value="${Number(c.difficultyMin??0)}" ${disabled}></label><label>到 <input id="mpHostDiffMax" class="mpInput" type="number" min="0" max="100" step="1" value="${Number(c.difficultyMax??100)}" ${disabled}></label></div></div>
    <label>年份下限<input id="mpHostYearMin" class="mpInput" type="number" min="1900" max="2100" step="1" value="${Number(c.yearMin??1900)}" ${disabled}></label>
    <label>年份上限<input id="mpHostYearMax" class="mpInput" type="number" min="1900" max="2100" step="1" value="${Number(c.yearMax??2100)}" ${disabled}></label>
   </div>
   <div class="mpFilterGrid">
    <fieldset class="mpFilterGroup"><legend>作品類型</legend><div class="mpFilterChoices">${animeOptions.map(([value,label])=>`<label class="mpFilterChoice"><input type="checkbox" data-room-anime-type value="${value}" ${animeTypes.includes(value)?'checked':''} ${disabled}><span>${label}</span></label>`).join('')}</div></fieldset>
    <fieldset class="mpFilterGroup"><legend>歌曲類型</legend><div class="mpFilterChoices">${songOptions.map(([value,label])=>`<label class="mpFilterChoice"><input type="checkbox" data-room-song-type value="${value}" ${songTypes.map(Number).includes(value)?'checked':''} ${disabled}><span>${label}</span></label>`).join('')}</div></fieldset>
    <fieldset class="mpFilterGroup"><legend>季度</legend><div class="mpFilterChoices">${seasonOptions.map(([value,label])=>`<label class="mpFilterChoice"><input type="checkbox" data-room-season value="${value}" ${seasons.includes(value)?'checked':''} ${disabled}><span>${label}</span></label>`).join('')}</div></fieldset>
   </div>
   <label class="mpCheck mpAutoAdvance"><input id="mpHostUnknownYear" type="checkbox" ${c.unknownYear!==false?'checked':''} ${disabled}><span>包含年份未知的作品</span></label>
   <p>作品、歌曲與季度條件會套用到所有玩家；個人清單由各玩家自行選擇。</p>
   <label class="mpCheck mpAutoAdvance"><input id="mpHostAutoAdvance" type="checkbox" ${c.autoAdvance?'checked':''} ${disabled}><span>揭曉後自動切題</span></label>
   ${host?'<div class="mpGameButtons"><button class="btn" id="mpSaveRoomSettings" type="button">保存房間設定</button><button class="btn primary" id="mpStart" type="button">開始比賽</button></div>':'<p class="mpHint">可以單人開始，不需要等待最低玩家數。</p>'}
  </section>`
 }
 function signature(s){const q=s.question||{},r=s.reveal||{};return JSON.stringify({phase:s.phase,index:s.questionIndex,qid:q.questionId,answered:s.yourHasAnswered,ownAnswers:s.ownAnswers,teamSubmittedAnswers:s.teamSubmittedAnswers,ready:s.yourReady,readyCount:q.readyCount,players:(s.players||[]).map(p=>[p.playerId,p.score,p.hasAnswered,p.you,p.isHost,p.online,p.teamId,p.avatarUrl]),reveal:r,final:s.finalResults,teams:s.finalTeams,settings:s.settings,stop:s.stopReason,round:s.roundNo})}
 function syncTeamDraftBubbles(s){const drafts=Array.isArray(s.teamDrafts)?s.teamDrafts:[];for(const p of(s.players||[])){const card=[...view.querySelectorAll('.mpPlayerCard')].find(el=>String(el.dataset.playerId)===String(p.playerId));const bubble=card?.querySelector('.mpSpeech');if(!bubble)continue;const ownAnswers=p.you?(s.ownAnswers||[]):[];const teamAnswers=(s.teamSubmittedAnswers||[]).filter(x=>String(x.playerId)===String(p.playerId));const submitted=s.phase==='reveal'?(p.submittedAnswers||[]):(p.you?ownAnswers.map(x=>({field:x.field,answer:x.answer})):teamAnswers.map(x=>({field:x.field,answer:x.answer})));const submittedText=submitted.map(x=>`${({anime:'作品',artist:'歌手',title:'歌名'})[x.field]||x.field}：${x.answer}`).join(' · ');const draft=p.you?(state.localDraft||submittedText):(drafts.find(x=>String(x.playerId)===String(p.playerId))?.text||submittedText);const html=draft?safeText(draft):'<span class="mpSpeechEmpty">…</span>';if(bubble.innerHTML!==html)bubble.innerHTML=html;bubble.classList.toggle('mpSpeechOn',!!draft)}}
 function syncChatMessagesOnly(s){const root=$('mpChatMessages');if(!root)return;const nearBottom=root.scrollHeight-root.scrollTop-root.clientHeight<80;const oldTop=root.scrollTop;const html=(s.chat||[]).map(m=>`<div class="mpChatMessage${m.system?' mpSystem':''}"><b>${safeText(m.playerName||'系統')}</b><span>${safeText(m.text)}</span></div>`).join('')||'<p class="mpChatEmpty">還沒有訊息。</p>';if(root.innerHTML!==html){root.innerHTML=html;if(nearBottom)root.scrollTop=root.scrollHeight;else root.scrollTop=Math.min(oldTop,Math.max(0,root.scrollHeight-root.clientHeight))}}
 function syncLivePanels(s){syncTeamDraftBubbles(s);syncChatMessagesOnly(s)}
 function chatHtml(s){return `<div class="mpChatHead"><div><h3>聊天室</h3><small>房間所有玩家都能看到</small></div></div><div class="mpChatMessages" id="mpChatMessages" role="log" aria-live="polite">${(s.chat||[]).map(m=>`<div class="mpChatMessage${m.system?' mpSystem':''}"><b>${safeText(m.playerName||'系統')}</b><span>${safeText(m.text)}</span></div>`).join('')||'<p class="mpChatEmpty">還沒有訊息。</p>'}</div><form id="mpChatForm" class="mpChatForm"><input class="mpInput" id="mpChatInput" maxlength="300" autocomplete="off" placeholder="傳送訊息…" aria-label="聊天室訊息"><button class="btn primary" type="submit">送出</button></form>`}
 function renderState(s){const previousPhase=state.phase;const answerDrafts=Object.fromEntries([...view.querySelectorAll('[data-answer-field]')].map(i=>[i.dataset.answerField,i.value]));const answerFocusField=document.activeElement?.dataset?.answerField||'';const answerFocused=!!answerFocusField;const oldAnswerPos=answerFocused?document.activeElement.selectionStart:null;const oldChatMessages=$('mpChatMessages');const chatScrollTop=oldChatMessages?.scrollTop??0;const chatNearBottom=oldChatMessages?oldChatMessages.scrollHeight-oldChatMessages.scrollTop-oldChatMessages.clientHeight<80:true;const chatInput=$('mpChatInput'),oldChat=chatInput?chatInput.value:state.chatDraft;const chatFocused=document.activeElement?.id==='mpChatInput';const chatPos=chatInput?.selectionStart;const visibleQuestionId=String(s.question?.questionId||s.reveal?.questionId||'');const questionChanged=!!(state.draftQuestionId&&visibleQuestionId&&state.draftQuestionId!==visibleQuestionId);if(s.phase!=='running'||questionChanged){state.localDraft='';state.draftPendingText='';state.lastDraftSent=null;state.answerDrafts={anime:'',artist:'',title:''};if(state.draftSendTimer){clearTimeout(state.draftSendTimer);state.draftSendTimer=null}}if(visibleQuestionId)state.draftQuestionId=visibleQuestionId;if(s.phase==='running'&&state.draftHydratedQuestionId!==visibleQuestionId){state.localDraft=String(s.ownDraft||'');state.draftPendingText=state.localDraft;state.lastDraftSent=state.localDraft;state.draftHydratedQuestionId=visibleQuestionId;const known=Object.fromEntries((s.ownAnswers||[]).map(x=>[x.field,x.answer]));state.answerDrafts={anime:known.anime||'',artist:known.artist||'',title:known.title||''};}else if(s.phase==='running'){state.answerDrafts={...(state.answerDrafts||{}),...answerDrafts};}state.phase=s.phase;if(s.phase!=='waiting')state.roomConfigDirty=false;state.lastPolled=s;syncTimer(s.question);$('mpSetup').classList.add('hidden');const stage=$('mpRoomStage');stage.classList.remove('hidden');const players=s.players||[];const pages=Math.max(1,Math.ceil(players.length/4));state.playerPage=Math.min(state.playerPage,pages-1);const visible=players.slice(state.playerPage*4,state.playerPage*4+4);const cards=visible.map((p,i)=>playerCard(p,state.playerPage*4+i,s.teamDrafts||[])).join('');const host=!!s.isHost;const statusLabel=({waiting:'大廳',preparing:'準備音訊',running:'猜題中',paused:'已暫停',reveal:'答案揭曉',finished:'結算',stopped:'已結束'})[s.phase]||s.phase;
  let game='';
  if(s.phase==='waiting'){game=`<div class="mpLobbyPane"><div class="mpGameLabel">ROOM LOBBY</div><h3>等待玩家，或直接開始</h3><p>目前 ${players.length} / 16 人 · ${s.settings.questionCount} 題 · ${s.settings.secondsPerQuestion} 秒／題 · ${s.settings.drawMode==='equal'?'均單':'Random'} · ${s.settings.mode==='team'?`組隊合作，每隊 ${s.settings.teamSize} 人`:'個人競賽'}。</p>${currentRoomSettingsMarkup(s)}<div class="mpSmall">題庫會在開賽時固定。離線玩家不再貢獻下一局的候選歌，但不會改變已開始的本局題序。</div></div>`}
  else if(s.phase==='preparing'){const q=s.question||{};game=`<div class="mpLobbyPane"><div class="mpGameLabel">AUDIO READY CHECK</div><h3>正在準備第 ${s.questionIndex} / ${s.questionCount} 題</h3>${mediaControlsMarkup()}<p>${Number(q.readyCount||0)} / ${Number(q.playerCount||players.length)} 位在線玩家音訊已就緒。</p><div class="mpMeter"><span style="width:${Math.min(100,100*Number(q.readyCount||0)/Math.max(1,Number(q.playerCount||players.length)))}%"></span></div><p id="mpAudioPrepareStatus" class="mpSmall">載入音訊中。在線玩家就緒後才會開始全房間倒數。</p><div class="mpGameButtons"><button class="btn" id="mpRetryAudio" type="button">重新載入音訊</button><button class="btn danger" id="mpSkipQuestion" type="button">跳過本題（全房間）</button>${host?'<button class="btn" id="mpPause" type="button">暫停</button><button class="btn danger" id="mpLobby" type="button">回到大廳</button>':''}</div></div>`}
  else if(s.phase==='running'){const q=s.question||{};const teamMode=s.settings?.mode==='team';const answerHelp=teamMode?'組隊共識：每位隊員可填作品、歌手與歌名；同欄位採最高票答案，最高票平手時隨機選其中一個。揭曉前不顯示正誤。':'可同時填寫作品、歌手與歌名，再一次提交。每欄答案各自判定；標點符號仍需符合曲庫資料。';const mk=(field,label,placeholder)=>{const submitted=(s.ownAnswers||[]).find(x=>x.field===field);const value=state.answerDrafts?.[field]??submitted?.answer??'';return `<div class="mpAnswerField" data-answer-wrap="${field}"><label for="mpAnswer_${field}">${label}</label><div class="mpAnswerRow"><div class="mpInputSuggestWrap"><input class="mpInput" id="mpAnswer_${field}" name="${field}" data-answer-field="${field}" type="text" lang="en" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="200" value="${safeText(value)}" placeholder="${placeholder}" aria-label="${label}"><div class="mpSuggest hidden" id="mpSuggest_${field}" role="listbox"></div></div></div>${submitted?`<small class="mpSubmittedField">已提交：${safeText(submitted.answer)}（揭曉前不顯示判定）</small>`:''}</div>`};const teamAnswers=(s.teamSubmittedAnswers||[]);const teamSummary=teamMode&&teamAnswers.length?`<div class="mpTeamAnswerList"><b>隊友已提交</b>${teamAnswers.map(x=>`<span>${safeText(x.playerName)}：${safeText(x.answer)}</span>`).join('')}</div>`:'';const answerFieldsMarkup=`${mk('anime','作品名稱','輸入作品英文名或羅馬字…')}${mk('artist','歌手／演唱者','輸入歌手名稱…')}${mk('title','歌曲名稱','輸入歌曲名稱…')}`;game=`<div class="mpPlayPane"><div class="mpGameLabel">QUESTION ${Number(q.index||s.questionIndex)} / ${Number(q.total||s.questionCount)}</div><h3>猜出這首歌所屬的作品</h3>${mediaControlsMarkup()}<div id="mpVideoMount" class="mpVideoMount"></div><div class="mpCountdown" id="mpCountdown">${Math.ceil(Number(q.secondsRemaining)||0)} 秒</div><div class="mpMeter"><span id="mpTimerFill" style="width:${Math.max(0,Math.min(100,100*Number(q.secondsRemaining||0)/Math.max(1,Number(s.secondsPerQuestion))))}%"></span></div><form id="mpAnswerForm"><div class="mpAnswerFields">${answerFieldsMarkup}</div><button class="btn primary mpAnswerSubmitAll" id="mpSubmitAll" type="button">提交已填答案</button><div id="mpAnswerHelp" class="mpHint">${answerHelp}</div></form>${teamSummary}<div class="mpGameButtons"><button class="btn" id="mpReplay" type="button">重播音訊</button><button class="btn danger" id="mpSkipQuestion" type="button">跳過本題（全房間）</button>${host?'<button class="btn" id="mpPause" type="button">暫停全房間</button><button class="btn danger" id="mpLobby" type="button">回到大廳</button><button class="btn" id="mpReveal" type="button">提前揭曉</button>':''}</div></div>`}
  else if(s.phase==='paused'){game=`<div class="mpLobbyPane mpPausedPane"><div class="mpGameLabel">PAUSED BY HOST</div><h3>比賽已暫停</h3>${mediaControlsMarkup()}<p>題目與剩餘時間已保留。所有玩家會在房主恢復後繼續同一題。</p><div class="mpGameButtons">${host?'<button class="btn primary" id="mpResume" type="button">恢復比賽</button><button class="btn danger" id="mpLobby" type="button">回到大廳</button>':''}</div></div>`}
  else if(s.phase==='reveal'){const r=s.reveal||{};const condensed=false;game=`<div class="mpRevealPane"><div class="mpGameLabel">ANSWER REVEALED · ${s.questionIndex} / ${s.questionCount}</div><h3>${safeText(displayAnimeName(r.animeId,r.animeEnglish||r.animeTitle,r.animeRomaji))}</h3>${mediaControlsMarkup()}<div id="mpVideoStatusV835" class="mpSmall" aria-live="polite"></div>${condensed?'<p class="mpSubmitted">你的自動跳過偏好已縮短揭曉等待畫面；房間仍依共用設定切題。</p>':`<p class="mpAltTitle">${safeText(prefs.displayLanguage==='chinese'?(r.animeEnglish||r.animeRomaji||''):(prefs.displayLanguage==='romaji'?(r.animeEnglish||''):(r.animeRomaji||'')))}</p><p class="mpSongInfo">歌曲：${safeText(r.songTitle||'未知歌曲')} · ${safeText(r.artist||'未知演唱者')}</p><div id="mpVideoMount" class="mpVideoMount"></div>${relatedAnimeHtml(r.questionId,r)}${resultsTable(r.results||[])}`}<div class="mpGameButtons">${host?`${s.settings.autoAdvance?'<span class="mpSmall">即將自動切題…</span>':'<button class="btn primary" id="mpNext" type="button">下一題 →</button>'}<button class="btn" id="mpPause" type="button">暫停</button><button class="btn danger" id="mpLobby" type="button">回到大廳</button>`:'<span class="mpSmall">等待下一題。</span>'}</div></div>`}
  else if(s.phase==='finished'){const lr=s.lastRound||{};game=`<div class="mpFinalPane"><div class="mpGameLabel">FINAL RESULTS</div><h3>本局結算</h3>${finalTable(s.finalResults||[])}${s.settings?.mode==='team'&&(s.finalTeams||[]).length?`<div class="mpMiniHeading">隊伍排名</div><div class="mpTeamResults">${s.finalTeams.map((t,i)=>`<div><b>#${i+1} ${safeText(t.teamName)}</b><span>${Number(t.score||0).toLocaleString()} 分</span></div>`).join('')}</div>`:''}<details class="mpHistoryDetails"><summary>逐題結果（${(s.questionHistory||[]).length} 題）</summary>${questionHistoryTable(s.questionHistory||[])}</details><div class="mpGameButtons">${host?'<button class="btn primary" id="mpLobby" type="button">再玩一局／回到大廳</button>':''}<button class="btn" id="mpBackQuiz" type="button">返回單人猜歌</button></div></div>`}
  else{game=`<div class="mpLobbyPane"><h3>房間已結束</h3><p>${safeText(s.stopReason||'目前房間已停止。')}</p><button class="btn" id="mpLeaveStopped" type="button">離開房間</button></div>`}
  const roomInfo=`<section class="mpInfoCard"><h3>房間資訊</h3><dl><div><dt>房間</dt><dd>${safeText(s.roomCode)}</dd></div><div><dt>狀態</dt><dd>${safeText(statusLabel)}</dd></div><div><dt>人數</dt><dd>${players.length} / 16</dd></div><div><dt>題庫</dt><dd>${safeText(s.settings.drawMode==='equal'?'均單':'Random')}</dd></div><div><dt>模式</dt><dd>${s.settings.mode==='team'?'組隊合作':'個人競賽'}</dd></div>${s.settings.mode==='team'?`<div><dt>每隊</dt><dd>${Number(s.settings.teamSize)} 人</dd></div>`:''}<div><dt>出題數</dt><dd>${Number(s.questionCount||0)} 題</dd></div></dl><div class="mpSourceCounts">${Object.entries(s.sourceCounts||{}).map(([name,n])=>`<div><span>${safeText(name)}</span><b>${n} 題</b></div>`).join('')}</div></section>`;
  const pageHtml=`<section class="mpPlayerStrip"><div class="mpStripHead"><div><b>玩家</b></div><div class="mpPageControls"><button class="btn" id="mpPlayerPrev" type="button" ${state.playerPage<=0?'disabled':''}>‹</button><span>${state.playerPage+1} / ${pages}</span><button class="btn" id="mpPlayerNext" type="button" ${state.playerPage>=pages-1?'disabled':''}>›</button></div></div><div class="mpPlayerGrid">${cards||'<p class="mpSmall">目前沒有玩家。</p>'}</div></section>`;
  stage.innerHTML=`<div class="mpStageHeader"><div><div class="detailEyebrow">ROOM CODE</div><div class="mpRoomCode">${safeText(s.roomCode)}</div><div class="mpSmall">第 ${s.questionIndex||'—'} / ${s.questionCount} 題 · 第 ${s.roundNo||1} 局 · ${players.length} 位玩家</div></div><div class="mpTopActions"><button class="btn" id="mpCopyCode" type="button">複製房間代碼</button><button class="btn" id="mpLeaveTop" type="button">離開房間</button></div></div><div class="mpGameLayout"><main class="mpMainGame">${game}</main><aside class="mpSidePanel">${roomInfo}<section class="mpChatCard">${chatHtml(s)}</section></aside></div>${pageHtml}`;
  if(s.phase==='reveal'&&state.revealKey!==`${s.roundNo}:${s.questionIndex}`){state.revealKey=`${s.roundNo}:${s.questionIndex}`;state.revealStartedAt=Date.now();recordRevealed(s);clearTimeout(state.revealTimer);state.revealTimer=null}
  if(s.phase==='finished'){const fk=`${s.roomCode}:${s.roundNo}`;if(state.finishedKey!==fk){state.finishedKey=fk;const stats=readJson(STATS_KEY,{matches:0,questions:0,individualCorrect:0,teamCorrect:0,providerCorrect:0});stats.matches=(Number(stats.matches)||0)+1;try{localStorage.setItem(STATS_KEY,JSON.stringify(stats))}catch{}}}else state.finishedKey='';
  if(s.phase==='running'){for(const [field,value] of Object.entries(state.answerDrafts||{})){const i=$('mpAnswer_'+field);if(i)i.value=value??''}if(state.focusNextAfterSubmit){const from=state.focusNextAfterSubmit;state.focusNextAfterSubmit=null;const order=['anime','artist','title'];const start=Math.max(0,order.indexOf(from));const next=order.slice(start+1).concat(order.slice(0,start+1)).find(field=>!(s.ownAnswers||[]).some(x=>x.field===field));if(next){const i=$('mpAnswer_'+next);if(i){i.focus({preventScroll:true});try{i.setSelectionRange(i.value.length,i.value.length)}catch{}}}}else if(answerFocused){const i=$('mpAnswer_'+answerFocusField);if(i){i.focus({preventScroll:true});try{i.setSelectionRange(oldAnswerPos??i.value.length,oldAnswerPos??i.value.length)}catch{}}}else if(previousPhase!=='running'||questionChanged){const next=['anime','artist','title'].find(field=>!(s.ownAnswers||[]).some(x=>x.field===field));if(next){const i=$('mpAnswer_'+next);if(i){i.focus({preventScroll:true});try{i.setSelectionRange(i.value.length,i.value.length)}catch{}}}}}
  if(chatFocused){const i=$('mpChatInput');if(i){i.value=oldChat;i.focus({preventScroll:true});try{i.setSelectionRange(chatPos??oldChat.length,chatPos??oldChat.length)}catch{}}}
  if(s.phase==='preparing'){if(previousPhase==='paused'&&state.audio&&state.audioSongId!==String(s.question?.questionId||'')&&state.audio.paused)state.audio.play().catch(()=>{});prepareAudio(s.question).catch(e=>setStatus(e.message,'error'))}
  else if(s.phase==='running')startAudioIfNeeded(s.question).catch(e=>setStatus(e.message,'error'));
  else if(s.phase==='paused'){if(state.audio)try{state.audio.pause()}catch{};if(state.nextAudio)try{state.nextAudio.pause()}catch{};if(state.video)try{state.video.pause()}catch{}}
  else if(s.phase==='reveal'){/* Keep the current audio alive through reveal and the next-question buffer; startAudioIfNeeded swaps decks when running begins. */if(gameMedia.showVideo)startVideoIfNeeded().catch(()=>{});else if(state.video)try{state.video.pause()}catch{}}
  else{if(state.audio)try{state.audio.pause()}catch{};if(state.nextAudio)try{state.nextAudio.pause()}catch{};if(state.video)try{state.video.pause()}catch{}}
  mountVideo()
  const cm=$('mpChatMessages');if(cm){if(chatNearBottom)cm.scrollTop=cm.scrollHeight;else cm.scrollTop=Math.min(chatScrollTop,Math.max(0,cm.scrollHeight-cm.clientHeight));}document.dispatchEvent(new CustomEvent('ani-multiplayer-state-rendered-v8258',{detail:{phase:s.phase}}));
 }
 function recordHistoryEntry(s,roundNo,entry){
  const own=(entry.results||[]).find(x=>x.playerId===s.yourPlayerId);
  if(!own)return;
  const key=`${s.roomCode}:${roundNo}:${entry.questionIndex}:${s.yourPlayerId}`;
  const recorded=readJson(RECORDED_KEY,[]);
  if(recorded.includes(key))return;
  recorded.push(key);
  try{localStorage.setItem(RECORDED_KEY,JSON.stringify(recorded.slice(-3000)))}catch{}

  const stats=readJson(STATS_KEY,{matches:0,questions:0,individualCorrect:0,teamCorrect:0,providerCorrect:0});
  stats.questions=(Number(stats.questions)||0)+1;
  if(own.correct)stats.individualCorrect=(Number(stats.individualCorrect)||0)+1;
  if(own.teamCorrect)stats.teamCorrect=(Number(stats.teamCorrect)||0)+1;
  if(own.correctProvider)stats.providerCorrect=(Number(stats.providerCorrect)||0)+1;
  try{localStorage.setItem(STATS_KEY,JSON.stringify(stats))}catch{}

  // Team success counts as a correct multiplayer performance for every teammate;
  // the separate provider field preserves who independently supplied a valid answer.
  const effectiveCorrect=!!own.teamCorrect;
  const api=window.__aniHistoryAPIv51;
  const song=api?.getSong?.(entry.songId);
  if(song&&typeof api.record==='function'){
   if(!state.roundKey||state.roundKey!==`${s.roomCode}:${roundNo}`){state.roundKey=`${s.roomCode}:${roundNo}`;api.beginRound?.()}
   const elapsed=own.elapsedSeconds==null?Number(s.secondsPerQuestion):Number(own.elapsedSeconds);
   const label=own.correctProvider?'多人答對（本人提供正解）':own.teamCorrect?'多人團隊答對（隊友提供正解）':'多人猜歌答錯／未作答';
   try{api.record(song,effectiveCorrect,String(own.answer||''),elapsed,label,'anime')}catch(e){console.warn('Multiplayer history write failed',e)}
   if(effectiveCorrect){
    try{document.dispatchEvent(new CustomEvent('quiz-v35-answered',{detail:{correct:true,answer:String(own.answer||''),elapsed,songId:String(entry.songId),target:'anime',validAudio:true,at:new Date().toISOString(),multiplayer:true,teamAssisted:!own.correctProvider,correctProvider:!!own.correctProvider}}))}catch{}
   }
  }
 }
 function recordRevealed(s){
  const entry={questionIndex:s.questionIndex,songId:s.reveal?.questionId,animeId:s.reveal?.animeId,animeEnglish:s.reveal?.animeEnglish,animeRomaji:s.reveal?.animeRomaji,songTitle:s.reveal?.songTitle,artist:s.reveal?.artist,results:s.reveal?.results||[]};
  if(entry.songId)recordHistoryEntry(s,s.roundNo,entry);
 }
 function reconcileHistory(s){
  const roundNo=Number(s.roundNo)||0;
  if(roundNo!==state.historyRoundNo){state.historyRoundNo=roundNo;state.historyCursor=0}
  const delta=Array.isArray(s.historyDelta)?s.historyDelta:[];
  for(const item of delta){if(item&&item.entry)recordHistoryEntry(s,Number(item.roundNo)||roundNo,item.entry);if(Number(item?.roundNo)>state.historyRoundNo||(Number(item?.roundNo)===state.historyRoundNo&&Number(item?.entry?.questionIndex)>state.historyCursor)){state.historyRoundNo=Number(item.roundNo)||roundNo;state.historyCursor=Number(item.entry?.questionIndex)||state.historyCursor}}
