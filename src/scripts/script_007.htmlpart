<script id="v36-quiz-fixes">
(()=>{
 const root=document.getElementById('quizView');if(!root)return;
 const $=id=>document.getElementById(id);
 const input=$('quizAnswer'),box=$('quizSuggestions');
 // V37 handles Enter once in the final capture handler below.
 box?.addEventListener('click',e=>{const item=e.target.closest('.quizSuggestion');if(!item)return;e.preventDefault();e.stopImmediatePropagation();window.__aniSelectQuizSuggestionV8272?.(item.textContent,'click')},true);
 // Minimal avatar: only image, submitted answer, and numeric correct count.
 const panel=document.createElement('section');panel.className='v36-amq-player';panel.innerHTML='<div class="v36-answer" id="v36Answer"></div><img class="v36-avatar" id="v36Avatar" alt=""><span class="v36-count" id="v36Count">0</span>';
 root.appendChild(panel);
 // Settings control VNDB lookup; only the image remains visible in the play UI.
 const idInput=$('qsVndbCharacterId'),status=$('qsVndbStatus'),load=$('qsLoadVndbCharacter'),avatar=$('v36Avatar');
 let lookupToken=0;
 async function loadVndb(id){id=String(id||'').trim();if(!id){status.textContent='請輸入角色 ID';return}if(!/^c\d+$/i.test(id)){status.textContent='ID 格式應為 c123';return}const token=++lookupToken;status.textContent='正在查詢 VNDB…';try{const response=await fetch('https://api.vndb.org/kana/character',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({filters:['id','=','c'+id.slice(1)],fields:'id,name,image.url',results:1})});if(!response.ok)throw new Error('VNDB API '+response.status);const data=await response.json();const character=data.results?.[0];const url=character?.image?.url;if(token!==lookupToken)return;if(!url)throw new Error('此角色沒有公開圖片');avatar.onload=()=>{status.textContent='角色圖片已載入';try{localStorage.setItem('aniQuizVndbCharacterV36',JSON.stringify({id:character.id,url}))}catch{}};avatar.onerror=()=>{status.textContent='圖片載入失敗'};avatar.src=url;status.textContent='找到 '+(character.name||character.id)+'，載入圖片中…'}catch(err){if(token===lookupToken)status.textContent='載入失敗：'+(err.message||'VNDB 連線或跨域限制');}}
 load?.addEventListener('click',()=>{const id=idInput?.value||'';try{localStorage.setItem('aniQuizSettingsV14',JSON.stringify({...JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}'),vndbCharacterId:id.trim()}))}catch{}loadVndb(id)});
 try{const saved=JSON.parse(localStorage.getItem('aniQuizVndbCharacterV36')||'{}');if(saved.id&&idInput)idInput.value=saved.id;if(saved.url)avatar.src=saved.url;else {try{const cfg=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');if(cfg.vndbCharacterId&&idInput){idInput.value=cfg.vndbCharacterId;loadVndb(cfg.vndbCharacterId)}}catch{}}}catch{}
 // A new song is a fresh timer/sample; random mode chooses a new valid start for every track.
 const randomButton=$('qsRandomSample');randomButton?.addEventListener('click',()=>{const on=randomButton.getAttribute('aria-pressed')!=='true';randomButton.setAttribute('aria-pressed',String(on));randomButton.textContent='隨機 Sample：'+(on?'開':'關');randomButton.classList.toggle('primary',on);try{const cfg=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}');cfg.randomSample=on;localStorage.setItem('aniQuizSettingsV14',JSON.stringify(cfg))}catch{}});
 const audio=$('audioPlayer');let pendingSeekId='';
 audio?.addEventListener('loadedmetadata',()=>{if(!document.body.classList.contains('quiz-mode')||!window.__aniQuizStateV45?.quizSong||!Number.isFinite(audio.duration)||audio.duration<=0)return;const id=String(window.__aniQuizStateV45?.quizSong[1]);if(pendingSeekId===id)return;pendingSeekId=id;let cfg={};try{cfg=JSON.parse(localStorage.getItem('aniQuizSettingsV14')||'{}')}catch{}const clip=Math.max(1,Number(cfg.clip)||20),maxStart=Math.max(0,audio.duration-clip);const randomOn=cfg.randomSample===true||$('qsRandomSample')?.getAttribute('aria-pressed')==='true';if(randomOn)return;/* V82.4: random sampling is owned by the pause-aware V42 handler, so this legacy metadata handler only applies fixed offsets. */const pct=Math.max(0,Math.min(100,Number(cfg.samplePosition??$('qsSamplePosition')?.value)||0));try{audio.currentTime=maxStart*pct/100}catch{}});
 // Reset only when nextQuiz actually creates a new question, not when the result label changes.
 document.addEventListener('ani-quiz-new-question',()=>{pendingSeekId=''});
})();
</script>